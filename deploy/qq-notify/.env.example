# Copy to .env on the server. These are separate, user-generated tokens.
NAPCAT_WEBUI_TOKEN=
ONEBOT_ACCESS_TOKEN=
QQ_GROUP_ID=
# GitHub token scoped to this repository, Actions: write, Contents: read.
# Required for the 08:00 publication dispatch, separate from QQ credentials.
DEV_PUBLISH_TOKEN=
# Optional: pin the image version/digest used for the deployment.
NAPCAT_IMAGE=mlikiowa/napcat-docker:latest
