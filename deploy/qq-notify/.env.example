# Copy to .env on the server. These are separate, user-generated tokens.
NAPCAT_WEBUI_TOKEN=
ONEBOT_ACCESS_TOKEN=
QQ_GROUP_ID=
# Optional, only for manually using notify.sh --publish.
# Scheduled publication is dispatched by GitHub Actions; ordinary polling needs no token.
DEV_PUBLISH_TOKEN=
# Optional: pin the image version/digest used for the deployment.
NAPCAT_IMAGE=mlikiowa/napcat-docker:latest
