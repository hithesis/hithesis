%
% Lua page metadata is independent of the Word text breaker. Ordinary native
% paragraphs are tagged too; the module does not require LuaTeX-ja to be loaded.
%    \begin{macrocode}
%<*docxlike-page>
\ifdefined\directlua
\RequirePackage{luatexbase}
\begingroup
\catcode32=10\relax
\catcode37=12\relax
\catcode35=12\relax
\catcode126=12\relax
\catcode95=12\relax
\directlua{
docxlike = docxlike or {}
local P = {active = false}
docxlike.page = P
local H, V = node.id('hlist'), node.id('vlist')
local INS = node.id('ins')
local function flag(name)
  return token.is_defined(name) and token.create(name).mode ~= 0
end
local function snapshot()
  local p = {}
  for _, name in ipairs({'margin_left','even_margin_left','margin_top','even_margin_top',
    'margin_right','even_margin_right','header_edge','footer_edge','head_height','head_sep','foot_skip'}) do
    p[name] = tex.getdimen('g_docxlike_page_' .. name .. '_dim')
  end
  p.width = tex.getdimen('g_docxlike_page_paper_width_dim') - p.margin_left - p.margin_right
  return p
end
function P.tag(box)
  if tex.nest.ptr ~= 0 or not flag('g__docxlike_page_configured_bool')
    or flag('l__docxlike_linebreak_output_bool') then return end
  local p = node.getproperty(box) or {}
  p.docxlike_page_geometry = snapshot()
  node.setproperty(box, p)
end
function P.tag_lines(head)
  if tex.nest.ptr == 0 then
    for n in node.traverse(head) do
      if n.id == H or n.id == V then P.tag(n)
      elseif n.id == INS and n.subtype == token.create('footins').mode then P.note(n) end
    end
  end
  return head
end
function P.note(insertion)
  if not flag('g__docxlike_page_configured_bool') then return end
  local geometry = snapshot()
  for line in node.traverse_id(H, insertion.list) do
    local p = node.getproperty(line) or {}
    if not p.docxlike_page_geometry then
      p.docxlike_page_geometry = geometry
      node.setproperty(line, p)
    end
  end
end
local function first_geometry(head)
  for n in node.traverse(head) do
    if n.id == H or n.id == V then
      local p = node.getproperty(n) or {}
      if p.docxlike_page_geometry then return p.docxlike_page_geometry end
      if n.list then
        local geometry = first_geometry(n.list)
        if geometry then return geometry end
      end
    end
  end
end
function P.prepare(index)
  if not P.active or not tex.box[index] then return end
  local geometry = first_geometry(tex.box[index].list)
  if not geometry then return end
  local even = math.fmod(tex.count['c@page'], 2) == 0
  P.base = even and geometry.even_margin_left or geometry.margin_left
  local top = even and geometry.even_margin_top or geometry.margin_top
  P.restore = {}
  local changes = {oddsidemargin=P.base-tex.sp('1in'), evensidemargin=P.base-tex.sp('1in'),
    textwidth=geometry.width, linewidth=geometry.width, columnwidth=geometry.width, hsize=geometry.width,
    headheight=geometry.head_height, headsep=geometry.head_sep, footskip=geometry.foot_skip,
    topmargin=top-tex.sp('1in')-geometry.head_height-geometry.head_sep,
    g_docxlike_page_header_edge_dim=geometry.header_edge, g_docxlike_page_footer_edge_dim=geometry.footer_edge}
  for name, value in pairs(changes) do
    P.restore[name] = tex.getdimen(name)
    tex.setdimen(name, math.floor(value))
  end
end
local function shift(head, even)
  for n in node.traverse(head) do
    if n.id == H or n.id == V then
      local p = node.getproperty(n) or {}
      local geometry = p.docxlike_page_geometry
      if geometry then
        n.shift = n.shift + (even and geometry.even_margin_left or geometry.margin_left) - P.base
      elseif n.list then shift(n.list, even) end
    end
  end
end
function P.shipout(index)
  if P.active and P.base and tex.box[index] then
    shift(tex.box[index].list, math.fmod(tex.count['c@page'], 2) == 0)
  end
end
function P.after()
  if P.restore then
    for name, value in pairs(P.restore) do
      if name == 'headsep' and flag('g__docxlike_headfoot_push_applied_bool') then
        --[[ Header cleanup next removes its actual push globally. Restore the
        caller's base plus that pending removal, not twice less. ]]
        value = value + tex.getdimen('g__docxlike_headfoot_push_dim')
      end
      tex.setdimen(name, value)
    end
    P.restore = nil
  end
  P.base = nil
end
function P.wrap_native()
  local descriptions = luatexbase.callback_descriptions('append_to_vlist_filter')
  for _, name in ipairs(descriptions) do
    if name == 'docxlike.native-boundary' or name == 'docxlike.page.native' then return end
  end
  if #descriptions > 1 then return end
  local name = descriptions[1]
  local base = name and luatexbase.remove_from_callback('append_to_vlist_filter', name)
  luatexbase.add_to_callback('append_to_vlist_filter', function(box, location, depth, mirrored)
    P.tag(box)
    if base then return base(box, location, depth, mirrored) end
    return box, depth, true
  end, 'docxlike.page.native')
end
function P.install()
  luatexbase.add_to_callback('post_linebreak_filter', P.tag_lines, 'docxlike.page.lines')
  P.wrap_native()
end
}
\endgroup
\fi
\AddToHook{begindocument/end}[docxlike-page-geometry]
  {\sys_if_engine_luatex:T{\lua_now:n{docxlike.page.install()}}}
\DeclareHookRule{begindocument/end}{docxlike-page-geometry}{after}{docxlike}
