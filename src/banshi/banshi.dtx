%
% \section{排版引擎 \pkg{banshi}}
%
% \changes{v3.2a}{2026/09/23}{照 Word 排版的三个模块（页面设置、段落格式、断行）独立成
%   \pkg{banshi} 包}
%
% 照 Word 的页面设置、段落格式与断行规则排版的那一层，与具体哪一份格式规范都无关，
% 所以单独成包，叫 \pkg{banshi}（版式），与 Typst 版的 \pkg{banshi} 同名。两边是姊妹实现，
% 键名尽量一一对应，用户在两边的写法可以照着映射。
%
% 源码在 \texttt{latex-banshi} 仓库里，\file{banshi.ins} 生成 \file{banshi.sty}
% 与断行层的 \file{banshi.lua}。名字照 expl3 的规矩：给文档类用的接口是
% \texttt{\textbackslash banshi\_...}，包内部的是 \texttt{\textbackslash \_\_banshi\_...}；
% 空段命令叫 \cs{banshienter}。
%
% ^^A ======================================================================
% ^^A Module package: banshi.sty 的包头
% ^^A ======================================================================
%    \begin{macrocode}
%<*package>
\NeedsTeXFormat{LaTeX2e}[2022/06/01]
\ProvidesExplPackage{banshi}{2026/09/23}{0.1.0}
  {Word-compatible page setup, paragraph formats and line breaking}
%    \end{macrocode}
%
% 给分页那几个内核宏打补丁用 \pkg{etoolbox} 的 \cs{patchcmd}。
%    \begin{macrocode}
\RequirePackage { etoolbox }
%    \end{macrocode}
%
% \subsection{消息}
%
% 报错与提示一律英文，照 \pkg{expl3} 的习惯：第一段一句话说出了什么事，键名用引号括起，
% 帮助文字说怎么改。输入写错（未知的键、不收的取值）报 error；能照常排下去、只是
% 效果打折的报 warning。
%    \begin{macrocode}
\msg_new:nnnn { banshi } { unknown-key }
  { The~key~'#1'~is~unknown~and~is~being~ignored. }
  { Check~the~spelling;~the~banshi~manual~lists~the~keys. }
\msg_new:nnnn { banshi } { bad-value }
  { The~key~'#1'~does~not~accept~the~value~'#2'. }
  { \tl_if_empty:nTF {#3} { Check~the~banshi~manual~for~the~syntax. } { Allowed~values:~#3. } }
\msg_new:nnnn { banshi } { measure-clash }
  { '#1'~and~'#2'~set~the~same~spacing;~using~'#2',~which~came~last. }
  { Only~one~of~them~may~be~given~for~a~target. }
\msg_new:nnnn { banshi } { enter-font-unmeasured }
  { No~measured~natural~line~height~for~the~font~'#1'. }
  {
    The~height~of~an~empty~paragraph~is~the~font's~natural~line~height~
    times~the~line~spacing,~and~only~measured~values~are~used:~serif~
    (Times~New~Roman,~1.1472)~and~songti~(SimSun,~1.29333).
  }
\msg_new:nnnn { banshi } { msword-no-pitch }
  { Cannot~determine~the~line~pitch~of~the~page~setup. }
  { Give~'line-pitch'~or~'lines-per-page'. }
\msg_new:nnnn { banshi } { page-patch-failed }
  { Could~not~patch~\token_to_str:N #1. }
  {
    The~space~reserved~for~the~depth~of~the~last~line~will~not~apply~on~
    every~page,~so~a~page~may~hold~one~more~line~than~in~Word.~Another~
    package~has~probably~redefined~\token_to_str:N #1.
  }
\msg_new:nnnn { banshi } { luatex-punct-grid }
  { Full-width~punctuation~is~not~on~the~character~grid~under~LuaLaTeX. }
  {
    Full-width~punctuation~follows~luatexja's~own~rules~(half-width~glyphs~
    plus~glue),~not~Word's~compression~on~demand.~Use~xelatex~for~exact~
    grid~alignment~with~Word.
  }
\msg_new:nnnn { banshi } { xecjk-punct-grid }
  { xeCJK~lacks~a~character~class~interface~that~banshi~needs. }
  {
    Each~full-width~punctuation~mark~will~be~one~grid~increment~narrower~
    than~in~Word,~and~quotes,~ellipses,~dashes~and~tildes~will~not~follow~
    Word's~widths.~The~interfaces~were~checked~with~xeCJK~3.9.1~(TeX~Live~
    2025)~and~3.10.5~(2026).~Typesetting~continues~with~approximate~
    punctuation.
  }
%    \end{macrocode}
%
% 取值不在集合里时，把允许的取值列成 \texttt{a, b or c} 交给消息。
%    \begin{macrocode}
\seq_new:N \l__banshi_one_of_seq
\tl_new:N \l__banshi_one_of_tl
\tl_new:N \l__banshi_one_of_last_tl
\cs_new_protected:Npn \__banshi_bad_value:nnn #1#2#3
  {
    \seq_set_from_clist:Nn \l__banshi_one_of_seq {#3}
    \int_compare:nNnTF { \seq_count:N \l__banshi_one_of_seq } < { 2 }
      { \tl_set:Nx \l__banshi_one_of_tl { \seq_use:Nn \l__banshi_one_of_seq { } } }
      {
        \seq_pop_right:NN \l__banshi_one_of_seq \l__banshi_one_of_last_tl
        \tl_set:Nx \l__banshi_one_of_tl
          { \seq_use:Nn \l__banshi_one_of_seq { ,~ } ~or~ \l__banshi_one_of_last_tl }
      }
    \msg_error:nnnnV { banshi } { bad-value } {#1} {#2} \l__banshi_one_of_tl
  }
\cs_generate_variant:Nn \msg_error:nnnnn { nnnnV }
%    \end{macrocode}
%
% 键值表里的 \cs{par} 先剥掉再交给 \cs{keys\_set:nn}：用户在键值之间空了一行，
% 读进来就是一个 \cs{par}，\pkg{l3keys} 会把它当成一个键名。
%    \begin{macrocode}
\tl_new:N \l__banshi_keys_tl
\cs_new_protected:Npn \__banshi_keys_set:nn #1#2
  {
    \tl_set:Nn \l__banshi_keys_tl {#2}
    \tl_replace_all:Nnn \l__banshi_keys_tl { \par } { }
    \exp_args:NnV \keys_set:nn {#1} \l__banshi_keys_tl
  }
%    \end{macrocode}
%
% \subsection{全局开关}
%
% 几件全文一刀切的事由布尔量管，文档类在设置它们时照着改：
% \begin{itemize}
% \item \cs{g\_banshi\_word\_layout\_bool}：这份文档走 Word 那套版面。关掉时断行层不装。
% \item \cs{g\_banshi\_ragged\_bottom\_bool}：页面底部不对齐（Word 本来就是这样）。
%   格式表的取值可以按它分两层（\option{if-raggedbottom} 与 \option{if-flushbottom}）。
% \item \cs{g\_banshi\_grid\_bool}：文档网格启用。关掉时“一行”折成正文的单倍行高。
% \item \cs{g\_banshi\_latin\_pitch\_bool}：西文字母也各加半格余量，与汉字对到同一张网格上。
% \item \cs{g\_banshi\_verb\_space\_visible\_bool}：行内代码里的空格印成可见的记号。
% \end{itemize}
%    \begin{macrocode}
\bool_new:N \g_banshi_word_layout_bool
\bool_gset_true:N \g_banshi_word_layout_bool
\bool_new:N \g_banshi_ragged_bottom_bool
\bool_gset_true:N \g_banshi_ragged_bottom_bool
\bool_new:N \g_banshi_grid_bool
\bool_gset_true:N \g_banshi_grid_bool
\bool_new:N \g_banshi_latin_pitch_bool
\bool_new:N \g_banshi_verb_space_visible_bool
\bool_gset_true:N \g_banshi_verb_space_visible_bool
%    \end{macrocode}
%
% \cs{banshisetup}\marg{键值} 是文档里的设置入口，各模块往 \texttt{banshi} 这一族上挂
% 自己的键（\option{format}、\option{linebreak} 等）。
%    \begin{macrocode}
\keys_define:nn { banshi }
  {
    unknown .code:n =
      { \msg_warning:nnV { banshi } { unknown-key } \l_keys_key_str } ,
  }
\NewDocumentCommand \banshisetup { m } { \__banshi_keys_set:nn { banshi } {#1} }
%</package>
%    \end{macrocode}
%
% \Finale
