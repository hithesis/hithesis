% \section{相邻文献序号的压缩}
% \label{sec:cite-compress}
% \option{bib} 族的 \option{compress-min} 管相邻连续的文献序号几个起压成
% 区间：
%
% \begin{longtblr}[caption={\option{compress-min} 的效果}, label={tab:compress}]
%   {colspec={l l l}}
% \toprule
% 取值 & \cs{cite}\{a,b\}（序号 1、2） & \cs{cite}\{a,b,c\}（序号 1、2、3） \\ \midrule
% \texttt{2} & \texttt{[1-2]}，默认 & \texttt{[1-3]} \\
% \texttt{3} & \texttt{[1,2]} & \texttt{[1-3]} \\
% \bottomrule
% \end{longtblr}
%
% 三个及以上连续的总归压成区间。不连续的序号本来就是逗号分隔，不受这个选项
% 影响。两条文献路线都认（见第~\ref{sec:bib-backend}~节），落点都是官方机制：
% 传统 \hologo{BibTeX} 一线转发给 \pkg{gbt7714.sty} 的 \texttt{mincompress}，
% biblatex 一线落到 \pkg{gb7714-2015} 的 \texttt{gbrefcompress} 计数器。
% 两边都不锁时机，什么时候设都行。
%
% \begin{latex}
% \hitsetup{bib={compress-min=3}}
% \end{latex}
%
% \section{参考文献的两条路线}
% \label{sec:bib-backend}
% 参考文献从 v3.2a 起分两条路线，\option{bib} 族的 \option{backend} 键选：
%
% \begin{longtblr}[caption={参考文献的两条路线}, label={tab:backend}]
%   {colspec={l X[1,l] l}, width=\linewidth}
% \toprule
% 取值 & 底下是什么 & 编译时跑的程序 \\ \midrule
% \texttt{bibtex} & \pkg{gbt7714}/\pkg{natbib} 加 \file{.bst}，默认 &
%   \texttt{bibtex} \\
% \texttt{biber} & \pkg{biblatex}，样式走 \pkg{biblatex-gb7714-2015} &
%   \texttt{biber} \\
% \bottomrule
% \end{longtblr}
%
% \texttt{biblatex} 当 \texttt{biber} 的别名也认。用 \texttt{latexmk} 编译不用
% 改别的——它看见 \file{.bcf} 就知道该跑 \texttt{biber}。不写这个键就是传统
% 一线；在导言区自己 \cs{usepackage}\marg{biblatex} 的，模板会侦测到，效果
% 等同 \texttt{biber}。
%
% \textbf{位置有讲究}：\pkg{biblatex} 必须赶在 \cs{begin}\marg{document} 之前
% 装载，所以 \option{backend}\texttt{=biber} 和 \option{struct} 里的
% \option{bibliography} 都要写在主文件的\emph{导言区}——demo 的
% \cs{hitsetup} 全在 \cs{begin}\marg{document} 之后，走 biber 一线时把这两组
% 往上挪：
%
% \begin{latex}
% \documentclass[…]{hithesis}
% \hitsetup[stage=final,lang=zh]{ struct = {
%   bibliography = {final/backmatter/reference} } }
% \hitsetup[stage=final]{ bib = { backend = biber } }
% \begin{document}
% \end{latex}
%
% 写晚了模板会一条条提醒，不会闷头编出错的结果。
%
% \option{bib} 族的通用键两条路线都认，名字对齐李泽平 gbt7714 v3 的官方
% 选项（kebab 拼写）：\option{uppercase-family}（\texttt{true} 著者姓名
% 全大写即国标排法，默认；\texttt{false} 保持 \file{.bib} 原样）、
% \option{max-bib-names}（文献表里最多列几位作者，\texttt{0} 不限）、
% \option{max-cite-names}（正文引用侧的同款，数字引用不出姓名，只在
% biblatex 一线对 \cs{textcite} 这类起作用）、\option{numbering-align}
% （文献表标号 \texttt{left}/\texttt{right}）、\option{compress-min}
% （见第~\ref{sec:cite-compress}~节）、\option{split-entry}（一条文献
% 可否跨页）、\option{punct}（著录标点三档，见下文换底座一段）、
% \option{comma-in-cite}（正文引用序号间的分隔：\texttt{half} 排
% \texttt{[3,5]} 默认、\texttt{half-with-space} 排 \texttt{[3,~5]}、
% \texttt{full} 排全角逗号）、\option{brackets-in-cite}（正文引用的方括号
% \texttt{half} 默认／\texttt{full} 排 ［3,5］）、\option{correct-punct}（\file{.bib} 数据里的
% 标点按 \option{punct} 档位清洗，默认开；biblatex 一线经 biber 的
% sourcemap 做同一套替换，姓名字段不动）、
% \option{sentence-case}（西文题名转不转句首大写。三个字段各一档：
% \texttt{sentence-case=\{title=true,booktitle=true,journal=false\}}；也可以
% \texttt{sentence-case=true|false|auto} 一次设三个。\texttt{auto} 是规范默认，
% 就是前面那一行的取值——期刊名不转，缩写形式本来就带自己的大小写。
% 名字取自两条后端线共有的说法，\file{.bst} 那边的控制字段叫
% \texttt{CTL\_sentence\_case\_title}，\pkg{biblatex} 那边的命令叫
% \cs{MakeSentenceCase}；不叫 \texttt{title-case}，那在西文排版里指每个实词
% 首字母大写，正好相反）、
% \option{show-mark}／\option{show-medium}（类型标 ［J］ 与载体标
% \texttt{/OL} 的显示开关，默认开）、\option{link-title}（题名加超链接，
% 默认关）、\option{show-url}／\option{show-doi}／\option{show-eprint}
% （默认开、开、关）、\option{show-note}（\file{.bib} 的 \texttt{note} 字段
% 排不排在条目末尾，默认关；成果页那种“SCI~收录，IDS~号为……”写进
% \texttt{note} 再打开它）、\option{show-sl-sn}（缺出版地或出版者时补不补
% ［出版地不详］/［出版者不详］，国标要补，默认 \texttt{true}，两条线
% 都可关）。除 \option{compress-min} 与 \option{split-entry} 外，其余在
% biblatex 一线是装载时换算成它的选项的，要么跟 \option{backend} 写进同一组
% \option{bib}\texttt{=\{...\}}，要么排在它前面，设晚了有提示。
%
% 后端专属的配置各归各的子组。传统一线换 \file{.bst} 写
% \option{bib}\texttt{=\{bibtex=\{style=gbt7714-2025-numeric\}\}}，值交给
% \cs{bibliographystyle}，\hologo{TeX} 树里任何 \file{.bst} 名都行，什么时候
% 设都行。biblatex 一线不开挑样式的口子——规范就是国标，样式锁死
% \texttt{gb7714-2015}；细调走 \option{biber}\texttt{=\{...\}}，整张键值表
% 原封并进 \pkg{biblatex} 的装载选项，\pkg{biblatex-gb7714-2015} 的几十个
% 选项（\texttt{gbpub}、\texttt{gbtype}、\texttt{gbannote}……）都从这儿过：
%
% \begin{latex}
% \hitsetup{ bib = { backend = biber ,
%                    biber = { gbpub = false , gbannote = true } } }
% \end{latex}
%
% 上标引用、\cs{inlinecite}、\cs{citeup}、全角序号、著录列表的版面都对齐到
% 传统一线。已知差别三处：著录条目的细排一边跟 \file{.bst}、一边跟
% \pkg{biblatex-gb7714-2015}，不逐字一致；传统一线默认把西文题名句首化
% （官方 \texttt{sentencecase=true}），biblatex 一线保持原样；
% \cs{inlinecite} 的标签前后没有传统一线那个中西文自动间距（gb 系样式特意
% 压掉的）；\option{punct} 在 biblatex 一线只落到方括号上（类型标、
% 访问日期），逗号冒号保持半角——2015 代的 biblatex 样式没有那半个旋钮
% （\texttt{gbpunctwidth} 是 2025 代才有的）。正文里残留的
% \cs{bibliographystyle} 会降级成一条提示，
% \cs{bibliography} 自动当 \cs{printbibliography} 排，老文档不用大改。
%
% 传统一线从 v3.2a 起只有一个 \file{hithesis.bst}，正文照抄李泽平官方
% \texttt{gbt7714-2015-numeric.bst}（v3.0.1）。原先深圳单独一个
% \file{hitszthesis.bst}，差异就是全角标点——标点如今是旋钮，不必再分文件：
% \option{bib} 族的 \option{punct} 三档，默认 \texttt{full}（不分语种
% 一律全角逗号冒号圆括号方括号、句点恒半角带空格，学校规范的示例与旧深圳版
% 都是这个排法）、\texttt{half}（一律半角，旧哈尔滨版的排法）、
% \texttt{by-lang}（按条目语言，中文全角西文半角）。全校区全学位同一个默认，
% 两条文献路线都认这个键，随设随生效。
%
% 对官方原版的补丁共五处（\file{src/hit-bst.dtx} 里 \texttt{HIT patch}
% 横幅标出）：\texttt{language} 认短码 \texttt{zh}/\texttt{en}（存量
% \file{.bib} 不用改）；默认档 \texttt{bylanguage}；句点恒半角带空格
% （官方全角档是 \texttt{．}，学校示例是 \texttt{.\ }）；方括号跟随全角档
% （类型标与访问日期排 ［Ｍ］ 这样的全角）；存量字段名 \texttt{citedate}
% 当 \texttt{urldate}、\texttt{typeoflit} 当 \texttt{entrytypeid} 的旧名
% （访问日期 ［1998-09-26］ 照旧显示）。其余默认照官方：西文姓氏全大写
% （\option{uppercase-family} 可关）、题名句首化、会议文献排出版地。
% 旧版丢出版地、\texttt{inbook} 排出悬空“\texttt{//}”的两个毛病随
% 换底座消失。写 \cs{bibliographystyle}\marg{hitszthesis} 的老文档请改成
% \texttt{hithesis}。
%
