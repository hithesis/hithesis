% \subsubsection{答辩决议那一页}
% \label{sec:defense}
% \changes{v3.2a}{2026/08/12}{答辩决议那一页改成排出来，名单与决议正文由
%   \texttt{defense} 族给}
% 这一页排的是评阅人名单、答辩委员会名单和答辩委员会决议。默认只有博士排，
% 由 \option{struct} 里的 \option{defense} 控制：
%
% \begin{longtable}{ll}
% \toprule
% 取值 & 谁排 \\\midrule
% \endfirsthead
% \option{auto}  & 只有博士排 \\
% \option{true}  & 都排 \\
% \option{false} & 都不排，不写也是这样 \\\bottomrule
% \end{longtable}
%
% \DescribeOption{defense}
% 名单与决议正文写在 \option{defense} 族里，一个人一条记录：
% \begin{latex}
% \hitsetup{ defense = {
%   reviewer  = {name=张三, title=教授（博导）, affiliation=哈尔滨工业大学,
%                discipline=机械工程},
%   reviewer  = {name=李四, title=研究员, affiliation=中国科学院沈阳自动化研究所,
%                discipline=机械工程},
%   chair     = {name=王五, …},
%   member    = {name=赵六, …},
%   member    = {name=孙七, …},
%   secretary = {name=周八, …},
%   resolution = {答辩委员会听取了论文作者的报告……建议授予工学博士学位。},
% } }
% \end{latex}
%
% 五个键：\option{reviewer} 评阅人，\option{chair} 主席，\option{member} 委员，
% \option{secretary} 秘书，\option{resolution} 决议正文。一条记录里四个字段：
% \option{name}、\option{title}、\option{affiliation}、\option{discipline}，
% 分别对应表上的姓名、职称（是否博导）、工作单位、所在学科。
%
% \textbf{同一个键写多遍是累加，不是覆盖。} 评阅人与委员写几条就是几个人，
% 顺序就是写的顺序。某个字段不写只是那一格空着，不会把后面的顶错位。
% \changes{v3.2a}{2026/08/13}{\texttt{defense} 族的键之间可以有空行}
% 键与键之间空一行分组也行。
%
% 一条都不填也能编，排出来是一张空表，行数与纸质表一样，打印出来手写或盖章。
% 填了人就按人数排，比纸质表的行数多也行。
%
% \changes{v3.2a}{2026/08/13}{某一块人数超了先向还有空行的块借行，借得到就不动
%   总行数；标签按格子高度自动决定竖排还是横排}
% \textbf{行数会互相匀。} 纸质表四块的行数是评阅人 2、主席 1、委员 6、秘书 1。
% 某一块写超了，先看别的块有没有空着的行——委员只填四个就空两行，这两行匀给
% 超了的那块，总行数不变，决议区也就不会变矮。全借完还不够才加总行数。
%
% \textbf{“委员”这类竖排标签会跟着行数变。} 那一块只剩一行时两个字自己横排，
% 行数够了变成竖排。两个字的标签字距随格子高度撑开，最多撑到 1.8 倍行距，
% 与纸质表默认六行时的间距一致；三个字以上的标签贴着排、整摞居中，
% 也与纸质表一致。
%
% 决议正文那一框吃掉整页剩下的高度：上面两张表有几个人就多高，剩多少这一框就占
% 多少，整页的底边始终落在纸质表的同一位置。
%
% \changes{v3.2a}{2026/08/12}{决议正文写不下时跨页续排；名单太长挤掉决议时
%   整块挪到下一页，上面的名单表撑满第一页}
% 决议正文写得长、一页放不下，就接着排到下一页，续页那一框四条边都有，
% 线宽与第一页最外侧那圈一样。名单填得多、把决议的地方挤到放不下两行字时，
% 决议整块挪到下一页，第一页由名单表撑满，底边照旧落在原处。
% 这时行高会比纸质表的略高，是保住底边对齐的代价。
%
% \changes{v3.2a}{2026/08/12}{答辩决议与授权书的三种排法统一进 \option{struct}：
%   取值是 \texttt{auto}/\texttt{true}/\texttt{false} 就排出来，是文件名就贴那个
%   PDF，带星号的键再加排页码}
% \DescribeOption{defense*}
% 已经有盖过章的扫描件就把文件名写进同一个键，不必另外调命令：
% \begin{latex}
% struct = { backmatter = {
%   defense  = auto,                        % 只有博士排，排版式表格
%   defense  = {figures/resolution.pdf},    % 贴这个 PDF，不排页码
%   defense* = {figures/resolution.pdf},    % 贴这个 PDF，排页码
% } }
% \end{latex}
% 取值是 \texttt{auto}、\texttt{true}、\texttt{false} 三个词之一就按上面的数据排，
% 别的都当文件名。\option{declarations} 与 \option{declarations*} 写法完全一样。这跟 \option{bibliography}、\option{appendix}
% 那些“给文件名就读那个文件”是同一个路数。
%
% \DescribeMacro{\resolution}
% \changes{v3.2a}{2026/08/13}{\cs{resolution} 与 \cs{resolution*} 列为旧写法，
%   调用时提示改用 \option{struct} 的 \option{defense} 键}
% \cs{resolution}\oarg{文件} 与 \cs{resolution*}\oarg{文件} 照旧能用，效果与上面两行
% 相同，但已经是旧写法：调用时日志里会提示改写成 \option{struct} 的 \option{defense}，
% 兼容期到 v4（预计~2027~年发布）。
%
% \changes{v3.2a}{2026/08/12}{不给文件时改成排版式表格，不再贴
%   \file{figures/empty-resolution.pdf}，那张图已从示例目录删掉}
% \textbf{从 v3.1e 升上来要注意：} 不给文件时原先贴的是
% \file{figures/empty-resolution.pdf} 那张扫描的空表图，现在改成排出来，
