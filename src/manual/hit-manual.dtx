% 排开题与中期报告。直接写它们一直有效。
%
% \DescribeMacro{kind}
% 另外有一个派发类 \file{hithesis.cls}，\option{kind} 选交付物种类，它按这个
% 转发给上面两个之一：
%
% \begin{latex}
% \documentclass[kind=thesis,  degree-level=doctor, campus=harbin]{hithesis}
% \documentclass[kind=proposal, degree-level=doctor, campus=harbin]{hithesis}
% \documentclass[kind=interim, degree-level=doctor, campus=harbin]{hithesis}
% \end{latex}
%
% \begin{longtable}{lll}
% \toprule
% \option{kind} & 转发给 & 等价于 \\\midrule
% \endfirsthead
% \toprule
% \option{kind} & 转发给 & 等价于 \\\midrule
% \endhead
% \texttt{thesis}（默认） & \file{hit-thesis} & \cs{documentclass}\marg{hit-thesis} \\
% \texttt{proposal} & \file{hit-report} &
%   \cs{documentclass}\oarg{kind=proposal}\marg{hit-report} \\
% \texttt{interim} & \file{hit-report} &
%   \cs{documentclass}\oarg{kind=interim}\marg{hit-report} \\\bottomrule
% \end{longtable}
%
% \changes{v3.2a}{2026/08/11}{手册记一条：\option{degree-level}\texttt{!=postdoc} 定死
%   \option{kind}\texttt{!=thesis}}
% \option{degree-level}\texttt{=postdoc} 是个例外。博士后只写研究报告，没有开题与中期，
% 所以只要出现这个取值就按学位论文类派发，\option{kind} 写什么都不看，不写也行。
% 显式写了别的 \option{kind} 时日志里说一句。
%
% 好处是一个学生三年里的开题、中期、学位论文可以放在同一个目录里，元信息、
% 参考文献库、图片目录写一次，三份主文件只有第一行不同。开题报告要填的字段
% 有九个，其中六个跟学位论文重名。
%
% \option{kind} 只能写在 \cs{documentclass} 上，挪不进导言区：\cs{LoadClass}
% 得在类文件里执行完，而 \cs{hitsetup} 是导言区的事，那时候基础类早装上了。
% 所以做不到“一个主文件靠一行开关切三种交付物”，能做到的是一个目录里三个
% 主文件，每个只有第一行不同。
%
% \option{kind} 写错了会有提示，并按 \texttt{thesis} 兜底，不硬失败——
% 装类失败的话后面几百个错都指不到病根。
%
