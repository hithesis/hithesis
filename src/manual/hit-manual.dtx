% \begin{latex}
% \hitsetup{term={zh={eqdenote-label={式中}}, en={eqdenote-label={where}},
%                  mainmatter-eqdenote-dash={——}}}
% \end{latex}
%
% 中文文档用 \texttt{eqdenote-label-zh}，\option{lang=en} 时用
