% \section{改写词条}
% \label{sec:const}
% 封面标签、章节名、声明正文这类固定词汇叫\emph{词条}，由模板给出默认值。各院系
% 的要求不尽相同，需要改写时在导言区用 \option{term} 族设置：
% \begin{latex}
% \hitsetup{
%   term = {
%     zh = { supervisor-field-label = {指导教师}, keywords-separator = {；} },
%   },
% }
% \end{latex}
% \emph{这一族原先叫 \option{const}。}改名的理由是族名该说清“这一族键是什么”：
% 每个键都是一条词条，取出来的宏一直叫 \cs{hit@term@}\meta{名}，而
% \texttt{const}（常量）只说了它不会变，没说是哪一类东西。旧族名照旧生效，
% 写了会在日志里提示一次；只有斜杠路径那种写法（\texttt{const/zh/\ldots}）
% 不认旧名，要写成 \texttt{term/zh/\ldots}。
%
% 中英文成对的词汇同样收在 \option{zh} 与 \option{en} 分组里，写法见
% 第~\ref{sec:setup-language}~节。带后缀的本名与内部命令一一对应：
% \option{supervisor-field-label-zh} 对应 \cs{hit@supervisor@field@label@zh}，
% 名字里的连字符对应内部命令里的 \texttt{@}。
%
% \emph{键名怎么拼。} 一个键名是“桶名 + 词条名 + 各档取值”。桶名在最前，
% 各档取值一律排在后面，次序固定：
%
% \begin{quote}
% \meta{词条名}\oarg{-材料}\oarg{-校区}\oarg{-学位}\oarg{-学位类别}\oarg{-学科门类}\oarg{-语言}
% \end{quote}
%
% 省掉哪一段，就是那条轴各档共用。\option{declarations-statement} 是研究生与本科
% 共用的那一份，\option{declarations-statement-bachelor} 是本科专有的那一份；
% \option{school-bottom-mark-shenzhen-master} 同时钉住校区与学位。
%
% 六根轴与六个类选项一一对应，取值也一样：材料是 \option{stage}
% （\texttt{final}／\texttt{proposal}／\texttt{interim}），校区是 \option{campus}，
% 学位是 \option{degree-level}，学位类别是 \option{degree-type}，学科门类是
% \option{category}，语言是 \option{lang}。
%
% \emph{档位值前面加 \texttt{!} 就是取反。} \option{achievements-heading-!final}
% 读作“不是终稿的那几档”，也就是开题与中期共用的那一条。终稿是这根轴的基准，
% 不为它另立名字——与条件里 \option{layout}\texttt{=!v2-layout} 是同一套写法。
%
% 比具体程度时，正着写的一段压得住取反的那一段：同时写了
% \option{achievements-heading-proposal} 与 \option{achievements-heading-!final}，
% 开题那一档取前者。语种段不许取反，写了当场报错。
%
% \emph{桶是页。} 同一个字段身份在不同的页上常常是不同的东西：报告封面的“院（系）”
% 与内封的“所在单位”都是 \option{affiliation}，挤在一层里只能靠前缀区分，越加越长，
% 也看不出哪一条只有某一页用得上。所以键名前面带一段桶名，一页一个桶，跨页共用的
% 进 \texttt{base}。桶名共十个：\texttt{base}、\texttt{cover}、\texttt{titlepage}、
% \texttt{abstract}、\texttt{toc}、\texttt{declarations}、\texttt{resolution}、
% \texttt{backmatter}、\texttt{header}、\texttt{caption}。
%
% 写的时候桶与语言各是一层，不必自己拼：
%
% \begin{latex}
% \hitsetup{ term = {
%   zh = { titlepage = { supervisor = {导师} } },   % titlepage-supervisor-zh
%   declarations = { authorization = {使用授权书} },  % declarations-authorization
% } }
% \end{latex}
%
% 三种写法等价：分层写、拼好写（\option{declarations-authorization}）、斜杠路径写
% （\option{term/zh/titlepage/supervisor}）。拼错桶名或词条名会收到一条警告，
% 里面写着拼出来的完整键名。
% 模板按当前文档的校区、学位、语种挑段数最多的一条，绑到不带任何档位的名字上，
% 所以排版代码里写 \cs{hit@statement@heading} 拿到的就是本档该用的值。
%
% 用户改写时两种名字都收：写不带档位的名字覆盖当前这一档，写带档位的名字只覆盖
% 那一档。
%
% v3.2a 开发中有 27 个键把档位写在名字前头（\option{bachelor-statement-heading}
% 这样），已经统一改成后缀。这些键都是 v3.2a 新加的，v3.1e 没有对应的写法。
%
% \subsection{默认值都在 \file{hithesis.cfg} 里}
% \label{sec:cfg}
% 模板给的默认值全在 \file{hithesis.cfg} 里，一行一个键，两档都读这一份。想知道
% 某个词、某个尺寸的默认值是什么，在里面搜键名就能看到；要改，照第
% ~\ref{sec:keyfamily}~节在导言区用 \cs{hitsetup} 覆盖，不必改这个文件。
%
% 它由 \file{hithesis.dtx} 生成，跟 \file{hithesis.cls} 一起装进
% \file{tex/latex/hithesis/}。里面每一块的形式是
% \cs{hit@presetup}\oarg{条件}\marg{键值表}：条件的写法与
% \cs{hitsetup} 的可选参数完全一样，见第~\ref{sec:setup-condition}~节。
% 不带条件的那些块无条件生效。
%
% 文件分三段。头一段不带段条件，两档都吃；接下来
% \cs{hit@presetup@scope}\texttt{\{stage!=final\}} 起是终稿那一段，
% \cs{hit@presetup@scope}\texttt{\{stage!=!!final\}} 起是开题与中期那一段。
% 段条件与每一行自己的条件各判各的，都成立才生效。
%
% v3.1e 是 \file{hithesisbook.cfg} 与 \file{hithesisart.cfg}，v3.2a 开发中一度
% 并进类文件，又按类名拆成两份，最后合成这一份。
%
