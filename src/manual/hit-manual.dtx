% \option{appendix}         & 文件名 & 后置，参考文献之后 \\
% \option{publications}     & 文件名 & 后置，附录之后 \\
% \option{defense}          & \texttt{auto} / \texttt{true} / \texttt{false} / 文件名 & 后置，成果之后 \\
% \option{defense*}         & 文件名 & 同上，贴 PDF 并排页码 \\
% \option{index}            & 文件名 & 后置，决议之后 \\
% \option{declarations}     & \texttt{true} / \texttt{false} / 文件名 & 后置，索引之后 \\
% \option{declarations*}    & 文件名 & 同上，贴 PDF 并排页码 \\
% \option{acknowledgements} & 文件名 & 后置或前置，可挪 \\
% \option{resume}           & 文件名 & 后置，最后 \\
% \bottomrule
% \end{longtblr}
%
% \option{cover} 与 \option{abstract} 那两个文件只是被读进来：封面那个设元信息，
% 摘要那个把两段正文收起来，真正排版由模板接着封面一起做。所以它们必须赶在
% 封面之前读到，写在分组里的哪个位置都不影响排出来的次序。
%
% 取文件名的那几项走 \cs{include}，只有 \option{cover}、\option{abstract}、
% \option{list-of-symbols} 与 \option{appendix} 走 \cs{input}，附录还会套上
% \env{appendix} 环境。
%
% 写错了会说三种话：
% \begin{itemize}
% \item 部件放进它不能去的那一段，报错并说清它能写在哪；
% \item 同一次 \cs{hitsetup} 里把一个部件写进两个段，警告，按后写的排；
% \item 分组里出现不认识的键，警告并忽略。
% \end{itemize}
%
% 报告也认这几个宏，这样一个目录里几份交付物的正文部分长得一样。报告没有
% 前后文之分，\cs{hitfrontmatter} 只排封面，\cs{hitbackmatter} 只排参考文献，
% \option{mainmatter} 走 \cs{input} 而不是 \cs{include}——报告正文紧接目录排，
% 多一个分页就多一张空白页。
%
% 原先逐个 \cs{include} 的写法照旧有效，两种可以混着用。
%
% \subsection{一份配置管几种交付物}
% \label{sec:one-main}
% \option{stage} 必须写在 \cs{documentclass} 上，因此每种交付物仍各有一个很薄的
% 主文件。元信息与结构配置可以放进同一份文件，由 \cs{hitsetup} 的条件参数分流：
% \begin{latex}
% \hitsetup[stage=final,lang=zh]{ struct = { ...完整一份... } }
% \hitsetup[stage=final,lang=en]{ struct = { ...完整一份... } }
% \hitsetup[stage=proposal]{ struct = { ...完整一份... } }
% \hitsetup[stage=interim]{ struct = { ...完整一份... } }
% \end{latex}
%
% \textbf{条件决定“做不做”，不决定“谁优先”。} \cs{hitsetup} 一贯是后写的覆盖
% 先写的，这一条不因为带了条件而改变。上面四组两两互斥，任何一份文档只命中一组，
% 所以先后无关。
%
% 写成“一组打底、另一组只改几项”也可以，但那样两组会同时命中，
% \textbf{顺序就有讲究了}：打底的那组必须写在前面，写反了它会把改过的项盖回去，
% 而且不报错。
%
% \subsection{按交付物加载宏包}
% \label{sec:usepackage}
% \DescribeMacro{\hitusepackage}
% 一份主文件只有一个导言区，\cs{usepackage} 对哪种交付物都生效。只有某一种要的
% 宏包写成：
% \begin{latex}
% \hitusepackage[stage=proposal]{lipsum, siunitx={per-mode=symbol, detect-all}}
% \end{latex}
% 条件与 \cs{hitsetup} 的那个可选参数完全一样，逗号是且、竖线是或、分号分组。
% 带选项的写成\meta{包名}\texttt{=}\marg{选项}：选项用花括号不用方括号，
% 外层是逗号表，方括号里的逗号会被外层拆开，花括号护得住。
%
% 按写的顺序加载，不排序也不去重——宏包之间的先后常常有讲究。
%
% 只能写在导言区，也就是 \cs{begin}\marg{document} 之前。
%
