% \section{索引排序样式}
%
% \changes{v4.0a}{2026/08/09}{索引排序样式从 \file{hithesis.dtx} 单独成文件；前置部分的罗马页码排在
%   正文页码前面}
% 生成 makeindex 样式，设置字母分组标题及页码对齐。
% 罗马页码须排在阿拉伯页码前，不能使用 makeindex 默认的大小写排序顺序。
% \changes{v1.0.10}{2018/02/19}{修改了索引的间距，使其更符合规范中的示例}
%    \begin{macrocode}
%<*ist>
page_precedence "rRnaA"
headings_flag 1
heading_prefix "\{\\par\\addvspace\{12bp\}\\centering\\normalsize\\textbf\{"
heading_suffix "\}\\par\}\\nopagebreak\n"
group_skip "\n"
delim_0 "\\hspace*{\\fill}"
delim_1 "\\hspace*{\\fill}"
delim_2 "\\hspace*{\\fill}"
%</ist>
%    \end{macrocode}
%
% \Finale
