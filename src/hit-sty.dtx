% \subsection{正文里排控制序列}
%
% \verb|\cs{foo}| 排出 \verb|\foo|，示例正文讲命令用法时在用。
%    \begin{macrocode}
\def\cmd#1{\cs{\expandafter\cmd@to@cs\string#1}}
\def\cmd@to@cs#1#2{\char\number`#2\relax}
\DeclareRobustCommand\cs[1]{\texttt{\char`\\#1}}
%</hit-sty>
%    \end{macrocode}
