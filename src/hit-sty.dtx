\newcommand{\tcellthree}[2]{%
  \pgfmathsetmacro{\x}{#1}
  \pgfmathsetmacro{\y}{#2}
  %\node [maternal] at (\x+12, \y) {M};
  %\node [paternal] at (\x+12, \y-0.5) {P};
  \draw[btcell](\x-2,\y+0.5)--(\x+11,\y+0.5)--
