%
% 固定词条按共用、终稿、报告三组提供。每组通过 presetup 条件限制适用范围。
% 词条按部件组织：title 表示部件标题，清单中的 image、table、equation 表示条目类型名，
% imprint 表示封面落款。info 是用户填写的信息，styles 和 layout 是版式参数。
%
%    \begin{macrocode}
%<*hithesis-cfg>
%    \end{macrocode}
%
% 校区名。值只有校区两个字，「（威海）」的括号、「深圳校区」的「校区」都在用的地方
% 拼——同一个校区名在封面上带括号、在深圳本科页眉上跟着「校区」，那是版式的事，
% 不是这个值的事。三个类共用一份。
%    \begin{macrocode}
\ExplSyntaxOff
\hit@presetup[campus=harbin]{ overrides = { base = { campus = {哈尔滨} } } }
\hit@presetup[campus=weihai]{ overrides = { base = { campus = {威海} } } }
\hit@presetup[campus=shenzhen]{ overrides = { base = { campus = {深圳} } } }
\hit@presetup{ overrides = { base = { campus-full = {<base-campus>校区} } } }
\hit@presetup{ overrides = { cover = { imprint = {哈尔滨工业大学教务处制} } } }
% 正文引用的“式”与公式清单的“公式”分别设置。
\hit@presetup{ overrides = { caption = { equation = {式}[Equation] } } }
\hit@presetup{ overrides = {
  list-of-figures = { image = {<caption-figure>}[<caption-figure>] },
  list-of-tables = { table = {<caption-table>}[<caption-table>] },
} }
\ExplSyntaxOn
%    \end{macrocode}
%
%    \begin{macrocode}
\hit@presetup@scope{stage=final}
%    \end{macrocode}
%
%    \begin{macrocode}
\ExplSyntaxOff
\hit@presetup[category=hass]{ overrides = {
  abstract = { in-english-toc = {Abstract(In Chinese)}[Abstract(In English)] },
  acknowledgements = { title = {\keepvalue}[Acknowledgments] },
  declarations = { title = {\keepvalue}[Statement of copyright and letter of authorization] },
} }
\ExplSyntaxOn
%    \end{macrocode}
%
%    \begin{macrocode}
\ExplSyntaxOff
%    \end{macrocode}
%
% 标题和题注名称统一按部件设置；标准 LaTeX 名称命令由词条接口更新。
%    \begin{macrocode}
\hit@presetup[lang=en]{ overrides = {
  mainmatter = { chapter-name = {Chapter\enskip,} },
  appendix = { title = {Appendix} },
  table-of-contents = { title = {Contents} },
  list-of-figures = { title = {List of Figures} },
  list-of-tables = { title = {List of Tables} },
  list-of-equations = { equation = {Equation} },
  caption = { figure = {Figure}, table = {Table} },
} }
%    \end{macrocode}
%
% 答辩决议表的表头。带 \verb|\\| 的几条是要在格子里换行的：评阅人那格三行，
% 「答辩委员会成员」与「委员」在纸质表上是竖排，逐字一行。
%    \begin{macrocode}
\hit@presetup[lang=en]{ overrides = {
  defense = {
    reviewer = {Reviewers},
    name = {Name},
    column-title = {Title\\(Doctoral\\Supervisor?)},
    affiliation = {Affiliation},
    discipline = {Discipline},
    role = {Role},
    committee = {\rotatebox{90}{Defense Committee}},
    chair = {Chair},
    member = {\rotatebox{90}{Member}},
    secretary = {Secretary},
    text = {Resolution of the defense committee (comments on the dissertation and whether the doctoral degree is recommended):},
  },
} }
%    \end{macrocode}
%    \begin{macrocode}
\hit@presetup[lang=zh]{ overrides = {
  mainmatter = { chapter-name = {第,章} },
  appendix = { title = {附录} },
  table-of-contents = { title = {目录} },
  list-of-figures = { title = {图清单} },
  list-of-tables = { title = {表清单} },
  list-of-equations = { equation = {公式} },
  caption = { figure = {图}, table = {表} },
} }
%    \end{macrocode}
%
% 参考文献与索引的标题保留中英文两份，词条接口同时更新标准名称命令。
% 正文标题按文档语言选择，英文目录使用英文词条。
%    \begin{macrocode}
