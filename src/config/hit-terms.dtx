% 还是被默认值填过，用户写了 \option{degree-type}\texttt{=professional} 会看不出变化。
%    \begin{macrocode}
\hit@presetup{ overrides = {
  degree-type = {
    academic = {学术学位论文}[Academic Degree],
    professional = {\hit@if@option@TF{practice}{专业学位\hit@cover@practice@type}{专业学位论文}}[Professional Degree],
  },
} }
