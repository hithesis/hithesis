% 中英文开题、中期按深圳教务部 2018 版 Word 的分节、样式及直接格式配置。
% 博士暂时继承同阶段、同语种的硕士版式，仅文种随学位变化。
% 开题三级标题采用示例的 18/15/14 bp，中期采用示例的 15/14/14 bp；
% 不保留原件粘贴造成的负缩进、旧字体和空白标题。目录与正文各从 1 编阿拉伯页码。
% 页眉双线与带短横页码沿用 iota 的统一取法，中期目录不印页眉。
%    \begin{macrocode}
\ExplSyntaxOff
\hit@presetup[body=shenzhen-report]{
  layout = {
    compatibility-mode = word-2013,
    bottom = ragged,
    paper = { width = 595.35bp, height = 842bp },
    margin = { top = 70.9bp, bottom = 65.2bp, left = 70.9bp, right = 70.9bp },
    header = { from-edge = 51bp, rule = { width = 3bp, from-text = 1bp } },
    footer = { from-edge = 49.6bp },
    grid = { enabled = true, lines = { pitch = 15.6bp }, chars = { pitch = 0bp } },
    cover = {
      margin = { top = 70.9bp, bottom = 65.2bp, left = 70.9bp, right = 70.9bp },
      grid = { enabled = true, lines = { pitch = 15.6bp }, chars = { pitch = 0bp } },
    },
  },
  styles = {
    Normal = { font = { asian-text-font = SimSun, size = 12bp, snap-to-grid = false },
      paragraph = { snap-to-grid = false, indentation = { special = first-line, by = 2 chars } } },
    Normal/if-raggedbottom = { paragraph = { spacing = { line-spacing = multiple, at = 1.2, before = 0bp, after = 0bp } } },
    Normal/if-flushbottom = { paragraph = { spacing = { line-spacing = multiple, at = 1.2, before = 0bp, after = 0bp } } },
    Heading1 = { font = { size = 15bp, snap-to-grid = false, character-spacing = { spacing = normal } },
      paragraph = { alignment = left, snap-to-grid = false, indentation = { left = 0bp, special = none } } },
    Heading2 = { font = { size = 14bp, snap-to-grid = false },
      paragraph = { alignment = left, snap-to-grid = false, indentation = { left = 0bp, special = none } } },
    Heading3 = { font = { size = 14bp, snap-to-grid = false },
      paragraph = { alignment = left, snap-to-grid = false, indentation = { left = 0bp, special = none } } },
    Heading1/if-raggedbottom = { paragraph = { spacing = { line-spacing = multiple, at = 1.2, before = 7.8bp, after = 7.8bp } } },
    Heading1/if-flushbottom = { paragraph = { spacing = { line-spacing = multiple, at = 1.2, before = 7.8bp, after = 7.8bp } } },
    Heading2/if-raggedbottom = { paragraph = { spacing = { line-spacing = multiple, at = 1.2, before = 7.8bp, after = 7.8bp } } },
    Heading2/if-flushbottom = { paragraph = { spacing = { line-spacing = multiple, at = 1.2, before = 7.8bp, after = 7.8bp } } },
    Heading3/if-raggedbottom = { paragraph = { spacing = { line-spacing = multiple, at = 1.2, before = 7.8bp, after = 7.8bp } } },
    Heading3/if-flushbottom = { paragraph = { spacing = { line-spacing = multiple, at = 1.2, before = 7.8bp, after = 7.8bp } } },
    toc-heading = { font = { asian-text-font = SimHei, size = 18bp, snap-to-grid = false },
      paragraph = { alignment = centered, snap-to-grid = false, spacing = { line-spacing = multiple, at = 1.2, before = 15.6bp, after = 12.45bp } } },
    TOC1 = { font = { asian-text-font = SimHei, size = 12bp, snap-to-grid = false },
      paragraph = { snap-to-grid = false, spacing = { line-spacing = multiple, at = 1.2 } } },
    TOC2 = { font = { size = 12bp, snap-to-grid = false },
      paragraph = { snap-to-grid = false, indentation = { left = 11.15bp }, spacing = { line-spacing = multiple, at = 1.2 } } },
    TOC3 = { font = { size = 12bp, snap-to-grid = false },
      paragraph = { snap-to-grid = false, indentation = { left = 22.3bp }, spacing = { line-spacing = multiple, at = 1.2 } } },
    Footer = { font = { size = 9bp }, paragraph = { snap-to-grid = false, spacing = { line-spacing = single } } },
    report-sz-blank-head = { font = { latin-line = true, size = 18bp },
      paragraph = { snap-to-grid = true, spacing = { line-spacing = single } } },
    report-sz-university = { font = { asian-text-font = KaiTi_GB2312, size = 18bp, font-style = bold,
      character-spacing = { spacing = expanded, by = 2bp } },
      paragraph = { alignment = centered, snap-to-grid = true, spacing = { line-spacing = single } } },
    report-sz-blank-university = { font = { latin-line = true, size = 18bp },
      paragraph = { snap-to-grid = true, spacing = { line-spacing = single } } },
    report-sz-name = { font = { asian-text-font = SimSun, size = 22bp, font-style = bold,
      character-spacing = { spacing = expanded, by = 2bp } },
      paragraph = { alignment = centered, snap-to-grid = true, spacing = { line-spacing = single } } },
    report-sz-blank = { font = { latin-line = true, size = 16bp },
      paragraph = { snap-to-grid = true, spacing = { line-spacing = single } } },
    report-sz-title = { font = { asian-text-font = SimSun, size = 18bp, font-style = bold },
      paragraph = { alignment = centered, snap-to-grid = true, spacing = { line-spacing = single } } },
    report-sz-blank-field = { font = { latin-line = true, size = 16bp },
      paragraph = { snap-to-grid = true, spacing = { line-spacing = single } } },
    report-sz-field = { font = { asian-text-font = SimSun, size = 16bp, font-style = bold },
      paragraph = { snap-to-grid = false, indentation = { left = 47.34bp },
        spacing = { line-spacing = multiple, at = 1.75 } } },
    report-sz-blank-foot = { font = { latin-line = true, size = 16bp },
      paragraph = { snap-to-grid = false, spacing = { line-spacing = single } } },
    report-sz-mark = { font = { asian-text-font = SimSun, size = 16bp, font-style = bold },
      paragraph = { alignment = centered, snap-to-grid = true, spacing = { line-spacing = single } } },
  },
}
\hit@presetup[body=shenzhen-report,stage=proposal]{
  layout = {
    paper = { width = 595.3bp, height = 841.9bp },
    margin = { top = 90.7bp, bottom = 85.05bp, left = 85.05bp, right = 79.4bp },
    header = { from-edge = 85.05bp }, footer = { from-edge = 77.08bp },
    grid = { chars = { pitch = 12.6499bp }, lines = { pitch = 19.55bp } },
    cover = {
      paper = { width = 595.35bp, height = 842bp },
      margin = { top = 54.45bp, bottom = 56.7bp, left = 51.05bp, right = 51.05bp },
      grid = { lines = { pitch = 15.6bp }, chars = { pitch = 12bp } },
    },
  },
  styles = {
    Heading1 = { font = { size = 18bp, snap-to-grid = true }, paragraph = { alignment = centered, snap-to-grid = true } },
    toc-heading = { paragraph = { spacing = { before = 19.55bp, after = 15.6bp } } },
    Heading1/if-raggedbottom = { paragraph = { spacing = { line-spacing = multiple, at = 1.2, before = 25bp, after = 12bp } } },
    Heading1/if-flushbottom = { paragraph = { spacing = { line-spacing = multiple, at = 1.2, before = 25bp, after = 12bp } } },
    Heading2 = { font = { size = 15bp, snap-to-grid = true } },
    Heading3 = { font = { snap-to-grid = true } },
    Heading2/if-raggedbottom = { paragraph = { spacing = { line-spacing = multiple, at = 1.2, before = 9.75bp, after = 9.75bp } } },
    Heading2/if-flushbottom = { paragraph = { spacing = { line-spacing = multiple, at = 1.2, before = 9.75bp, after = 9.75bp } } },
    Heading3/if-raggedbottom = { paragraph = { spacing = { line-spacing = multiple, at = 1.35, before = 9.75bp, after = 9.75bp } } },
    Heading3/if-flushbottom = { paragraph = { spacing = { line-spacing = multiple, at = 1.35, before = 9.75bp, after = 9.75bp } } },
    report-sz-blank-head = { font = { size = 10.5bp }, paragraph = { spacing = { line-spacing = multiple, at = 1.5 } } },
    report-sz-name = { font = { size = 24bp } },
    report-sz-blank-field = { paragraph = { spacing = { before = 12bp } } },
    report-sz-field = { paragraph = { indentation = { left = 63.75bp } } },
    report-sz-blank-foot = { paragraph = { spacing = { line-spacing = multiple, at = 1.25 } } },
  },
}
\hit@presetup[body=shenzhen-report,stage=proposal,lang=zh]{
  layout = { compatibility-mode = word-2010 },
}
\hit@presetup[body=shenzhen-report,lang=en]{
  styles = {
    Normal = { font = { latin-line = true } },
    Heading1 = { font = { font-style = bold, latin-line = true } },
    Heading2 = { font = { font-style = bold, latin-line = true } },
    Heading3 = { font = { font-style = bold, latin-line = true } },
    toc-heading = { font = { font-style = regular, latin-line = true } },
    Header = { font = { latin-line = true } },
    report-sz-university = { font = { latin-line = true } },
    report-sz-name = { font = { latin-line = true } },
    report-sz-title = { font = { latin-line = true } },
    report-sz-field = { font = { latin-line = true }, paragraph = { indentation = { left = 42.5bp } } },
    report-sz-mark = { font = { latin-line = true } },
  },
}
\hit@presetup[body=shenzhen-report,lang=en,stage=proposal]{
  styles = { report-sz-field = { paragraph = { indentation = { left = 56.7bp } } } },
}
\hit@presetup[body=shenzhen-report,lang=en,stage=interim]{
  styles = {
    TOC1 = { font = { font-style = bold } }, TOC2 = { font = { font-style = bold } },
    report-sz-field = { paragraph = { indentation = { special = first-line, by = 24.45bp } } },
  },
}
\hit@presetup[body=shenzhen-report,stage=interim]{
  layout = { dont-use-html-paragraph-auto-spacing = true },
}
\ExplSyntaxOn
