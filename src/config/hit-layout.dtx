%% 四个空当都是零；英文那一份另有取值，见上面 lang=en 那一块。
\hit@presetup[campus=shenzhen,degree-level=bachelor]{
  format = {
    caption-figure = { space-before = 0bp, space-after = 0bp },
    caption-table  = { space-before = 0bp, space-after = 0bp },
  },
}
\hit@presetup[campus=shenzhen,degree-level=bachelor]{
  format = {
    chapter = { char-spacing = 0bp },
    chapter/if-raggedbottom = { line-spacing = 1.25 },
    chapter/if-flushbottom  = { line-spacing = 1.25 },
  },
}
