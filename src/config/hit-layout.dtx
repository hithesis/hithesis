    toc-section       = { paragraph = { spacing = { line-spacing = multiple, at = 1.5 } } },
    toc-subsection    = { paragraph = { spacing = { line-spacing = multiple, at = 1.5 } } },
    toc-subsubsection = { paragraph = { spacing = { line-spacing = multiple, at = 1.5 } } },
