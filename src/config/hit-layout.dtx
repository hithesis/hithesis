%
% \subsection{图表上下的空段}
%
% 图表前后各排一个正文格式的空段，浮动体额外间距归零。
%    \begin{macrocode}
\ExplSyntaxOff
\hit@presetup{
  float-sep = 0bp,
  float-blank = {
    figure-above = { lines = 1 }, figure-below = { lines = 1 },
    table-above  = { lines = 1 }, table-below  = { lines = 1 },
  },
}
