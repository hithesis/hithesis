% \section{正文页眉：硕士}
%
% ^^A ======================================================================
% ^^A Module final-pagestyle-master: 正文页眉的硕士变体
% ^^A ======================================================================
%
% \changes{v3.2a}{2026/09/13}{硕士这一档的页眉单独成一个变体文件}
% 基准（博士加哈尔滨）在 \file{src/flow/hit-final-pagestyle.dtx}。这一份只写
% 与基准不同的那一小坨。
%
% 硕士单面排，页眉只有一个 \texttt{C}，没有基准那对 \texttt{CO}／\texttt{CE}。词条与基准同。
%    \begin{macrocode}
%<*final-pagestyle-master>
\hit@hook@new:nn { headings-body-master }
  {
    \hit@header:nn { oe }
      {
        \hit@header@font \hit@term@header@university@zh
        \hit@term@header@degree@level@zh \hit@term@header@document@type
      }
  }
%</final-pagestyle-master>
%    \end{macrocode}
%
% \Finale
