%
% \section{开题报告的页眉与页脚}
%
% ^^A ======================================================================
% ^^A Module report-pagestyle: 页眉页脚样式（fancyhdr 配置）（hit-report）
% ^^A ======================================================================
%    \begin{macrocode}
%<*report-pagestyle>
% \changes{v3.2a}{2026/08/07}{art-pagestyle 自包含 etoolbox 与 fancyhdr 依赖}
% \changes{v3.2a}{2026/08/07}{art-pagestyle 的控制流改用 expl3。页眉定义含中文
%   与控制空格，按 CONTRIBUTING §4.7 留在 expl3 之外定义成宏，再由条件调用}
\RequirePackage{fancyhdr}
%    \end{macrocode}
% \changes{v3.1d}{2025/03/03}{为威海校区硕士开题设置章节样式与页眉页脚样式。\issue[219]}
% \changes{v3.2a}{2026/08/07}{威海硕士开题的页眉定义放入 art-pagestyle，激活仍留 artcls 保持时序}
% 两处页眉的横线画法相同，但页眉文字与适用条件不同，各自定义。
%    \begin{macrocode}
\cs_set:Npn \hit@report@weihai@master@pagestyle
  {
%
~\fancypagestyle{hit@weihai@headings@main}{%
 \fancyhf{}~
 \fancyfoot[C]{\xiaowu\thepage}~
 \cs_set:Npn \headrule {~
 \vskip 1.190132pt~
 \hrule\@height2.276208pt\@width\headwidth
 \vskip 0.75pt~
 \hrule\@height.75pt\@width\headwidth
 }~
 \fancyhead[C]{\songti\xiaowu[0]\hit@report@header}~
 \fancyfoot[C]{-\ \thepage\ -}~
 }%
  }
\cs_set:Npn \hit@report@shenzhen@master@pagestyle
  {
%
~\fancypagestyle{hit@shenzhen@headings@main}{%
 \fancyhf{}~
 \fancyfoot[C]{\xiaowu\thepage}~
 \cs_set:Npn \headrule {~
 \vskip 1.190132pt~
 \hrule\@height2.276208pt\@width\headwidth
 \vskip 0.75pt~
 \hrule\@height.75pt\@width\headwidth
 }~
 \fancyhead[C]{\songti\xiaowu[0]\hit@report@header}~
 \fancyfoot[C]{-\ \thepage\ -}~
 }~
 \fancypagestyle{hit@shenzhen@headings@front}{%
 \fancyhf{}~
 \cs_set:Npn \headrule {~
 \vskip 1.190132pt~
 \hrule\@height2.276208pt\@width\headwidth
 \vskip 0.75pt~
 \hrule\@height.75pt\@width\headwidth
 }~
 \fancyhead[C]{\songti\xiaowu[0]\hit@report@front@header}~
 }%
  }
\bool_lazy_and:nnT
  { \bool_if_p:N \g__hit_weihai_bool }
  {
    \bool_lazy_and_p:nn
      { \bool_if_p:N \g__hit_master_bool }
      { \bool_if_p:N \g__hit_proposal_bool }
  }
  { \hit@report@weihai@master@pagestyle }
\bool_lazy_and:nnT
  { \bool_if_p:N \g__hit_shenzhen_bool }
  { \bool_if_p:N \g__hit_master_bool }
  { \hit@report@shenzhen@master@pagestyle }
%    \end{macrocode}
%
% 深圳博士中期的版式没有页眉线，页码在页脚居中、前后各一个短横。原先这一段在
% \file{hithesisartplus.cls} 里，与上面两条是同一件事的三种写法。
%    \begin{macrocode}
\cs_set:Npn \hit@report@shenzhen@doctor@pagestyle
  {
~\fancypagestyle{hit@shenzhen@doctor@headings@main}{%
 \fancyhf{}%
 \cs_set:Npn \headrulewidth {0pt}%
 \cs_set:Npn \footrulewidth {0pt}%
 \fancyfoot[C]{\xiaowu-\nobreakspace{}\thepage\nobreakspace{}-}%
 }%
  }
\hit@if@shenzhen@doctor@interim { \hit@report@shenzhen@doctor@pagestyle }
%</report-pagestyle>
%    \end{macrocode}
%
% \Finale
