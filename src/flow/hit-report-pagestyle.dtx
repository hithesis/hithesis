%
% \section{开题报告的页眉与页脚}
%
% \changes{v3.2a}{2026/09/24}{控制流改用 expl3，整块套 \option{stage} 闸；页眉页脚改用类自己搭的
%   盒子，不再依赖 \pkg{fancyhdr}}
%
% ^^A ======================================================================
% ^^A Module report-pagestyle: 页眉页脚样式（hit-report）
% ^^A ======================================================================
%    \begin{macrocode}
%<*report-pagestyle>
\bool_if:NF \g__hit_final_bool
  {
%    \end{macrocode}
% \changes{v3.1d}{2025/03/03}{为威海校区硕士开题设置章节样式与页眉页脚样式。\issue[219]}
% 两处页眉的横线画法相同，但页眉文字与适用条件不同，各自定义。横线是一粗一细两条，
% 离字 1.190132\,pt，粗 2.276208\,pt，隔 0.75\,pt 再一条 0.75\,pt 的细线。页面样式的
% 搭法见 \file{hit-final-pagestyle.dtx}。
%    \begin{macrocode}
\cs_new_protected:Npn \hit@report@header@rule:
  {
    \vskip 1.190132pt
    \hrule \@height 2.276208pt \@width \headwidth
    \vskip 0.75pt
    \hrule \@height .75pt \@width \headwidth
  }
\cs_set:Npn \hit@report@weihai@master@pagestyle
  {
    \hit@pagestyle:nn { hit@weihai@headings@main }
      {
        \hit@hf@clear:
        \cs_set_eq:NN \headrule \hit@report@header@rule:
        \hit@hf@head:nn { oe }
          { \songti \hit@fontsize@x {xiaowu} {0} \hit@term@header@report }
        \hit@hf@foot:nn { oe } { - \  \thepage \  - }
      }
  }
\cs_set:Npn \hit@report@shenzhen@master@pagestyle
  {
    \hit@pagestyle:nn { hit@shenzhen@headings@main }
      {
        \hit@hf@clear:
        \cs_set_eq:NN \headrule \hit@report@header@rule:
        \hit@hf@head:nn { oe }
          { \songti \hit@fontsize@x {xiaowu} {0} \hit@term@header@report }
        \hit@hf@foot:nn { oe } { - \  \thepage \  - }
      }
    \hit@pagestyle:nn { hit@shenzhen@headings@front }
      {
        \hit@hf@clear:
        \cs_set_eq:NN \headrule \hit@report@header@rule:
        \hit@hf@head:nn { oe }
          { \songti \hit@fontsize@x {xiaowu} {0} \hit@term@header@report@front }
      }
  }
\bool_lazy_and:nnT
  { \bool_if_p:N \g__hit_weihai_bool }
  {
    \bool_lazy_and_p:nn
      { \bool_if_p:N \g__hit_master_bool }
      { \bool_if_p:N \g__hit_proposal_bool }
  }
  { \hit@report@weihai@master@pagestyle }
\bool_lazy_and:nnT
  { \bool_if_p:N \g__hit_shenzhen_bool }
  { \bool_if_p:N \g__hit_master_bool }
  { \hit@report@shenzhen@master@pagestyle }
%    \end{macrocode}
%
% 深圳博士中期的版式没有页眉线，页码在页脚居中、前后各一个短横。原先这一段在
% \file{hithesisartplus.cls} 里，与上面两条是同一件事的三种写法。
%    \begin{macrocode}
\cs_set:Npn \hit@report@shenzhen@doctor@pagestyle
  {
    \hit@pagestyle:nn { hit@shenzhen@doctor@headings@main }
      {
        \hit@hf@clear:
        \cs_set:Npn \headrulewidth { 0pt }
        \cs_set:Npn \footrulewidth { 0pt }
        \hit@hf@foot:nn { oe } { \xiaowu - \nobreakspace {} \thepage \nobreakspace {} - }
      }
  }
\hit@if@shenzhen@doctor@interim { \hit@report@shenzhen@doctor@pagestyle }
  }
%</report-pagestyle>
%    \end{macrocode}
%
% \Finale
