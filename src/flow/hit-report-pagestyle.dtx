%<*report-pagestyle>
\bool_if:NT\g__hit_shenzhen_report_bool
  {
    \hit@pagestyle:nn{hit@shenzhen@toc}
      {
        \ps@hit@headings
        \bool_if:NT\g__hit_interim_bool
          {\hit@hf@head:nn{oe}{}\bool_gset_false:N\g__hit_header_rule_on_bool}
        \hit@hf@foot:nn{oe}{\hit@page@number@front}
      }
  }
%</report-pagestyle>
