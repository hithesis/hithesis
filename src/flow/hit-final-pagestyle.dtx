% \iffalse meta-comment
%
% hit-final-pagestyle.dtx 是页眉与页脚
%
% \fi
%
% \section{页眉与页脚}
%
% \changes{v3.2a}{2026/09/28}{页眉页脚照 Word 排：每页放什么由页面样式定，排与放交给 \pkg{docxlike}（页眉、
%   页脚样式的段落，页眉框的顶在页眉距边界处、页脚框的底在页脚距边界处，行盒按行里的字算，双线是段落的
%   \texttt{thinThickSmallGap} 下边框，与范例 docx 同构）；页码离 Windows 导出件差 0.2（先前差 0.3），
%   横向对上，先前为此加的纵横偏移删掉；不再依赖 \pkg{fancyhdr}，深圳硕博的报告仍用照它 v5 搬来的那只盒；
%   章号与题目的间距跟随章标题；\option{layout}/\option{header} 的 \option{shown} 与 \option{shift}；
%   博士后偶数页印“博士后研究报告”，奇数页章号里数字两边不空、章号后空半个字；博士后的页脚是
%   两个 10 磅短横单独一段、页码小五在图文框里；本部与威海的报告不印页眉}
% \changes{v3.2a}{2026/09/14}{页码装饰三态、各学位各校区统一，间距小五的半个字宽，
%   位置由 \option{layout}/\option{footer}/\option{shift} 给；正文页眉改用部件变体
%   （基准博士加哈尔滨）；英文那一支只管终稿；加 \texttt{hit@headings@front}
%   与扫描件专用的只显示页码的样式；闸放在 \texttt{final-body}，深圳本科报告的正文
%   照终稿排；深圳硕博的页眉与本部一样，不再印学科门类，硕士前置也印校名那一行}
% \changes{v3.2a}{2026/08/07}{条件树迁到 expl3，页眉横线与本科页脚两块留在 expl3 之外
%   定义成宏（花括号后换行的空格记号在 \cs{ExplSyntaxOn} 下会消失，CONTRIBUTING §4.7）}
%
% ^^A ======================================================================
% ^^A Module final-pagestyle: 页眉页脚样式（hit-thesis）
% ^^A ======================================================================
% \emph{闸认的是正文照哪一档排，不是 \option{stage}。} 深圳本科的开题与中期
%   \option{stage} 不是 \texttt{final}，可正文与终稿同构，页眉页脚也该走这一套；
%   它与终稿的差别只有两处，一是横线粗细与离字的距离，二是页眉印什么字，
%   前者在 \file{src/config/hit-layout.dtx} 的取值里，后者是一个部件变体。
%    \begin{macrocode}
%<*final-pagestyle>
%    \end{macrocode}
%
% \subsection{页面样式的内容槽}
%
% 每个页面样式保存奇偶页的页眉、页脚内容，统一交给 docxlike 定位和排版。
% 保留 headrule、线宽及 headwidth 名称供既有页面样式使用，不再构造传统报告的固定高度盒。
%    \begin{macrocode}
\dim_new:N \headwidth
\dim_gset:Nn \headwidth { -123456789sp }
\cs_new:Npn \headrulewidth { 0.4pt }
\cs_new:Npn \footrulewidth { 0pt }
\cs_new_protected:Npn \headrule
  { { \hrule \@height \headrulewidth \@width \headwidth \vskip -\headrulewidth } }
\cs_new_eq:NN \__hit_hf_ps_empty: \ps@empty
%    \end{macrocode}
%
% 四份内容：奇偶页各一份页眉、一份页脚。写的时候给定 \texttt{o}、\texttt{e} 或
% \texttt{oe}。赋值是局部的：页面样式每次换进来都
% 从头设一遍，与 \pkg{fancyhdr} 的 \cs{fancypagestyle} 一样。
%    \begin{macrocode}
\tl_new:N \l__hit_hf_oh_tl
\tl_new:N \l__hit_hf_eh_tl
\tl_new:N \l__hit_hf_of_tl
\tl_new:N \l__hit_hf_ef_tl
\cs_new_protected:Npn \hit@hf@clear:
  {
    \tl_clear:N \l__hit_hf_oh_tl
    \tl_clear:N \l__hit_hf_eh_tl
    \tl_clear:N \l__hit_hf_of_tl
    \tl_clear:N \l__hit_hf_ef_tl
  }
\cs_new_protected:Npn \__hit_hf_put:nnn #1#2#3
  {
    \tl_if_empty:nTF {#3}
      { \tl_clear:c { l__hit_hf_ #1 #2 _tl } }
      {
        \tl_set:cn { l__hit_hf_ #1 #2 _tl } {#3}
      }
  }
\cs_new_protected:Npn \__hit_hf_set:nnn #1#2#3
  {
    \str_case:nn {#2}
      {
        { o } { \__hit_hf_put:nnn { o } {#1} {#3} }
        { e } { \__hit_hf_put:nnn { e } {#1} {#3} }
        { oe }
          {
            \__hit_hf_put:nnn { o } {#1} {#3}
            \__hit_hf_put:nnn { e } {#1} {#3}
          }
      }
  }
\cs_new_protected:Npn \hit@hf@head:nn #1#2 { \__hit_hf_set:nnn { h } {#1} {#2} }
\cs_new_protected:Npn \hit@hf@foot:nn #1#2 { \__hit_hf_set:nnn { f } {#1} {#2} }
%    \end{macrocode}
%
% \cs{hit@pagestyle:nn}\marg{名字}\marg{代码} 定义一个页面样式。换进来时先按
% \cs{ps@empty} 清掉，再让 \cs{@mkboth} 发标记（章标题要往页眉里送 \cs{leftmark}），
% 然后执行\meta{代码}设内容。\cs{headwidth} 在第一次换页面样式时定成当时的
% \cs{textwidth}，以后不再跟着变，也照 \pkg{fancyhdr}。
%    \begin{macrocode}
\cs_new_protected:Npn \hit@pagestyle:nn #1#2
  { \cs_set_protected:cpn { ps@ #1 } { \__hit_hf_proto: #2 } }
\cs_new_protected:Npn \__hit_hf_proto:
  {
    \dim_compare:nNnT { \headwidth } < { 0sp }
      {
        \dim_gadd:Nn \headwidth { 123456789sp }
        \dim_gadd:Nn \headwidth { \textwidth }
      }
    \__hit_hf_ps_empty:
    \cs_set:Npn \@mkboth { \protect \markboth }
    \cs_set:Npn \@oddhead { \__hit_hf_word:NN \l__hit_hf_oh_tl \l__hit_hf_of_tl \hfil }
    \cs_set:Npn \@evenhead { \__hit_hf_word:NN \l__hit_hf_eh_tl \l__hit_hf_ef_tl \hfil }
  }
%    \end{macrocode}
%
% 排页眉页脚前的准备。终稿另有一段要在这里做（见下文 \cs{hit@hf@init:}），默认是空的。
%    \begin{macrocode}
\cs_new_protected:Npn \hit@hf@init: { }
%    \end{macrocode}
%
%    \begin{macrocode}
\bool_if:NT \g__hit_final_body_bool
  {
\cs_set_eq:NN \hit@original@header@rule \headrule
\hit@pagestyle:nn { hit@empty }
  {
    \hit@hf@clear:
    \cs_set_eq:NN \headrule \hit@original@header@rule
    \cs_set:Npn \headrulewidth { 0pt }
    \cs_set:Npn \footrulewidth { 0pt }
  }
%    \end{macrocode}
%
%    \begin{macrocode}
\hit@pagestyle:nn { hit@scanpage }
  {
    \hit@hf@clear:
    \hit@hf@foot:nn { oe } { \hit@page@number@decorated }
    \cs_set_eq:NN \headrule \relax
    \cs_set:Npn \headrulewidth { 0pt }
    \cs_set:Npn \footrulewidth { 0pt }
  }
%    \end{macrocode}
%
% 页眉那条粗细双线三处都一样，本科页脚的页码格式只此一处。两块都含花括号后
% 换行产生的空格记号，所以留在 expl3 之外原样定义。
%    \begin{macrocode}
%    \end{macrocode}
%
% \subsection{照 Word 排页眉页脚}
%
% 页面样式选择内容，docxlike 按 Header、Footer 样式排版并定位。
%
% 双线排不排是一个布尔（\option{layout}/\option{header-rule} 的三态，页面样式里定），排的时候给这一段
% 加下边框，粗细与离字的距离取 \option{layout}/\option{header}/\option{rule}。页眉页脚的
% \option{shown} 为假时不放那一份。\option{shift} 把放好的那一份整体挪开（往下、往右为正；页脚横向的
% 那一项只挪页码，见下面 \cs{hit@page@number@shift}），Word 里没有这一项，留给学校格式与 Word 对不上的
% 时候用，默认都是零。
%    \begin{macrocode}
\bool_new:N \g__hit_header_rule_on_bool
\tl_new:N \l__hit_hf_content_tl
\box_new:N \l__hit_hf_word_box
\cs_new_protected:Npn \__hit_hf_word:NN #1#2
  {
    \__hit_tristate_if:NnT \g__hit_page_header_shown_tl { \c_true_bool }
      {
        \tl_if_empty:NF #1
          {
            \bool_if:NTF \g__hit_header_rule_on_bool
              {
                \tl_set:Nx \l__hit_hf_content_tl
                  {
                    \exp_not:N \docxpar
                      [
                        border = { bottom = {
                          style = thin-thick-small-gap ,
                          width = \dim_use:N \g__hit_page_rule_width_dim ,
                          from-text = \dim_use:N \g__hit_page_rule_text_dim } }
                      ]
                      { \exp_not:V #1 }
                  }
              }
              { \tl_set_eq:NN \l__hit_hf_content_tl #1 }
            \__hit_hf_word_put:nnn { header }
              { \g__hit_page_head_shift_dim } { \g__hit_page_head_shift_x_dim }
          }
      }
    \__hit_tristate_if:NnT \g__hit_page_footer_shown_tl { \c_true_bool }
      {
        \tl_if_empty:NF #2
          {
            \tl_set_eq:NN \l__hit_hf_content_tl #2
            \__hit_hf_word_put:nnn { footer } { \g__hit_page_foot_shift_dim } { 0pt }
          }
      }
  }
\cs_new_protected:Npn \__hit_hf_word_put:nnn #1#2#3
  {
    \bool_lazy_and:nnTF
      { \dim_compare_p:nNn {#2} = { 0pt } }
      { \dim_compare_p:nNn {#3} = { 0pt } }
      { \docxlike_headfoot_put:nV {#1} \l__hit_hf_content_tl }
      {
        \hbox_set:Nn \l__hit_hf_word_box
          { \docxlike_headfoot_put:nV {#1} \l__hit_hf_content_tl }
        \tex_kern:D \dim_eval:n {#3} \scan_stop:
        \box_move_down:nn {#2} { \box_use_drop:N \l__hit_hf_word_box }
        \tex_kern:D - \dim_eval:n {#3} \scan_stop:
      }
  }
\cs_generate_variant:Nn \docxlike_headfoot_put:nn { nV }
%    \end{macrocode}
%
% \cs{hit@header@font} 与 \cs{hit@footer@font} 是页眉、页脚两个样式的字体，正文照 Word 排的文档在导言区之后由
% \pkg{docxlike} 按样式换掉（见 \file{hithesis.dtx} 的配置回放）。页眉页脚本身不用它们：段落按样式
% 排，字体是样式给的。
%    \begin{macrocode}
\cs_new_protected:Npn \hit@header@font { \songti \hit@fontsize@x{xiaowu}{0} }
\cs_new_protected:Npn \hit@footer@font { \xiaowu }
%    \end{macrocode}
%
% 页码的两种写法：光数字，与两边带短横的（博士后另有一种，见下）。
%    \begin{macrocode}
\cs_new_protected:Npn \hit@page@number@plain { \thepage }
\cs_new_protected:Npn \hit@page@number@decorated
  {
    \bool_if:NTF \g__hit_postdoc_bool
      { \__hit_page_number_postdoc: }
      { \__hit_page_number_decorated: }
  }
%    \end{macrocode}
%
% 博士后的页脚照《博士后研究工作报告模板》：两个 10 磅的短横连同中间三个半角空格（各占半个字）
% 是页脚里单独的一段，居中，不随页码宽窄挪；页码是一个图文框（\texttt{w:framePr}：相对页边距
% 居中、相对段落往下 1 缇），框里那一段是页脚样式、小五。照 docx 交给 \cs{docxframe}，页码基线
% 比短横高 0.958（10 磅行与小五行的上升部之差减 1 缇），模板短横基线 790.23、页码 789.23。
% 页脚的行盒按 10 磅排，样式写在 \file{hit-layout.dtx} 的博士后那一档。
%    \begin{macrocode}
\cs_new_protected:Npn \__hit_page_number_postdoc:
  {
    \docxlike_frame:nn
      {
        style = Footer , format = { font = { size = xiaowu } } ,
        horizontal = { position = center , relative-to = margin } ,
        vertical = { position = 0.05bp , relative-to = paragraph } ,
      }
      { \thepage }
    - \skip_horizontal:n { 1.5em } -
  }
\cs_new_protected:Npn \__hit_page_number_decorated:
  {
    \kern \hit@page@number@shift
    - \hspace { \hit@page@number@separator }
    \thepage
    \hspace { \hit@page@number@separator } -
    \kern -\hit@page@number@shift
  }
%    \end{macrocode}
%
% \option{page-number-line} 的 \texttt{auto}：正文与前置部分一律带装饰。
% \option{header-rule} 的 \texttt{auto} 一律为真。
%    \begin{macrocode}
\cs_new_protected:Npn \hit@page@number@main
  {
    \__hit_tristate_if:NnTF \g__hit_page_number_line_mainmatter_tl { \c_true_bool }
      { \hit@page@number@decorated } { \hit@page@number@plain }
  }
\cs_new_protected:Npn \hit@page@number@front
  {
    \__hit_tristate_if:NnTF \g__hit_page_number_line_frontmatter_tl { \c_true_bool }
      { \hit@page@number@decorated } { \hit@page@number@plain }
  }
\cs_new_protected:Npn \hit@final@header@rule@setup
  {
    \__hit_tristate_if:NnTF \g__hit_header_rule_tl { \c_true_bool }
      { \bool_gset_true:N \g__hit_header_rule_on_bool }
      { \bool_gset_false:N \g__hit_header_rule_on_bool }
  }
\cs_new_protected:Npn \hit@final@footer
  {
    \hit@hf@foot:nn { oe }
      {
        \legacy_if:nTF { @mainmatter }
          { \hit@page@number@main } { \hit@page@number@front }
      }
  }
%    \end{macrocode}
% 
% \changes{v3.1d}{2025/03/03}{定义页脚中横线与页码的距离。\issue[172]}
% \cs{hit@page@number@separator} 是页码两侧短横与数字之间的距离，各学位一个值。
% 范例里那段间距在 300\,ppi 下量出来是二十个像素，半个字宽最接近：页脚是小五，
% 一个字宽 9\,bp，一半 4.5\,bp 折 18.75 个像素，再加上短横右侧与数字左侧的空白
% 正好二十。
%
% 这里写死 4.5\,bp 而不写 \texttt{.5em}，因为这一行在类文件加载时执行，那时
% 当前字体是小四，\texttt{em} 会读成 12\,bp，间距要宽出三分之一。从前的
% \texttt{.3333333em} 与 \texttt{.1666667em} 也踩在这上面。
%
% 从前哈尔滨本科取三分之一字宽、其余取六分之一字宽，硕博那一支根本没读这个
% 长度，直接写的不断行空格。现在四处页码都走这一条路径。判断虽然撤了，长度本身
% 留着，往后哪个学位再分家，改这一个值就够。
%    \begin{macrocode}
\skip_new:N \hit@page@number@separator
\dim_set:Nn \hit@page@number@separator { 4.5bp }
%    \end{macrocode}
%
% \cs{hit@page@number@shift} 是页码整体的横向偏移，往右为正，取 \option{layout}/\option{footer}/\option{shift}
% 的 \option{horizontal}，默认零。范例的页码是个文本框（\texttt{<w:framePr w:hAnchor="margin" w:xAlign="center"/>}），
% 框按版心居中，框宽是内容的自然宽，与居中排的页脚段落落点相同：Windows 导出件的“- 5 -”首字在
% 287.95，这里排 287.89。先前按 Mac 导出件往右补过 0.24\,bp，换成 Windows 导出件之后反而多了，已去掉。
%
% 前后各一个反号的 \cs{kern}：盒子的总宽不变，只有内容整体挪一格。只在一头加
% 的话盒子跟着变宽，居中又把它匀掉一半，得写两倍，绕。
%    \begin{macrocode}
\cs_new:Npn \hit@page@number@shift { \g__hit_page_foot_shift_x_dim }
%    \end{macrocode}
%
% 此处根据本科生模板的多种版本，提供选项自定义页码、页眉样式。
% \changes{v1.0.15}{2018/06/05}{添加控制本科论文的页码横线选项}
% \changes{v1.0.15}{2018/06/05}{删除冗余的页面格式}
% \changes{v3.0.0}{2020/05/21}{添加英文版页眉格式控制}
% \changes{v3.0.0}{2020/05/21}{添加博后页眉控制}
% \changes{v3.1b}{2022/06/06}{本部硕博页眉中不再包含学科}
% \changes{v3.1d}{2025/03/03}{根据 \issue[222] 修改深圳博士的页眉}
% \changes{v3.0.10}{2020/10/28}{根据窝工2020年深圳校区新规定，mainmatter之前都用正文内容作为页眉，之后都用哈尔滨工业大学作为页眉}
% \changes{v3.0.01}{2020/06/06}{此处设置威海本科页眉与本部一样}
% 页眉恒排中文，英文版也一样，规范如此。所以下面一律取常量的 zh 那半，
% 那不是漏了英文分支。\option{lang} 只管摘要之后的正文，见手册
% 第 \ref{sec:option} 节。
%    \begin{macrocode}
%    \end{macrocode}
%
% 按学位和校区选择页眉实现，未指定变体时使用默认实现。
%
% \emph{语种不进部件名。} 英文那一份不是中文那一份的变体，是另一套版面——
% 不分学位不分校区，一句 \cs{leftmark} 到底。所以语种仍是外面那一层
% \cs{bool\_if}，部件只管中文这一支。真写成 \texttt{-en} 也不行：深圳的英文稿
% 会让 \texttt{-shenzhen} 与 \texttt{-en} 段数打平，查表当场报歧义。
%
% \emph{深圳硕博不另分档。} 先前深圳博士偶数页、深圳硕士正文印“哈尔滨工业大学
% 工学博士（硕士）学位论文”，深圳硕士前置印 \cs{leftmark}：依据是深圳 2021 版的书写
% 范例（\issue[222]、\issue[97]）与 2020 年那条新规定。现行的研究生学位论文写作指南
% 全校统一，两档分别使用默认实现与硕士实现。
%    \begin{macrocode}
\hit@hook@new:nn { headings-body }
  {
    \hit@header:nn { o } { \leftmark }
    \hit@header:nn { e }
      {
        \hit@term@header@university@zh
        \hit@term@header@degree@level@zh \hit@term@header@document@type
      }
  }
%    \end{macrocode}
%
% \emph{本部与威海的报告不印页眉。} 研究生院那两份原件的说明页写着“报告不要设置页眉”，
% 教务处的本科中期原件也没有；横线在 \file{src/config/hit-layout.dtx} 那一档关掉。
% 按阶段写两条，不写成 \texttt{-!final-!shenzhen}：取反的一段只算半档，那样与
% \texttt{-bachelor}、\texttt{-master} 两个学位变体一样具体，查表报歧义。
%    \begin{macrocode}
\hit@hook@new:nn { headings-body-proposal-!shenzhen } { }
\hit@hook@new:nn { headings-body-interim-!shenzhen } { }
%    \end{macrocode}
%
% 威海硕士开题照 \issue[219] 附的模板：版面是终稿的，页眉单双页都是表单名那一行
% （\option{header-report}），横线照终稿。
%    \begin{macrocode}
\hit@hook@new:nn { headings-body-proposal-weihai-master }
  { \hit@header:nn { oe } { \hit@term@header@report } }
%    \end{macrocode}
%
% 页眉主体。语种在外层分，中文那一支交给基准与各档的部件变体。
%
% \emph{英文那一支只管终稿。} 英文学位论文的页眉印章标题（\cs{leftmark}）、
% 页脚一律带短横，那是论文的规矩。深圳本科那两份报告的正文虽然照终稿排，
% 页眉却是表单上印死的一行字，中英两版都印那一行（英文版印的是
% \texttt{Undergraduate~Thesis~(Design)~Proposal~Report}），页脚也照报告的分
% 前置与正文两档。先前这一支只看语种，英文版的报告跟着走了论文那一条，
% 页眉印出来是 \cs{leftmark} 留下的「目录」。
%    \begin{macrocode}
%    \end{macrocode}
%
% \emph{前置那几页的页面样式。} 页眉与正文同一份，页码光排数字、不加那对短横。
% 正文照终稿排的那一档的目录页要它：原件的目录印 \texttt{I}，正文才是
% \texttt{-1-}。
%
% 直接调 \cs{ps@hit@headings} 再把页脚盖掉，不重抄一遍页眉。
%
% \emph{页码取不带装饰的那一支}，不走 \cs{hit@page@number@front}。Word 那边前置
% 印的就是裸数字，这是事实不是选项。
%
%    \begin{macrocode}
\cs_new_protected:Npn \hit@header:nn #1#2
  { \hit@hf@head:nn {#1} {#2} }
\hit@pagestyle:nn { hit@headings }
  {
    \hit@hf@clear:
    \bool_lazy_and:nnTF
      { \bool_if_p:N \g__hit_en_bool } { \bool_if_p:N \g__hit_final_bool }
      {
        \hit@header:nn { oe } { \leftmark }
        \hit@hf@foot:nn { oe } { \hit@page@number@decorated }
        \bool_gset_true:N \g__hit_header_rule_on_bool
      }
      {
        \hit@hook@use:n { headings-body }
        \hit@final@footer
        \hit@final@header@rule@setup
      }
    \bool_if:NT\g__hit_shenzhen_report_bool
      {
        \hit@header:nn{oe}{\hit@term@header@report}
        \hit@hf@foot:nn{oe}{\hit@page@number@main}
      }
    \cs_set:Npn \headrulewidth { 0pt }
    \cs_set:Npn \footrulewidth { 0pt }
  }
\hit@pagestyle:nn { hit@headings@front }
  {
    \ps@hit@headings
    \hit@hf@foot:nn { oe } { \hit@page@number@plain }
  }
%    \end{macrocode}
%
% 此处解决页眉经典 bug。
%
% 章号取这一章标题的编号串（\cs{l\_docxlike\_field\_parnum\_tl}，\pkg{docxlike} 发 \cs{chaptermark} 之前放好的，
% 就是多级列表排出来的“第1章”“附录A”），与 Word 页眉里 \texttt{STYLEREF} 取标题编号一样。先前取 \CTeX\ 的
% \cs{CTEXthechapter}，要另外把章名、附录名、人文的中文章号再告诉 \CTeX\ 一遍。
%
% 章号与题目之间空多少，页眉与章标题是同一件事，取
% \cs{hit@chapter@number@gap:}（用户设了 \option{after-chapter-number} 词条
% 用词条，没设是一个字宽，见 \file{docxlike-format.dtx}），不另设键。词条内容
% 存进 mark，排版页眉时才在页眉字体下解值，一个字取的是页眉的字宽。
%
% 博士后的章号里数字两边不空中西文间距：模板页眉的 \texttt{STYLEREF} 域把列表编号抄成
% 正文，带 \texttt{w:hint="eastAsia"}，与目录条目同一回事（见 \file{hit-final-toc.dtx}）。
% 只关章号那一组，题目照常。
%    \begin{macrocode}
\cs_new_protected:Npn \__hit_pagestyle_at_begin:
  {
    \pagestyle { hit@empty }
    \RenewDocumentCommand \chaptermark { m }
      {
        \bool_if:NTF \g__hit_postdoc_bool
          {
            \@mkboth
              { { \hit@engine@ecglue@off: \l_docxlike_field_parnum_tl } \hit@chapter@number@gap: ##1 } { }
          }
          { \@mkboth { \l_docxlike_field_parnum_tl \hit@chapter@number@gap: ##1 } { } }
      }
  }
\AtBeginDocument { \__hit_pagestyle_at_begin: }
  }
%</final-pagestyle>
%    \end{macrocode}
%
% \Finale
