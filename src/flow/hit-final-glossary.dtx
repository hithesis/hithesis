% \section{终稿的术语与符号表}
%
% \changes{v3.2a}{2026/10/06}{缩略语统一用 glossaries-extra：词条在 abbreviations 中声明，
%   新增 abbr/abbrs、语种切换、复数、索引及链接开关；缩略语表采用两列布局，可与符号表合排}
% \changes{v3.2a}{2026/10/06}{新增 hitindex，按文字选择中英文索引；中文排序键支持自动拼音和显式指定，
%   可用于 LuaLaTeX、XeLaTeX 和 pdfLaTeX}
%
% ^^A ======================================================================
% ^^A Module final-glossary: 术语与符号表（glossaries 配置 + 示例条目）（hit-thesis）
% ^^A ======================================================================
%    \begin{macrocode}
%<*final-glossary>
%    \end{macrocode}
%
% \changes{v3.1d}{2025/03/03}{将 \cs{glossarystyle} 替换为 \cs{setglossarystyle}。\issue[200]}
% 在 \pkg{glossaries} 中表示 \cs{glossarystle} 这个命令 Deprecated in v3.08a. Removed in v4.50.
% 中英文共用 glossaries-extra 和 \cs{makenoidxglossaries}，缩略语排序不需要外部程序。
%    \begin{macrocode}
\RequirePackage [ xindy , order=letter ] { glossaries-extra }
%    \end{macrocode}
%
% xpinyin 不支持 LuaLaTeX，但其数据库可独立读取。Lua 下只加载数据，
% 使用与 xpinyin 相同的表项名，供后续查表函数调用。
%    \begin{macrocode}
\sys_if_engine_luatex:TF
  {
    \group_begin:
      \cs_set_protected:Npn \XPYU #1#2
        { \cs_gset_nopar:cpn { c__xpinyin_ #2 _tl } }
      \cs_set_protected:Npn \XPYUM #1#2
        { \cs_gset_nopar:cpn { c__xpinyin_multiple_ #2 _clist } }
      \file_input:n { xpinyin-database.def }
    \group_end:
  }
  { \RequirePackage { xpinyin } }
%    \end{macrocode}
%
% 样式代码存进 \pkg{glossaries} 时就已经记号化完了，写在里面的
% \cs{ExplSyntaxOn} 不起作用。环境正文本来就是排版内容，直接用 2e 写法。
%    \begin{macrocode}
%    \end{macrocode}
%
%    \begin{macrocode}
%    \end{macrocode}
%
% 缩略语表与符号表共用两列布局，合排时统一标签列宽。
%    \begin{macrocode}
\cs_new:Npn \__hit_abbr_desc:n #1
  {
    \tl_if_blank:eTF { \hitabbrzh {#1} }
      { \hitabbren {#1} }
      {
        \tl_if_blank:eTF { \hitabbren {#1} }
          { \hitabbrzh {#1} }
          { \hitabbrzh {#1} （ \hitabbren {#1} ） }
      }
  }
\cs_new:Npn \__hit_abbr_desc_en:n #1
  {
    \tl_if_blank:eTF { \hitabbren {#1} }
      { \hitabbrzh {#1} }
      { \hitabbren {#1} }
  }
\newglossarystyle{hitabbrstyle}{%
  \RenewDocumentEnvironment{theglossary}{+b}%
    {\hit@symbols@list:n {##1}}%
    {}%
  \renewcommand*{\glossaryheader}{}%
  \renewcommand*{\glsgroupheading}[1]{}%
  \renewcommand*{\glsgroupskip}{}%
  \renewcommand*{\glossentry}[2]{%
    \prop_gput:Nnn \g__hit_abbreviation_targets_prop {##1} { }%
    \item[\glsentryitem{##1}\glstarget{##1}{\glossentryname{##1}}]%
    \__hit_abbr_desc:n {##1}%
  }%
  \renewcommand*{\subglossentry}[3]{\glossentry{##2}{##3}}%
}
\newglossarystyle{engstyle}{%
  \RenewDocumentEnvironment{theglossary}{+b}%
    {\hit@symbols@list:n {##1}}%
    {}%
  \renewcommand*{\glossaryheader}{}%
  \renewcommand*{\glsgroupheading}[1]{}%
  \renewcommand*{\glsgroupskip}{}%
  \renewcommand*{\glossentry}[2]{%
    \prop_gput:Nnn \g__hit_abbreviation_targets_prop {##1} { }%
    \item[\glsentryitem{##1}\glstarget{##1}{\glossentryname{##1}}]%
    \__hit_abbr_desc_en:n {##1}%
  }%
  \renewcommand*{\subglossentry}[3]{\glossentry{##2}{##3}}%
}
%    \end{macrocode}
%
% \cs{newacronym} 是 v3.1e 的写法，渲染冻结在那一版：中文侧首次只排全称、
% 之后排短形（v3.1e 靠 \cs{setacronymstyle}\marg{short-long} 再把
% \cs{genacrfullformat} 改成只取 \cs{glsentrylong} 凑出来，上游现成的
% \texttt{long-only-short-only} 就是这个行为）；英文侧照旧 \texttt{long-short}。
% \cs{genacrfullformat} 那个改写在 extra 下已经不起作用，留着是误导，删掉。
%    \begin{macrocode}
\bool_if:NTF \g__hit_en_bool
  { \setabbreviationstyle [ acronym ] { long-short } }
  { \setabbreviationstyle [ acronym ] { long-only-short-only } }
%    \end{macrocode}
%
% \pkg{glossaries-extra} 把 \cs{setacronymstyle} 做成了硬报错，指向
% \cs{setabbreviationstyle}。v3.1e 的用户可能在自己的 \file{.sty} 里写过它，
% 直接报错会让老文档编不过，所以拦下来转发，只提示一次。
%    \begin{macrocode}
\RenewDocumentCommand \setacronymstyle { o m }
  {
    \hit@warn@renamed@command { setacronymstyle }
      { setabbreviationstyle[acronym] }
    \IfNoValueTF {#1}
      { \setabbreviationstyle [ acronym ] {#2} }
      { \setabbreviationstyle [ #1 ] {#2} }
  }
\makenoidxglossaries
%    \end{macrocode}
%
% \subsection{缩略语的声明与使用}
%
% 将统一双语入口解析后的全称、简称及复数存入 glossaries-extra 词条。
% 规范要求「文中第一次出现的缩写词应该用括号注明英文原词」，中文全称在前时
% 括号里依次是英文原词与缩写：
% \begin{center}
% 体细胞拷贝数变异（Somatic copy number alteration，SCNA）
% \end{center}
% 三种取值各一种排法，中文里与英文里又各一套括号：
% \begin{longtblr}[caption={缩写首次出现的排法}, label={tab:impl-abbr}]
%   {colspec={l l l}}
% \toprule
% 定义 & 中文里首次 & 英文里首次 \\ \midrule
% 中英文全称 & X（Y，S） & Y (S) \\
% 只有中文全称 & X（S） & X (S) \\
% 只有英文全称 & S（Y） & Y (S) \\
% \bottomrule
% \end{longtblr}
%
% 落实的办法是把整串首次形式拼好存进词条的 \texttt{long} 字段，再配上游现成的
% \texttt{long-only-short-only} 样式：它首次排 \texttt{long}、之后排 \texttt{short}，正是要的
% 行为。复数另存 \texttt{longplural}，括号里的缩写取 \option{plural}，英文全称取 \option{long-plural}
% （不写加 \texttt{s}），中文全称不动。中文里还是英文里按用的那一段定，所以每用一次重拼一次，见 \cs{\_\_hit\_abbr\_localize:n}。
%
% v3.1e 是把括号手写进 \cs{newacronym} 的第三个参数里，单数看着对而复数漏了，
% 排出来半角括号套全角括号。现在括号由样式生成，两边不会再各走各的。
%    \begin{macrocode}
\tl_new:N \l__hit_abbr_zh_tl
\tl_new:N \l__hit_abbr_en_tl
\tl_new:N \l__hit_abbr_pinyin_tl
\tl_new:N \l__hit_abbr_label_tl
\tl_new:N \l__hit_abbr_long_tl
\tl_new:N \l__hit_abbr_longpl_tl
\tl_new:N \l__hit_abbr_pick_tl
\tl_new:N \l__hit_abbr_plural_tl
\tl_new:N \l__hit_abbr_enpl_tl
\tl_new:N \l__hit_abbr_indexed_tl
\keys_define:nn { hit / abbr / entry }
  {
    long        .tl_set:N = \l__hit_abbr_zh_tl ,
    long-en     .tl_set:N = \l__hit_abbr_en_tl ,
    short       .tl_set:N = \l__hit_abbr_label_tl ,
    plural      .tl_set:N = \l__hit_abbr_plural_tl ,
    long-plural .tl_set:N = \l__hit_abbr_enpl_tl ,
    indexed     .choices:nn = { auto , true , false }
      { \tl_set_eq:NN \l__hit_abbr_indexed_tl \l_keys_choice_tl } ,
    pinyin      .tl_set:N = \l__hit_abbr_pinyin_tl ,
  }
%    \end{macrocode}
%
% 检测文本中的 CJK 字符，跳过控制序列。
%    \begin{macrocode}
\bool_new:N \l__hit_abbr_cjk_bool
\cs_new_protected:Npn \__hit_abbr_cjk_scan:n #1
  {
    \tl_map_inline:nn {#1}
      {
        \token_if_cs:NF ##1
          {
            \int_compare:nNnT { `##1 } > { "2E7F }
              { \bool_set_true:N \l__hit_abbr_cjk_bool }
          }
      }
  }
\sys_if_engine_pdftex:T
  {
    \cs_set_protected:Npn \__hit_abbr_cjk_scan:n #1
      { \hit@engine@pdftex@cjk@scan:nN {#1} \l__hit_abbr_cjk_bool }
  }
\cs_new_protected:Npn \__hit_abbr_cjk_set:n #1
  {
    \bool_set_false:N \l__hit_abbr_cjk_bool
    \__hit_abbr_cjk_scan:n {#1}
  }
\cs_generate_variant:Nn \__hit_abbr_cjk_set:n { V }
%    \end{macrocode}
%
% \begin{macro}{\hit@abbr@declare:nn}
% 旧式词条构造器；统一双语入口在 hit-bilingual.dtx 中安装。
%    \begin{macrocode}
\cs_new_protected:Npn \hit@abbr@declare:nn #1#2
  {
    \tl_clear:N \l__hit_abbr_zh_tl
    \tl_clear:N \l__hit_abbr_en_tl
    \tl_clear:N \l__hit_abbr_pinyin_tl
    \tl_clear:N \l__hit_abbr_plural_tl
    \tl_clear:N \l__hit_abbr_enpl_tl
    \tl_set:Nn \l__hit_abbr_indexed_tl { auto }
    \tl_set:Nn \l__hit_abbr_label_tl {#1}
    \tl_if_in:nnTF {#2} { = }
      { \hit@keys@set:nn { hit / abbr / entry } {#2} }
      {
        \__hit_abbr_cjk_set:n {#2}
        \bool_if:NTF \l__hit_abbr_cjk_bool
          { \tl_set:Nn \l__hit_abbr_zh_tl {#2} }
          { \tl_set:Nn \l__hit_abbr_en_tl {#2} }
      }
    \bool_lazy_and:nnTF
      { \tl_if_empty_p:N \l__hit_abbr_zh_tl }
      { \tl_if_empty_p:N \l__hit_abbr_en_tl }
      { \msg_error:nnn { hithesis } { abbr-no-long } {#1} }
      { \exp_args:NV \__hit_abbr_declare:nn \l__hit_abbr_label_tl {#1} }
  }
\cs_new_protected:Npn \__hit_abbr_declare:nn #1#2
  {
    \tl_if_empty:NT \l__hit_abbr_plural_tl
      { \tl_set:Nn \l__hit_abbr_plural_tl { #1 s } }
    \__hit_abbr_compose:n {#1}
    \use:x
      {
        \exp_not:N \newabbreviation
          [
            shortplural = { \exp_not:V \l__hit_abbr_plural_tl } ,
            longplural = { \exp_not:V \l__hit_abbr_longpl_tl } ,
            hitzh = { \exp_not:V \l__hit_abbr_zh_tl } ,
            hiten = { \exp_not:V \l__hit_abbr_en_tl } ,
            hitenpl = { \exp_not:V \l__hit_abbr_enpl_tl } ,
            hitindexed = { \exp_not:V \l__hit_abbr_indexed_tl } ,
            hitpinyin = { \exp_not:V \l__hit_abbr_pinyin_tl } ,
            description = { \exp_not:V \l__hit_abbr_long_tl } ,
          ]
          { \exp_not:n {#2} }
          { \exp_not:n {#1} }
          { \exp_not:V \l__hit_abbr_long_tl }
      }
  }
%    \end{macrocode}
% \end{macro}
%
% 拼首次形式。排法与括号都按语种：中文全称在前、括号里依次是英文原词与缩写，
% 用全角括号与全角逗号；英文全称在前、括号里只有缩写，用半角括号。语种取的是
% 这一段的（\cs{hit@lang@if@en:TF}），英文版里的中文摘要照中文排。
%
% 括号与逗号取哪一档由 \option{abbreviation-fullwidth} 定，\texttt{auto} 按语种走，
% 另两档只换那三个符号，不动排法。
%    \begin{macrocode}
\tl_new:N \l__hit_abbr_lparen_tl
\tl_new:N \l__hit_abbr_rparen_tl
\tl_new:N \l__hit_abbr_comma_tl
\cs_new_protected:Npn \__hit_abbr_punct_pick:n #1
  {
    \bool_lazy_or:nnTF
      { \str_if_eq_p:Vn \g__hit_abbr_punct_str { half } }
      {
        \bool_lazy_and_p:nn
          { \str_if_eq_p:Vn \g__hit_abbr_punct_str { auto } }
          { \str_if_eq_p:nn {#1} { en } }
      }
      {
        \tl_set:Nn \l__hit_abbr_lparen_tl { \c_space_tl ( }
        \tl_set:Nn \l__hit_abbr_rparen_tl { ) }
        \tl_set:Nn \l__hit_abbr_comma_tl { ,~ }
      }
      {
        \tl_set:Nn \l__hit_abbr_lparen_tl { （ }
        \tl_set:Nn \l__hit_abbr_rparen_tl { ） }
        \tl_set:Nn \l__hit_abbr_comma_tl { ， }
      }
  }
\cs_new_protected:Npn \__hit_abbr_compose:n #1
  {
    \hit@lang@if@en:TF
      {
        \__hit_abbr_punct_pick:n { en }
        \__hit_abbr_compose_en:n {#1}
      }
      {
        \__hit_abbr_punct_pick:n { zh }
        \__hit_abbr_compose_zh:n {#1}
      }
  }
\cs_new_protected:Npn \__hit_abbr_compose_en:n #1
  {
    \tl_if_empty:NTF \l__hit_abbr_en_tl
      { \tl_set_eq:NN \l__hit_abbr_pick_tl \l__hit_abbr_zh_tl }
      { \tl_set_eq:NN \l__hit_abbr_pick_tl \l__hit_abbr_en_tl }
    \tl_set:Nx \l__hit_abbr_long_tl
      {
        \exp_not:V \l__hit_abbr_pick_tl
        \exp_not:V \l__hit_abbr_lparen_tl #1 \exp_not:V \l__hit_abbr_rparen_tl
      }
%    \end{macrocode}
%
% 全称的复数只在它是西文时才加 \texttt{s}。英文段里引一条只有中文全称的条目
% 是少见但合法的写法，那时候「树结构折筷过程s」显然不对。
%    \begin{macrocode}
    \__hit_abbr_cjk_set:V \l__hit_abbr_pick_tl
    \tl_set:Nx \l__hit_abbr_longpl_tl
      {
        \tl_if_empty:NTF \l__hit_abbr_en_tl
          {
            \str_if_eq:VnTF \l__hit_abbr_zhpl_tl {\scan_stop:}
              {\exp_not:V \l__hit_abbr_pick_tl}{\exp_not:V \l__hit_abbr_zhpl_tl}
          }
          {
            \str_if_eq:VnTF \l__hit_abbr_enpl_tl {\scan_stop:}
              {\exp_not:V \l__hit_abbr_pick_tl \bool_if:NF \l__hit_abbr_cjk_bool {s}}
              {\exp_not:V \l__hit_abbr_enpl_tl}
          }
        \exp_not:V \l__hit_abbr_lparen_tl
        \exp_not:V \l__hit_abbr_plural_tl
        \exp_not:V \l__hit_abbr_rparen_tl
      }
  }
\cs_new_protected:Npn \__hit_abbr_compose_zh:n #1
  {
    \tl_if_empty:NTF \l__hit_abbr_zh_tl
      {
        \tl_set:Nx \l__hit_abbr_long_tl
          {
            #1 \exp_not:V \l__hit_abbr_lparen_tl
            \exp_not:V \l__hit_abbr_en_tl \exp_not:V \l__hit_abbr_rparen_tl
          }
        \tl_set:Nx \l__hit_abbr_longpl_tl
          {
            \exp_not:V \l__hit_abbr_plural_tl \exp_not:V \l__hit_abbr_lparen_tl
            \str_if_eq:VnTF \l__hit_abbr_enpl_tl {\scan_stop:}
              {\exp_not:V \l__hit_abbr_en_tl s}{\exp_not:V \l__hit_abbr_enpl_tl}
            \exp_not:V \l__hit_abbr_rparen_tl
          }
      }
      {
        \tl_set:Nx \l__hit_abbr_long_tl
          {
            \exp_not:V \l__hit_abbr_zh_tl \exp_not:V \l__hit_abbr_lparen_tl
            \tl_if_empty:NF \l__hit_abbr_en_tl
              {
                \exp_not:V \l__hit_abbr_en_tl
                \exp_not:V \l__hit_abbr_comma_tl
              }
            #1 \exp_not:V \l__hit_abbr_rparen_tl
          }
        \tl_set:Nx \l__hit_abbr_longpl_tl
          {
            \str_if_eq:VnTF \l__hit_abbr_zhpl_tl {\scan_stop:}
              {\exp_not:V \l__hit_abbr_zh_tl}{\exp_not:V \l__hit_abbr_zhpl_tl}
            \exp_not:V \l__hit_abbr_lparen_tl
            \tl_if_empty:NF \l__hit_abbr_en_tl
              {
                \str_if_eq:VnTF \l__hit_abbr_enpl_tl {\scan_stop:}
                  {\exp_not:V \l__hit_abbr_en_tl s}{\exp_not:V \l__hit_abbr_enpl_tl}
                \exp_not:V \l__hit_abbr_comma_tl
              }
            \exp_not:V \l__hit_abbr_plural_tl \exp_not:V \l__hit_abbr_rparen_tl
          }
      }
  }
%    \end{macrocode}
%
% 声明时按全文的语种拼一份存进 \texttt{long}，给不经 \cs{abbr} 取全称的地方用；
% 用的时候再按那一段的语种重拼一次，写回这一条的 \texttt{long} 与 \texttt{longpl}
% 再交给 \cs{gls}（\pkg{glossaries} 里 \texttt{longplural}、\texttt{shortplural} 两个键存进的字段叫
% \texttt{longpl}、\texttt{shortpl}，按键名读写是空操作），\option{punct} 写在词条后面也照样生效。两个字段都空的是
% \cs{newacronym} 立的条目，没有中英两份可拼，原样不动。
%    \begin{macrocode}
\tl_new:N \l__hit_abbr_short_tl
\cs_new_protected:Npn \__hit_abbr_localize:n #1
  {
    \ifglsentryexists {#1}
      {
        \glsletentryfield \l__hit_abbr_zh_tl {#1} { hitzh }
        \glsletentryfield \l__hit_abbr_en_tl {#1} { hiten }
        \bool_lazy_and:nnF
          { \tl_if_empty_p:N \l__hit_abbr_zh_tl }
          { \tl_if_empty_p:N \l__hit_abbr_en_tl }
          {
            \glsletentryfield \l__hit_abbr_short_tl {#1} { short }
            \glsletentryfield \l__hit_abbr_plural_tl {#1} { shortpl }
            \glsletentryfield \l__hit_abbr_enpl_tl {#1} { hitenpl }
            \glsletentryfield \l__hit_abbr_zhpl_tl {#1} { hitzhpl }
            \exp_args:NV \__hit_abbr_compose:n \l__hit_abbr_short_tl
            \GlsXtrLetField {#1} { long } \l__hit_abbr_long_tl
            \GlsXtrLetField {#1} { longpl } \l__hit_abbr_longpl_tl
          }
      }
      { }
  }
\glsaddstoragekey { hitzh } { } { \hitabbrzh }
\glsaddstoragekey { hiten } { } { \hitabbren }
\glsaddstoragekey { hitpinyin } { } { \hitabbrpinyin }
\glsaddstoragekey { hitenpl } { } { \hitabbrenpl }
\glsaddstoragekey { hitindexed } { auto } { \hitabbrindexed }
\setabbreviationstyle [ abbreviation ] { long-only-short-only }
%    \end{macrocode}
%
% \subsection{拼音排序键}
%
% 中文索引靠一个人工排序键分组，\pkg{splitidx} 底下是 \pkg{makeindex}，
% 它不认汉字。v3.1e 的写法是每处手写 \texttt{ti!体细胞拷贝数变异}。
%
% \pkg{xpinyin} 随包带一张四万七千行的表，每个汉字一条
% \cs{XPYU}\marg{字}\marg{码点}\marg{带调拼音}，存成
% \cs{c\_\_xpinyin\_\meta{码点}\_tl}。查表是纯 \hologo{TeX}，不调外部程序，
% 整张表加载实测四十毫秒。所以首字的拼音可以推出来，声调转成数字排在后面
% （\texttt{tǐ} 记作 \texttt{ti3}），同音节按调号排，与汉语词典一致。
%
% 两处必须提示用户：库里查不到，以及首字是多音字。两种都退回取库里的首选读音
% 并说明怎么手写覆盖。
%    \begin{macrocode}
\tl_new:N \l__hit_pinyin_tl
\tl_new:N \l__hit_pinyin_head_tl
\prop_new:N \c__hit_pinyin_tone_prop
\cs_new_protected:Npn \__hit_pinyin_tone_put:nn #1#2
  { \prop_put:Nnn \c__hit_pinyin_tone_prop {#1} {#2} }
\clist_map_inline:nn
  {
    {ā}{a1},{á}{a2},{ǎ}{a3},{à}{a4},
    {ē}{e1},{é}{e2},{ě}{e3},{è}{e4},
    {ī}{i1},{í}{i2},{ǐ}{i3},{ì}{i4},
    {ō}{o1},{ó}{o2},{ǒ}{o3},{ò}{o4},
    {ū}{u1},{ú}{u2},{ǔ}{u3},{ù}{u4},
    {ǖ}{v1},{ǘ}{v2},{ǚ}{v3},{ǜ}{v4},{ü}{v},
  }
  { \__hit_pinyin_tone_put:nn #1 }
%    \end{macrocode}
%
% 把带调拼音拆成「无调音节 + 调号」。逐字符查上表，查得到就换成基字母并记下
% 调号，查不到原样留下。轻声没有调号，补 \texttt{5}。
%    \begin{macrocode}
\tl_new:N \l__hit_pinyin_tone_tl
\cs_new_protected:Npn \__hit_pinyin_detone:n #1
  {
    \tl_clear:N \l__hit_pinyin_head_tl
    \tl_set:Nn \l__hit_pinyin_tone_tl { 5 }
    \__hit_pinyin_detone_map:n {#1}
    \tl_put_right:NV \l__hit_pinyin_head_tl \l__hit_pinyin_tone_tl
  }
\cs_new_protected:Npn \__hit_pinyin_detone_map:n #1
  { \tl_map_function:nN {#1} \__hit_pinyin_detone_char:n }
\cs_new_protected:Npn \__hit_pinyin_detone_char:n #1
  {
    \prop_get:NnNTF \c__hit_pinyin_tone_prop {#1} \l_tmpa_tl
      {
        \tl_put_right:Nx \l__hit_pinyin_head_tl
          { \tl_head:V \l_tmpa_tl }
        \tl_if_empty:NF \l_tmpa_tl
          {
            \tl_set:Nx \l_tmpb_tl { \tl_tail:V \l_tmpa_tl }
            \tl_if_empty:NF \l_tmpb_tl
              { \tl_set_eq:NN \l__hit_pinyin_tone_tl \l_tmpb_tl }
          }
      }
      { \tl_put_right:Nn \l__hit_pinyin_head_tl {#1} }
  }
%    \end{macrocode}
%
% \hologo{pdfTeX} 下库里的带调字母是两个字节，逐记号走会拆开。这里转成字节串，按 UTF-8
% 把后续字节（0x80--0xBF）并进前一个字再查表；上表的键本来就按字节串存。
%    \begin{macrocode}
\str_new:N \l__hit_pinyin_str
\str_new:N \l__hit_pinyin_char_str
\sys_if_engine_pdftex:T
  {
    \cs_set_protected:Npn \__hit_pinyin_detone_map:n #1
      {
        \str_set:Nn \l__hit_pinyin_str {#1}
        \str_clear:N \l__hit_pinyin_char_str
        \str_map_inline:Nn \l__hit_pinyin_str
          {
            \bool_lazy_and:nnF
              { \int_compare_p:nNn { `##1 } > { "7F } }
              { \int_compare_p:nNn { `##1 } < { "C0 } }
              {
                \str_if_empty:NF \l__hit_pinyin_char_str
                  { \exp_args:NV \__hit_pinyin_detone_char:n \l__hit_pinyin_char_str }
                \str_clear:N \l__hit_pinyin_char_str
              }
            \str_put_right:Nn \l__hit_pinyin_char_str {##1}
          }
        \str_if_empty:NF \l__hit_pinyin_char_str
          { \exp_args:NV \__hit_pinyin_detone_char:n \l__hit_pinyin_char_str }
      }
  }
%    \end{macrocode}
%
% \begin{macro}{\hit@pinyin@head:nN}
% \meta{词}\meta{存放处}：取首字的排序键。
%    \begin{macrocode}
\cs_new_protected:Npn \hit@pinyin@head:nN #1#2
  {
    \tl_set:Nx \l__hit_pinyin_tl { \tl_head:n {#1} }
    \exp_args:Nf \__hit_pinyin_lookup:nN
      { \tl_use:N \l__hit_pinyin_tl } #2
  }
\cs_new_protected:Npn \__hit_pinyin_lookup:nN #1#2
  { \exp_args:Nf \__hit_pinyin_lookup:nnN { \int_value:w `#1 } {#1} #2 }
\cs_new_protected:Npn \__hit_pinyin_lookup:nnN #1#2#3
  {
    \cs_if_exist:cTF { c__xpinyin_ #1 _tl }
      {
        \exp_args:Nv \__hit_pinyin_detone:n { c__xpinyin_ #1 _tl }
        \tl_set_eq:NN #3 \l__hit_pinyin_head_tl
%    \end{macrocode}
%
% 提示里给的是排序键该写成的样子，也就是转过数字的形式，不是库里那个带调的。
% 每用一次缩写就查一次，同一个字只提示一次，按码位记下提示过的字。
%    \begin{macrocode}
        \clist_if_exist:cT { c__xpinyin_multiple_ #1 _clist }
          {
            \__hit_pinyin_warn_once:nn {#1}
              {
                \msg_warning:nnxxx { hithesis } { pinyin-multiple } {#2}
                  { \tl_use:N \l__hit_pinyin_head_tl }
                  { \tl_to_str:c { c__xpinyin_multiple_ #1 _clist } }
              }
          }
      }
      {
        \__hit_pinyin_warn_once:nn {#1}
          { \msg_warning:nnn { hithesis } { pinyin-missing } {#2} }
        \tl_clear:N #3
      }
  }
\prop_new:N \g__hit_pinyin_warned_prop
\cs_new_protected:Npn \__hit_pinyin_warn_once:nn #1#2
  {
    \prop_if_in:NnF \g__hit_pinyin_warned_prop {#1}
      {
        \prop_gput:Nnn \g__hit_pinyin_warned_prop {#1} { }
        #2
      }
  }
%    \end{macrocode}
%
% \hologo{pdfTeX} 下一个汉字是三个字节，\cs{tl\_head:n} 只取到第一个。这里用
% \cs{text\_purify:n} 还原成裸字节，按 UTF-8 的首字节定长度，把首字的码位拼出来再查表；
% 提示里给的是首字那几个字节，写进日志就是那个字。
%    \begin{macrocode}
\int_new:N \l__hit_pinyin_cp_int
\int_new:N \l__hit_pinyin_left_int
\sys_if_engine_pdftex:T
  {
    \cs_set_protected:Npn \hit@pinyin@head:nN #1#2
      {
        \str_set:Ne \l__hit_pinyin_str { \text_purify:n {#1} }
        \str_clear:N \l__hit_pinyin_char_str
        \int_set:Nn \l__hit_pinyin_left_int { -1 }
        \str_map_inline:Nn \l__hit_pinyin_str
          {
            \str_put_right:Nn \l__hit_pinyin_char_str {##1}
            \int_compare:nNnTF \l__hit_pinyin_left_int < { 0 }
              {
                \int_set:Nn \l__hit_pinyin_cp_int { `##1 }
                \int_set:Nn \l__hit_pinyin_left_int
                  {
                    \int_compare:nNnTF { `##1 } < { "C0 } { 0 }
                      {
                        \int_compare:nNnTF { `##1 } < { "E0 } { 1 }
                          { \int_compare:nNnTF { `##1 } < { "F0 } { 2 } { 3 } }
                      }
                  }
                \int_set:Nn \l__hit_pinyin_cp_int
                  {
                    \l__hit_pinyin_cp_int -
                    \int_case:nn { \l__hit_pinyin_left_int }
                      { { 0 } { 0 } { 1 } { "C0 } { 2 } { "E0 } { 3 } { "F0 } }
                  }
              }
              {
                \int_set:Nn \l__hit_pinyin_cp_int
                  { \l__hit_pinyin_cp_int * 64 + `##1 - "80 }
                \int_decr:N \l__hit_pinyin_left_int
              }
            \int_compare:nNnT \l__hit_pinyin_left_int = { 0 } { \str_map_break: }
          }
        \exp_args:NVV \__hit_pinyin_lookup:nnN
          \l__hit_pinyin_cp_int \l__hit_pinyin_char_str #2
      }
  }
%    \end{macrocode}
% \end{macro}
