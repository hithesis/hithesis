% \begin{macro}{\hitindex}
% abbreviation-indexed 控制缩略语是否同时登记索引，单次调用可覆盖。
%
% \cs{hitindex}\oarg{键值}\marg{文字} 输出文字并登记索引，
% 同一个词按有没有汉字登记进中文或英文索引，不分语种、不配对。\option{entry} 给另一个词条，
% 正文写的是「乔帮主」而索引条目要「乔峰」时用；带星号只登记不排。
%
% 中文索引的排序键取首字的拼音，见上面的 \cs{hit@pinyin@head:nN}；写了
% \option{pinyin} 就以写的为准。
%    \begin{macrocode}
\tl_new:N \l__hit_index_zh_tl
\tl_new:N \l__hit_index_en_tl
\tl_new:N \l__hit_index_pinyin_tl
\tl_new:N \l__hit_index_entry_tl
\bool_new:N \l__hit_index_on_bool
\keys_define:nn { hit / index / one }
  {
    entry  .tl_set:N = \l__hit_index_entry_tl ,
    pinyin .tl_set:N = \l__hit_index_pinyin_tl ,
  }
\keys_define:nn { hit / abbr / use }
  {
    indexing .bool_set:N = \l__hit_index_on_bool ,
    indexing .default:n = true ,
  }
%    \end{macrocode}
%
% 真正往两个索引里写。中文那份要排序键，缺了就不写——没有键的条目在
% \pkg{makeindex} 里会排到莫名其妙的地方，不如不进。
%
% 键与词之间用的是 \texttt{@}（\pkg{makeindex} 的实际符：@ 前排序、@ 后
% 排印），从前误写成层级符 \texttt{!}，拼音键被当成父条目印了出来
% （“duan4”一行、词缩进在下），官方示例（规范附录 6）里只有词，
% 组标题是单个大写字母。
%
% \hologo{pdfTeX} 下词条可能已经展开过，汉字成了 \cs{CTEX@char@nnn} 加三个字节参数，原样写进
% \file{.idx} 的话名字里的 \texttt{@} 被 \pkg{makeindex} 当成实际符，整条拒收；读回 \file{.ind}
% 时 \texttt{@} 也不是字母。写之前用 \cs{text\_purify:n} 还原成裸字节。
%    \begin{macrocode}
\cs_new_protected:Npn \__hit_index_emit:
  {
    \sys_if_engine_pdftex:T
      { \tl_set:Ne \l__hit_index_zh_tl { \text_purify:V \l__hit_index_zh_tl } }
    \tl_if_empty:NF \l__hit_index_zh_tl
      {
        \tl_if_empty:NT \l__hit_index_pinyin_tl
          {
            \exp_args:NV \hit@pinyin@head:nN
              \l__hit_index_zh_tl \l__hit_index_pinyin_tl
          }
        \tl_if_empty:NF \l__hit_index_pinyin_tl
          {
            \use:x
              {
                \exp_not:N \sindex [ china ]
                  {
                    \exp_not:V \l__hit_index_pinyin_tl @
                    \exp_not:V \l__hit_index_zh_tl
                  }
              }
          }
      }
    \tl_if_empty:NF \l__hit_index_en_tl
      {
        \use:x
          { \exp_not:N \sindex [ english ] { \exp_not:V \l__hit_index_en_tl } }
      }
  }
\cs_new_protected:Npn \__hit_index_term:n #1
  {
    \tl_clear:N \l__hit_index_zh_tl
    \tl_clear:N \l__hit_index_en_tl
    \tl_if_blank:nF {#1}
      {
        \__hit_abbr_cjk_set:n {#1}
        \bool_if:NTF \l__hit_abbr_cjk_bool
          { \tl_set:Nn \l__hit_index_zh_tl {#1} }
          { \tl_set:Nn \l__hit_index_en_tl {#1} }
        \tl_trim_spaces:N \l__hit_index_zh_tl
        \tl_trim_spaces:N \l__hit_index_en_tl
        \__hit_index_emit:
      }
  }
\NewDocumentCommand \hitindex { s O{} m }
  {
    \tl_clear:N \l__hit_index_entry_tl
    \tl_clear:N \l__hit_index_pinyin_tl
    \hit@keys@set:nn { hit / index / one } {#2}
    \tl_if_empty:NTF \l__hit_index_entry_tl
      { \__hit_index_term:n {#3} }
      { \exp_args:NV \__hit_index_term:n \l__hit_index_entry_tl }
    \IfBooleanF {#1} {#3}
  }
%    \end{macrocode}
% \end{macro}
%
% \cs{abbr} 用一次就登记一次索引，索引形式直接取条目的 \option{long} 与
% \option{long-en}，不另设字段：开了 \option{indexing} 两边本来就该是同一个词。
% 中文那份的排序键取条目的 \option{pinyin}，没写就查表，与 \cs{hitindex} 一样。
% 登不登记先看全局的 \option{indexing}，条目写了 \option{indexed} 照条目，这一处写了可选参数照这一处。
%    \begin{macrocode}
\cs_new_protected:Npn \__hit_abbr_use:nn #1#2
  {
    \bool_set_eq:NN \l__hit_index_on_bool \g__hit_abbr_indexing_bool
    \ifglsentryexists {#2}
      {
        \tl_set:Nx \l_tmpa_tl { \hitabbrindexed {#2} }
        \str_case:Vn \l_tmpa_tl
          {
            { true }  { \bool_set_true:N \l__hit_index_on_bool }
            { false } { \bool_set_false:N \l__hit_index_on_bool }
          }
      }
      { }
    \hit@keys@set:nn { hit / abbr / use } {#1}
    \bool_if:NT \l__hit_index_on_bool
      {
        \tl_set:Nx \l__hit_index_pinyin_tl { \hitabbrpinyin {#2} }
        \tl_set:Nx \l__hit_index_zh_tl { \hitabbrzh {#2} }
        \tl_set:Nx \l__hit_index_en_tl { \hitabbren {#2} }
        \__hit_index_emit:
      }
  }
%    \end{macrocode}
