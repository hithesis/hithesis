% \section{正文页眉：博士后}
%
% ^^A ======================================================================
% ^^A Module final-pagestyle-postdoc: 正文页眉的博士后变体
% ^^A ======================================================================
%
% \changes{v3.2a}{2026/09/13}{博士后这一档的页眉单独成一个变体文件}
% 基准（博士加哈尔滨）在 \file{src/flow/hit-final-pagestyle.dtx}。这一份只写
% 与基准不同的那一小坨。
%
% 博士后偶数页印的是「研究报告」那一句，不走学位层次那条路。
%    \begin{macrocode}
%<*final-pagestyle-postdoc>
\hit@hook@new:nn { headings-body-postdoc }
  {
    \hit@header:nn { o } { \hit@header@font \leftmark }
    \hit@header:nn { e }
      { \hit@header@font \hit@term@header@university@zh \hit@term@header@report }
  }
%</final-pagestyle-postdoc>
%    \end{macrocode}
