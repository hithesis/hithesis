          level-3 = { enter-formatting-for-number = \% 1 . \% 2 . \% 3 , follow-number-with = space ,
                      aligned-at = 0bp , text-indent-at = 36bp } ,
          level-4 = { enter-formatting-for-number = \% 1 . \% 2 . \% 3 . \% 4 , follow-number-with = space ,
                      aligned-at = 0bp , text-indent-at = 43.2bp } ,
        } }
      }
  }
