                          follow-number-with = nothing } ,
              level-2 = { enter-formatting-for-number = \% 1 . \% 2 , follow-number-with = nothing } ,
              level-3 = { enter-formatting-for-number = \% 1 . \% 2 . \% 3 , follow-number-with = nothing } ,
