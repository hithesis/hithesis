% \section{报告的文档骨架}
%
% \changes{v3.2a}{2026/09/14}{报告的骨架宏与学位论文同名；文献表调总出口 \cs{hit@bib@print:}；
%   正文照终稿排的那一档页码制式跟着终稿}
%
% ^^A ======================================================================
% ^^A Module report-matter: 报告的骨架宏（hit-report）
% ^^A ======================================================================
%
% 与学位论文的 \cs{hitfrontmatter}、\cs{hitbackmatter} 同名，这样一个目录里
% 三份主文件的正文部分长得一样，只有第一行的 \option{stage} 不同。
%
% 报告没有前后文之分，\cls{ctexart} 底下 \cs{frontmatter} 根本不存在，所以
% 骨架宏没法跟学位论文共用一份。报告的前置只有封面，后置只有参考文献。
%
%    \begin{macrocode}
%<*report-matter>
\bool_if:NF \g__hit_final_bool
  {
%    \end{macrocode}
%
% \emph{页码制式跟着正文那一档走。} 报告默认整篇一个制式；正文照终稿排的那一档
% 与终稿一样分两段——前置（目录）罗马数字，正文另起一段从 1 数。原件的页脚
% 逐页量过就是这样：目录印 \texttt{I}、正文印 \texttt{-1-}。
%
% 章另起一页也在这儿发：这一档正文里第一级写的是 \cs{section}，可它按章排
% （见 \file{src/hithesis.dtx} 的层级错位），章就得另起一页。
%
% \emph{不能走 \pkg{ctex} 的 \option{break} 键。} 那个键在 \cs{@startsection} 里
% 挂在 \cs{if@nobreak} 的假支上——标题底下没正文时这个开关还立着（\hologo{LaTeX}
% 不在标题与它的头一段之间断页），换页就被跳过。示例里 1.2 底下正好没字，
% 章 2 于是跟在同一页上。所以直接在 \cs{section} 前面无条件发一次换页。
%
% \emph{换页之后那一段的段前也要留住。} \hologo{TeX} 把换页处的竖胶丢掉，而
% Word 在页首照进段前：原件的章标题基线量到 137.98 ＝ 版心顶 107.75 加段前 12
% 加上升部 18.23，丢了就只剩 125.98。跟封面那一页同一招——换完页先发一条零高的
% \cs{hrule} 把这一页垫成非空，后面那段胶就留得住；\cs{topskip} 一并归零，
% 不然它又会顶上来一截。
%    \begin{macrocode}
\cs_set_protected:Npn \hitfrontmatter
  {
    \bool_gset_true:N \g__hit_matter_front_bool
    \hit@structure@input:n { cover }
    \makecover
  }
\cs_set_protected:Npn \hitmainmatter
  {
    \bool_gset_true:N \g__hit_matter_main_bool
    \bool_if:NT \g__hit_final_body_bool
      {
        \clearpage
        \legacy_if_gset_true:n { @mainmatter }
        \pagenumbering { arabic }
        \pagestyle { hit@headings }
        \dim_zero:N \topskip
        \pretocmd { \section } { \clearpage \hrule ~ height ~ \c_zero_dim } { } { }
      }
    \hit@structure@input@list:n { mainmatter }
  }
\cs_set_protected:Npn \hitbackmatter
  {
    \bool_gset_true:N \g__hit_matter_back_bool
    \hit@structure@part:nn { bibliography }
      {
        \hit@bib@print:
      }
  }
  }
%</report-matter>
%    \end{macrocode}
%
% \Finale
