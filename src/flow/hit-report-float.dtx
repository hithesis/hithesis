% \iffalse meta-comment
%
% hit-report-float.dtx 是开题报告的浮动体
%
% \fi
%
% \section{开题报告的浮动体}
%
% \changes{v3.2a}{2026/09/28}{照 Word 排正文的那几档，题注改成 \pkg{docxlike} 的段（与学位论文同一个
%   \cs{@makecaption}），不再借 \pkg{ccaption} 的再裹一层；多行题注的对齐、段前段后照样式}
% \changes{v3.2a}{2026/09/14}{题号与题名之间改调共享层的 \cs{hit@caption@separator}
%   （发 \pkg{ccaption} 的 \cs{captiondelim}，\pkg{caption} 的 \texttt{labelsep} 到不了
%   正题注），兜底中文一个字、英文一个西文空格；哈尔滨与威海本科开题的图表编号
%   排「图 X-X」，公式连续编号；深圳本科那两份图表公式都排「图 1-1」（编号跟着节走）；
%   本部与威海的报告题注照 Word 排；图表上下各一个空段，与学位论文同一条；
%   题注上下的间距从 \option{caption-*} 取}
%
% ^^A ======================================================================
% ^^A Module report-floats: 浮动体默认行为与双语题注（hit-report）
% ^^A ======================================================================
%    \begin{macrocode}
%<*report-floats>
\bool_if:NF \g__hit_final_bool
  {
%    \end{macrocode}
%
% \emph{图表与正文之间是空段。} 报告与学位论文一样，图表上下各排一个正文格式的空段
% （\option{style}/\option{float-blank}，取值在 \file{src/config/hit-layout.dtx} 末尾），浮动体
% 自己的间距写成零（\option{style}/\option{float-sep}）。下面照 \option{float-sep} 设那三个
% 间距；它被写空时退回一个网格行。
%
% 挂在 \texttt{begindocument/end} 上，与终稿那一处同一个时机，不然会被它盖掉。
%
% \emph{题注是 \pkg{docxlike} 的段。} 与学位论文同一个 \cs{@makecaption}（\cs{hit@makecaption:nn}，
% \file{hit-caption.dtx}）：按图还是表挑 \texttt{caption-figure}／\texttt{caption-table}，字号、行距、段前段后
% 都从样式取。取值去 \file{docx} 里读：2026 年 9 月版深圳本科\emph{中文}中期原件的图段、图题、表题、
% 表格全是光 \texttt{w:line="300" w:lineRule="auto" snapToGrid=0}，四个空当都是零；\emph{英文}那一份
% 图题段后 60 缇（3\,bp）、1.5 倍，表题段前 \texttt{w:beforeLines="20"}（2.4\,bp）。
% 先前借 \pkg{ccaption} 的 \cs{@makecaption} 再裹一层：字号靠 \cs{captionnamefont} 那两个口子，
% 段前要自己发（它见浮动体顶端的 \cs{prevdepth} 是 $-1000$ 就不发，英文报告表题的 2.4\,bp 一直丢），
% 单行居中、多行两端对齐也是它自己的规矩，不看样式。\cs{abovecaptionskip} 与
% \cs{belowcaptionskip} 归零，间距全由样式给。
%    \begin{macrocode}
    \bool_if:NT \g__hit_final_body_bool
      {
        \AddToHook { begindocument / end }
          {
            \tl_if_empty:NTF \g__hit_float_sep_tl
              {
                \skip_set:Nn \intextsep    { \g_docxlike_page_lead_dim }
                \skip_set:Nn \textfloatsep { \g_docxlike_page_lead_dim }
                \skip_set:Nn \floatsep     { \g_docxlike_page_lead_dim }
              }
              { \hit@float@sep: }
            \skip_zero:N \abovecaptionskip
            \skip_zero:N \belowcaptionskip
            \cs_set_eq:NN \@makecaption \hit@makecaption:nn
          }
      }
%    \end{macrocode}
%
%    \begin{macrocode}
%    \end{macrocode}
%
% 题号与题名之间的间隔。报告走 \pkg{caption} 的 \texttt{labelsep}，那个键只认
% 名字，所以自己声明两个，各读一个常量，常量为空就退回原来的 \texttt{space}，
% 也就是一个空格。
%
% 两处 \cs{captionsetup} 各自先 \cs{RequirePackage}\marg{caption}，声明得排在加载
% 之后，所以包成一个宏在两处都调一次。
%
% \emph{兜底跟共享层走。} 先前这三条各自把兜底写成 \cs{space}（一个西文空格，
%  小四下 3.0），中文报告的题注因此排成「表2-1 叶轮主要参数表」只空 3.0；
% 原件与 iota-hit 的复刻件都是空一个字（12.0）。共享层的
% \cs{hit@caption@separator} 本来就按图表分、按语种分、兜底是
% \cs{hit@caption@separator@fallback}（有网格数就 \cs{hskip}\cs{ccwd}），
% 终稿那一份 \cs{@makecaption} 用的就是它，报告直接调同一个。
% \emph{\texttt{labelsep} 到不了正题注。} \file{hit-flow-deps.dtx} 在
% \pkg{subcaption}（它自己带进 \pkg{caption}）之后又加载了 \pkg{ccaption}，
% 而 \pkg{ccaption} 把 \cs{@makecaption} 整个换掉了，分隔符读的是它自己的
% \cs{@contdelim}。所以上面那两条声明发出去一直没作数，报告的题注从头到尾印的是
% \pkg{ccaption} 的默认值「\texttt{:~}」。这里补发一次 \cs{captiondelim}，
% 图与表按 \cs{@captype} 各读各的常量；两条旧声明留着，子题注那一头还走它们。
%
% 语言跟着文档走。先前这儿写死 \texttt{zh}——那会儿报告没有 \option{lang}，
% 现在有了。
%    \begin{macrocode}
\cs_new_protected:Npn \hit@report@declare@caption@separator:
  {
    \DeclareCaptionLabelSeparator { hit@figure@number } { \hit@caption@separator }
    \DeclareCaptionLabelSeparator { hit@table@number }  { \hit@caption@separator }
    \captiondelim { \hit@caption@separator }
  }
%    \end{macrocode}
%
% 深圳硕士中期把图注排成「图 1-1 标题」的格式。
%    \begin{macrocode}
\bool_lazy_and:nnT
  { \bool_if_p:N \g__hit_shenzhen_bool }
  {
    \bool_lazy_and_p:nn
      { \bool_if_p:N \g__hit_master_bool }
      { \bool_if_p:N \g__hit_interim_bool }
  }
  {
    \RequirePackage { caption }
    \hit@report@declare@caption@separator:
    \cs_set:Npn \thefigure { \thesection - \arabic { figure } }
    \captionsetup [ figure ] { labelsep=hit@figure@number }
  }
%    \end{macrocode}
%
% \emph{正文照 Word 排的那几档，题注都照 Word 的写法。} 编号按节走的只有两档：深圳本科
% 那两份（第一级写的是 \cs{section}、按章排，iota-hit 对原件的复刻件里中英两版都是
% 「图1-1」「Figure 1-1」）与照终稿排的威海硕士开题，与本部、威海的本科开题。别的报告
% 连续编号，「表1」，与 iota-hit 的 \texttt{report-caption-by-section} 同一张表。公式只有
% 照终稿排的两档按节编，本部与威海的本科开题图表按节、公式照报告连续编号，也照 iota-hit。
%    \begin{macrocode}
\bool_if:NT \g__hit_final_body_bool
  {
    \RequirePackage { caption }
    \hit@report@declare@caption@separator:
    \captionsetup [ figure ] { labelsep=hit@figure@number }
    \captionsetup [ table ]  { labelsep=hit@table@number }
  }
\bool_lazy_or:nnT
  {
    \bool_lazy_and_p:nn
      { \bool_if_p:N \g__hit_final_body_bool }
      { ! \bool_if_p:N \g__hit_harbin_report_bool }
  }
  {
    \bool_lazy_all_p:n
      {
        { \bool_if_p:N \g__hit_harbin_report_bool }
        { \bool_if_p:N \g__hit_bachelor_bool }
        { \bool_if_p:N \g__hit_proposal_bool }
      }
  }
  {
    \RequirePackage { caption }
    \hit@report@declare@caption@separator:
    \cs_set:Npn \thefigure { \thesection - \arabic { figure } }
    \cs_set:Npn \thetable { \thesection - \arabic { table } }
    \captionsetup [ figure ] { labelsep=hit@figure@number }
    \captionsetup [ table ]  { labelsep=hit@table@number }
    \@addtoreset { figure }   { section }
    \@addtoreset { table }    { section }
    \bool_if:NF \g__hit_harbin_report_bool
      {
        \cs_set:Npn \theequation { \thesection - \arabic { equation } }
        \@addtoreset { equation } { section }
      }
  }
  }
%</report-floats>
%    \end{macrocode}
%
% \Finale
