% \section{学位论文类的字体与字号}
% ^^A ======================================================================
% ^^A Module thesis-fonts: 正文字号、中英文主字体与字号宏命令（\wuhao 等）（hit-thesis）
% ^^A ======================================================================
%    \begin{macrocode}
%<*thesis-fonts>
%    \end{macrocode}
%
% \changes{v3.2a}{2026/08/12}{字体层主体抽到 \file{src/utils/hit-fonts.dtx}，
%   这里只留调用与本类特有的部分}
%
% \changes{v3.2a}{2026/08/14}{正文字号与行距改从 \cs{g\_hit\_body\_size\_dim}、
%   \cs{g\_hit\_body\_lead\_dim} 取，这里只给默认值，\option{format}/\option{body}
%   写了就盖掉}
% 正文的字号与行距。两个数在这里只是默认值，真正的取值由 \option{format} 的
% \option{body} 目标算出来，机制见 \file{src/utils/hit-format.dtx} 的「接到正文上」。
% \cs{normalsize} 每次执行都重读这两个长度，所以导言区里改得动。
%
% 20.50394\,bp 这个默认行距是旧版面的，来路是 v3.1e 的写法，与规范里
% 「多倍行距 1.25」算出来的 19.455\,bp 不是一个数。新版面下会被盖掉。
%    \begin{macrocode}
\hit@setup@fonts
\dim_gset:Nn \g_hit_body_size_dim { 12bp }
\dim_gset:Nn \g_hit_body_lead_dim { 20.50394bp }
\cs_new:Npn \hit@body@lead@skip:
  {
    \bool_if:NTF \g__hit_layout_two_bool
      { \hit@glue@skip{\dim_use:N \g_hit_body_lead_dim}{2.834646bp} }
      {
        \dim_use:N \g_hit_body_lead_dim
        \dim_compare:nNnF { \g_hit_body_stretch_dim } = { 0pt }
          { ~ plus ~ \dim_use:N \g_hit_body_stretch_dim }
      }
  }
\cs_set:Npn \normalsize
  {
    \@setfontsize \normalsize { \g_hit_body_size_dim }
      { \hit@body@lead@skip: }
    \abovedisplayskip = 8pt
    \abovedisplayshortskip = 8pt
    \belowdisplayskip = \abovedisplayskip
    \belowdisplayshortskip = \abovedisplayshortskip
  }
%</thesis-fonts>
%    \end{macrocode}
%
% \Finale
