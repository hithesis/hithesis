% \section{正文页眉：深圳博士}
%
% ^^A ======================================================================
% ^^A Module final-pagestyle-shenzhen-doctor: 正文页眉的深圳博士变体
% ^^A ======================================================================
%
% \changes{v3.2a}{2026/09/13}{深圳博士这一档的页眉单独成一个变体文件}
% 基准（博士加哈尔滨）在 \file{src/flow/hit-final-pagestyle.dtx}。这一份只写
% 与基准不同的那一小坨。
%
% 深圳的博士页眉印\emph{学科门类}，本部与威海印\emph{学位层次}——「哈尔滨工业大学工学博士学位论文」对「哈尔滨工业大学（深圳）……」那一处。偶数页那一行换一个词条，奇数页与基准一样。
%    \begin{macrocode}
%<*final-pagestyle-shenzhen-doctor>
\hit@hook@new:nn { headings-body-shenzhen-doctor }
  {
    \hit@header:nn { o } { \hit@header@font \leftmark }
    \hit@header:nn { e }
      {
        \hit@header@font \hit@term@header@university@zh
        \hit@term@header@degree@of@discipline@zh \hit@term@header@document@type
      }
  }
%</final-pagestyle-shenzhen-doctor>
%    \end{macrocode}
%
% \Finale
