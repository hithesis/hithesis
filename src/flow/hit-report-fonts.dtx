% \section{报告类的字体与字号}
% ^^A ======================================================================
% ^^A Module report-fonts: 正文字号、中英文主字体与字号宏命令（\wuhao 等）（hit-report）
% ^^A ======================================================================
%    \begin{macrocode}
%<*report-fonts>
%    \end{macrocode}
%
% \changes{v3.2a}{2026/08/12}{字体层主体抽到 \file{src/utils/hit-fonts.dtx}，
%   这里只留调用与本类特有的部分}
%
% \changes{v3.2a}{2026/08/14}{正文字号与行距改从 \cs{g\_hit\_body\_size\_dim}、
%   \cs{g\_hit\_body\_lead\_dim} 取，与学位论文类同一条路径}
% 正文字号与行距的默认值。深圳博士中期那一份行距是 15\,bp 且不给伸缩量，其余
% 20.50394\,bp。真正的取值由 \option{format} 的 \option{body} 目标算出来，
% 见 \file{src/utils/hit-format.dtx} 的「接到正文上」。
%    \begin{macrocode}
\hit@setup@fonts
\dim_gset:Nn \g_hit_body_size_dim { 12bp }
\hit@if@shenzhen@doctor@interim@TF
  {
    \dim_gset:Nn \g_hit_body_lead_dim { 15bp }
    \cs_set:Npn \normalsize
      {
        \@setfontsize \normalsize { \g_hit_body_size_dim }
          { \g_hit_body_lead_dim }
        \abovedisplayskip = 6pt
        \abovedisplayshortskip = 6pt
        \belowdisplayskip = \abovedisplayskip
        \belowdisplayshortskip = \abovedisplayshortskip
      }
  }
  {
    \dim_gset:Nn \g_hit_body_lead_dim { 20.50394bp }
    \cs_set:Npn \normalsize
      {
        \@setfontsize \normalsize { \g_hit_body_size_dim }
          { \hit@glue@skip{\dim_use:N \g_hit_body_lead_dim}{2.834646bp} }
        \abovedisplayskip = 8pt
        \abovedisplayshortskip = 8pt
        \belowdisplayskip = \abovedisplayskip
        \belowdisplayshortskip = \abovedisplayshortskip
      }
  }
%</report-fonts>
%    \end{macrocode}
%
% \Finale
