% \section{正文页眉：深圳硕士}
%
% ^^A ======================================================================
% ^^A Module final-pagestyle-shenzhen-master: 正文页眉的深圳硕士变体
% ^^A ======================================================================
%
% \changes{v3.2a}{2026/09/13}{深圳硕士这一档的页眉单独成一个变体文件}
% 基准（博士加哈尔滨）在 \file{src/flow/hit-final-pagestyle.dtx}。这一份只写
% 与基准不同的那一小坨。
%
% 深圳硕士的前置页面与正文页眉不一样：正文印学科门类那一句，前置印 \cs{leftmark}。判据是 \texttt{@mainmatter}，在页面排出来那一刻才问。
%    \begin{macrocode}
%<*final-pagestyle-shenzhen-master>
\hit@hook@new:nn { headings-body-shenzhen-master }
  {
    \legacy_if:nTF { @mainmatter }
      {
        \hit@header:nn { oe }
          {
            \hit@header@font \hit@term@header@university@zh
            \hit@term@header@degree@of@discipline@zh \hit@term@header@document@type
          }
      }
      { \hit@header:nn { oe } { \hit@header@font \leftmark } }
  }
%</final-pagestyle-shenzhen-master>
%    \end{macrocode}
%
% \Finale
