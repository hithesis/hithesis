%    \begin{macrocode}
%<*art-options>
% \changes{v3.2a}{0000/00/00}{加通用选择器 \cs{hit@if}，与 \file{hithesisbook.cls}
%   一致。}
% \cs{hit@if}\marg{flag}\marg{真}\marg{假} 按标志位二选一，
% \cs{hit@iffontset}\marg{名字}\marg{真}\marg{假} 比对 \option{fontset}，
% \cs{hit@ifnotempty}\marg{宏}\marg{真} 在宏非空时执行，
% \cs{hit@ifwider}\marg{长度}\marg{阈值}\marg{真}\marg{假} 比长度。
% \cs{hit@ifT}\marg{flag}\marg{真} 是只有真分支的那一半。封面里几个多条件判断
% 也各自取了名：\cs{hit@ifand} 两个标志位同时成立，\cs{hit@ifstage} 取「开题」
% 或「中期」，\cs{hit@ifwidema} 是威海或深圳的硕士，\cs{hit@ifszmaop} 是深圳硕士
% 开题，\cs{hit@ifhrbmastage} 是哈尔滨硕士的开题或中期。参数从 expl3 之外传
% 进来，里面的空格照原样保留；替换旧写法时注意 \cs{fi} 后面被跳过的那个空格。
%    \begin{macrocode}
\ExplSyntaxOn
\cs_new:Npn \hit@if #1#2#3 { \bool_if:cTF { g__hit_#1_bool } {#2} {#3} }
\cs_new:Npn \hit@ifT #1#2 { \bool_if:cT { g__hit_#1_bool } {#2} }
\cs_new:Npn \hit@iffontset #1#2#3
  { \str_if_eq:eeTF { \hit@fontset } {#1} {#2} {#3} }
\cs_new_protected:Npn \hit@ifnotempty #1#2 { \tl_if_empty:NF #1 {#2} }
\cs_new:Npn \hit@ifwider #1#2#3#4 { \dim_compare:nNnTF {#1} > {#2} {#3} {#4} }
\cs_new:Npn \hit@ifand #1#2#3#4
  {
    \bool_lazy_and:nnTF
      { \bool_if_p:c { g__hit_#1_bool } } { \bool_if_p:c { g__hit_#2_bool } } {#3} {#4}
  }
\cs_new:Npn \hit@ifstage
  {
    \bool_if:NTF \g__hit_opening_bool
      { \hit@stage@opening } { \hit@ifT { midterm } { \hit@stage@midterm } }
  }
\cs_new:Npn \hit@ifwidema #1
  {
    \bool_lazy_and:nnT
      {
        \bool_lazy_or_p:nn
          { \bool_if_p:N \g__hit_weihai_bool } { \bool_if_p:N \g__hit_shenzhen_bool }
      }
      { \bool_if_p:N \g__hit_master_bool }
      {#1}
  }
\cs_new:Npn \hit@ifszmaop #1#2
  {
    \bool_lazy_all:nTF
      {
        { \bool_if_p:N \g__hit_shenzhen_bool }
        { \bool_if_p:N \g__hit_master_bool }
        { \bool_if_p:N \g__hit_opening_bool }
      }
      {#1} {#2}
  }
\cs_new:Npn \hit@ifhrbmastage #1
  {
    \bool_lazy_all:nT
      {
        { \bool_if_p:N \g__hit_harbin_bool }
        { \bool_if_p:N \g__hit_master_bool }
        {
          \bool_lazy_or_p:nn
            { \bool_if_p:N \g__hit_opening_bool } { \bool_if_p:N \g__hit_midterm_bool }
        }
      }
      {#1}
  }
\cs_new:Npn \hit@ifhrbmastage@TF #1#2
  {
    \bool_lazy_all:nTF
      {
        { \bool_if_p:N \g__hit_harbin_bool }
        { \bool_if_p:N \g__hit_master_bool }
        {
          \bool_lazy_or_p:nn
            { \bool_if_p:N \g__hit_opening_bool } { \bool_if_p:N \g__hit_midterm_bool }
        }
      }
      {#1} {#2}
  }
\cs_new:Npn \hit@ifshenzhenmaop #1#2
  {
    \bool_lazy_all:nTF
      {
        { \bool_if_p:N \g__hit_shenzhen_bool }
        { \bool_if_p:N \g__hit_opening_bool }
        { \bool_if_p:N \g__hit_master_bool }
      }
      {#1} {#2}
  }
\cs_new:Npn \hit@ifharbinmaop #1#2
  {
    \bool_lazy_all:nTF
      {
        { \bool_if_p:N \g__hit_harbin_bool }
        { \bool_if_p:N \g__hit_opening_bool }
        { \bool_if_p:N \g__hit_master_bool }
      }
      {#1} {#2}
  }
\ExplSyntaxOff
%    \end{macrocode}
