%
% \changes{v3.2a}{0000/00/00}{补回 \pkg{aliasctr} 覆盖 \cs{@addtoreset} 时丢掉的
%   \cs{theH} 定义（\issue[183]）}
% \pkg{thmtools} 依赖的 \pkg{aliasctr} 用 \cs{renewcommand*} 平覆盖了内核的
% \cs{@addtoreset}，只保留计数器清零链，丢掉了内核同时生成的 \cs{theH} 定义。
% LaTeX 2024-11-01 起 \pkg{hyperref} 不再自己打这个补丁（\cs{hyper@nopatch@counter}
% 恒定义），于是 \pkg{subfigure}、\pkg{lstlisting} 和定理环境的 PDF 锚点都丢了章号
% 前缀。这里在保留 \pkg{aliasctr} 别名跟随行为的前提下把 \cs{theH} 补回去。
%    \begin{macrocode}
\ExplSyntaxOn
\cs_set_eq:NN \hit@org@addtoreset \@addtoreset
\cs_set:Npn \@addtoreset #1#2
  {
    \hit@org@addtoreset {#1} {#2}
    \cs_gset:cpx { theH #1 }
      { \exp_not:c { theH #2 } . \exp_not:N \the \exp_not:N \value {#1} }
  }
\ExplSyntaxOff
%    \end{macrocode}
%
% \changes{v3.2a}{0000/00/00}{定理环境的样式与声明收进 \cs{hit@thm@style} 与
%   \cs{hit@thm@list}，为 \issue[183] 换 \pkg{thmtools} 做准备。}
% 定理环境的内部接口。样式与声明分散在三处（全局样式、\file{cfg} 里的
% \env{proof}、十几个编号环境），换实现时要改的地方太多，先收到这里。
% \cs{hit@thm@style} 的键名按 \pkg{thmtools} 的叫法取，将来换实现只改这一处的
% 映射；\cs{hit@thm@list} 接一张「环境名 = 标题」的表，顺序即声明顺序。
%    \begin{macrocode}
\ExplSyntaxOn
\prop_new:N \g__hit_thm_opt_prop
\seq_new:N \g__hit_thm_order_seq
\tl_new:N \g__hit_thm_within_tl
\tl_new:N \g__hit_thm_optlist_tl
\tl_new:N \l__hit_thm_tmp_tl
\int_new:N \g__hit_thm_style_int
\tl_new:N \g__hit_thm_style_tl
\cs_new_protected:Npn \__hit_thm_opt:nn #1#2
  {
    \prop_if_in:NnF \g__hit_thm_opt_prop {#1}
      { \seq_gput_right:Nn \g__hit_thm_order_seq {#1} }
    \prop_gput:Nnn \g__hit_thm_opt_prop {#1} {#2}
  }
\cs_new_protected:Npn \__hit_thm_build:
  {
    \tl_gclear:N \g__hit_thm_optlist_tl
    \seq_map_inline:Nn \g__hit_thm_order_seq
      {
        \prop_get:NnN \g__hit_thm_opt_prop {##1} \l__hit_thm_tmp_tl
        \tl_gput_right:Nx \g__hit_thm_optlist_tl
          { ##1 = { \exp_not:V \l__hit_thm_tmp_tl } , }
      }
  }
%    \end{macrocode}
%
% \pkg{thmtools} 的样式键只认 \cs{declaretheoremstyle}，\cs{declaretheorem} 不吃。
% 所以每次改样式就生成一个新样式名，声明环境时引用它。名字带序号是因为
% \pkg{amsthm} 的 \cs{newtheoremstyle} 重名会报错。
%    \begin{macrocode}
\cs_new_protected:Npn \__hit_thm_newstyle:
  {
    \__hit_thm_build:
    \int_gincr:N \g__hit_thm_style_int
    \tl_gset:Nx \g__hit_thm_style_tl { hitthm \int_use:N \g__hit_thm_style_int }
    \use:x
      {
        \exp_not:N \declaretheoremstyle
          [ \exp_not:V \g__hit_thm_optlist_tl ] { \g__hit_thm_style_tl }
      }
    \use:x { \exp_not:N \theoremstyle { \g__hit_thm_style_tl } }
  }
\cs_new_protected:Npn \hit@thm@autorefname #1#2
  { \cs_gset:cpn { #1 autorefname } {#2} }
\cs_new_protected:Npn \hit@thm@declare #1#2
  {
    % \pkg{amsthm} 自带 proof，重名的先撤掉再声明
    \cs_undefine:c {#1} \cs_undefine:c { end #1 }
    \use:x
      {
        \exp_not:N \declaretheorem
          [
            style = \g__hit_thm_style_tl ,
            name = { \exp_not:n {#2} } ,
            \tl_if_empty:NF \g__hit_thm_within_tl
              { numberwithin = \exp_not:V \g__hit_thm_within_tl , }
          ]
          {#1}
      }
    \hit@thm@autorefname {#1} {#2}
  }
\cs_new_protected:Npn \hit@thm@declare@star #1#2
  {
    \cs_undefine:c {#1} \cs_undefine:c { end #1 }
    \use:x
      {
        \exp_not:N \declaretheorem
          [ style = \g__hit_thm_style_tl , name = { \exp_not:n {#2} } , numbered = no ]
          {#1}
      }
    \hit@thm@autorefname {#1} {#2}
  }
\keys_define:nn { hit / thm }
  {
    body-font   .code:n = { \__hit_thm_opt:nn { bodyfont }   {#1} } ,
    head-font   .code:n = { \__hit_thm_opt:nn { headfont }   {#1} } ,
    qed         .code:n = { \__hit_thm_opt:nn { qed }        {#1} } ,
    head-punct  .code:n = { \__hit_thm_opt:nn { headpunct }  {#1} } ,
    note-braces .code:n = { \__hit_thm_opt:nn { notebraces } {#1} } ,
    note-font   .code:n = { \__hit_thm_opt:nn { notefont }   {#1} } ,
    space-above .code:n = { \__hit_thm_opt:nn { spaceabove } {#1} } ,
    space-below .code:n = { \__hit_thm_opt:nn { spacebelow } {#1} } ,
    head-space  .code:n = { \__hit_thm_opt:nn { postheadspace } {#1} } ,
    head-indent .code:n = { \__hit_thm_opt:nn { headindent } {#1} } ,
    within .code:n = { \tl_gset:Nn \g__hit_thm_within_tl {#1} } ,
  }
\cs_new_protected:Npn \hit@thm@style #1
  { \keys_set:nn { hit / thm } {#1} \__hit_thm_newstyle: }
\cs_new_protected:Npn \hit@thm@list #1
  { \keyval_parse:nnn { \use_none:n } { \hit@thm@declare } {#1} }
%    \end{macrocode}
%
% \changes{v3.2a}{0000/00/00}{为 \pkg{ntheorem} 专有命令加兼容层（\issue[183]）}
% \pkg{ntheorem} 专有命令的兼容层。前四条能一一对应到 \cs{hitsetup} 的
% \option{theorem} 键，转发过去；后面几条 \pkg{thmtools} 没有对应写法，报个警告
% 后忽略。\cs{theoremstyle} 不动，那是 \pkg{amsthm} 自己的命令。
%    \begin{macrocode}
\cs_new_protected:Npn \__hit_thm_legacy:nnn #1#2#3
  {
    \__hit_warn_once:nnn {#1} { deprecated-ntheorem } {#2}
    \hit@thm@style { #2 = {#3} }
  }
\cs_new_protected:Npn \__hit_thm_dropped:nn #1#2
  { \__hit_warn_once:nnn {#1} { removed-ntheorem } {#2} }
\cs_new_protected:Npn \theorembodyfont #1
  { \__hit_thm_legacy:nnn { theorembodyfont } { body-font } {#1} }
