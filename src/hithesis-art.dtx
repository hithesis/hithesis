\ExplSyntaxOn
\bool_new:N \g_bib_authorupper_bool
\bool_set_false:N \g_bib_authorupper_bool
\keys_define:nn { hit / class }
  {
    bibauthorupper .code:n =
      {
        \str_if_eq:nnT {#1} {full}
