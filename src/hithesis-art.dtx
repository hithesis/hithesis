% \changes{v3.2a}{0000/00/00}{art-options 的三段选项校验改用 \cs{bool\_lazy\_any:nF}、
%   \cs{bool\_lazy\_or:nnF} 与 \cs{bool\_lazy\_all:nT}，嵌套的 \cs{relax}\cs{else}
%   链换成显式判断。报错文本含英文与空格，按 CONTRIBUTING §4.6 留在 expl3 之外。}
% 三段报错文本原样留在 expl3 之外，里面的空格与花括号都有意义。
%    \begin{macrocode}
\ExplSyntaxOn
\cs_new_protected:Npn \hit@art@error@type
  {
    \ClassError { hithesisart }
      {
        \MessageBreak Please~specify~thesis~type~in~option:~
        \MessageBreak type=[bachelor~|~master~|~doctor]~
      }
  }
\ExplSyntaxOff
\ExplSyntaxOn
\cs_new_protected:Npn \hit@art@error@stage
  {
    \ClassError { hithesisart }
      {
        \MessageBreak Please~specify~stage~in~option:~
        \MessageBreak stage=<opening|midterm>~
      }
  }
\ExplSyntaxOff
\ExplSyntaxOn
\cs_new_protected:Npn \hit@art@error@szdoctor
  {
    \ClassError { hithesisart }
      {
        \MessageBreak This~document~class~does~not~support~midterm~report~for~doctor~
        in~shenzhen~campus.~
        \MessageBreak please~use~\string\documentclass{hithesisartplus}~
      }
  }
\ExplSyntaxOff
\ExplSyntaxOn
\bool_lazy_any:nF
  {
    { \bool_if_p:N \g__hit_bachelor_bool }
    { \bool_if_p:N \g__hit_master_bool }
    { \bool_if_p:N \g__hit_doctor_bool }
  }
  { \hit@art@error@type }
\bool_lazy_or:nnF
  { \bool_if_p:N \g__hit_opening_bool }
  { \bool_if_p:N \g__hit_midterm_bool }
  { \hit@art@error@stage }
\bool_lazy_all:nT
  {
    { \bool_if_p:N \g__hit_doctor_bool }
    { \bool_if_p:N \g__hit_midterm_bool }
    { \bool_if_p:N \g__hit_shenzhen_bool }
  }
  { \hit@art@error@szdoctor }
\ExplSyntaxOff
%    \end{macrocode}
