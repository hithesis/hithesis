          {
            { windows } { \str_set:Nn \l__hit_cjk_font_str { windows } }
            { mac }     { \str_set:Nn \l__hit_cjk_font_str { mac } }
            { ubuntu }  { \str_set:Nn \l__hit_cjk_font_str { noto } }
            { fandol }  { \str_set:Nn \l__hit_cjk_font_str { fandol } }
