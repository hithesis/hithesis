\int_new:N \g_bib_maxauthor_int
\int_set:Nn \g_bib_maxauthor_int {3}
\keys_define:nn { hit / class }
  {
    bibmaxauthor .code:n =
      {
        \int_set:Nn \g_bib_maxauthor_int {#1}
        \int_if_zero:nT { \g_bib_maxauthor_int }
