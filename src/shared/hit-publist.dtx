% \iffalse meta-comment
%
% hit-publist.dtx 是各个类共用的发表论文列表
%
% \fi
%
% \section{共享发表论文列表}
%
% \changes{v3.2a}{0000/00/00}{\env{publist} 抽出来给各个类共用}
% \DescribeEnv{publist} 发表文章、专利、科研项目的编号列表，用法是
% \cs{begin}\marg{publist} 里逐条 \cs{item}。
% \changes{v3.2a}{0000/00/00}{art 与 artplus 也有 \env{publist} 了}
% 原来只有 \file{hithesisbook.cls} 定义，art 与 artplus 写不了这个列表。
% \changes{v3.2a}{0000/00/00}{\env{publist} 改用 \pkg{enumitem} 的 \cs{newlist}
%   实现，不再自己 \cs{newcounter}。用法与版面不变}
% 参数照搬原来那个 \env{list} 的设置。计数器由 \pkg{enumitem} 内部管，模板这边
% 就不必再造一个 LaTeX 计数器了。\cs{labelwidth} 原来没显式设过，靠的是
% \cs{leftmargin}\texttt{-}\cs{itemindent}\texttt{-}\cs{labelsep}，这里写明。
%
%    \begin{macrocode}
%<*shared-publist>
%    \end{macrocode}
%
% \begin{macro}{\hit@setup@publist}
% 标号的排法照搬内核 \env{list} 的 \cs{@mklab}：装进一个 \cs{labelwidth} 宽的盒子、
% 用 \cs{hfil} 顶到右边。\pkg{enumitem} 自带的 \texttt{align=right} 用的是 \cs{hss}，
% 标号超宽时会往左溢出，与原来相反。
%    \begin{macrocode}
\cs_new_protected:Npn \hit@setup@publist
  {
\SetLabelAlign{hit@pubright}{\hb@xt@\labelwidth{\hfil##1}}
\newlist{publist}{enumerate}{1}
\setlist[publist]{%
  label={[\arabic*]},
  leftmargin=1.7em,
  itemindent=0em,
  labelsep=0.5em,
  labelwidth=24pt,
  align=hit@pubright,
  rightmargin=0em,
  topsep=0ex,
  parsep=0ex,
  itemsep=0ex,
  listparindent=0pt,
  partopsep=3pt plus 1pt minus 1pt,
}
  }
%    \end{macrocode}
% \end{macro}
%
%    \begin{macrocode}
%</shared-publist>
%    \end{macrocode}
%
% \Finale
