  {
\bibpunct{[}{]}{,}{n}{,}{\hit@inline@separator}
  }

\citestyle{numerical}
\DeclareRobustCommand\inlinecite{\@inlinecite}
\cs_set:Npn \@inlinecite #1
  {
\group_begin: \citestyle{inline} \cs_set_eq:NN \@cite \NAT@citenum \citep{#1} \group_end:
  }
