%
% \changes{v3.2a}{0000/00/00}{字体层主体抽到 \file{src/utils/hit-fonts.dtx}，
%   这里只留调用与本类特有的部分}
%    \begin{macrocode}
\hit@setup@fonts
\hit@if@shenzhen@doctor@midterm@TF
  {
    \cs_set:Npn \normalsize
      {
        \@setfontsize \normalsize { 12bp } { 15bp }
        \abovedisplayskip = 6pt
        \abovedisplayshortskip = 6pt
        \belowdisplayskip = \abovedisplayskip
        \belowdisplayshortskip = \abovedisplayshortskip
      }
  }
  {
    \cs_set:Npn \normalsize
      {
        \@setfontsize \normalsize { 12bp } { \hit@glue@skip{20.50394bp}{2.834646bp} }
        \abovedisplayskip = 8pt
        \abovedisplayshortskip = 8pt
        \belowdisplayskip = \abovedisplayskip
        \belowdisplayshortskip = \abovedisplayshortskip
      }
  }
