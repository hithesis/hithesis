% \changes{v3.2a}{2026/09/13}{报告类从基础类白拿的那几条默认值显式写出来，
%   为换 \cls{ctexbook} 做准备}
% \emph{从基础类白拿的默认值，显式写一遍。} 下面这几条现在都是
% \cls{ctexart} 已有的默认值，抄一遍是恒等改写，一个像素都不该动。写出来是
% 为了接下来换 \cls{ctexbook}：那边这几条各不相同，到时候只要改这几行，
% 而不是在「底类换了」与「这一条没压住」之间猜。
%
% \begin{itemize}
% \item \cs{secnumdepth}：\cls{article} 是 3，\cls{book} 是 2。报告通篇没写过
%   这一句，一直白拿 3；不写死的话三级标题的编号会整个消失。
% \item \cs{thesection}：\cls{article} 是光节号，\cls{book} 带章号前缀。
% \item \cs{theHsection}：\pkg{hyperref} 的锚名，同理。印出来看不见，但书签
%   与交叉引用的目标名会变。
% \item \cs{pagestyle}：\cls{article} 末尾设 \texttt{plain}，\cls{book} 设
%   \texttt{headings}。报告只有深圳两处与威海硕士开题显式设过自家样式，
%   本部各档吃的是类默认值。
% \end{itemize}
%
% \changes{v3.2a}{2026/09/13}{底类换 \cls{ctexbook}；两个编号宏改成按章计数器
%   自适应，写了 \cs{chapter} 就带章号，没写就与从前一字不差}
% \emph{两个编号宏问的是「有没有章」，不是「哪个类」。}
% \cs{int\_compare:nNnT}\{\cs{c@chapter}\}\texttt{>}\{0\} 这一句：没写过
% \cs{chapter} 时章计数器停在零，编号就是光节号，与 \cls{ctexart} 下一字不差；
% 写了 \cs{chapter} 就自动带上章号。这不是我们发明的写法——\cls{book} 自己的
% \cs{thefigure}、\cs{thetable}、\cs{theequation} 就是
% \cs{ifnum}\cs{c@chapter}\texttt{>}\cs{z@} \cs{thechapter}\texttt{.}\cs{fi}，
% 只有 \cs{thesection} 没这么写，它无条件带章号。补上这一条之后，报告排不排章
% 就成了作者写不写 \cs{chapter} 的事，不需要选项，也不需要模板提前知道。
%    \begin{macrocode}
\setcounter { secnumdepth } { 3 }
\cs_set:Npn \thesection
  { \int_compare:nNnT { \c@chapter } > { 0 } { \thechapter . } \@arabic \c@section }
\AddToHook { begindocument }
  {
    \cs_set:Npn \theHsection
      {
        \int_compare:nNnT { \c@chapter } > { 0 } { \theHchapter . }
        \arabic { section }
      }
  }
\pagestyle { plain }
%    \end{macrocode}
%
% \changes{v3.2a}{2026/09/13}{\cs{appendix} 也按有没有章分岔：没写 \cs{chapter}
%   就改节号，写了就走 \cls{ctexbook} 原来那份改章号}
% \emph{\cs{appendix} 问的同样是「有没有章」。} \cls{article} 的 \cs{appendix}
% 置零节计数器、把 \cs{thesection} 改成 \cs{@Alph}\cs{c@section}；\cls{book} 那份
% 置零的是章计数器，改的是 \cs{thechapter}，一个字都没碰 \cs{thesection}。
% 换了底类又不管，报告里 \cs{appendix} 之后的节号会从 A 变回 1。
%
% 所以先看章计数器再决定走哪一边。判断要抢在调用底类那份\emph{之前}：
% \cls{book} 的 \cs{appendix} 头一件事就是把章计数器置零，调完再问，问到的
% 永远是零。
%
% \emph{编号的形状也跟着分。} \cs{CTEX@appendix@number} 是同一个宏，章那一支要
% \cs{@Alph}\cs{c@chapter}（\cls{ctexbook} 的默认值），节那一支要
% \cs{@Alph}\cs{c@section}，所以在分支里设，不在类加载时设死。
%    \begin{macrocode}
\cs_new_eq:NN \__hit_appendix_chapter: \appendix
\cs_gset_protected:Npn \appendix
  {
    \int_compare:nNnTF { \c@chapter } > { 0 }
      { \__hit_appendix_chapter: }
      {
        \ctexset { appendix / number = \@Alph \c@section }
        \setcounter { section } { 0 }
        \setcounter { subsection } { 0 }
        \cs_gset:Npn \thesection { \@Alph \c@section }
        \gdef \CTEX@presection { \CTEX@preappendix }
        \gdef \CTEX@thesection { \CTEX@appendix@number }
        \gdef \CTEX@postsection { \CTEX@postappendix }
        \gdef \CTEX@section@numbering { \CTEX@appendix@numbering }
      }
  }
%    \end{macrocode}
