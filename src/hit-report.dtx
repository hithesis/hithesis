% \changes{v3.2a}{0000/00/00}{\option{font} 与 \option{cjk-font} 改名
%   \option{font-en} 与 \option{font-cn}，与模板其余选项的中英后缀一致。旧名仍
%   生效，只在日志里提示}
%    \begin{macrocode}
\keys_define:nn { hit / class }
  {
    font     .tl_gset:c = { hit@font@en } ,
    cjk-font .tl_gset:c = { hit@font@cn } ,
  }
