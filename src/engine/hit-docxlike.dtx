          }
        { caption-table }
          {
            \__hit_docxlike_flag_eq:nnnn {#1} { capcenterlast }
              { pPr/jc } { last-line-centered }
          }
        { caption-sub }
          {
            \__hit_docxlike_flag_eq:nnnn {#1} { subcapcenterlast }
