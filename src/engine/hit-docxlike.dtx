    \tl_set:Nn \l__hit_heading_toc_tl {#6}
    \IfNoValueTF {#5}
      { \tl_put_left:Nn \l__hit_heading_local_tl { toc = {#6} , } }
      {
        \tl_if_in:nnTF {#5} { = }
          { \tl_put_left:Nn \l__hit_heading_local_tl { toc = {#6} , #5 , } }
          {
            \tl_put_left:Nn \l__hit_heading_local_tl { toc = {#5} , }
