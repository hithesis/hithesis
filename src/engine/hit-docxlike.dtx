          {
            \cs_if_exist:NT \ctex_update_ccglue:
              { \cs_set_eq:NN \ctex_update_ccglue: \prg_do_nothing: }
            \cs_if_exist:NT \ccwd { \dim_set_eq:NN \ccwd \g_docxlike_page_char_dim }
          }
      }
  }
%    \end{macrocode}
%
% \subsection{标题里的西文}
