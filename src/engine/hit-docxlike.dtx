            \__hit_docxlike_flag_eq:nnnn {#1} { heading_latin_sans } { rPr/rFonts/ascii } { Arial }
          }
        { Heading2 }
          { \__hit_docxlike_flag_eq:nnnn {#1} { heading_latin_sans } { rPr/rFonts/ascii } { Arial } }
        { Heading3 }
          { \__hit_docxlike_flag_eq:nnnn {#1} { heading_latin_sans } { rPr/rFonts/ascii } { Arial } }
        { Heading4 }
          { \__hit_docxlike_flag_eq:nnnn {#1} { heading_latin_sans } { rPr/rFonts/ascii } { Arial } }
        { caption-figure }
          {
            \__hit_docxlike_flag_eq:nnnn {#1} { capcenterlast }
