  }
\cs_new_protected:Npn \__hit_bilingual_listing_short:w [#1]#2\q_stop
  {\__hit_bilingual_listing_caption:nn{#1}{#2}}
\cs_new_protected:Npn \__hit_bilingual_listing_caption:nn #1#2
  {
    \hit@bilingual@value:nNN{#2}\l__hit_bilingual_heading_main_tl\l__hit_listing_en_tl
    \cs_set_nopar:Npe\lst@caption{\exp_not:V\l__hit_bilingual_heading_main_tl}
    \tl_if_eq:nnTF{#1}{\q_no_value}
      {\cs_set_eq:NN\lst@@caption\lst@caption}
      {\cs_set_nopar:Npn\lst@@caption{#1}}
