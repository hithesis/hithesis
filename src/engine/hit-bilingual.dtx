  }
\cs_new_protected:Npn \__hit_bilingual_subcaption:nnnn #1#2#3#4
  {
    \IfNoValueTF{#4}
      {
        \hit@bilingual@value:nNN{#3}\l__hit_bilingual_heading_main_tl\l__hit_bilingual_heading_other_tl
        \tl_if_empty:NT\l__hit_bilingual_heading_other_tl
          {\tl_set_eq:NN\l__hit_bilingual_heading_other_tl\c_novalue_tl}
      }
      {\hit@bilingual@command:nnNN{#3}{#4}\l__hit_bilingual_heading_main_tl\l__hit_bilingual_heading_other_tl}
    \tl_set:Nn\l__hit_bilingual_short_tl{#2}
    \tl_if_eq:nnT{#2}{#3}
      {\tl_set_eq:NN\l__hit_bilingual_short_tl\l__hit_bilingual_heading_main_tl}
    \use:e{\exp_not:N\hit@bilingual@original@subcaption
      \IfBooleanT{#1}{*}\IfNoValueF{#2}{[\exp_not:V\l__hit_bilingual_short_tl]}
      {\exp_not:V\l__hit_bilingual_heading_main_tl}}
    \exp_args:NV \tl_if_novalue:nF \l__hit_bilingual_heading_other_tl
      {
        \bool_if:NT \g__hit_bilingual_caption_bool
          {\use:e{\exp_not:N\hit@bilingual@original@subcaption*{\exp_not:V\l__hit_bilingual_heading_other_tl}}}
      }
  }
