%
% \section{共享双语题注}
%
% \changes{v4.0a}{2026/10/06}{双语题注统一为 \cs{caption} 的尾随副语言参数，输入方向可局部交换，中英文共用编号，
%   英文不重复写入清单；支持短标题、无编号题注和 \cs{figurenote}，旧 \cs{bicaption} 保留兼容}
% \changes{v4.0a}{2026/10/06}{题注字体与行距由样式控制，额外间距默认归零；
%   \option{float-blank} 配置图表前后空段，\option{float-sep} 配置浮动体间距}
%
% 前置可选参数是清单短标题，尾随可选参数是英文题注：
% \begin{latex}
% \caption{中文题}
% \caption{中文题}[English caption]
% \caption[目录用短标题]{中文题}[English caption]
% \end{latex}
% 前置参数为清单短标题，尾随参数为副语言题注。
%
% 英文题注受 \option{caption-bilingual} 控制，默认值按学位选择。
%
% \cs{bicaption} 只兼容 v3.1e 已发布的 ccaption 参数形式。
%
%    \begin{macrocode}
%<*shared-caption>
%    \end{macrocode}
%
% 浮动体间距在文档开始时设置，避免被后加载的宏包覆盖；题注额外 skip 为零。
% 浮动体前后间距补丁参考 \texttt{tuna/thuthesis\#614}。
% 此处退出 expl3，以保留 \cs{patchcmd} 匹配文本中的普通空格；
% 补丁须等相关宏包完成重定义后再应用。
%    \begin{macrocode}
\ExplSyntaxOff
\AtBeginDocument{%
  \setlength{\floatsep}{12bp \@plus 2bp \@minus 2bp}%
  \setlength{\textfloatsep}{12bp \@plus 2bp \@minus 2bp}%
  \setlength{\intextsep}{12bp \@plus 2bp \@minus 2bp}%
  \setlength{\@fptop}{0bp \@plus 1fil}%
  \setlength{\@fpsep}{12bp \@plus 2fil}%
  \setlength{\@fpbot}{0bp \@plus 1fil}%
  \captionsetup{skip=0pt,tableposition=top,figureposition=bottom}%
  \patchcmd{\@addtocurcol}%
    {\vskip \intextsep}%
    {\edef\hit@save@first@penalty{\the\lastpenalty}\unpenalty
     \ifnum \lastpenalty = \@M
       \unpenalty
     \else
       \penalty \hit@save@first@penalty \relax
     \fi
     \ifnum\outputpenalty <-\@Mii
       \addvspace\intextsep
       \vskip\parskip
     \else
       \addvspace\intextsep
     \fi}%
    {}{\ClassWarningNoLine{hithesis}{补丁 \string\@addtocurcol 之一没打上}}%
  \patchcmd{\@addtocurcol}%
    {\vskip\intextsep \ifnum\outputpenalty <-\@Mii \vskip -\parskip\fi}%
    {\ifnum\outputpenalty <-\@Mii
       \aftergroup\vskip\aftergroup\intextsep
       \aftergroup\nointerlineskip
     \else
       \vskip\intextsep
     \fi}%
    {}{\ClassWarningNoLine{hithesis}{补丁 \string\@addtocurcol 之二没打上}}%
  \patchcmd{\@getpen}{\@M}{\@Mi}%
    {}{\ClassWarningNoLine{hithesis}{补丁 \string\@getpen 没打上}}%
}
\ExplSyntaxOn
%    \end{macrocode}
%
% \begin{macro}{\hit@setup@caption}
% 在 \texttt{begindocument/end} 接管 \cs{caption}，晚于 caption 与 ccaption 的
% \cs{AtBeginDocument} 重定义。
%
% \cs{\_\_hit\_bicaption:w} 存的是 \pkg{ccaption} 的原形，这个在类文件里存就行；
% \cs{hit@original@caption} 存的是接管前那条完整的 \cs{caption} 链。
%    \begin{macrocode}
\bool_new:N \g__hit_bilingual_caption_bool
\bool_new:N \g__hit_bilingual_caption_auto_bool
\bool_gset_true:N \g__hit_bilingual_caption_auto_bool
%    \end{macrocode}
%
% 双语题注的 auto 值按学位决定：博士、博士后开启，本科、硕士关闭。
%    \begin{macrocode}
\keys_define:nn { hit / styles }
  {
    bilingual-caption .choice: ,
    bilingual-caption / true .code:n =
      {
        \bool_gset_false:N \g__hit_bilingual_caption_auto_bool
        \bool_gset_true:N \g__hit_bilingual_caption_bool
      } ,
    bilingual-caption / false .code:n =
      {
        \bool_gset_false:N \g__hit_bilingual_caption_auto_bool
        \bool_gset_false:N \g__hit_bilingual_caption_bool
      } ,
    bilingual-caption / auto .code:n =
      { \bool_gset_true:N \g__hit_bilingual_caption_auto_bool } ,
    bilingual-caption .default:n = { true } ,
  }
%    \end{macrocode}
%
% 主语言题注负责编号和清单条目；副语言只排文字，不修改计数器或引用标签。
%    \begin{macrocode}
%    \end{macrocode}
%
% 英文题注局部使用西文字体度量，避免中文行盒抬高行距。
%    \begin{macrocode}
\cs_new_protected:Npn \hit@caption@latin@pick:
  {
    \bool_if_exist:NT \l_docxlike_format_latin_pick_bool
      { \bool_set_true:N \l_docxlike_format_latin_pick_bool }
    \cs_if_exist:NT \docxlike_format_latin_chars:n
      { \docxlike_format_latin_chars:n { \c_true_bool } }
  }
\cs_new_protected:Npn \hit@bilingual@caption #1#2#3
  {
    \hit@single@caption {#1} {#2}
    \hit@caption@repeat:nn
      { \exp_args:No \hit@caption@secondary@name:n {\@captype} } {#3}
  }
\cs_new_protected:Npn \hit@caption@repeat:nn #1#2
  {
    \group_begin:
      \bool_if:NF \g__hit_en_bool { \hit@caption@latin@pick: }
      \cs_set:cpn { \@captype name } {#1}
      \@makecaption { \use:c { fnum@ \@captype } } {#2}
    \group_end:
  }
\cs_new_protected:Npn \hit@single@caption #1#2
  {
    \tl_if_novalue:nTF {#1}
      { \hit@original@caption {#2} }
      { \hit@original@caption [#1] {#2} }
  }
\bool_new:N \l_hit_caption_star_bool
\cs_new_protected:Npn \hit@star@caption #1#2
  {
    \group_begin:
      \bool_set_true:N \l_hit_caption_star_bool
      \hit@original@caption * {#1}
      \bool_lazy_and:nnT
        { ! \tl_if_novalue_p:n {#2} }
        { \g__hit_bilingual_caption_bool }
        {
          \bool_if:NF \g__hit_en_bool {\hit@caption@latin@pick:}
          \hit@original@caption * {#2}
        }
    \group_end:
  }
%    \end{macrocode}
%
% \begin{macro}{\hit@float@sep:}
% 显式设置 float-sep 时，用固定长度覆盖默认浮动体间距。
%    \begin{macrocode}
\cs_new_protected:Npn \hit@float@sep:
  {
    \tl_if_empty:NF \g__hit_float_sep_tl
      {
        \skip_set:Nn \intextsep    { \g__hit_float_sep_tl }
        \skip_set:Nn \textfloatsep { \g__hit_float_sep_tl }
        \skip_set:Nn \floatsep     { \g__hit_float_sep_tl }
      }
  }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\hit@setup@float@blank}
% 在图表浮动盒内部插入配置的前后空段，页首和页尾也保留。
%    \begin{macrocode}
\cs_new_protected:Npn \__hit_float_blank:n #1
  {
    \tl_if_exist:cT { g__hit_float_blank_ #1 _tl }
      {
        \tl_if_empty:cF { g__hit_float_blank_ #1 _tl }
          {
            \par
            \use:e
              {
                \exp_not:N \hitenter *
                  [ \exp_not:v { g__hit_float_blank_ #1 _tl } ]
              }
          }
      }
  }
\cs_new_protected:Npn \__hit_float_blank_hook:nn #1#2
  { \AddToHook { env / #1 / end } { \__hit_float_blank:n { #2 -below } } }
\cs_new_protected:Npn \hit@setup@float@blank
  {
    \tl_gput_right:Nn \@floatboxreset
      {
        \cs_if_exist:NT \@captype
          { \__hit_float_blank:n { \@captype -above } }
      }
    \__hit_float_blank_hook:nn { figure } { figure }
    \__hit_float_blank_hook:nn { figure* } { figure }
    \__hit_float_blank_hook:nn { table } { table }
    \__hit_float_blank_hook:nn { table* } { table }
  }
%    \end{macrocode}
% \end{macro}
%
% 中文图表名与编号之间只保留自动中西文间距，英文名称后保留空格。
%
% \cs{caption} 的接管。给了尾随的英文题、并且开关没关死，才走双语。
%
% 星号题注不编号、不写清单；需显式标记以阻止自定义 makecaption 再次输出标签。
%    \begin{macrocode}
\cs_new_protected:Npn \hit@setup@caption
  {
    \hit@setup@float@blank
    \AddToHook { begindocument/end }
      {
    \hit@float@sep:
    \bool_if:NF \g__hit_en_bool
      {
        \cs_set:Npn \fnum@figure { \figurename \thefigure }
        \cs_set:Npn \fnum@table { \tablename \thetable }
      }
    \bool_if:NT \g__hit_bilingual_caption_auto_bool
      {
        \bool_gset_eq:NN \g__hit_bilingual_caption_bool \g__hit_doctor_bool
        \bool_if_exist:NT \g__hit_postdoc_bool
          {
            \bool_if:NT \g__hit_postdoc_bool
              { \bool_gset_true:N \g__hit_bilingual_caption_bool }
          }
      }
    \cs_set_eq:NN \hit@original@caption \caption
    \RenewDocumentCommand \caption { s o +m o }
      {
        \IfBooleanTF {##1}
          { \hit@star@caption {##3} {##4} }
          {
            \IfNoValueTF {##4}
              { \hit@single@caption {##2} {##3} }
              {
                \bool_if:NTF \g__hit_bilingual_caption_bool
                  { \hit@bilingual@caption {##2} {##3} {##4} }
                  { \hit@single@caption {##2} {##3} }
              }
          }
      }
%    \end{macrocode}
%
% 仅保留 v3.1e 的 ccaption 写法：可选标签、短题、中文题、英文名称、英文题。
%    \begin{macrocode}
    \RenewDocumentCommand \bicaption { o +m +m +m +m }
      {
        \__hit_bicaption_legacy:nnnn {##1} {##2} {##3} {##4} {##5}
      }
      }
  }
\cs_new_protected:Npn \__hit_bicaption_legacy:nnnn #1#2#3#4#5
  {
    \msg_warning:nn { hithesis } { bicaption-five-args }
    \tl_if_blank:nTF {#2}
      { \hit@original@caption {#3} }
      { \hit@original@caption [#2] {#3} }
    \tl_if_novalue:nF {#1} { \label {#1} }
    \hit@caption@repeat:nn {#4} {#5}
  }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\figurenote}
% 使用 caption-note 样式排图注，调用位置在图题之前。
% 开头的 par 不可省略：段落格式中的 nointerlineskip 只能用于竖直模式。
%    \begin{macrocode}
\NewDocumentCommand \figurenote { m }
  { \par \docxlike_format_par:nn { caption-note } {#1} }
%    \end{macrocode}
% \end{macro}
%
% \emph{题号与题名之间的间隔。} 图题表题各读一个常量，常量为空退回兜底值：
% 有网格时一律一个汉字宽（\cs{ccwd}，题注贴字符网格，一个字就是一格）；没有网格的
% （普通报告）照 v3.1e，本科一个字宽、其余 \cs{enskip}。图还是表看 \cs{@captype}；
% \cs{LT@makecaption} 那条路上它也是有的，取不到就按图算。
%
% 题注间隔在共享模块中定义，供终稿、报告和长表共同使用。
%    \begin{macrocode}
\cs_new:Npn \__hit_caption_separator:nn #1#2
  {\bool_if:nTF {#1} {\hskip #2} {\enskip}}
\cs_new:Npn \hit@caption@separator@fallback
  {
    \__hit_caption_separator:nn
      {\dim_compare_p:nNn {\g_docxlike_page_lead_dim} > {\c_zero_dim}
       || \bool_if_p:N \g__hit_bachelor_bool}
      {\ccwd}
  }
\cs_new:Npn \hit@caption@number@lang:
  { \bool_if:NTF \g__hit_en_bool { en } { zh } }
\cs_new:Npn \hit@caption@type:
  { \cs_if_exist:NTF \@captype { \@captype } { figure } }
%    \end{macrocode}
%
% \cs{hit@caption@font:} 按图还是表挑目标，从 \option{styles} 表取字号、行距、
% 贴不贴网格。表里没取值（普通报告）就退回 \cs{wuhao}，行距跟着
% \cs{wuhao} 自带的 1.3 倍走，与 v3.1e 一样。
%    \begin{macrocode}
%    \end{macrocode}
%
% 按浮动体类型选择题注样式；星号题注只输出题名。
%    \begin{macrocode}
\cs_new_protected:Npn \hit@makecaption:nn #1#2
  {
    \bool_if:NTF \l_hit_caption_star_bool
      { \__hit_make_caption:n {#2} }
      { \__hit_make_caption:n { #1 \hit@caption@separator #2 } }
  }
\cs_new_protected:Npn \__hit_make_caption:n #1
  {
    \par
    \tex_global:D \@minipagefalse
    \exp_args:Ne \docxlike_format_par:nn { caption- \hit@caption@type: } {#1}
  }
\cs_new_protected:Npn \hit@caption@font:
  {
    \docxlike_format_apply_font_else:en { caption- \hit@caption@type: } { \wuhao }
  }
\cs_new:Npn \hit@caption@separator
  {
    \str_if_eq:eeTF { \hit@caption@type: } { table }
      {
        \hit@after@number:nnn { table@caption } { \hit@caption@number@lang: }
          { \hit@caption@separator@fallback }
      }
      {
        \hit@after@number:nnn { figure@caption } { \hit@caption@number@lang: }
          { \hit@caption@separator@fallback }
      }
  }
%</shared-caption>
%    \end{macrocode}
