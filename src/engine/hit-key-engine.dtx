% \iffalse meta-comment
%
% hit-key-engine.dtx 是各个类共用的键机制：\hitsetup 入口、键族、常量与字段的声明
%
% \fi
%
% \section{键机制（engine）}
%
% \changes{v3.2a}{2026/10/09}{条件后缀支持乱序输入和规范化，增加同轴重复、未知条件及
%   同组规范键冲突检查；支持为已有词条添加变体，保留正负条件的匹配权重。}
% \changes{v3.2a}{2026/10/06}{配置解析支持统一双语值、斜杠路径、条件覆盖和旧名提示；
%   词条按部件及文档类型选择，支持跨词条引用，缺失取值时报告错误}
%
% 本模块定义配置解析和存储函数；公开字段在 \file{hit-keylist.dtx} 注册。
% 类选项检查需要完整的旧名映射表，由注册完成后的调用者执行。
%
%    \begin{macrocode}
%<*shared-key-engine>
%    \end{macrocode}
%
% \begin{macro}{\hit@declare@class@key,\hit@define@term}
% \cs{hit@declare@class@key}\marg{名} 把一个键注册进 \texttt{hit/class} 族，处理器直接
% 调用同名命令。\cs{hit@define@term}\marg{名} 在此之上再造出那个同名命令：
% 设值器写入模板自己的 token-list 变量，并导出原有读取宏；字段声明时先置空值。
%    \begin{macrocode}
\cs_new_protected:Npn \hit@declare@class@key #1
  { \keys_define:nn { hit / class } { #1 .code:n = { \use:c {#1} {##1} } } }
% Same storage implementation as l3refactor; only the exported-name prefix differs.
\tl_const:Nn \c__hit_info_prefix_tl {hit@info@}
\prop_new:N \g__hit_info_exports_prop
\cs_new_protected:Npn \__hit_info_export:n #1
  {
    \cs_gset_nopar:cpe {\c__hit_info_prefix_tl #1}
      {\exp_not:v {g__hit_info_#1_tl}}
    \exp_args:NNe \prop_gput:Nnn \g__hit_info_exports_prop
      {\c__hit_info_prefix_tl #1} {g__hit_info_#1_tl}
  }
\cs_new_protected:Npn \__hit_info_set:nn #1#2
  {
    \tl_if_exist:cF {g__hit_info_#1_tl}
      {\tl_new:c {g__hit_info_#1_tl}}
    \tl_gset:cn {g__hit_info_#1_tl} {#2}
    \__hit_info_export:n {#1}
  }
\cs_new_protected:Npn \__hit_info_define:nn #1#2
  {
    \cs_gset_nopar:cpn {#1} ##1
      {\__hit_info_set:nn {#2} {##1}}
    \use:c {#1} {}
  }
\cs_new_protected:Npn \__hit_define_term:nn #1#2
  {\__hit_info_define:nn {#1} {#2}}
\cs_new_protected:Npn \hit@define@term #1
  {
    \hit@declare@class@key {#1}
    \__hit_key_to_macro_name:n {#1}
    \exp_args:Nnx \__hit_define_term:nn {#1} { \l__hit_constant_name_str }
  }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\hit@define@legacy@terms}
% 元信息字段在 v3.1e 就是公开接口，改名后旧名要继续能用。
% \cs{hit@define@legacy@terms}\marg{旧名=新名,\ldots} 给每个旧名做三件事：把同名命令
% 指向新字段的设值器、把旧键注册进 \texttt{hit/class} 族、往改名表里记一条，
% 这样用户写旧名时会收到一次提示，告诉他新名叫什么。
%    \begin{macrocode}
\prop_new:N \l__hit_legacy_term_prop
\cs_new_protected:Npn \hit@define@legacy@term #1#2
  {
    \cs_gset_eq:cc {#1} {#2}
    \hit@declare@class@key {#1}
    \prop_gput:Nnn \g__hit_renamed_option_prop {#1} { info={#2=...} }
  }
%    \end{macrocode}
%
% \cs{hit@define@legacy@constant}\marg{旧名}\marg{常量键}：有些旧名对应的现在是
% 常量而不是元信息字段（\cs{cstudenttype} 就是），转发到 \cs{hitsetup} 的
% \option{overrides} 族。
%    \begin{macrocode}
\cs_new_protected:Npn \hit@define@legacy@constant #1#2
  {
    \cs_gset_protected_nopar:cpn {#1} ##1
      { \hit@set@constant { #2 = {##1} } }
    \hit@declare@class@key {#1}
    \prop_gput:Nnn \g__hit_renamed_option_prop {#1} { overrides={#2=...} }
  }
\cs_new_protected:Npn \hit@define@legacy@terms #1
  {
    \prop_set_from_keyval:Nn \l__hit_legacy_term_prop {#1}
    \prop_map_function:NN \l__hit_legacy_term_prop \hit@define@legacy@term
  }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\hit@define@term@alias}
% \cs{hit@define@term@alias}\marg{别名}\marg{正名} 也是把两个名字接到同一个设值器上，
% 但不进改名表，所以写哪个都不提示。跟 \cs{hit@define@legacy@term} 的区别在于
% 定位：那个是「旧名，该改了」，这个是「两个名字都对」。
% 学号写 \option{student-id} 还是 \option{student-number} 全看习惯，没有哪个更规范。
%    \begin{macrocode}
\cs_new_protected:Npn \hit@define@term@alias #1#2
  {
    \cs_gset_eq:cc {#1} {#2}
    \hit@declare@class@key {#1}
  }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\hit@define@date@term}
% \cs{hit@define@date@term}\marg{键名}\marg{样式} 与 \cs{hit@define@term}
% 并列，区别在取值那一头：原值使用同一个 token-list 存储器，导出带 \texttt{@raw}
% 后缀的兼容宏；排版时从原值变量取内容，再按样式和输入精度格式化。
%    \begin{macrocode}
\cs_new_protected:Npn \__hit_define_date_term:nnn #1#2#3
  {
    \__hit_info_define:nn {#1} {#2@raw}
    \cs_gset_protected_nopar:cpn { hit@info@#2 }
      {
        \tl_set_eq:Nc \l__hit_date_raw_tl {g__hit_info_#2@raw_tl}
        \hit@date@use:nnV {#1} {#3} \l__hit_date_raw_tl
      }
  }
\cs_generate_variant:Nn \__hit_define_date_term:nnn { nxn }
\cs_new_protected:Npn \hit@define@date@term #1#2
  {
    \hit@declare@class@key {#1}
    \__hit_key_to_macro_name:n {#1}
    \__hit_define_date_term:nxn
      {#1} { \l__hit_constant_name_str } {#2}
  }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\hit@parse@keywords}
% \cs{hit@parse@keywords}\marg{字段名}\marg{分隔符宏名} 造出 \cs{keywords-zh}\marg{甲,乙,丙}，
% 把逗号表拼成关键词内容，词与词之间插一个分隔符。排版版保存当时的分隔符内容，
% 避免额外的宏打断 xeCJK 标点字符对；PDF 属性版保留 \cs{use:c} 引用。
% 分隔符的名字显式传进来，不从字段名拼——两者的命名规律不一样。
%
% 同时另存一份 \cs{hit@}\meta{字段}\cs{@plain}：每项去掉首尾空格，词之间只有分隔符，
% 没有 \cs{ignorespaces}。这一份给 PDF 属性用——那条路上 \cs{ignorespaces} 不能执行，
% 屏蔽掉之后示例里 \texttt{\{\string\hologo{TeX}, \string\hologo{LaTeX}\}} 逗号后的空格就会漏进
% 元数据，排出来的版面却是没有空格的，两处对不上。两版共用保留空项及分组的序列拼接器，
% 由调用方指定修剪条目两端空格；维护版传入不同策略，保留 v3.1e 的原记号和分隔符写法。
%    \begin{macrocode}
\seq_new:N \l__hit_keywords_seq
\cs_new_protected:Npn \__hit_keywords_join:NNnnn #1#2#3#4#5
  {
    \seq_set_split_keep_spaces:Nnn #1 {,} {#4}
    \seq_map_inline:Nn #1
      {
        \tl_if_empty:NF #2 {\tl_gput_right:Nn #2 {#3}}
        \bool_if:nTF {#5}
          {\tl_gput_right:Ne #2 {\tl_trim_spaces:n {##1}}}
          {\tl_gput_right:Nn #2 {##1}}
      }
  }
\cs_generate_variant:Nn \__hit_keywords_join:NNnnn {Nc, NcnV, NcV}
\tl_new:N \l__hit_keywords_separator_tl
\cs_new_protected:Npn \__hit_parse_keywords:nnn #1#2#3
  {
    \cs_gset_nopar:cpn { hit@info@#3 } { }
    \cs_gset_nopar:cpn { hit@info@#3@plain } { }
    \cs_gset_protected_nopar:cpn {#1} ##1
      {
        % Word/xeCJK output keeps the literal separator and trims item edges;
        % PDF metadata retains a dynamic separator reference.
        \tl_set:Nv \l__hit_keywords_separator_tl {hit@term@#2}
        \__hit_keywords_join:NcVnn
          \l__hit_keywords_seq {hit@info@#3}
          \l__hit_keywords_separator_tl {##1} {\c_true_bool}
        \__hit_keywords_join:Ncnnn
          \l__hit_keywords_seq {hit@info@#3@plain}
          {\use:c {hit@term@#2}} {##1} {\c_true_bool}
      }
  }
\cs_new_protected:Npn \hit@parse@keywords #1#2
  {
    \hit@declare@class@key {#1}
    \__hit_key_to_macro_name:n {#1}
    \exp_args:Nnnx \__hit_parse_keywords:nnn {#1} {#2} { \l__hit_constant_name_str }
  }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\hitsetup}
% 先占个位，各个类在自己的 meta 模块末尾用 \cs{RenewDocumentCommand} 接管。
%    \begin{macrocode}
\cs_new_protected:Npn \hitsetup #1 { }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\hit@keys@set:nn}
% 在每层键值表中删除键之间的 \cs{par}，避免空行成为键名的一部分。
% \cs{tl\_replace\_all:Nnn} 不进入花括号，因而保留值内的段落。子组也须通过本函数解析。
%    \begin{macrocode}
\tl_new:N \l__hit_keys_list_tl
\cs_new_protected:Npn \hit@keys@set:nn #1#2
  {
    \tl_set:Nn \l__hit_keys_list_tl {#2}
    \tl_replace_all:Nnn \l__hit_keys_list_tl { \par } { }
    \exp_args:NnV \keys_set:nn {#1} \l__hit_keys_list_tl
  }
%    \end{macrocode}
% \end{macro}
%
% 未识别的键转给旧接口。转发前展开键名，值保持原记号。
%    \begin{macrocode}
\cs_new_protected:Npn \__hit_legacy_key:n #1
  {
    \__hit_legacy_warn:
    \use:x
      { \exp_not:N \keys_set:nn { hit / class } { \l_keys_key_str = { \exp_not:n {#1} } } }
  }
\clist_map_inline:nn { info-internal , style , toc , gb7714 , overrides-internal }
  { \keys_define:nn { hit / #1 } { unknown .code:n = { \__hit_legacy_key:n {##1} } } }
%    \end{macrocode}
%
% 双语内容先由统一解析器分语言，再写入内部存储。
%
%    \begin{macrocode}
\cs_new_protected:Npn \hit@warn@renamed@environment #1#2
  { \__hit_warn_once:nnn {#1} { renamed-environment } {#2} }
\cs_new_protected:Npn \hit@warn@renamed@command #1#2
  { \__hit_warn_once:nnn {#1} { renamed-command } {#2} }
\cs_new_protected:Npn \hit@warn@renamed@to:nn #1#2
  { \__hit_warn_once:nnn {#1} { renamed-to-command } {#2} }
%    \end{macrocode}
%
% 词条按部件分组。各页可以分别设置同一字段的标签，跨页共用的文字放在 \texttt{base}。
%
% \begin{latex}
% \hitsetup{ overrides = {
%   titlepage = { supervisor = {导师}[Supervisor] },
%   base = { university = {哈尔滨工业大学} },
% } }
% \end{latex}
%
% 部件前缀与语言由解析器补齐，调用方只填写字段名和双语内容。
%
% 公开分组 \texttt{achievements}、\texttt{references}、\texttt{defense} 分别映射到内部
% 前缀 publications、bibliography、resolution。分组转发和完整键名共用同一份词条存储。
%
% 另外四个不在部件表里：\texttt{base} 是跨页共用的那一档，
% \texttt{header}、\texttt{caption} 是页眉与图表题，\texttt{titlepage} 是内封——
% 内封与封面原先合成一个 \texttt{cover} 部件，词条得分开。
%
% 部件分组名优先匹配，词条名不能与其重名。
%    \begin{macrocode}
\clist_const:Nn \c__hit_bucket_clist
  {
    base , header , caption , titlepage , algorithm , degree-type , number-separator ,
    cover , abstract , denotation ,
    list-of-symbols , list-of-abbreviations ,
    list-of-symbols-and-abbreviations , table-of-contents ,
    list-of-figures , list-of-tables , list-of-equations ,
    mainmatter , conclusions , bibliography ,
    appendix , publications , resolution , index , declarations ,
    acknowledgements , resume ,
  }
\tl_new:N \l__hit_bucket_name_tl
% 标准 LaTeX 名称在 overrides 中也使用部件名；别名只转发设值，不另存一份。
\prop_const_from_keyval:Nn \c__hit_named_term_prop
  {
    caption-figure = figurename,
    caption-table = tablename,
    mainmatter-chapter-name = chapter-name,
    appendix-heading = appendixname,
    table-of-contents-heading = contentsname,
    list-of-figures-heading = listfigurename,
    list-of-tables-heading = listtablename,
    list-of-equations-heading = listequationname,
    list-of-equations-entry-name = equationname,
  }
\prop_const_from_keyval:Nn \c__hit_term_key_alias_prop
  {
    abstract-title = abstract-heading,
    appendix-title = appendix-heading,
    table-of-contents-title = table-of-contents-heading,
    list-of-figures-title = list-of-figures-heading,
    list-of-tables-title = list-of-tables-heading,
    list-of-equations-title = list-of-equations-heading,
    list-of-equations-equation = list-of-equations-entry-name,
    list-of-symbols-title = list-of-symbols-heading,
    list-of-abbreviations-title = list-of-abbreviations-heading,
    list-of-symbols-and-abbreviations-title = list-of-symbols-and-abbreviations-heading,
    references-title = bibliography-heading,
    bibliography-title = bibliography-heading,
    index-title = index-heading,
    conclusions-title = conclusions-heading,
    acknowledgements-title = acknowledgements-heading,
    resume-title = resume-heading,
    achievements-title = publications-heading,
    achievements-doctoral-title = publications-doctoral-heading,
    publications-title = publications-heading,
    publications-doctoral-title = publications-doctoral-heading,
    defense-title = resolution-heading,
    defense-column-title = resolution-title,
    declarations-title = declarations-heading,
    declarations-title-line-one-bachelor = declarations-heading-line-one-bachelor,
    declarations-title-line-two-bachelor = declarations-heading-line-two-bachelor,
    declarations-title-bachelor = declarations-heading-bachelor,
    declarations-title-short-bachelor = declarations-heading-short-bachelor,
    cover-imprint = cover-bottommark,
    cover-imprint-graduate = cover-bottom-mark-graduate,
    cover-imprint-harbin-master = cover-school-bottom-mark-harbin-master,
    cover-imprint-harbin-doctor = cover-school-bottom-mark-harbin-doctor,
    cover-report-imprint-shenzhen = cover-report-bottommark-shenzhen,
    number-separator-chapter = after-chapter-number,
    number-separator-section = after-section-number,
    number-separator-subsection = after-subsection-number,
    number-separator-subsubsection = after-subsubsection-number,
    number-separator-figure-caption = after-figure-caption-number,
    number-separator-table-caption = after-table-caption-number,
    header-sz = header-report-text-shenzhen,
    cover-sz-university = cover-report-university-shenzhen,
    cover-sz-affiliation = cover-report-affiliation-shenzhen,
    cover-sz-major = cover-report-major-shenzhen,
    cover-sz-supervisor = cover-report-supervisor-shenzhen,
    cover-sz-student = cover-report-student-shenzhen,
    cover-sz-id = cover-report-student-id-shenzhen,
    cover-sz-date = cover-report-date-shenzhen,
    cover-sz-mark = cover-report-bottommark-shenzhen,
  }
\cs_new:Npn \__hit_bucket_internal:n #1
  {
    \str_case:nnF {#1}
      { {references}{bibliography} {achievements}{publications} {defense}{resolution} }
      {#1}
  }
\tl_new:N \l__hit_term_alias_target_tl
\tl_new:N \l__hit_term_alias_base_tl
\seq_new:N \l__hit_term_alias_seq
\cs_generate_variant:Nn \regex_extract_once:nnNT { nV }
\cs_new_protected:Npn \__hit_term_key_resolve:N #1
  {
    \prop_get:NVNTF \c__hit_term_key_alias_prop #1 \l__hit_term_alias_target_tl
      { \tl_set_eq:NN #1 \l__hit_term_alias_target_tl }
      {
        \regex_extract_once:nVNT { \A (.*) - (zh|en) \Z } #1 \l__hit_term_alias_seq
          {
            \tl_set:Nx \l__hit_term_alias_base_tl { \seq_item:Nn \l__hit_term_alias_seq {2} }
            \prop_get:NVNT \c__hit_term_key_alias_prop \l__hit_term_alias_base_tl \l__hit_term_alias_target_tl
              { \tl_set:Nx #1 { \l__hit_term_alias_target_tl - \seq_item:Nn \l__hit_term_alias_seq {3} } }
          }
      }
  }
\cs_new_protected:Npn \__hit_bucket_key:nnnn #1#2#3#4
  {
    \tl_set:Ne \l__hit_bucket_name_tl { \__hit_bucket_internal:n {#1} - #3 }
    \tl_if_empty:nF {#2} { \tl_put_right:Nn \l__hit_bucket_name_tl { - #2 } }
    \exp_args:NnV \keys_if_exist:nnTF { hit / overrides-internal } \l__hit_bucket_name_tl
      {
        \use:x
          {
            \exp_not:N \keys_set:nn { hit / overrides-internal }
              { \l__hit_bucket_name_tl = { \exp_not:n {#4} } }
          }
      }
      { \__hit_bucket_from_base:nnnn {#1} {#2} {#3} {#4} }
  }
%    \end{macrocode}
%
% 部件中未声明的字段可从 base 创建局部覆盖，两处均未声明时报告错误。
%    \begin{macrocode}
\tl_new:N \l__hit_bucket_base_tl
\cs_new_protected:Npn \__hit_bucket_from_base:nnnn #1#2#3#4
  {
    \tl_set:Nn \l__hit_bucket_base_tl { base - #3 }
    \tl_if_empty:nF {#2} { \tl_put_right:Nn \l__hit_bucket_base_tl { - #2 } }
    \exp_args:NnV \keys_if_exist:nnTF { hit / overrides-internal } \l__hit_bucket_base_tl
      {
        \exp_args:NV \hit@declare@constant \l__hit_bucket_name_tl
        \use:x
          {
            \exp_not:N \keys_set:nn { hit / overrides-internal }
              { \l__hit_bucket_name_tl = { \exp_not:n {#4} } }
          }
      }
      {
        \msg_warning:nnV { hithesis } { key-not-in-bucket }
          \l__hit_bucket_name_tl
      }
  }
\cs_new_protected:Npn \__hit_bucket_unknown:nnn #1#2#3
  {
    \tl_if_empty:nTF{#2}
      {\group_begin:
       \tl_set:Nn\l__hit_bilingual_override_bucket_tl{#1}
       \use:e{\exp_not:N\__hit_bilingual_override:nn{\l_keys_key_str}{\exp_not:n{#3}}}
       \group_end:}
      {
    \use:x
      {
        \exp_not:N \__hit_bucket_key:nnnn
          {#1} {#2} { \l_keys_key_str } { \exp_not:n {#3} }
      }
      }
  }
\cs_new:Npn \__hit_bucket_public:n #1
  {
    \str_case:nnF {#1}
      {
        { bibliography } { references }
        { publications } { achievements }
        { resolution }   { defense }
      }
      {#1}
  }
\cs_new_protected:Npn \__hit_declare_bucket:nn #1#2
  {
    \keys_define:nn { hit / overrides / #1 }
      { unknown .code:n = { \__hit_bucket_unknown:nnn {#2} { } {##1} } }
    \keys_define:nn { hit / overrides }
      { #1 .code:n = { \hit@keys@set:nn { hit / overrides / #1 } {##1} } }
  }
\cs_generate_variant:Nn \__hit_declare_bucket:nn { en }
\clist_map_inline:Nn \c__hit_bucket_clist
  {
    \__hit_declare_bucket:en { \__hit_bucket_public:n {#1} } {#1}
  }
\cs_new_protected:Npn \__hit_bucket_moved:nn #1#2
  {
    \keys_define:nn { hit / overrides }
      { #1 .code:n = { \__hit_family_moved:nn { overrides/#1 } { 改用~overrides/#2。 } } }
  }
\clist_map_inline:nn
  { { bibliography } { references } , { publications } { achievements } , { resolution } { defense } }
  { \__hit_bucket_moved:nn #1 }
%    \end{macrocode}
%
% 三态取值。选项可取 \texttt{auto}、\texttt{true}、\texttt{false}，也可以按学位分别
% 指定；\texttt{auto} 的含义由各选项自己定义，在用到的时候才解析。分学位映射里没
% 列到的学位保持 \texttt{auto}，不是 \texttt{false}。
%    \begin{macrocode}
\tl_new:N \l__hit_tristate_tl
