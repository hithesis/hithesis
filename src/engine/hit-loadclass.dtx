%
% \section{加载基础文档类}
%
% \changes{v4.0a}{2026/09/28}{两条装配线的 \cs{LoadClass} 合成一份。底类：正文照 Word 排的文档在
%   \hologo{LuaLaTeX} 与 \hologo{XeLaTeX} 下是 \cls{book}，不装 \pkg{ctex}（标题、目录、题注、列表都已交给
%   \pkg{docxlike}，中文字族、字号与字距由共享中文层设置）；仅 \hologo{pdfLaTeX}
%   为 \pkg{CJK} 中文后端保留 \cls{ctexbook}。
%   报告从基础类白拿的默认值显式写出来，节号与 \cs{appendix} 照 \cls{article}；\cs{paragraph}、
%   \cs{subparagraph} 报错（规范只到款）}
%
% ^^A ======================================================================
% \changes{v4.0a}{2026/10/08}{保留上游中文后端：Unicode 引擎使用 book，
%   pdfLaTeX 由 ctexbook 初始化 CJK；具体版式仍由模板与 docxlike 控制。}
% ^^A Module shared-loadclass: 基础类与中文后端初始化
% ^^A ======================================================================
%    \begin{macrocode}
%<*shared-loadclass>
%    \end{macrocode}
%
% Unicode 引擎使用 \cls{book} 与共享中文层；pdfTeX 保留 \cls{ctexbook} 的 CJK 初始化。
%
% 单双面及其他基础类选项由选项模块解析，此处统一转发。
%    \begin{macrocode}
\bool_if:NTF \g__hit_ctex_base_bool
  {
    \exp_args:No \PassOptionsToClass { \g__hit_base_class_options_clist } { ctexbook }
    \LoadClass [ a4paper , UTF8 , zihao = -4 , scheme = plain ] { ctexbook }
  }
  {
    \exp_args:No \PassOptionsToClass { \g__hit_base_class_options_clist } { book }
    \hit@cjk@before@class:
    \LoadClass [ a4paper , 12pt ] { book }
    \hit@cjk@base:
  }
\bool_gset_true:N \g__hit_base_class_loaded_bool
%    \end{macrocode}
%
% \subsection{报告默认设置}
%
% 报告显式恢复 article 的节级编号、锚点和页面样式默认值。
%
% \begin{itemize}
% \item \cs{secnumdepth}：\cls{article} 是 3，\cls{book} 是 2。报告通篇没写过
%   这一句，一直白拿 3；不写死的话三级标题的编号会整个消失。
% \item \cs{thesection}：\cls{article} 是光节号，\cls{book} 带章号前缀。
% \item \cs{theHsection}：\pkg{hyperref} 的锚名，同理。印出来看不见，但书签
%   与交叉引用的目标名会变。
% \item \cs{pagestyle}：\cls{article} 末尾设 \texttt{plain}，\cls{book} 设
%   \texttt{headings}。报告只有深圳两处与威海硕士开题显式设过自家样式，
%   本部各档吃的是类默认值。
% \end{itemize}
%
% \emph{报告里没有章。} 作者写的 \cs{chapter} 在报告里排成节（见
% \file{src/flow/hit-report-heading.dtx} 的标题层级），章计数器始终停在零，所以
% 节号就是光节号，与 \cls{ctexart} 下一字不差，锚名同理。
%    \begin{macrocode}
\bool_if:NF \g__hit_final_bool
  {
    \setcounter { secnumdepth } { 3 }
    \cs_set:Npn \thesection { \@arabic \c@section }
    \AddToHook { begindocument }
      { \cs_set:Npn \theHsection { \arabic { section } } }
    \pagestyle { plain }
%    \end{macrocode}
%
% \emph{\cs{appendix} 照 \cls{article} 的样子改节。} \cls{article} 的 \cs{appendix}
% 置零节计数器、把 \cs{thesection} 改成 \cs{@Alph}\cs{c@section}；\cls{book} 那份
% 置零的是章计数器，改的是 \cs{thechapter}，一个字都没碰 \cs{thesection}。
% 换了底类又不管，报告里 \cs{appendix} 之后的节号会从 A 变回 1。
%    \begin{macrocode}
    \cs_gset_protected:Npn \appendix
      {
        \setcounter { section } { 0 }
        \setcounter { subsection } { 0 }
        \cs_gset:Npn \thesection { \@Alph \c@section }
      }
  }
%    \end{macrocode}
%
% 报告附录也由自有标题层排版，不再修改 ctex 私有编号宏。
%    \begin{macrocode}
%    \end{macrocode}
%
% \subsection{款以下不许写}
%
% 规范的标题只到款（终稿的第四级、报告的第三级），再往下是项，写列表。
% \cs{paragraph}、\cs{subparagraph} 在 \cls{book} 里有定义、默认不编号，照旧
% 放行就是静默排出一个规范里没有的层级，所以一律报错。出错之后照原来的
% 定义排，后面的内容照常编下去。
%    \begin{macrocode}
\cs_new_eq:NN \hit@paragraph@original \paragraph
\cs_new_eq:NN \hit@subparagraph@original \subparagraph
\cs_gset_protected:Npn \paragraph
  {
    \msg_error:nnn { hithesis } { heading-too-deep } { paragraph }
    \hit@paragraph@original
  }
\cs_gset_protected:Npn \subparagraph
  {
    \msg_error:nnn { hithesis } { heading-too-deep } { subparagraph }
    \hit@subparagraph@original
  }
%    \end{macrocode}
%
% \cs{titlepage} 同时是底类环境的入口和题名页部件名。\cs{begin} 先设置当前环境名，
% 因此可以保留环境的原定义，而正文里的命令交给部件排版，不会递归进入外封。
%    \begin{macrocode}
\cs_new_eq:NN \hit@original@titlepage \titlepage
\RenewDocumentCommand \titlepage { O{} }
  {
    \str_if_eq:eeTF { \@currenvir } { titlepage }
      { \hit@original@titlepage }
      { \__hit_titlepage_command:n {#1} }
  }
\RenewDocumentCommand \maketitle { O{} }
  {
    \hit@warn@renamed@to:nn { maketitle } { titlepage }
    \titlepage [#1]
  }
%    \end{macrocode}
%
%    \begin{macrocode}
%</shared-loadclass>
%    \end{macrocode}
