% \subsection{\hologo{pdfTeX} 下没有年份的条目}
%
% pdfTeX 下中文年份标签会展开为控制序列；此时跳过 natbib 的逐字符年份拆分，避免字符码错误。
%    \begin{macrocode}
\sys_if_engine_pdftex:T
  {
    \AddToHook { package / natbib / after }
      {
        \cs_new_eq:NN \__hit_bib_nat_parse_date:w \NAT@parse@date
        \cs_set:Npn \NAT@parse@date #1#2#3#4#5#6 @@
          {
            \token_if_cs:NTF #1
              {
                \cs_set_eq:NN \NAT@year \NAT@date
                \cs_set:Npn \NAT@exlab { }
              }
              { \__hit_bib_nat_parse_date:w #1#2#3#4#5#6 @@ }
          }
      }
  }
%    \end{macrocode}
