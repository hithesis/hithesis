% \iffalse meta-comment
%
% hit-hyperlink.dtx 是各个类共用的 hyperref 配置
%
% \fi
%
% \section{共享超链接配置}
%
% \changes{v3.2a}{2026/10/09}{用户加载独立 wiseref 后，通过公开配置接口接入现有词条、
%   章节名称和公式括号，不自动加载或分发引用实现。}
% \changes{v3.2a}{2026/09/27}{\hologo{pdfLaTeX} 下不开 \texttt{CJKbookmarks}：那一支是给 \pkg{CJK} 的 GBK 编码用的，UTF-8 下书签照常}
% \changes{v3.2a}{2026/08/31}{hyperref 的配置抽出来共用；题目、作者、关键词写进 PDF 属性；
%   \cs{enskip} 在书签里换成空格（英文章名每份都报 Token not allowed）；钉住
%   \cs{Urlmuskip}；封面与报告目录不打页锚（与摘要、正文首页重名，按页码的链接跳到封面）}
%
% 配置 PDF 书签、链接样式、URL 断行和元数据。
%
%    \begin{macrocode}
%<*shared-hyperlink>
% wiseref 由用户显式加载；模板只通过公开接口配置名称和编号格式。
\cs_new_protected:Npn \__hit_wiseref_setup:
  {
    \wiserefsetup{lang={\bool_if:NTF\g__hit_en_bool{en}{zh}}}
    \wiserefsetup{
      figure={prefix={\figurename\hit@wiseref@gap:},suffix={}},
      subfigure={prefix={\figurename\hit@wiseref@gap:},suffix={}},
      table={prefix={\tablename\hit@wiseref@gap:},suffix={}},
      subtable={prefix={\tablename\hit@wiseref@gap:},suffix={}},
      equation={prefix={\equationautorefname\hit@wiseref@gap:},suffix={},
        number-format={\hit@wiseref@equation:n{##1}}},
      chapter={prefix={\__hit_heading_term:nn{chapter-name}{1}},suffix={\__hit_heading_term:nn{chapter-name}{2}}},
      appendix={prefix={\appendixname\hit@wiseref@gap:},suffix={}},
      algocf={prefix={\hit@wiseref@algorithm:\hit@wiseref@gap:},suffix={}},
      lstlisting={prefix={\hit@wiseref@listing:\hit@wiseref@gap:},suffix={}},
    }
    \clist_map_inline:nn
      {assumption,definition,proposition,lemma,theorem,axiom,corollary,exercise,example,remark,problem,conjecture}
      {
        \cs_if_exist:cT {##1autorefname}
          {\wiserefsetup{##1={prefix={\use:c{##1autorefname}\hit@wiseref@gap:},suffix={}}}}
      }
  }
\cs_new:Npn \hit@wiseref@gap: {\bool_if:NT\g__hit_en_bool{\nobreakspace}}
\cs_new_protected:Npn \hit@wiseref@equation:n #1
  {\textup{\cs_if_exist:NTF\hit@equation@paren@left
    {\hit@equation@paren@left #1\hit@equation@paren@right}{(#1)}}}
\cs_new:Npn \hit@wiseref@algorithm:
  {\use:c{hit@term@caption@algorithm@\bool_if:NTF\g__hit_en_bool{en}{zh}}}
\cs_new:Npn \hit@wiseref@listing:
  {\use:c{hit@term@caption@listing@\bool_if:NTF\g__hit_en_bool{en}{zh}}}
\IfPackageLoadedTF{wiseref}
  {\AddToHook{class/hithesis/after}[hithesis/wiseref]{\__hit_wiseref_setup:}}
  {\AddToHook{package/wiseref/after}[hithesis/wiseref]{\__hit_wiseref_setup:}}
%    \end{macrocode}
%
% \begin{macro}{\hit@setup@hyperlink}
% \texttt{colorlinks=false} 加 \texttt{pdfborder=0 0 0}：屏幕上不上色也不画框，
% 打印出来与正文一致。\texttt{CJKbookmarks} 让中文书签不乱码（\hologo{pdfLaTeX} 下不写：那一支是给
% \pkg{CJK} 的 GBK 编码用的，\pkg{ctex} 自己只在 GBK 下打开它，UTF-8 下书签照常），
% \texttt{bookmarksopenlevel=1} 只展开到章。
%    \begin{macrocode}
\cs_new_protected:Npn \hit@setup@hyperlink
  {
\RequirePackage{hyperref}
% 引用名称从词条取值，后续修改 overrides 时无需再同步一份名称。
\cs_set:Npn \figureautorefname { \figurename }
\cs_set:Npn \tableautorefname { \tablename }
\cs_set:Npn \equationautorefname
  { \bool_if:NTF \g__hit_en_bool
      { \hit@term@caption@equation@en } { \hit@term@caption@equation@zh } }
\sys_if_engine_pdftex:F { \hypersetup { CJKbookmarks=true } }
\hypersetup{%
  linktoc=all,
  bookmarksnumbered=true,
  bookmarksopen=true,
  bookmarksopenlevel=1,
  breaklinks=true,
  colorlinks=false,
  plainpages=false,
  pdfborder=0~0~0
}
\urlstyle{same}
%    \end{macrocode}
% 在宏包初始化后统一 URL 伸缩量和断点集，避免 gbt7714 版本差异改变断行。
%    \begin{macrocode}
\AddToHook { begindocument / end }
  {
    \Urlmuskip = 0 mu \scan_stop:
    \cs_if_exist:NF \__xeCJK_use_ecglue_skip:
      {
        \cs_set_nopar:Npn \UrlBreaks
          {
            \do \. \do \@ \do \\ \do \/ \do \! \do \_ \do \|
            \do \; \do \> \do \] \do \) \do \, \do \? \do \&
            \do \' \do + \do \= \do \#
          }
      }
  }
%    \end{macrocode}
% 封面关闭页锚，避免重置页码后与正文产生同名链接目标。
%    \begin{macrocode}
\AddToHook { env / titlepage / begin } { \hypersetup { pageanchor = false } }
  }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\hit@setup@pdf@metadata}
% 排封面时写入 PDF 元数据；标题须使用不含分组控制命令的版本。
%
% \cs{pdfstringdefDisableCommands} 是 \pkg{hyperref} 给的钩子，在把记号转成 PDF
% 字符串时生效，把 \cs{\textbackslash\textbackslash} 与 \cs{enskip} 换成空格。
% 后者出现在英文版的章名里（\option{chapter-name} 取 \texttt{Chapter\string\enskip,}），
% 不声明的话 \pkg{hyperref} 照样会换成空格，但要报一条警告。关键词取的是
% \cs{hit@keywords@zh@plain}——那一份没有 \cs{ignorespaces}，词之间只有分隔符，
% 与排出来的版面一致。关键词只有 \file{hit-thesis.cls} 有，所以先探一下。
%    \begin{macrocode}
\cs_new_protected:Npn \hit@setup@pdf@metadata
  {
    \pdfstringdefDisableCommands
      {
        \cs_set:Npn \\ { ~ }
        \cs_set:Npn \enskip { ~ }
        \cs_set:Npn \hithesis { hiThesis }
      }
  }
\cs_new_protected:Npn \hit@write@pdf@metadata
  {
    \hit@part@info@global:n
      {
        \hypersetup
          {
            pdftitle  = { \hit@info@title@cover@zh } ,
            pdfauthor = { \hit@info@author@zh } ,
          }
        \cs_if_exist:cT { hit@info@keywords@zh }
          { \hypersetup { pdfkeywords = { \use:c { hit@info@keywords@zh@plain } } } }
      }
  }
%    \end{macrocode}
% \end{macro}
%
%    \begin{macrocode}
%</shared-hyperlink>
%    \end{macrocode}
