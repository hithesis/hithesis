% \option{degree-level} 也没有这个取值，所以只要扫到它就按学位论文类派发，\option{kind}
% 写什么都不看，不写也行。旧名 \option{type}\texttt{=postdoc} 一样管用。显式写了别的
% \option{kind} 时在日志里说一句，不写就静默。
%
% \option{kind} 只能写在 \cs{documentclass} 上，挪不进导言区：\cs{LoadClass} 得在
% 类文件里执行完，而 \cs{hitsetup} 是导言区的事，那时候基础类早装上了。
%
% \cs{documentclass}\marg{hit-thesis} 与 \cs{documentclass}\marg{hit-report}
% 照旧能用，它们才是真正的类，派发类只是转发。
%
% 读 \option{kind} 得赶在 \cs{LoadClass} 之前，所以自己扫一遍
% \cs{@classoptionslist}，不走 \pkg{l3keys}。
%
% \changes{v3.2a}{2026/08/11}{\option{kind} 原样转给报告类，派发类不再翻译成
%   \option{stage}}
% 扫到的 \option{kind} 原样转给 \file{hit-report}，它认这个键；
% \file{hit-thesis} 不认，转发时剔掉。
%    \begin{macrocode}
%<*dispatch>
\NeedsTeXFormat{LaTeX2e}[2022/06/01]
\ProvidesClass{hithesis}
  [2026/08/07 v3.2a Harbin Institute of Technology Thesis Template]
\ExplSyntaxOn
\tl_new:N \g__hit_kind_tl
\tl_gset:Nn \g__hit_kind_tl { thesis }
\bool_new:N \g__hit_kind_report_bool
\bool_new:N \g__hit_kind_given_bool
\bool_new:N \g__hit_degree_postdoc_bool
\cs_new_protected:Npn \__hit_kind_scan:w #1 = #2 = #3 \q_stop
  {
    \str_if_eq:eeT { \tl_trim_spaces:n {#1} } { kind }
      {
        \bool_gset_true:N \g__hit_kind_given_bool
        \tl_gset:Nx \g__hit_kind_tl { \tl_trim_spaces:n {#2} }
      }
    \str_if_eq:eeT { \tl_trim_spaces:n {#1} } { degree-level } { \__hit_degree_scan:n {#2} }
    \str_if_eq:eeT { \tl_trim_spaces:n {#1} } { type }  { \__hit_degree_scan:n {#2} }
  }
\cs_new_protected:Npn \__hit_degree_scan:n #1
  {
    \str_if_eq:eeT { \tl_trim_spaces:n {#1} } { postdoc }
      { \bool_gset_true:N \g__hit_degree_postdoc_bool }
  }
\cs_if_exist:NT \@classoptionslist
  {
    \exp_args:NV \clist_map_inline:nn \@classoptionslist
      { \__hit_kind_scan:w #1 = = \q_stop }
  }
%    \end{macrocode}
%
% \changes{v3.2a}{2026/08/11}{\option{kind}\texttt{!=mid-term} 作为
%   \option{kind}\texttt{!=interim} 的别名}
% \option{kind}\texttt{=mid-term} 与 \option{kind}\texttt{=interim} 等价。
% 「中期」的英文两种拼法都常见，认哪个都行，不必让用户去记我们选了哪个。
% 这是别名不是废弃名，两个都是正式写法，写哪个都不提示。
%
% \changes{v3.2a}{2026/08/11}{\option{degree-level}\texttt{!=postdoc} 直接定死
%   \option{kind}\texttt{!=thesis}。博士后只有研究报告一种交付物，没有开题与中期，
%   写了别的 \option{kind} 原先会一路炸到丢掉 \cs{begin\{document\}}}
% 博士后不写开题与中期，所以 \option{degree-level}\texttt{=postdoc} 一出现就按学位论文类
% 派发，\option{kind} 写什么都不看。显式写了别的取值时在日志里说一句，不写就静默。
%    \begin{macrocode}
\msg_new:nnn { hithesis } { postdoc-forces-thesis }
  {
    degree-level=postdoc~与~kind=#1~冲突，按~kind=thesis~处理。 \\
    博士后只有研究报告一种交付物，没有开题与中期。
  }
\bool_if:NT \g__hit_degree_postdoc_bool
  {
    \bool_lazy_and:nnT
      { \bool_if_p:N \g__hit_kind_given_bool }
      { ! \str_if_eq_p:Vn \g__hit_kind_tl { thesis } }
      { \msg_warning:nnV { hithesis } { postdoc-forces-thesis } \g__hit_kind_tl }
    \tl_gset:Nn \g__hit_kind_tl { thesis }
  }
\msg_new:nnn { hithesis } { unknown-kind }
  {
    kind~只能取~thesis、proposal~或~interim，收到的是~#1。 \\
    这一份按~kind=thesis~处理。
  }
\str_case:VnF \g__hit_kind_tl
  {
    { thesis } { }
    { proposal } { \bool_gset_true:N \g__hit_kind_report_bool }
    { interim }  { \bool_gset_true:N \g__hit_kind_report_bool }
    { mid-term } { \bool_gset_true:N \g__hit_kind_report_bool }
  }
  { \msg_warning:nnV { hithesis } { unknown-kind } \g__hit_kind_tl }
\cs_new_protected:Npn \__hit_forward_option:w #1 = #2 = #3 \q_stop #4
  {
    \bool_if:NTF \g__hit_kind_report_bool
      { \PassOptionsToClass {#4} { hit-report } }
      {
        \str_if_eq:eeF { \tl_trim_spaces:n {#1} } { kind }
          { \PassOptionsToClass {#4} { hit-thesis } }
      }
  }
\cs_new_protected:Npn \__hit_forward_option:n #1
  { \__hit_forward_option:w #1 = = \q_stop {#1} }
\cs_new_protected:Npn \hit@forward@option
  { \exp_args:NV \__hit_forward_option:n \CurrentOption }
\cs_new_protected:Npn \hit@load@target
  {
    \bool_if:NTF \g__hit_kind_report_bool
      { \LoadClass { hit-report } }
      { \LoadClass { hit-thesis } }
  }
\ExplSyntaxOff
\DeclareOption*{\hit@forward@option}
\ProcessOptions\relax
\hit@load@target
%</dispatch>
%    \end{macrocode}
