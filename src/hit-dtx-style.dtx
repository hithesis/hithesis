% \changes{v3.2a}{0000/00/00}{长链接允许在任意字母数字后断行。同 \pkg{thuthesis}}
% 长链接允许在任意字母数字之后断行。手册里最长的一条是 130 个字符的百分号编码
% 地址，不给断点就整条压出版心。\cs{Urlmuskip} 给链接内部一点点可伸缩量，
% 断不开时也不至于把整行撑坏。
%    \begin{macrocode}
\g@addto@macro\UrlBreaks{%
  \do0\do1\do2\do3\do4\do5\do6\do7\do8\do9%
  \do\A\do\B\do\C\do\D\do\E\do\F\do\G\do\H\do\I\do\J\do\K\do\L\do\M
  \do\N\do\O\do\P\do\Q\do\R\do\S\do\T\do\U\do\V\do\W\do\X\do\Y\do\Z
  \do\a\do\b\do\c\do\d\do\e\do\f\do\g\do\h\do\i\do\j\do\k\do\l\do\m
  \do\n\do\o\do\p\do\q\do\r\do\s\do\t\do\u\do\v\do\w\do\x\do\y\do\z
}
\Urlmuskip=0mu plus 0.1mu
%    \end{macrocode}
%
% \changes{v3.2a}{0000/00/00}{\cs{file} 的路径允许在分隔符处断行。
%   \file{src/pages/hit-thesis-backmatter.dtx} 这种 40 多字符的路径原先是一个
%   不可断的整体，行尾遇上就压出版心}
% \cs{file} 排的路径允许在 \texttt{/}、\texttt{-}、\texttt{.} 之后断行。
% \pkg{thuthesis} 那边用的是 \cs{nolinkurl}，我们用不了：它要 verbatim 抓参数，
% 而本仓库在 \cs{changes} 的文本里写 \cs{file}，那里参数早已记号化，
% 换上去手册直接塌成 4 页、100 个错。试过了。
%
% 所以自己插断点：逐个记号扫过去，遇上三个分隔符之一就补一个 \cs{allowbreak}。
% 全仓 306 处 \cs{file} 的参数都是字面路径，没有宏，扫得动。
%    \begin{macrocode}
\newcommand*\hit@file@breakable[1]{%
  \@tfor\hit@file@tok:=#1\do{%
    \hit@file@tok
    \expandafter\hit@file@sep\expandafter{\hit@file@tok}}}
\newcommand*\hit@file@sep[1]{%
  \ifcat\noexpand#1\relax\else
    \if/#1\allowbreak\else
    \if-#1\allowbreak\else
    \if.#1\allowbreak\fi\fi\fi
  \fi}
%    \end{macrocode}
