% \cs{hitgh}\marg{账号} 排一个指向 GitHub 主页的昵称，\cs{hitmail}\marg{地址}
% 排一个邮件链接。
%
% \cs{hitauthor}\oarg{称号}\marg{姓名}\marg{邮箱}\marg{GitHub 账号} 排封面上的
% 一位作者，脚注给出「昵称（邮箱）」。邮箱一栏收的是排好的内容，多个邮箱就写多个
% \cs{hitmail}。
%
% \changes{v3.2a}{2026/08/12}{\cs{hitauthor}}
% \changes{v3.2a}{2026/08/12}{\cs{hitauthor} 加可选的称号，用 \pkg{ruby} 排在名字
%   头上。三位主要维护者各标一代}
% 可选参数是称号，用 \pkg{ruby} 排在名字头上，读作「注音」那个位置。没写就只排名字。
%
% \cs{hitref}\marg{账号} 在正文里排一个跳回封面的昵称。落点是封面整页而不是脚注
% 那一行：\pkg{hypdoc} 与 \pkg{hyperref} 在 \cs{maketitle} 的时机放不了锚点，
% \cs{hypertarget} 与 \cs{phantomsection}\cs{label} 写在 \cs{thanks} 里或作者名上
% 都会报 \cs{HyperLocalCurrentHref} 未定义而编不过，所以退一步用页锚点。
%    \begin{macrocode}
\newcommand*\hitgh[1]{\href{https://github.com/#1}{\texttt{@#1}}}
\newcommand*\hitmail[1]{\href{mailto:#1}{\texttt{#1}}}
\newcommand*\hitref[1]{\hyperlink{page.1}{\texttt{@#1}}}
\NewDocumentCommand\hitauthor{o m m m}
  {%
    \IfNoValueTF{#1}{#2}{\ruby{#2}{\hit@rank@font #1}}%
    \thanks{\hitgh{#4}（#3）}%
  }
\newcommand*\hit@rank@font{\normalfont\sffamily\color{hit@option}}
%    \end{macrocode}
