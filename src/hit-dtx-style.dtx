%
% \changes{v3.2a}{2026/08/12}{手册加封面：满版底色、双线框里的竖排书名、
%   框外的作者列、朱文方印}
% \changes{v3.2a}{2026/08/14}{封面底色改用主色，印色相应提亮一档。三支颜色
%   都挪去了前面的色板一节}
% \DescribeMacro{\hitcoverpage}
% \cs{hitcoverpage}\marg{书名}\marg{版次}\marg{作者甲}\marg{作者乙}\marg{脚注}
% 排手册的封面。版式是中文书封的常见路数：满版底色，右侧一个双线框，框里竖排书名，
% 框外左侧两列作者，框下钤一枚朱文方印，左下角是模板名与版本。
%
% 两列作者按竖排的规矩从右往左读，\meta{作者甲} 在右。方印的四个字按回文读序排，
% 右上、右下、左上、左下，读作「哈工大印」。
%
% 底色、字色、印色三个在前面的色板一节，想换配色改那里。
%
% \textbf{要编两遍。} \pkg{tikz} 的 \texttt{remember~picture} 靠 \file{.aux} 传
% \texttt{current~page} 的坐标，头一遍拿不到，整幅会缩在左上角。\texttt{make~doc}
% 本来就编三遍，不必额外处理。
%    \begin{macrocode}
\RequirePackage{tikz}
\usetikzlibrary{calc}
\colorlet{hit@cover@ground}{hit@main}
\definecolor{hit@cover@ink}{HTML}{EDE6D6}
\definecolor{hit@cover@seal}{HTML}{D2422E}
%    \end{macrocode}
%
% 竖排一列：\marg{tikz 坐标}\marg{字号}\marg{行距}\marg{文本}。逐字放一个
% \cs{node}，每字往下挪一个行距。
%    \begin{macrocode}
\ExplSyntaxOn
\cs_new_protected:Npn \hit_cover_column:nnnn #1#2#3#4
  {
    \int_zero:N \l_tmpa_int
    \tl_map_inline:nn {#4}
      {
        \node [ anchor = north , inner~sep = 0pt , text = hit@cover@ink ]
          at ( $ #1 + ( 0 , - \fp_eval:n { \l_tmpa_int * #3 } pt ) $ )
          { \fontsize {#2} {#2} \selectfont ##1 } ;
        \int_incr:N \l_tmpa_int
      }
  }
\cs_new_eq:NN \hit@cover@column \hit_cover_column:nnnn
\ExplSyntaxOff
%    \end{macrocode}
%
% 满版底色，往里 30\,pt 一圈细线。
%    \begin{macrocode}
\newcommand\hitcoverpage[5]{%
  \thispagestyle{empty}%
  \begin{tikzpicture}[remember picture,overlay,
      every node/.style={font=\kaishu}]
    \fill[hit@cover@ground]
      (current page.south west) rectangle (current page.north east);
    \draw[hit@cover@ink,line width=0.4pt]
      ($(current page.south west)+(30pt,30pt)$)
        rectangle ($(current page.north east)+(-30pt,-30pt)$);
%    \end{macrocode}
%
% 书名块。坐标从 \texttt{current~page.north} 起算，往右 112\,pt、往下 210\,pt，
% 于是整块落在版面右侧、竖直方向的视觉中心稍上。
%    \begin{macrocode}
    \coordinate (hit@tc) at ($(current page.north)+(112pt,-210pt)$);
    \draw[hit@cover@ink,line width=0.6pt]
      ($(hit@tc)+(-52pt,30pt)$) rectangle ($(hit@tc)+(52pt,-348pt)$);
    \draw[hit@cover@ink,line width=2.4pt]
      ($(hit@tc)+(-59pt,37pt)$) rectangle ($(hit@tc)+(59pt,-355pt)$);
    \hit@cover@column{(hit@tc)}{54pt}{54}{#1}
    \hit@cover@column{($(hit@tc)+(34pt,-10pt)$)}{16pt}{18}{#2}
    \hit@cover@column{($(hit@tc)+(-96pt,-42pt)$)}{17pt}{19}{#3}
    \hit@cover@column{($(hit@tc)+(-126pt,-42pt)$)}{17pt}{19}{#4}
%    \end{macrocode}
%
% 朱文方印，四个字按回文读序：右上、右下、左上、左下。
%    \begin{macrocode}
    \begin{scope}[shift={($(hit@tc)+(0pt,-386pt)$)}]
      \draw[hit@cover@seal,line width=2pt]
        (-21pt,-21pt) rectangle (21pt,21pt);
      \node[text=hit@cover@seal] at ( 10pt, 10pt){\fontsize{16}{16}\selectfont 哈};
      \node[text=hit@cover@seal] at ( 10pt,-10pt){\fontsize{16}{16}\selectfont 工};
      \node[text=hit@cover@seal] at (-10pt, 10pt){\fontsize{16}{16}\selectfont 大};
      \node[text=hit@cover@seal] at (-10pt,-10pt){\fontsize{16}{16}\selectfont 印};
    \end{scope}
    \node[anchor=south west,text=hit@cover@ink,font=\rmfamily]
      at ($(current page.south west)+(60pt,74pt)$)
      {\fontsize{30}{30}\selectfont hi\kern-.5pt Thesis};
    \node[anchor=south west,text=hit@cover@ink]
      at ($(current page.south west)+(62pt,52pt)$)
      {\fontsize{12}{12}\selectfont #5};
  \end{tikzpicture}%
  \null\newpage}
%    \end{macrocode}
%    \begin{macrocode}
%</dtx-style>
%    \end{macrocode}
