% \changes{v3.2a}{0000/00/00}{记号改用 \pkg{hologo}，\pkg{metalogo} 撤掉。
%   原先 \cs{LaTeX} 一族是内核那套按 CM 字形调好的 kern，换到 Noto Serif 上凑不准；
%   \pkg{hologo} 按当前字体调，还把 \pkg{metalogo} 只管的 \cs{XeTeX} 一族一并覆盖}
% 记号一律写 \cs{hologo}\marg{名字}，不裸写 \cs{LaTeX} 这类。内核的 \cs{LaTeX}
% 用的是照 Computer Modern 量好的固定 kern，本手册西文是 Noto Serif，凑不准；
% \pkg{hologo} 按当前字体现算。\pkg{metalogo} 原先只是为了 \cs{XeLaTeX} 与
% \cs{XeTeX}，那两个 \pkg{hologo} 也有，所以撤掉，一套就够。
%    \begin{macrocode}
\RequirePackage{hologo}
%    \end{macrocode}
%
% \changes{v3.2a}{0000/00/00}{显式加载 \pkg{graphicx}。手册第 2293 行的
%   \cs{includegraphics} 原先靠 \pkg{metalogo} 顺带把它拉进来，撤掉 \pkg{metalogo}
%   才发现这层隐式依赖}
% 手册里插图要它。原先没写，是 \pkg{metalogo} 为了 \cs{XeTeX} 那个反转的 E 用
% \cs{reflectbox} 而加载了 \pkg{graphicx}，我们白捡了一个。跟 \pkg{multicol} 那条
% 一个道理，自己要用的就自己装。
%    \begin{macrocode}
\RequirePackage{graphicx}
\RequirePackage{ruby}
