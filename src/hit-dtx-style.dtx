%
% 默认字体为fandol
% \changes{v3.0.02}{2020/06/11}{默认字体为fandol}
% \changes{v3.2a}{2026/08/09}{手册西文改用 Noto Serif 与 Noto Sans，装了才用，
%   没有就回退到原来的 TeX Gyre Pagella 与 IBM Plex Sans}
% 西文用 Noto Serif 与 Noto Sans，两者都在 \hologo{TeX}~Live 里，CI 上也有。
%
% 中文没有跟着换 Noto CJK。\pkg{ctex} 的 \texttt{ubuntu} fontset 楷体取
% \texttt{AR~PL~KaitiM~GB}，装了 Noto 也未必有这一支；直接写
% \texttt{Noto~Serif~CJK~SC} 又只能拿到 \file{NotoSerifCJK.ttc} 的默认字面，
% 也就是日文那面，\texttt{Language=Chinese~Simplified} 不起作用，排出来是
% 日文字形。所以中文仍旧用 fandol，简体字形正确，\hologo{TeX}~Live 自带。
%    \begin{macrocode}
\RequirePackage[UTF8,scheme=chinese,fontset=fandol]{ctex}
\IfFontExistsTF{NotoSerif-Regular.ttf}{
  \setmainfont{NotoSerif}[
    Extension   = .ttf,
    UprightFont = *-Regular,
    BoldFont    = *-Bold,
    ItalicFont  = *-Italic,
    BoldItalicFont = *-BoldItalic,
  ]
}{\IfFontExistsTF{Noto Serif}{
  \setmainfont{Noto Serif}
}{
  \setmainfont{TeXGyrePagellaX}[
    Extension   = .otf,
    UprightFont = *-Regular,
    BoldFont    = *-Bold,
    ItalicFont  = *-Italic,
    BoldItalicFont = *-BoldItalic,
  ]
}}
\IfFontExistsTF{NotoSans-Regular.ttf}{
  \setsansfont{NotoSans}[
    Extension   = .ttf,
    UprightFont = *-Regular,
    BoldFont    = *-Bold,
    ItalicFont  = *-Italic,
    BoldItalicFont = *-BoldItalic,
  ]
}{\IfFontExistsTF{Noto Sans}{
  \setsansfont{Noto Sans}
}{
  \setsansfont{IBMPlexSansCondensed}[%
    Extension      = .otf,
    UprightFont    = *-Regular,
    BoldFont       = *-Bold,
    ItalicFont     = *-Italic,
    BoldItalicFont = *-BoldItalic
  ]
}}
%    \end{macrocode}
%
% 手册里代码块的字体。首选霞鹜文楷等宽，它的中西文等宽，中文注释与西文代码能对齐；
% 中西文一起设，否则 \cs{ttfamily} 下的中文仍走 \pkg{ctex} 的仿宋，宽度对不上。
% 字体名与文件名两种写法都试一次：前者靠 fontconfig 找已装字体，后者给把
% \file{.ttf} 直接放在工程目录的人用。找不到就退回原来那条链。
%
% \changes{v3.2a}{2026/08/21}{文件名那一档补上 \file{.ttf} 扩展名，不带扩展名的
%   裸名字在没装这个字体的机器上会被当成 \file{.tfm} 去找}
% \emph{文件名一定要带扩展名。} 不带扩展名的裸名字，\hologo{XeTeX} 找不到同名
% 系统字体就退回去找 \file{.tfm}，kpathsea 跟着起 \texttt{mktextfm} 造字，
% metafont 报 \texttt{I can't find file} 之后整份手册停在那里——Linux 上没有这个
% 字体，手册就编不出来（在 \texttt{texlive/texlive} 容器里复现）。带上扩展名之后
% 判定走的是文件查找，找不到就干净地返回假。
%
% \changes{v3.2a}{2026/08/21}{Noto 两族先按 \TeX~Live 的字体文件找，再按
%   fontconfig 名字找}
% \emph{先按字体文件找，再按名字找。} \texttt{texlive/texlive} 容器里按名字找
% 会解析到 Type1 的 \file{.pfb}，\texttt{xdvipdfmx} 嵌入时直接 fatal，整份手册
% 编不出来（实测）。第一档走文件、带扩展名，判定与嵌入都是确定的；第二档给
% 装了系统 Noto 但没装 \TeX~Live \pkg{noto} 宏包的人用；再退 \pkg{tex-gyre}。
%
% 添加fallback字体，这样无论本机/CI/Debian/macOS都不会炸
% \changes{v3.1e}{2026/01/08}{添加fallback字体，这样无论本机/CI/Debian/macOS都不会炸}
% \changes{v3.2a}{2026/08/09}{修复Latin Modern Mono fallback缺少\cs{IfFontExistsTF}防护导致CI编译文档失败的问题}
% \changes{v3.2a}{2026/08/09}{手册的代码字体首选霞鹜文楷等宽，中西文等宽，
%   中文注释与西文代码能对齐。装了才用，CI 上没有就按原来的链回退}
%    \begin{macrocode}
\newif\ifhit@doc@mono
\IfFontExistsTF{LXGW WenKai Mono}{
  \setmonofont{LXGW WenKai Mono}
  \setCJKmonofont{LXGW WenKai Mono}
  \hit@doc@monotrue
}{
  \IfFontExistsTF{LXGWWenKaiMono-Regular.ttf}{
    \setmonofont{LXGWWenKaiMono-Regular.ttf}
    \setCJKmonofont{LXGWWenKaiMono-Regular.ttf}
    \hit@doc@monotrue
  }{}
}
\ifhit@doc@mono\else
  \IfFontExistsTF{Iosevka Slab}{
    \setmonofont{Iosevka Slab}
  }{
    \IfFontExistsTF{Latin Modern Mono}{
      \setmonofont{Latin Modern Mono}
    }{}
  }
\fi
%    \end{macrocode}
%
