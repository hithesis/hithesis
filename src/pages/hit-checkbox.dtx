% \section{勾选框}
%
% ^^A ======================================================================
% ^^A Module shared-checkbox: 两处共用的空框与打勾框
% ^^A ======================================================================
%
% \changes{v3.2a}{2026/09/13}{勾选框从 \texttt{final-titlepage} 抽出来单开一个
%   模块，本科内封与深圳本科报告首页共用}
% 两处在用：本科内封头一行的「毕业论文／毕业设计」，与深圳本科报告首页
% 2026 年 9 月版新加的那一行。原先只写在内封那个模块里，而那个模块只在终稿
% 才编进类，报告取不到。
%
% Word 那两个框是 Wingdings~2 私有位的字形，本机未必有；\pkg{amssymb} 的
% \cs{square} 只为一个方块引一个包不值，而且它会动数学字体。所以两个框都自己画。
%
% \begin{macro}{\hit@empty@box}
% \begin{macro}{\hit@checked@box}
%    \begin{macrocode}
%<*shared-checkbox>
\cs_new_protected:Npn \hit@empty@box
  {
    {
      \dim_set:Nn \fboxsep { 0pt } \dim_set:Nn \fboxrule { 0.5pt }
      \raisebox { 0.5pt } { \framebox [8pt] [c] { \raisebox { 0pt } [7pt] [0pt] { } } }
    }
  }
\cs_new_protected:Npn \hit@checked@box
  {
    {
      \dim_set:Nn \fboxsep { 0pt } \dim_set:Nn \fboxrule { 0.5pt }
      \raisebox { 0.5pt }
        {
          \framebox [8pt] [c]
            {
              \raisebox { 0pt } [7pt] [0pt]
                {
                  \makebox [0pt] [c]
                    { \raisebox { 1.2pt } { \resizebox { 6.5pt } { 6.5pt } { $ \checkmark $ } } }
                }
            }
        }
    }
  }
%</shared-checkbox>
%    \end{macrocode}
% \end{macro}
% \end{macro}
%
% \Finale
