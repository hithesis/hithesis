%
% \subsubsection{编号的排法}
%
% 终稿与报告两档的目录共用这一段（报告的目录模块紧接在后面抽出）。
%
% 编号与标题之间空多少，目录条目与章标题是同一件事，不另设键：间距取
% \cs{hit@chapter@number@gap:}（用户设了 \option{after-chapter-number} 词条
% 用词条，没设是一个字宽，见 \file{docxlike-format.dtx}），装盒量宽。
% \option{toc}/\option{number-align} 管编号怎么摆：
% \begin{itemize}
% \item \texttt{natural}（默认）不取列：编号排自然宽，后面空足间距，标题
%   起点跟着编号长短走。范例是这么排的——目录条目按字形原点量，“章”到
%   “绪”的步进 25.00\,bp，正是一个汉字加一个全宽空格（12.55\,bp）。
% \item \texttt{left} 是 v3.1e 的量宽取齐：编号靠左排进定宽列，列宽取
%   “额定列宽与实宽加\emph{半个间距}的较大者”，间距吃在列里；节以下折行悬挂到额定列宽。
%   原版写死的半个字号在这里参数化成间距的一半——兜底值一个字宽的一半正是半个字号。
% \item \texttt{right} 编号靠右贴齐额定列宽，右侧再空足间距，标题起点整列
%   对齐。章条目没有额定列宽（零），这一档退化成
%   \texttt{natural}——“第几章”本就同宽，不缺这次取齐。
% \end{itemize}
% 额定列宽是 \LaTeX\ 内核给各级条目的编号宽：章零、节 2\,em、条 3\,em、款 3.1\,em，
% 图表清单 4\,em；别的宏包的清单用它们自己给的（见下面 \cs{@dottedtocline}）。
%
% \emph{折行悬挂到标题首字。}指南 3.6：“对于超过一行的目录内容提前换行，
% 换行后缩进至相应标题第一个字符处”。悬挂多宽只有排完编号才知道，写进
% \cs{g\_docxlike\_toc\_hang\_dim}，目录域在段尾照它悬挂。无编号的条目（摘要、结论这些）
% 不经过这里，悬挂是零，折行处恰好也是它标题的首字。
%
% 图表清单的编号前加“图”“表”“公式”，与编号隔 0.4\,em。
%
% 博士后的目录条目照《博士后研究工作报告模板》，“第1章”里数字两边不空中西文间距：模板“第”
% 到“1”的步进 12.5，正是一格，没有间距。目录域把列表编号抄成正文，每一段都带
% \texttt{w:hint="eastAsia"}；学位论文的范例是手敲的“第1章”，没带，那边照空。编号后的空当在
% \cs{hit@chapter@number@gap:} 里（半个字宽）。
%    \begin{macrocode}
\str_new:N \g__hit_toc_number_align_str
\str_gset:Nn \g__hit_toc_number_align_str { natural }
\bool_new:N \g__hit_toc_lists_bool
\keys_define:nn { hit / toc }
  {
    number-align .choices:nn = { natural , left , right }
      { \str_gset:NV \g__hit_toc_number_align_str \l_keys_choice_tl } ,
    lists .bool_gset:N = \g__hit_toc_lists_bool ,
    lists .default:n   = true ,
  }
\box_new:N \l__hit_toc_num_box
\box_new:N \l__hit_toc_gap_box
\dim_new:N \l__hit_toc_rated_dim
\dim_new:N \l__hit_toc_num_dim
\dim_new:N \l__hit_toc_num_pad_dim
\tl_new:N \l__hit_toc_num_tl
\tl_new:N \l__hit_toc_rated_tl
\cs_new_protected:Npn \__hit_toc_numberline:n #1
  {
    \tl_if_empty:NTF \l_docxlike_toc_label_tl
      {
        \dim_set:Nn \l__hit_toc_rated_dim
          {
            \int_case:nnF { \l_docxlike_toc_level_int }
              { { 2 } { 2em } { 3 } { 3em } { 4 } { 3.1em } }
              { 0pt }
          }
        \tl_set:Nn \l__hit_toc_num_tl {#1}
      }
      {
        \dim_set:Nn \l__hit_toc_rated_dim { 4em }
        \tl_set:Nn \l__hit_toc_num_tl
          { \use:c { \l_docxlike_toc_label_tl name } \skip_horizontal:n { .4em } #1 }
      }
    \tl_if_empty:NF \l__hit_toc_rated_tl
      { \dim_set:Nn \l__hit_toc_rated_dim { \l__hit_toc_rated_tl } }
    \bool_if:NT \g__hit_postdoc_bool
      { \tl_put_left:Nn \l__hit_toc_num_tl { \hit@engine@ecglue@off: } }
    \exp_args:NV \__hit_toc_gap_box_set:n \l__hit_toc_num_tl
    \hbox_set:Nn \l__hit_toc_num_box { \l__hit_toc_num_tl }
    \dim_zero:N \l__hit_toc_num_pad_dim
    \str_case:VnF \g__hit_toc_number_align_str
      {
        { left }
          {
            \dim_set:Nn \l__hit_toc_num_dim
              {
                \dim_max:nn { \l__hit_toc_rated_dim }
                  { \box_wd:N \l__hit_toc_num_box + \box_wd:N \l__hit_toc_gap_box / 2 }
              }
            \bool_lazy_and:nnTF
              { \int_compare_p:nNn { \l_docxlike_toc_level_int } = { 1 } }
              { \tl_if_empty_p:N \l_docxlike_toc_label_tl }
              { \dim_gset_eq:NN \g_docxlike_toc_hang_dim \l__hit_toc_num_dim }
              { \dim_gset_eq:NN \g_docxlike_toc_hang_dim \l__hit_toc_rated_dim }
          }
        { right }
          {
            \dim_set:Nn \l__hit_toc_num_pad_dim
              { \dim_max:nn { \c_zero_dim } { \l__hit_toc_rated_dim - \box_wd:N \l__hit_toc_num_box } }
            \dim_set:Nn \l__hit_toc_num_dim
              { \box_wd:N \l__hit_toc_num_box + \box_wd:N \l__hit_toc_gap_box }
            \dim_gset:Nn \g_docxlike_toc_hang_dim { \l__hit_toc_num_pad_dim + \l__hit_toc_num_dim }
          }
      }
      {
        \dim_set:Nn \l__hit_toc_num_dim
          { \box_wd:N \l__hit_toc_num_box + \box_wd:N \l__hit_toc_gap_box }
        \dim_gset_eq:NN \g_docxlike_toc_hang_dim \l__hit_toc_num_dim
      }
    \skip_horizontal:N \l__hit_toc_num_pad_dim
    \hbox_to_wd:nn { \l__hit_toc_num_dim } { \l__hit_toc_num_tl \hfil }
  }
%    \end{macrocode}
%
% 题序后那一个字的空隙，按题序自己的样子给：人文社科类的“一、”“（一）”自带
% 全角顿号或括号，范例目录里题序贴着标题排，不再空；“第一章”“1.1”
% “Chapter One”后面照旧空一个字。看的是题序末字是不是那两个全角标点，
% 不看层级——英文目录里的“1.1”与中文目录里的“一、”是同一层级、两种排法。
% 比的是字符串：\file{.toc} 里读回来的顿号与本文件里写的顿号 catcode 不一定
% 相同，按 token 比对不上。末字取两遍：题序整个裹在一对花括号里传进来时，
% 第一遍取到的“末项”是整个括号组，再取一遍才是末字；没裹的取两遍结果一样。每遍之前按字
% 打包一次，\hologo{pdfTeX} 下一个汉字是几个记号（见 \cs{hit@engine@group@chars:N}）。
%    \begin{macrocode}
\tl_new:N \l__hit_toc_num_last_tl
\cs_new_protected:Npn \__hit_toc_gap_box_set:n #1
  {
    \tl_set:Nn \l__hit_toc_num_last_tl {#1}
    \hit@engine@group@chars:N \l__hit_toc_num_last_tl
    \tl_set:Nx \l__hit_toc_num_last_tl { \tl_item:Nn \l__hit_toc_num_last_tl { -1 } }
    \hit@engine@group@chars:N \l__hit_toc_num_last_tl
    \tl_set:Nx \l__hit_toc_num_last_tl { \tl_item:Nn \l__hit_toc_num_last_tl { -1 } }
    \exp_args:NnV \str_if_in:nnTF { 、） } \l__hit_toc_num_last_tl
      { \hbox_set:Nn \l__hit_toc_gap_box { } }
      { \hbox_set:Nn \l__hit_toc_gap_box { \hit@chapter@number@gap: } }
  }
%    \end{macrocode}
%
% \subsubsection{终稿的目录}
%
% \option{toc}/\option{depth} 数的是级数，\cs{tocdepth} 数的是比章低几级，两者差一。
% 这一句在 \cs{AtBeginDocument} 才赶得上导言区的 \cs{hitsetup}，又仍旧早于第一条
% \cs{addcontentsline}。目录域的 \texttt{\textbackslash o} 按排的当时的 \cs{tocdepth} 取，文档里自己改过
% \cs{tocdepth} 的照旧有效。
%    \begin{macrocode}
\bool_if:NT \g__hit_final_bool
  {
\setcounter { secnumdepth } { 3 }
\AtBeginDocument
  { \setcounter { tocdepth } { \int_eval:n { \g__hit_toc_depth_int - 1 } } }
%    \end{macrocode}
