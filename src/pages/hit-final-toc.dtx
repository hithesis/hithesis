% \begin{macro}{\tableofengcontents}
% 英文目录，读 \file{.toe}。「Contents」是纯西文行，行盒按 Times 算，标题自己会这样判
% （Word 按行里实际的字算行高）；范例里它的基线比中文目录的「目录」高 1.5、到首条近 2.8，
% 正是宋体与 Times 两副上升部、行深之差。字距与「目录」一样写回 normal。书签与页眉标记
% 写在标题里，跟标题落在同一处。
%    \begin{macrocode}
\cs_new:Npn \engcontentsname { \bfseries Contents }
\cs_new_protected:Npn \tableofengcontents
  {
    \hit@chapter* [ font = { character-spacing = { spacing = normal } } ]
      {
        \engcontentsname
        \pdfbookmark [ 0 ] { Contents } { econtent } ~
        \@mkboth { \engcontentsname } { \engcontentsname }
      }
    \group_begin:
      \hit@toc@layout:n { en }
      \__hit_toc_field:nn { \f "toe" } { en }
    \group_end:
  }
%    \end{macrocode}
% \end{macro}
%
% 调目录域。\texttt{\textbackslash o} 的级数照 \cs{tocdepth}（比章低几级，差一）。
%
% 各级的直接格式按两样定。粗体：英文目录（\texttt{en}）与英文版论文的一级条目整行粗，
% 照 iota（英文目录的一级条目 \texttt{bold-chapter}，点线与页码一起粗）；本科那一档
% 跟着标题 1 的粗细走（\option{chapterbold} 由标题 1 样式的 \texttt{b} 写回，默认是细的）；
% 博士后的粗体写在 \texttt{TOC1} 样式里。西文：\option{toc}/\option{latin-sans} 开着时
% 条目的西文用无衬线（Arial），本科的章条目除外。
%
% 这些是 Word 里域结果那几段自己带的格式：同一篇里中英两份目录，一级条目一粗一细，
% 样式只有一个 \texttt{TOC1}。
%    \begin{macrocode}
\tl_new:N \l__hit_toc_local_tl
\tl_new:N \l__hit_toc_font_tl
\cs_new_protected:Npn \__hit_toc_field:nn #1#2
  {
    \tl_clear:N \l__hit_toc_local_tl
    \int_step_inline:nn { 4 }
      {
        \tl_clear:N \l__hit_toc_font_tl
        \bool_lazy_and:nnT { \int_compare_p:nNn {##1} = { 1 } }
          {
            \str_if_eq_p:nn {#2} { en }
            || \bool_if_p:N \g__hit_en_bool
            || ( \bool_if_p:N \g__hit_chapterbold_bool && \bool_if_p:N \g__hit_bachelor_bool )
          }
          { \tl_put_right:Nn \l__hit_toc_font_tl { font-style = bold , } }
        \bool_lazy_and:nnT { \g__hit_toc_latin_sans_bool }
          { ! ( \int_compare_p:nNn {##1} = { 1 } && \bool_if_p:N \g__hit_bachelor_bool ) }
          { \tl_put_right:Nn \l__hit_toc_font_tl { latin-text-font = Arial , } }
        \tl_if_empty:NF \l__hit_toc_font_tl
          { \tl_put_right:Nx \l__hit_toc_local_tl { ##1 = { font = { \l__hit_toc_font_tl } } , } }
      }
    \use:x
      {
        \exp_not:N \docxlike_toc_field:nn
          {
            \exp_not:N \o " 1 - \int_eval:n { \c@tocdepth + 1 } "
            \exp_not:N \h \exp_not:n {#1}
          }
          { \exp_not:V \l__hit_toc_local_tl }
      }
  }
%    \end{macrocode}
%
% 目录版面组：页码右缘照 Word 的右制表位（8494 缇＝页左缘起 424.7\,bp，
% 比版心右缘少 0.45），行宽整个收窄这一段，点线与页码跟着落位；贴排制的行深从
% 这一份目录的标题语言起算（目录域起头按首级样式垫一块，垫的时候按这里定的中西文）。
% 三份入口（中文目录、英文目录、图表清单）都在自己的分组里调它，出组即还。编号的
% 排法也在这里换上。\option{toc}/\option{latin-natural} 关掉时纯西文的条目也按样式那副字
% 算行盒。
%    \begin{macrocode}
\cs_new_protected:Npn \hit@toc@layout:n #1
  {
    \dim_set:Nn \hsize { \hsize - 0.45 bp }
    \dim_set_eq:NN \linewidth \hsize
    \bool_set:Nn \l_docxlike_format_latin_pick_bool
      { \str_if_eq_p:nn {#1} { en } }
    \__hit_tristate_if:NnTF \g__hit_toc_latin_natural_tl { \c_true_bool }
      { } { \bool_set_false:N \l_docxlike_toc_latin_line_bool }
    \cs_set_eq:NN \docxlike_toc_numberline:n \__hit_toc_numberline:n
  }
%    \end{macrocode}
%
% \subsubsection{别的清单}
%
% 目录与图表清单都不走 \cs{@dottedtocline} 了，这个内核宏只剩别的宏包的清单在用
% （\pkg{algorithm2e} 的算法清单、\pkg{listings} 的代码清单这些）。让它们也照目录条目排：
% 交给同一个目录条目的排法，级数加一作样式（\meta{级} 0 是 \texttt{TOC1}），左缩进取宏包
% 自己给的第二个参数，编号照上面的排法、额定列宽取第三个参数。\cs{@pnumwidth} 与
% \cs{@dotsep} 这里不读了，留着给还在读它们的宏包。
%    \begin{macrocode}
\cs_set:Npn \@pnumwidth { 4em }
\cs_set:Npn \@tocrmarg { \@pnumwidth }
\cs_set:Npn \@dotsep { 0 }
\cs_set_protected:Npn \@dottedtocline #1#2#3#4#5
  {
    \int_compare:nNnF {#1} > { \c@tocdepth }
      {
        \group_begin:
          \hit@toc@layout:n { \bool_if:NTF \g__hit_en_bool { en } { zh } }
          \int_set:Nn \l_docxlike_toc_level_int { #1 + 1 }
          \tl_clear:N \l_docxlike_toc_label_tl
          \tl_set:Nn \l__hit_toc_rated_tl {#3}
          \cs_set_protected:Npn \numberline { \__hit_toc_numberline:n }
          \use:x
            {
              \exp_not:N \docxlike_toc_entry:nnnnn { TOC \int_eval:n { #1 + 1 } }
                { paragraph = { indentation = { left = \dim_to_decimal_in_bp:n {#2} bp } } }
            }
            {#4} {#5} { }
        \group_end:
      }
  }
\dim_set:Nn \leftmargini {0pt}
\dim_set:Nn \leftmarginii {0pt}
\dim_set:Nn \leftmarginiii {0pt}
\dim_set:Nn \leftmarginiv {0pt}
\dim_set:Nn \leftmarginv {0pt}
\dim_set:Nn \leftmarginvi {0pt}
%    \end{macrocode}
%
%    \begin{macrocode}
  }
%</final-toc>
%    \end{macrocode}
%
% \Finale
