% \section{封面与扉页}
%
%    \begin{macrocode}
%<*thesis-cover>
%    \end{macrocode}
%
%    \begin{macrocode}
\skip_new:N \hit@title@width
\NewDocumentCommand \hit@put@title { O{\hit@title@width} m }
  { \begin { CJKfilltwosides } [b] {#1} #2 \end { CJKfilltwosides } }
%    \end{macrocode}
%
% \begin{macro}{\hit@cover@row}
% \changes{v3.2a}{0000/00/00}{封面表格里「字段名加下划线填空」的行型抽成
%   \cs{hit@cover@row}，格宽与对齐做成两个可设的量}
% \cs{hit@cover@row}\marg{字段名}\marg{值} 排封面表格的一行：左格是字段名，
% 右格是一条 \cs{hit@cover@field@width} 宽的下划线，值按 \cs{hit@cover@field@alignment}
% 对齐。带星号的不出 \cs{\textbackslash\textbackslash}，给表格最后一行用。
%
% 深圳与其余校区的本科封面原先是两整段几乎一样的表格，差别只在值是左对齐还是
% 居中（\cs{makebox} 不给对齐参数就是居中，等同于 \texttt{c}），以及行的顺序。
% 对齐做成量之后，两段就只剩行的顺序不同了。
%    \begin{macrocode}
\dim_new:N \hit@cover@field@width
\dim_set:Nn \hit@cover@field@width { 6.1cm }
\tl_new:N \hit@cover@field@alignment
\tl_set:Nn \hit@cover@field@alignment { c }
\NewDocumentCommand \hit@cover@row { s m m }
  {
    {\hit@put@title{#2}}~&~\underline{\makebox[\hit@cover@field@width][\hit@cover@field@alignment]{#3}}
    \IfBooleanF {#1} { \\ } ~
  }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\hit@cover@line}
% \changes{v3.2a}{0000/00/00}{第二封面上「字段名加值」的行型抽成
%   \cs{hit@cover@line}}
% 第二封面的信息表不画下划线，字段名走黑体。哈尔滨本科那张七行、其余那张九行，
% 行型完全一样。带星号的不出 \cs{\textbackslash\textbackslash}，给最后一行用。
%    \begin{macrocode}
\NewDocumentCommand \hit@cover@line { s m m }
  { {\heiti \hit@put@title{#2}}~&~#3 \IfBooleanF {#1} { \\ ~ } }
%    \end{macrocode}
% \end{macro}
%
% \changes{v3.1d}{2025/03/03}{将哈尔滨本科的第一封面替换为 \cmd{\hit@first@title@page@other}。\issue[172]}
% 将哈尔滨本科的第一封面替换为 \cmd{\hit@first@title@page@other}。之后应该会逐步替换掉, 看学校又会怎么改吧。
%
% \changes{v3.2a}{0000/00/00}{两张封面的分派与「哈尔滨本科」这个反复出现的判断
%   迁到 expl3。}
% \changes{v3.2a}{0000/00/00}{去掉 \cs{end}\{tabular\}
%   之后多出来的词间空格。\issue[294]}
% 第一张封面有三套版式：博后一套；本科里非哈尔滨一套；其余（含哈尔滨本科）
% 走 \cs{hit@first@title@page@other}。「哈尔滨本科取前者，其余取后者」写成 \cs{hit@if@both@options@TF}\marg{harbin}\marg{bachelor}。
%    \begin{macrocode}
\cs_new_protected:Npn \hit@first@title@page
  {
    \bool_if:NTF \g__hit_postdoc_bool
      { \hit@first@title@page@postdoc }
      {
        \bool_lazy_and:nnTF
          { \bool_if_p:N \g__hit_bachelor_bool } { ! \bool_if_p:N \g__hit_harbin_bool }
          { \hit@first@title@page@bachelor }
          { \hit@first@title@page@other }
      }
  }

%    \end{macrocode}
%
% \changes{v3.1d}{2025/03/03}{增加哈尔滨本科的第二封面。\issue[172]}
% 继深圳之后，本部的本科模板又开始整新活了，大改一通，醉好的结局就是都统一吧。
%
% 第二张封面有四套版式，哈尔滨本科单独一套。
%    \begin{macrocode}
\cs_new_protected:Npn \hit@second@title@page
  {
    \bool_if:NTF \g__hit_postdoc_bool
      { \hit@second@title@page@postdoc }
      {
        \bool_if:NTF \g__hit_bachelor_bool
          {
            \bool_if:NTF \g__hit_harbin_bool
              { \hit@second@title@page@harbin@bachelor }
              { \hit@second@title@page@bachelor }
          }
          { \hit@second@title@page@other }
      }
  }
%    \end{macrocode}
