\NewDocumentEnvironment { resume } { }
  { \hit@clear@page \hit@appendix@chapter * { \hit@resume@heading@zh } [ \hit@resume@heading@en ] } { }
\NewDocumentEnvironment { publication } { }
  { \hit@clear@page \hit@appendix@chapter * { \hit@publication@heading@zh } [ \hit@publication@heading@en ] } { }


\NewDocumentEnvironment { doctorpublication } { }
