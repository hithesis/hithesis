\RequirePackage{changepage}
\RequirePackage{multicol}
%    \end{macrocode}
%
% \changes{v3.2a}{2026/08/12}{\pkg{changepage} 与 \pkg{multicol} 从
%   \file{src/flow/hit-thesis-deps.dtx} 挪过来。整个类里只有下面索引那一页调它们}
% 索引那一页要比正文更宽的左右边距（\env{adjustwidth}）和双栏（\env{multicols*}），
% 这两个包只服务于它。
%
%
% \begin{environment}{conclusions}
% \changes{v3.1d}{2025/03/03}{\cs{hit@appendix@chapter*}如果不给第四个参数就不写英文目录}
%    \begin{macrocode}
\NewDocumentEnvironment { conclusions } { }
  {
    \hit@clear@page
    \hit@if@option@TF{en}%
      {\hit@appendix@chapter*{\hit@conclusion@heading@en}[\hit@conclusion@heading@en]}%
      {\hit@appendix@chapter*[\hit@conclusion@heading@zh]%
        {\hit@spread@by:nn{\hit@heading@spread}{\hit@conclusion@heading@zh}}%
        [\hit@conclusion@heading@en]}%
  }
  { }
%    \end{macrocode}
% \end{environment}
% \begin{environment}{acknowledgements}
% \changes{v3.1d}{2025/03/03}{\cs{hit@appendix@chapter*}如果不给第四个参数就不写英文目录}
%    \begin{macrocode}
\NewDocumentEnvironment { acknowledgements } { }
  {
    \hit@clear@page
    \hit@if@option@TF{en}%
      {\hit@appendix@chapter*{\hit@acknowledgement@heading@en}[\hit@acknowledgement@heading@en]}%
      {\hit@appendix@chapter*[\hit@acknowledgement@heading@zh]%
        {\hit@spread@by:nn{\hit@heading@spread}{\hit@acknowledgement@heading@zh}}%
        [\hit@acknowledgement@heading@en]}%
  }
  { }
%    \end{macrocode}
% \end{environment}
% \begin{environment}{correspondingaddr}
%    \begin{macrocode}

\NewDocumentEnvironment { correspondingaddr } { }
  { \hit@clear@page \hit@appendix@chapter * { \hit@corresponding@address@heading@zh } [ \hit@corresponding@address@heading@en ] } { }
%    \end{macrocode}
