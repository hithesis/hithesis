%    \begin{macro}{\authorization}
%    \changes{v3.2a}{0000/00/00}{添加星号版本，控制PDF扫描件是否显示页码}
%
% \changes{v3.2a}{0000/00/00}{\cs{authorization} 与 \cs{resolution} 迁到 expl3}
%    \begin{macrocode}
\NewDocumentCommand \authorization { s o }
  {
    \IfNoValueTF {#2}
      {
        \hit@if@option@TF { bachelor }
          { \hit@authorization@bachelor } { \hit@authorization@other }
      }
      {
        \hit@clear@page
        \phantomsection
        \addcontentsline { toc } { chapter }
          {
            \hit@if@option@TF { bachelor }
%    \end{macrocode}
%
% \changes{v3.1b}{2022/06/06}{修改深圳校区原创性声明的目录标题。}
% \changes{v3.1d}{2025/03/03}{调整 \cmd{\fi} 的位置。}
% 深圳校区本科生目录中的原创性声明的部分为“原创性声明”，而不是 \cs{hit@declarename@bachelor}。
%    \begin{macrocode}
              { \hit@if@option@TF { shenzhen } { 原创性声明~} { \hit@bachelor@declaration@heading@zh } }
              { \hit@authorization@heading@zh }
          }
        \hit@if@option@T { doctor }
          {
%    \end{macrocode}
%
% \changes{v1.0.13}{2018/04/05}{添加\cs{texorpdfstring}命令去除书签中带有格式时的警告}
%    \begin{macrocode}
            \addcontentsline { toe } { chapter }
              {
                \texorpdfstring
                  { \bfseries \hit@authorization@heading@en }
                  { \hit@authorization@heading@en }
              }
          }
        \IfBooleanTF {#1}
          {% 有星号，显示页码
            \includepdf
              [ fitpaper=true , pagecommand={\thispagestyle{hit@scanpage}} ] {#2}
          }
          {% 无星号，不显示页码
            \includepdf
              [ fitpaper=true , pagecommand={\thispagestyle{empty}} ] {#2}
          }
      }
  }
%    \end{macrocode}
