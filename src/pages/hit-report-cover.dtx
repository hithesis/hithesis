% \changes{v3.2a}{2026/08/07}{深圳博士中期从 \file{hithesisartplus.cls} 并入本类，
%   原先它自成一个文档类，与 \file{hithesisart.cls} 有九成代码逐字相同}
% 深圳博士中期的封面自成一版：一张表格排完全部字段，正文四周画一个边框，
% 封面之后跟一页填写说明。
%    \begin{macrocode}
\cs_set_protected:Npn \hit@report@shenzhen@doctor@makecover
  {
    \hit@write@pdf@metadata
    \begin { titlepage }
      \hit@report@shenzhen@doctor@title@page@graduate
      \clearpage
      \hit@shenzhen@doctor@interim@note
      \hit@structure@part:nn { contents } { \clearpage \tableofcontents \clearpage }
    \end { titlepage }
    \AddToShipoutPicture { \hit@report@shenzhen@doctor@frame@picture }
    \pagestyle { hit@shenzhen@doctor@headings@main }
  }
\cs_set_protected:Npn \hit@report@default@makecover
  {
    \hit@write@pdf@metadata
    \begin { titlepage }
      \bool_if:NTF \g__hit_bachelor_bool
        { \hit@report@title@page@bachelor }
        { \hit@report@title@page@graduate }
      \clearpage
      \bool_if:NT \g__hit_print_bool
        { \thispagestyle { empty } \mbox { } \clearpage }
      \hit@structure@part:nn { contents } { \tableofcontents \clearpage }
    \end { titlepage }
    \bool_lazy_and:nnT
      { \bool_if_p:N \g__hit_shenzhen_bool } { \bool_if_p:N \g__hit_master_bool }
      { \pagestyle { hit@shenzhen@headings@main } }
  }
\hit@if@shenzhen@doctor@interim@TF
  { \cs_set_eq:NN \makecover \hit@report@shenzhen@doctor@makecover }
  { \cs_set_eq:NN \makecover \hit@report@default@makecover }
%    \end{macrocode}
% \end{macro}
