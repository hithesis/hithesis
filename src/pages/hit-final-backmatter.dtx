% \changes{v3.2a}{2026/09/28}{整页部件照 iota-hit 收可选参数 \option{shown}（\texttt{auto}、\texttt{true}、\texttt{false}）：默认终稿排、报告里静默
%   跳过，\texttt{true} 在报告里也排（不另起页，标题照章标题那一档，目录里与节同级），\texttt{false} 终稿里
%   也不排；各排一次，排之前进后置；照 iota-hit 改名：成果页 \env{achievements}（\option{gb7714}、\option{period}，
%   旧名 \env{publication}、\env{doctorpublication}），永久通讯地址 \env{permanentaddress}（旧名 \env{correspondingaddr}，
%   只有博士后排），索引页 \cs{printindex}（旧写法 \env{ceindex}）}
% \changes{v3.2a}{2026/09/13}{成果页的条目从 \file{.bib} 里出：\env{achievements} 收库名，
%   \env{pubgroup} 分组，组名段照范例（编号、段前段后 5 磅、1.25 倍行盒、宋体伪粗；
%   人文社科类走节标题那一档），编号版式与参考文献表同源，\pkg{biblatex} 一线也加进
%   资源；索引页照规范附录 6 的官方示例自定义 \env{theindex}}
%
%    \begin{macrocode}
%<*final-backmatter>
\RequirePackage{changepage}
\RequirePackage{multicol}
%    \end{macrocode}
%
% 索引那一页要比正文更宽的左右边距（\env{adjustwidth}）和双栏（\env{multicols*}），
% 这两个包只服务于它。
%
% \emph{排不排由 \option{shown} 定，照 iota-hit。} 这几页是终稿的整章，学校的开题与中期报告
% 规范里没有对应的一页，所以默认（\texttt{auto}）终稿排、报告不排。写
% \oarg{shown=true} 在报告里也排，\oarg{shown=false} 连终稿也不排，与 iota-hit 每一页的
% \texttt{shown} 同一个三态（\texttt{final-only-wanted}）。判定与“只排一次”在 \file{hit-parts.dtx}；
% 除结论外，排之前先进后置（英文论文把致谢排在前置时还没进正文，不会被推进后置）。
%
% \emph{报告里不排是静默的，这是本类唯一容许的静默失效，写在这里免得日后被「修」掉。}
% 别处一律相反：覆盖键落进没人读的桶、选项取值拼错、词条查不到，每一处都专门做了报错。
% 这里反过来，是因为它不是错：同一份正文通吃三档时，开题报告里出现 \env{conclusions} 是必然的，
% 改一行 \option{stage} 就该出任何一档，用户不必把十来行调用注释来注释去。判据照抄 iota-hit
% 的 \texttt{src/flow/stage.typ}。
%
% 不排的时候整段跳到 \cs{end}\marg{环境名} 为止，只记号化、不执行，里面的标签、索引、目录行
% 一样都不留。
%    \begin{macrocode}
\bool_new:N \l__hit_back_shown_bool
\cs_new_protected:Npn \__hit_back_part:nn #1#2
  {
    \bool_set_false:N \l__hit_back_shown_bool
    \hit@part@if:nnTF {#1} {#2}
      { \hit@part@once:nT {#1} { \bool_set_true:N \l__hit_back_shown_bool } }
      { }
  }
\cs_generate_variant:Nn \__hit_back_part:nn { nV }
\cs_new_protected:Npn \__hit_back_page:nnn #1#2#3
  {
    \hit@part@opts:n {#2}
    \__hit_back_part:nV {#1} \l_hit_part_shown_tl
    \bool_if:NTF \l__hit_back_shown_bool {#3} { \hit@part@skip: }
  }
%    \end{macrocode}
%
% 终稿里每一页另起一页；报告没有章，这几页接着排，照 iota-hit。标题那一步报告另有一份
% \cs{hit@appendix@chapter}，见本节末尾。
%    \begin{macrocode}
\cs_new_protected:Npn \__hit_back_clear:
  { \bool_if:NT \g__hit_final_bool { \hit@clear@page } }
%    \end{macrocode}
%
