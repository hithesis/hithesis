%    \begin{macrocode}


\NewDocumentEnvironment { doctorpublication } { O{} }
  {
    \hit@warn@renamed@environment { doctorpublication } { achievements~[period=doctoral] }
    \__hit_achievements:n { period = doctoral , #1 }
  }
  { \__hit_achievements_end: }
%    \end{macrocode}
%
% 此处添加博后用到的博士生发表页面
% \changes{v3.0.0}{2020/05/21}{此处添加博后用到的博士生发表页面}
% 此处中英文索引的格式设置尽量符合\PGR\ 中给出的示例的格式。此处间距常数是人工调节的。
% \changes{v1.0.10}{2018/02/19}{修改了索引的间距，使其更符合规范中的示例}
%    \begin{macrocode}
%    \end{macrocode}
%
% \emph{标题要拉开字距。}两个字的章级标题模板一律分排（“目\ 录”“摘\ 要”
% “结\ 论”“致\ 谢”，间距取 \option{base-heading-spread}，博后档为空），
% 只有索引从前直接排 \cs{indexname}，印出来是挤在一起的“索引”。改走与
% 结论、致谢同一套写法：中文档用词条加字距，英文档排英文名。
% 官方示例（规范附录 6，iota-hit 逐条量过）：两栏是一张假分栏的表格，
% 两列各 4230 缇、整表占满版心，栏间只有两个格的默认边距共 10.8\,bp——
% 先前的栏距 4\,em 与两侧各缩 2\,em 都无据，去掉；条目行距 1.35
% （\texttt{w:line="324" auto}），比正文的 1.25 松。
%    \begin{macrocode}
\cs_new_protected:Npn \__hit_index_open:
      {
        \hit@matter@back@enter:
        \cs_set_eq:NN \printindex \__hit_splitidx_printindex:
        \__hit_back_clear:
        \hit@if@option@TF { en }
          {
            \hit@appendix@chapter * { \hit@term@index@heading@en }
              [ \hit@term@index@heading@en ]
          }
          {
            \hit@appendix@chapter * [ \hit@term@index@heading@zh ]
              {
                \hit@spread@by
                  { \hit@term@index@heading@spread } { \hit@term@index@heading@zh }
              }
              [ \hit@term@index@heading@en ]
          }
        \dim_set:Nn \columnsep { 10.8 bp }
        \begin { multicols* } { 2 }
        \dim_set:Nn \baselineskip { 21.01 bp }
      }
%    \end{macrocode}
%
% \cs{printindex} 排索引页：标题、两栏，里面是 \pkg{splitidx} 的 \cs{printsubindex*}（中文一段、英文一段）。
% 与 iota-hit 的 \texttt{index()} 对应（\cs{index} 是登记条目的命令，占不得，照 \hologo{LaTeX} 的习惯叫
% \cs{printindex}；\pkg{splitidx} 自带的同名命令在这里接管）。v3.1e 的写法是 \env{ceindex} 环境里写
% \cs{printsubindex*}，照旧能用，提示改名；环境里手写条目的用法手册早说过要去掉。
% \cs{printsubindex*} 里面逐个调的是 \pkg{splitidx} 自己的 \cs{printindex}，排索引页时在组里换回那一个。
%    \begin{macrocode}
\cs_new_protected:Npn \__hit_print_index:n #1
  {
    \hit@part@opts:n {#1}
    \__hit_back_part:nV { index } \l_hit_part_shown_tl
    \bool_if:NT \l__hit_back_shown_bool
      {
        \hit@matter@back@enter:
        \group_begin:
          \__hit_index_open:
          \printsubindex*
          \end { multicols* }
        \group_end:
      }
  }
\AtBeginDocument
  {
    \cs_gset_eq:NN \__hit_splitidx_printindex: \printindex
    \DeclareDocumentCommand \printindex { O{} } { \__hit_print_index:n {#1} }
  }
\NewDocumentEnvironment { ceindex } { O{} }
  {
    \hit@warn@renamed@environment { ceindex } { \iow_char:N \\printindex }
    \__hit_back_page:nnn { index } {#1} { \__hit_index_open: }
  }
  { \bool_if:NT \l__hit_back_shown_bool { \end { multicols* } } }
%    \end{macrocode}
%
% \emph{\env{theindex} 自己写一个。}\pkg{book} 的原版开头是
% \cs{twocolumn}\oarg{\cs{@makeschapterhead}\cs{indexname}}——\pkg{splitidx}
% 把 \cs{twocolumn} 换成“排掉可选参数”、把 \cs{@makeschapterhead} 换成
% \cs{section*}，于是每一段索引（中文一段、英文一段）开头都排一个节标题的
% 竖直空当：实测中英两段之间空出 76\,bp，章标题到首组也多出四十来 bp。
% 条目那边原版是 \cs{@idxitem}＝\cs{par}\cs{hangindent}~40\,pt，折行悬挂
% 40\,pt。官方示例（规范附录 6）里条目一律顶格、折行不悬挂，两段接着排。
%
% 所以整个环境重写：不排任何标题（章标题由 \env{ceindex} 排过了），条目
% 顶格、不悬挂，段间不加距，组间的段前由 \file{.ist} 的组标题给。两端
% 对齐关掉——一条是“词 + 页码”，拉伸没有意义。
%    \begin{macrocode}
\RenewDocumentEnvironment { theindex } { }
  {
    \dim_zero:N \parindent
    \skip_zero:N \parskip
    \raggedright
    \cs_set_protected:Npn \item { \par \dim_zero:N \hangindent }
    \cs_set_protected:Npn \subitem { \par \dim_zero:N \hangindent }
    \cs_set_protected:Npn \subsubitem { \par \dim_zero:N \hangindent }
    \cs_set_protected:Npn \indexspace { \par }
  }
  { \par }
%    \end{macrocode}
%
% \env{idxwordlist} 是 v3.1e 留给用户手排索引的列表。报告那一档到这里 \pkg{enumitem} 还没装
% （报告的依赖在目录模块之后才装），定义挪到导言区结束时；终稿照旧当场定义，导言区里能改它。
%    \begin{macrocode}
\cs_new_protected:Npn \__hit_back_idxwordlist:
  {
    \newlist{idxwordlist}{description}{3}
    \setlist[idxwordlist,~1]{%
      itemsep=\baselineskip,
      labelindent=8em,
      font=\normalsize\bfseries,
    }
    \setlist[idxwordlist,~2]{%
      nosep,
      labelindent=2em,
      font=\wuhao\rm,
    }
    \setlist[idxwordlist,~3]{%
      nosep,
      labelindent=4em,
      font=\wuhao\rm,
    }
  }
\bool_if:NTF \g__hit_final_bool
  { \__hit_back_idxwordlist: }
  { \AddToHook { begindocument / before } { \__hit_back_idxwordlist: } }
%    \end{macrocode}
%
% \emph{报告里的章级标题。} 报告没有章，终稿的 \cs{hit@appendix@chapter} 不在。这几页在报告里强排时
% 照 iota-hit 的 \texttt{term-heading}：标题用章标题那一档，报告里就是目录标题用的那个样式
% （本部与威海是 \texttt{toc-heading}，深圳本科是“标题 1”，见 \file{hit-report-toc.dtx}），段前一行；
% 不另起一页，目录里与节同级。正文不照 Word 排的那几份报告（深圳硕博）用 \cs{section*}。
%    \begin{macrocode}
\bool_if:NF \g__hit_final_bool
  {
    \NewDocumentCommand \hit@appendix@chapter { s o m o }
      {
        \par
        \phantomsection
        \addcontentsline { toc } { section }
          { \texorpdfstring {#3} { \IfValueTF {#2} {#2} {#3} } }
        \__hit_back_report_heading:n {#3}
      }
    \cs_new_protected:Npn \__hit_back_report_heading:n #1
      {
        \bool_if:NTF \g__hit_final_body_bool
          {
            \exp_args:NV \docxlike_format_par:nnn \g__hit_report_toc_title_style_tl
              { numbering = none , paragraph = { spacing = { before = 1 ~ line } } } {#1}
          }
          { \section* {#1} }
      }
  }
%    \end{macrocode}
%    \begin{macrocode}
%</final-backmatter>
%    \end{macrocode}
%
% \Finale
