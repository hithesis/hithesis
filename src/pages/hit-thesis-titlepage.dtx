\NewDocumentCommand \emultiline { O{c} m }
  {
    \cs_set:Npn \arraystretch { 1 }
    \begin { tabular } [#1] { @{}l@{} } #2 \end { tabular }~
    \cs_set:Npn \arraystretch { 1.3 }
  }
\cs_new_protected:Npn \hit@titlepage@en
  {
    \hit@layout@push@part:n { titlepage }
    \group_begin:
      \dim_zero:N \parindent
      \dim_zero:N \parskip
      \hit@format@par:nn { titlepage-en-mark }
        {
          \hit@term@titlepage@classified@index@national@en :~
          \hit@info@classified@index@national
        }
      \hit@format@par:nn { titlepage-en-mark }
        {
          \hit@term@titlepage@classified@index@international@en :~
          \hit@info@classified@index@international
        }
      \hitenter*[lines=3,size=xiaosi,font-en=serif,line-spacing=19.75bp!]
      \hit@format@par:nn { titlepage-en-degree } { \hit@titlepage@en@degree: }
      \hit@if@option@TF { fulltime } { }
        {
          \hit@format@par:nn { titlepage-en-degree }
            {
              \hit@term@titlepage@brace@left@en \hit@term@degree@type@en
              \hit@term@titlepage@brace@right@en
