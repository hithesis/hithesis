\cs_new_protected:Npn \hit@titlepage@bachelor@body:n #1
  {
      \hit@format@par:nn { titlepage-mark }
        {
          \hbox_to_wd:nn { \textwidth }
            {
              \hit@if@option@TF { design }
                { \hit@empty@box } { \hit@checked@box }
              \nobreakspace \hit@term@titlepage@mark@paper \quad
              \hit@if@option@TF { design }
                { \hit@checked@box } { \hit@empty@box }
              \nobreakspace \hit@term@titlepage@mark@design
              \hfil
              \hit@term@titlepage@secrecy \hit@term@titlepage@title@separator@zh
              \hit@info@secret@level
            }
        }
      \hitenter*[lines=4,size=xiaosi,font-zh=songti,line-spacing=1]
      \hit@format@par:nn { titlepage-label }
        { \hit@term@titlepage@document@type@level \hit@term@titlepage@document@type }
      \hitenter*[lines=1,size=xiaosi,font-zh=songti,line-spacing=19.75bp]
      \hitenter*[lines=1,size=xiaosi,font-zh=songti,line-spacing=1.25]
      \hit@format@par:nn { titlepage-title } { \hit@info@title@cover@zh }
      \hit@if@subtitle@T
        {
          \hit@format@par:nnn { titlepage-title } { size = xiaoer }
            { ——\hit@info@title@subtitle@zh }
        }
      \hitenter*[lines=2,size=xiaosi,font-zh=songti,line-spacing=19.75bp]
      \hitenter*[lines=#1,size=erhao,font-zh=songti,line-spacing=39bp]
      \dim_set_eq:NN \hit@title@width \c__hit_titlepage_label_dim
      \hit@titlepage@field:nn
        { \hit@term@titlepage@author@zh } { \hit@info@author@zh }
      \hit@titlepage@field:nn
        { \hit@term@titlepage@student@id } { \hit@info@student@id }
      \hit@titlepage@field:nn
        { \hit@term@titlepage@supervisor@zh } { \hit@info@supervisor@zh }
      \hit@titlepage@field:nn
        { \hit@term@titlepage@major@zh } { \hit@info@major@zh }
      \hit@titlepage@field:nn
        { \hit@term@titlepage@affiliation@zh } { \hit@info@affiliation@zh }
      \hit@titlepage@field:nn
        { \hit@term@titlepage@date@zh } { \hit@info@date@zh }
      \hit@titlepage@field:nn
        { \hit@term@titlepage@institution@zh } { \hit@term@titlepage@university@zh }
  }
\cs_new_protected:Npn \hit@titlepage@bachelor
  {
    \exp_args:Nx \hit@msword@layout@push:n
