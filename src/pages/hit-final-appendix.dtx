% \iffalse meta-comment
%
% hit-final-appendix.dtx 是附录标题与英文目录章名
%
% \fi
%
% \section{附录标题与英文目录章名}
%
% \changes{v3.2a}{2026/09/28}{\cs{appendix} 是附录的开关（照 iota-hit），与 \env{appendix} 环境的开头相同}
% \changes{v3.2a}{2026/09/13}{附录、结论、致谢等环境从类主体拆出，整块套 \option{stage} 闸}
%
% 设置附录、结论、参考文献等格式。
%    \begin{macro}{\hit@english@toc@chapter@name}
% \changes{v3.1b}{2022/06/06}{添加 \cs{hit@english@toc@chapter@name} 来使英文目录中的附录为 “Appendix”}
% \cs{hit@english@toc@chapter@name} 命令在英文目录正文显示为 “Chapter”， 在附录部分显示为 “Appendix”。
% ^^A ======================================================================
% ^^A Module final-appendix: 附录环境（hit-thesis）
% ^^A ======================================================================
%    \begin{macrocode}
%<*final-appendix>
\bool_if:NT \g__hit_final_bool
  {
\RequirePackage{enumitem}
\cs_set_eq:NN \hit@appendix \appendix
\bool_new:N \g__hit_in_appendix_bool
\cs_new:Npn \hit@english@toc@chapter@name { \hit@if@option@TF{in_appendix}{Appendix~}{Chapter~} }
%    \end{macrocode}
%    \end{macro}
%    \begin{macrocode}
\hook_new:n { hit / appendix }
\cs_new_protected:Npn \__hit_appendix_begin:
  {
    \cs_set_eq:NN \title \hit@appendix@title
    \hit@appendix
    \hook_use:n { hit / appendix }
    \hit@if@option@T{bachelor}{\cs_set:Npn \thechapter { \arabic { chapter } }}
%    \end{macrocode}
%
% \changes{v3.1b}{2022/06/06}{在附录环境中增加判断}
%    \begin{macrocode}
    \bool_gset_true:N \g__hit_in_appendix_bool
  }
\RenewDocumentEnvironment { appendix } { }
  { \__hit_appendix_begin: }
  { \cs_set_eq:NN \title \@gobble }
%    \end{macrocode}
%
% \cs{appendix} 是开关，与 iota-hit 的 \texttt{\#show:~appendix} 对应：写在附录各章前面，从那里到文末都按附录
% 编号。环境定义出来的 \cs{appendix} 就是环境的开头，本身不开组，单写就是开关；\cs{begin}\marg{appendix}
% 的写法照旧能用。不另定义开关：\pkg{hyperref} 包在它外面换锚名，\file{hit-final-float.dtx} 又在它后面接上
% 图表公式的附录编号，另起一个会把这两层都绕过去。附录章号的切换挂在本类的钩子 \texttt{hit/appendix} 上
% （\file{hit-final-heading.dtx}）；挂在环境开头的钩子上的话，写成开关就不触发。
%    \begin{macrocode}
\cs_set_eq:NN \title \@gobble
\NewDocumentCommand \hit@appendix@title { m }
  { \begin { center } \bfseries \xiaosi #1 \end { center } }
\newlist{translationbib}{enumerate}{1}
\setlist[translationbib]{label=[\arabic*],align=left,nosep,itemsep=6bp,
  leftmargin=10mm,labelsep=!,before=\vspace{0.5\baselineskip}\hit@fontsize@x{wuhao}{1.3}}
%    \end{macrocode}
%
%    \begin{macrocode}
  }
%</final-appendix>
%    \end{macrocode}
%
% \Finale
