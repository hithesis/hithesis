%
% \section{开题报告的目录}
%
% \changes{v4.0a}{2026/09/28}{报告目录支持 \cs{tableofcontents} 的 \option{depth} 与
%   \option{latin-sans} 参数；采用终稿正文版式的报告改用 \pkg{docxlike} 排目录，
%   共用终稿编号格式，折行悬挂至题名首字，目录页保留页眉；其余报告保持节级目录布局。
%   本部与威海报告的目录标题使用 \texttt{toc-heading} 样式，目录页不印页码}
%
% \option{depth} 按标题级数计数。报告虽然使用书籍底类，标题映射后的
% 最高一级仍是节，因此 \cs{tocdepth} 等于级数；终稿以章为最高一级，需要减一。
%
% 跟终稿一样放在 \cs{AtBeginDocument}：类文件执行时导言区的
% \cs{hitsetup} 还没跑，写在那里的 \option{depth} 会被漏掉。
%    \begin{macrocode}
%<*report-toc>
\bool_if:NF \g__hit_final_bool
  {
\AtBeginDocument
  { \setcounter { tocdepth } { \g__hit_toc_depth_int } }
\RequirePackage[subfigure]{tocloft}
%    \end{macrocode}
%
% \pkg{tocloft} 因底类存在 \cs{chapter} 而采用书籍默认值。报告目录以节为最高一级，
% 因此显式恢复节条目的左缩进、目录标题前间距及标题命令。
% 使用 \cs{cftsection} 也恢复其页首可丢弃的垂直间距；仅修改长度不足以达到同样效果。
% 保留 \pkg{tocloft} 的有章模式，使章级格式定义仍然可用。
%    \begin{macrocode}
\dim_set:Nn \cftsecindent { 0em }
%    \end{macrocode}
%
% 节条目使用 addvspace 合并相邻间距，不能沿用书籍模式的直接 vskip。
%    \begin{macrocode}
\cs_set:Npn \cfttoctitlefont  { \hfill \xiaoer \heiti }
\cs_set:Npn \cftaftertoctitle { \hfill \mbox { } }
\cs_set:Npn \cftsecfont       { \hit@toc@font \heiti }
\cs_set:Npn \cftsubsecfont    { \normalfont \hit@toc@font }
\cs_set:Npn \cftsubsubsecfont { \normalfont \hit@toc@font }
\cs_set:Npn \cftsecpagefont   { }
\cs_set:Npn \cftsecdotsep     { \cftdotsep }
\cs_set:Npn \cftsecleader     { \cftdotfill { \cftsecdotsep } }
\cs_set:Npn \cftdotsep        { 1 }
\dim_set:Nn \cftsubsecindent {1em}% 目录中subsection的缩进
\dim_set:Nn \cftsubsubsecindent {2em}% 目录中subsubsection的缩进
%  \setlength{\cftsecnumwidth}{1.5em}
%  \setlength{\cftsubsecnumwidth}{0em}
%  \setlength{\cftsubsubsecnumwidth}{0em}
%    \end{macrocode}
%
% \changes{v3.1d}{2025/03/03}{根据 \issue[228] 更新深圳硕士中期目录样式}
% \changes{v3.1d}{2025/03/03}{将目录格式统一成深圳样式，除去深圳硕士开题报告的目录页有页眉}
%    \begin{macrocode}
%  \ifhit@shenzhen
%    \ifhit@interim
\dim_set:Nn \cftsecnumwidth {1em}% 目录中的section条目序号和标题之间的距离
\dim_set:Nn \cftsubsecnumwidth {1.7em}% 目录中的subsection条目序号和标题之间的距离
\dim_set:Nn \cftsubsubsecnumwidth {2.4em}% 目录中的subsubsection条目序号和标题之间的距离
%    \end{macrocode}
%
% \emph{正文照终稿排的那一档，目录也照 Word 排。}深圳本科那两份原件的目录，
% 标题那一块与正文的章标题是同一档：段前一行、黑体小二居中、段后 0.8 行，
% 基线落在版心顶起 30.23（原件量得整页 137.98），与正文第一章的标题同数。
% 所以标题直接用 \cs{docxlike\_format\_par:nn} 按 \option{Heading 1} 那个样式排，
% \pkg{tocloft} 的 \cs{cftbeforetoctitleskip} 与 \cs{cftaftertoctitleskip}
% 一并归零，间距全由 \option{styles} 给。
%
% 条目交给 \pkg{docxlike} 的目录条目（\cs{docxlike\_toc\_entry:nnnnn}），与终稿那一份目录同一个
% 排法：样式 \texttt{TOC1} 到 \texttt{TOC3}（报告的节就是章，所以节是一级、条二级、款三级），
% 行盒按内容的字体摞（起头与终稿一样按条目自己那一档垫，\cs{docxlike\_format\_stack\_seed:n}
% \texttt{\{TOC1\}}；先前按标题那一块起头，头一条比 Windows Word 的导出件低 3.69），每行排到
% 制表位、只有末行给点线与页码让路，折行悬挂到题名首字（指南 3.6），题序后空一个字，点线是
% Times 句点贴排。编号的排法与终稿共用（\cs{\_\_hit\_toc\_numberline:n}）。条目仍从
% \pkg{tocloft} 的 \cs{tableofcontents} 进来，只把 \cs{l@section} 这三个换成调它。
%
%
% \emph{英文版的章条目整行加粗。} 两份英文原件的“目录 1”样式都写着 \texttt{w:b}，
% Windows Word 导出件里题名、点线、页码都是 Times 粗体；中文版那一份没写，不加。
%
% \emph{目录之后还有一个空段。} 原件目录那一节的最后一段是空的，与目录标题同一档（二号、段前
% 一行、段后 0.8 行、1.25 倍），分节符就在它上面。它的段后 9.6 留在目录页，可 Word 合并段距的
% 办法是拿下一段的段前减上一段的段后，跨了页也照减，于是正文第一章的标题在新页页首只剩
% $12 - 9.6 = 2.4$ 的段前：Windows Word 导出的三份原件里第一章标题都比目录标题高 9.6
% （128.2 对 137.8，英文版 127.0 对 136.6）。这里照排这一段（\cs{hit@report@toc@tail:}，
% 首页那边排完目录就调它；不可见），段距那一本账交给 \pkg{docxlike}。别的档什么都不做。
% 不挂在 \pkg{tocloft} 身上：这一版没有 \cs{cftaftertoc}，收尾的 \cs{@cfttocfinish} 图表清单也用。
%
% 页首那一段段前 \hologo{TeX} 会在分页处丢掉，Word 不丢，所以标题前先发一条
% 零高的 \cs{hrule} 把这一页垫成非空，\cs{topskip} 一并归零。标题这一段照“标题 1”
% 排，段上写“编号：无”：正文的“标题 1”链接着编号列表，目录标题不编号。本部与威海的
% 报告正文的“标题 1”是节，目录标题另用 \texttt{toc-heading}（Word 的“TOC 标题”），
% 使用章标题的格式（威海硕士开题取终稿章标题格式）；
% 目录之后那个空段也只有深圳本科那两份原件有。
%
% topskip 只在目录分组内清零，泄漏到外层会使后续 clearpage 产生空白页。
%
% \emph{英文版的章条目整行加粗。} 两份英文原件的“目录 1”样式都写着 \texttt{w:b}，
% Windows Word 导出件里题名、点线、页码都是 Times 粗体；中文版那一份没写，不加。
% 终稿英文目录的章条目也是粗的（\cs{hit@toc@chapter@line@font}）。
%    \begin{macrocode}
\cs_new_protected:Npn \__hit_report_toc_entry:nnn #1#2#3
  {
    \int_compare:nNnF {#1} > { \c@tocdepth }
      {
        \group_begin:
          \int_set:Nn \l_docxlike_toc_level_int {#1}
          \tl_clear:N \l_docxlike_toc_label_tl
          \__hit_tristate_if:NnTF \g__hit_toc_latin_natural_tl { \c_true_bool }
            { } { \bool_set_false:N \l_docxlike_toc_latin_line_bool }
          \cs_set_protected:Npn \numberline { \__hit_toc_numberline:n }
          \bool_lazy_all:nTF
            {{\bool_if_p:N\g__hit_en_bool}{\int_compare_p:nNn{#1}={1}}{!\bool_if_p:N\g__hit_shenzhen_report_bool}}
            { \docxlike_toc_entry:nnnnn { TOC #1 } { font = { font-style = bold } } {#2} {#3} { } }
            { \docxlike_toc_entry:nnnnn { TOC #1 } { } {#2} {#3} { } }
        \group_end:
      }
  }
\cs_new_protected:Npn \hit@report@toc@tail: { }
\tl_new:N \g__hit_report_toc_title_style_tl
\tl_gset:Nx \g__hit_report_toc_title_style_tl
  { \bool_if:NTF \g__hit_shenzhen_bool { Heading1 } { toc-heading } }
\bool_if:NT\g__hit_shenzhen_report_bool{\tl_gset:Nn\g__hit_report_toc_title_style_tl{toc-heading}}
\bool_if:NT \g__hit_final_body_bool
  {
    \dim_zero:N \cftbeforetoctitleskip
    \dim_zero:N \cftaftertoctitleskip
    \dim_zero:N \cftbeforesecskip
    \dim_zero:N \cftbeforesubsecskip
    \dim_zero:N \cftbeforesubsubsecskip
    \cs_set:Npn \cfttitlecommand #1
      {
        \@cftpagestyle
        \dim_zero:N \topskip
        \hrule ~ height ~ \c_zero_dim
        \bool_set_false:N \l_docxlike_format_latin_pick_bool
        \exp_args:NV \docxlike_format_par:nnn \g__hit_report_toc_title_style_tl
          { numbering = none } { \use:c { cft #1 titlename } }
        \use:c { cftmark #1 }
        \docxlike_format_stack_seed:n { TOC1 }
        \dim_set:Nn \lineskiplimit { - \maxdimen }
        \@afterheading
      }
    \cs_set:Npn \l@section #1#2 { \__hit_report_toc_entry:nnn { 1 } {#1} {#2} }
    \cs_set:Npn \l@subsection #1#2 { \__hit_report_toc_entry:nnn { 2 } {#1} {#2} }
    \cs_set:Npn \l@subsubsection #1#2 { \__hit_report_toc_entry:nnn { 3 } {#1} {#2} }
    \bool_lazy_and:nnT{\bool_if_p:N\g__hit_shenzhen_bool}{\bool_if_p:N\g__hit_bachelor_bool}
      {
        \cs_set_protected:Npn \hit@report@toc@tail:
          {
            \group_begin:
              \docxlike_format_compute:n { Heading1 }
              \use:e
                {
                  \exp_not:N \parmark
                    [
                      font = { size = \dim_use:N \l_docxlike_format_size_dim } ,
                      paragraph = { spacing = { line-spacing = multiple , at = 1.25 ,
                        before = \dim_use:N \l_docxlike_format_before_dim ,
                        after = \dim_use:N \l_docxlike_format_after_dim } }
                    ]
                }
            \group_end:
          }
      }
  }
%    \fi
%  \fi
%  \ifboolexpr{ bool {hit@weihai} or bool {hit@interim}}{\tocloftpagestyle{empty}}{\tocloftpagestyle{hit@shenzhen@headings@front}}
\bool_if:NTF\g__hit_shenzhen_report_bool
  {\tocloftpagestyle{hit@shenzhen@toc}}
  {\bool_if:NTF\g__hit_harbin_report_bool
    {\tocloftpagestyle{hit@empty}}{\tocloftpagestyle{hit@headings@front}}}
%    \end{macrocode}
