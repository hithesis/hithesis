% \section{答辩决议页}
%
%    \begin{macrocode}
%<*thesis-resolution>
%    \end{macrocode}
%
% \changes{v3.2a}{0000/00/00}{\cs{resolution} 迁到 expl3}
%    \begin{macrocode}
\NewDocumentCommand \resolution { s o }
  {
    \hit@if@option@TF { doctor }
      {
        \IfNoValueTF {#2}
          {
            \hit@clear@page
            \hit@appendix@chapter * { \hit@resolution@heading@zh }
              [ \hit@resolution@heading@en ]
            \begin{center}
              \includegraphics [ width=\textwidth ] { figures/empty-resolution.pdf }
            \end{center}
          }
          {% 有文件，读入 PDF
            \hit@clear@page
            \phantomsection
            \addcontentsline { toc } { chapter } { \hit@resolution@heading@zh }
            \addcontentsline { toe } { chapter }
              {
                \texorpdfstring
                  { \bfseries \hit@resolution@heading@en } { \hit@resolution@heading@en }
              }
            \IfBooleanTF {#1}
              {% 有星号，显示页码
                \includepdf
                  [ fitpaper=true , pages=- ,
                    pagecommand={\thispagestyle{hit@scanpage}} ] {#2}
              }
              {% 无星号，不显示页码
                \includepdf
                  [ fitpaper=true , pages=- ,
                    pagecommand={\thispagestyle{empty}} ] {#2}
              }
          }
      }
      { }
  }
%    \end{macrocode}
