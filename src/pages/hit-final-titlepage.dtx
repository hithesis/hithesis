  }
%    \end{macrocode}
%
% 英文范例的字段格左右边距各 5.4 bp。单行标签和内容用固定 22 bp 行距，
% 多行内容用固定 18 bp；先按 18 bp 试排，若只有一行，再用标签行距重排。
% 行高取标签与内容两者的较大值，多行内容超出的高度在行后补足。
%
% 内容在标签段之前测量，避免试排改变标签段的全局状态。固定行距交给 docxlike，
% 测量盒重新封装为顶对齐盒后，盒高就是首行基线到盒顶的距离；按此距离与标签行顶对齐。
% 放入标签段前清除内容盒的高深，超出标签行的实际高度另在行后补足，避免重复增加行高。
% Affiliation 与 Date of Defence 使用单独的紧缩样式；全角冒号按范例使用粗黑体。
%    \begin{macrocode}
\dim_const:Nn \c__hit_titlepage_en_value_lead_dim { 18bp }
\dim_new:N \l__hit_titlepage_label_lead_dim
\dim_new:N \l__hit_titlepage_lead_dim
\dim_new:N \l__hit_titlepage_value_height_dim
\box_new:N \l__hit_titlepage_value_box
\cs_new_protected:Npn \__hit_titlepage_en_value_box:nn #1#2
  {
    \docxlike_format_measure:Nn \l__hit_titlepage_value_box
      {
        \dim_set:Nn \tex_prevdepth:D { -1000pt }
        \dim_set:Nn \hsize
          { \c__hit_titlepage_en_value_dim - 2 \c__hit_titlepage_en_cell_margin_dim }
        \dim_set_eq:NN \linewidth \hsize
        \dim_zero:N \parindent
        \skip_zero:N \parskip
        \cs_set_eq:NN \\ \newline
        \docxlike_format_par:nnn {#1}
          {
            paragraph =
              {
