      \hitenter*[lines=1,font={size=xiaosi,asian-text-font=SimSun},paragraph={spacing={line-spacing=multiple,at=1}}]
      \int_compare:nNnT {#1} < { 3 }
        { \hitenter*[lines=1,font={size=xiaoer,latin-text-font=Times New Roman},paragraph={spacing={line-spacing=exactly,at=39.5bp}}] }
      \hit@titlepage@en@title:
      \hitenter*[lines=1,font={size=xiaosi,asian-text-font=SimSun},paragraph={spacing={line-spacing=multiple,at=1}}]
      \hitenter*[lines=1,font={size=xiaosi,asian-text-font=SimSun},paragraph={spacing={line-spacing=multiple,at=1}}]
      \int_compare:nNnT {#1} < { 2 }
        { \hitenter*[lines=\int_eval:n{2-#1},font={size=erhao,latin-text-font=Times New Roman},paragraph={spacing={line-spacing=exactly,at=39.5bp}}] }
      \hit@titlepage@en@fields:
  }
