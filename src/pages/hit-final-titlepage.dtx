% 英文封面。\cs{emultiline} 给过长的取值（学院的英文名）手动换行。英文内封的取值格在 Word 里是表的
% 一格，几行是格里的几段，固定值 18\,bp、段前段后为零，与一段里换行排出来一样，所以在段里就把
% |\\| 当换行，字段行按测得的内容盒高撑高。在盒里（深圳本科报告封面的
% 字段）没有段可换行，照旧用 \env{tabular} 摞起来。可选参数是 \env{tabular} 的对齐，段里用不上。
\NewDocumentCommand \emultiline { O{c} m }
  {
    \mode_if_vertical:T { \mode_leave_vertical: }
    \mode_if_inner:TF
      {
        \group_begin:
          \cs_set:Npn \arraystretch { 1 }
          \begin { tabular } [#1] { @{}l@{} } #2 \end { tabular }
        \group_end:
        \c_space_tl
      }
      {#2}
  }
%    \end{macrocode}
%
% 英文内封保留默认序列；只有整页放不下才让掉大空段。先减字段表前的两个
% 39.5 bp 空段，再减题目前的一个。其余空段、字号及字段行距不参与这一步优化。
% 每个候选都由 docxlike 完整试排，连同自动折行的字段量高；页首补上实际会产生的
% \cs{topskip}，防止接近版心下沿的候选在实排时多出一页。
%    \begin{macrocode}
\int_new:N \l__hit_titlepage_en_removed_int
\bool_new:N \l__hit_titlepage_en_fit_bool
\dim_new:N \l__hit_titlepage_en_height_dim
\cs_new_protected:Npn \__hit_titlepage_en_measure:n #1
  {
    \docxlike_format_measure:Nn \l__hit_titlepage_box
      {
        \dim_set:Nn \tex_prevdepth:D { -1000pt }
        \dim_set_eq:NN \hsize \textwidth
        \dim_set_eq:NN \linewidth \textwidth
        \dim_zero:N \parindent
        \skip_zero:N \parskip
        \hit@titlepage@en@body:n {#1}
      }
    \vbox_set_top:Nn \l__hit_titlepage_box
      { \vbox_unpack_drop:N \l__hit_titlepage_box }
    \dim_set:Nn \l__hit_titlepage_en_height_dim
      {
        \box_ht_plus_dp:N \l__hit_titlepage_box
        + \dim_max:nn { 0pt } { \topskip - \box_ht:N \l__hit_titlepage_box }
      }
  }
\cs_new_protected:Npn \__hit_titlepage_en_fit:
  {
    \bool_set_false:N \l__hit_titlepage_en_fit_bool
    \int_step_inline:nnn { 0 } { 3 }
      {
        \bool_if:NF \l__hit_titlepage_en_fit_bool
          {
            \int_set:Nn \l__hit_titlepage_en_removed_int {##1}
            \__hit_titlepage_en_measure:n {##1}
            \dim_compare:nNnF { \l__hit_titlepage_en_height_dim } > { \textheight }
              { \bool_set_true:N \l__hit_titlepage_en_fit_bool }
          }
      }
    \bool_if:NF \l__hit_titlepage_en_fit_bool
      { \msg_warning:nn { hithesis } { titlepage-en-overflow } }
  }
\cs_new_protected:Npn \hit@titlepage@en@body:n #1
  {
      \docxlike_format_par:nn { titlepage-en-mark }
        {
          \hit@term@titlepage@classified@index@national@en :~
          \hit@info@classified@index
        }
