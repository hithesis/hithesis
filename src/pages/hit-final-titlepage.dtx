%
% \section{内封}
%
% \changes{v4.0a}{2026/10/06}{本科三校区内封统一，学位论文及博士后内封按对应 Word 模板排版；
%   长题目可缩减间隔段，英文信息栏支持折行，空字段不占行，标签与内容分别应用样式}
% \changes{v4.0a}{2026/10/13}{中文内封通过 docxlike 试排量高，自动减空段不再消耗实排的段落状态}
% \changes{v4.0a}{2026/10/13}{英文内封按实际标题样式测量自动字号，二号使用单段直接格式，不再改写标题样式}
% \changes{v4.0a}{2026/10/13}{英文内封字段使用 docxlike 排段及测量，以实际盒高和首行位置对齐，不再手算行高与基线偏移}
% \changes{v4.0a}{2026/10/13}{英文内封整页试排，放不下时依次缩减题目前后的三个大空段，仍溢出时给出警告}
% \changes{v4.0a}{2026/10/13}{英文内封自动字号使用有界量宽；含排版命令的题目按定宽段落试排，避免超限横盒}
%
%    \begin{macrocode}
%<*final-titlepage>
\bool_if:NT \g__hit_final_bool
  {
%    \end{macrocode}
%
% \changes{v3.1d}{2025/03/03}{增加哈尔滨本科的第二封面。\issue[172]}
% 内封按博士后、本科、硕博三种版式分派。
%    \begin{macrocode}
\cs_new_protected:Npn \hit@titlepage
  {
    \bool_if:NTF \g__hit_postdoc_bool
      { \hit@titlepage@postdoc }
      {
        \bool_if:NTF \g__hit_bachelor_bool
          { \hit@titlepage@bachelor }
          { \hit@titlepage@other }
      }
  }
%    \end{macrocode}
%
% 内封照《出站报告封皮模板》第二页排，与封面同一节，所以也是只有行网格、行跨度 16.3\,bp。
% 这一页的单倍段与 1.5 倍段都贴网格：三号题目一行占两格，四号英文题目一行一格（纯西文的行
% 按 Times 算行高，16.1 不到一格），六行四号的栏目（1.5 倍）一行两格。中文题目与封面一样是
% 两段，取题目的上下两部分，第二部分空着也留那一段。栏目下面那个 1.5 倍的空段按空段排
% （\cs{hitenter*}）：段落标记是 Times，单倍不到一格，1.5 倍就是 1.5 格，24.45\,bp；
% 当成有字的段按宋体算会是两格。栏目段首行缩进 1400 缇即五个字，栏名撑到七个字、研究工作起止时间
% 那两行八个字，模板里冒号就是错开的，照排。
%    \begin{macrocode}
\cs_new_protected:Npn \__hit_titlepage_postdoc_field:nn #1#2
  {
    \docxlike_format_par:nnn { cover-postdoc }
      {
        paragraph =
          {
            indentation = { special = first-line , by = 70bp } ,
            spacing = { line-spacing = multiple , at = 1.5 } ,
          } ,
      }
      { #1 \hit@term@titlepage@separator@postdoc #2 }
  }
\cs_new_protected:Npn \hit@titlepage@postdoc
  {
    \hit@layout@push@part:n { titlepage }
    \group_begin:
      \dim_zero:N \parindent
      \dim_zero:N \parskip
      \docxlike_format_par:nnn { cover-postdoc }
        { font = { size = sanhao } , paragraph = { spacing = { line-spacing = single } } }
        { \textcolor [ rgb ] { 1 , 1 , 1 } { \hit@term@titlepage@hi } }
      \docxlike_format_par:nnn { cover-postdoc }
        {
          font = { size = sanhao } ,
          paragraph = { alignment = centered , spacing = { line-spacing = single } } ,
        }
        { \hit@info@title@line@one@zh }
      \docxlike_format_par:nnn { cover-postdoc }
        {
          font = { size = sanhao } ,
          paragraph = { alignment = centered , spacing = { line-spacing = single } } ,
        }
        { \hit@info@title@line@two@zh }
      \docxlike_format_par:nnn { cover-postdoc } { font = { size = sanhao } } { }
      \docxlike_format_par:nnn { cover-postdoc }
        {
          font = { all-caps = true , latin-line = true } ,
          paragraph = { alignment = centered , spacing = { line-spacing = single } } ,
        }
        { \hit@info@title@cover@en }
      \prg_replicate:nn { 2 }
        {
          \docxlike_format_par:nnn { cover-postdoc }
            { font = { size = sanhao } , paragraph = { spacing = { line-spacing = single } } } { }
        }
      \prg_replicate:nn { 2 } { \docxlike_format_par:nnn { cover-postdoc } { } { } }
      \__hit_titlepage_postdoc_field:nn
        { \hit@term@titlepage@author@postdoc@zh } { \hit@info@author@zh }
      \__hit_titlepage_postdoc_field:nn
        { \hit@term@titlepage@co@supervisor@postdoc@zh } { \hit@info@supervisor@zh }
      \__hit_titlepage_postdoc_field:nn
        { \hit@term@titlepage@station@postdoc } { \hit@info@station@zh }
      \__hit_titlepage_postdoc_field:nn
        { \hit@term@titlepage@major@postdoc@zh } { \hit@info@speciality@zh }
      \__hit_titlepage_postdoc_field:nn
        { \hit@term@titlepage@research@start@date@postdoc } { \hit@info@research@start@date@zh }
      \__hit_titlepage_postdoc_field:nn
        { \hit@term@titlepage@research@end@date@postdoc } { \hit@info@research@end@date@zh }
      \hitenter*
        [
          font = { size = sihao , latin-text-font = Times~New~Roman } ,
          paragraph = { spacing = { line-spacing = multiple , at = 1.5 } } ,
        ]
      \prg_replicate:nn { 3 }
        {
          \docxlike_format_par:nnn { cover-postdoc }
            {
              paragraph =
                {
                  alignment = centered ,
                  spacing = { line-spacing = exactly , at = 12bp , before = 8.15bp , after = 8.15bp } ,
                } ,
            }
            { }
        }
      \docxlike_format_par:nnn { cover-postdoc }
        {
          paragraph =
            {
              alignment = centered ,
              spacing = { line-spacing = exactly , at = 12bp , before = 8.15bp , after = 8.15bp } ,
            } ,
        }
        { \hit@term@titlepage@university@zh （ \hit@term@titlepage@campus ） }
      \docxlike_format_par:nnn { cover-postdoc }
        {
          paragraph =
            { alignment = centered , spacing = { line-spacing = multiple , at = 1.5 } } ,
        }
        { \hit@info@date@zh }
    \group_end:
    \hit@layout@pop@part:
  }
%    \end{macrocode}
% \begin{macro}{\hit@titlepage@line}
% 第二封面的信息表不画下划线，字段名走黑体。哈尔滨本科那张七行、其余那张九行，
% 行型完全一样。带星号的不出 \cs{\textbackslash\textbackslash}，给最后一行用。
%    \begin{macrocode}
\NewDocumentCommand \hit@titlepage@line { s m m }
  { {\heiti \hit@put@title{#2}}~&~#3 \IfBooleanF {#1} { \\ ~ } }
%    \end{macrocode}
% \end{macro}
% 勾选框在 \file{src/pages/hit-checkbox.dtx}，与深圳本科报告首页共用。
%    \begin{macro}{\hit@titlepage@bachelor}
%    \begin{macrocode}
%    \end{macrocode}
%
% 本科内封与外封的网格行距相同，linePitch 为 395 缇（19.75 bp）。
% 序列取值（本科书写范例第三页，批注段换成同高空段）：
% \begin{itemize}
%   \item 标签，宋体小二加粗，不贴网格
%   \item 中文题目，黑体二号，\emph{贴网格}
%   \item 题目与字段之间三个间隔段，\texttt{w:line="780" w:lineRule="exact"}，
%         即固定值 39\,bp
%   \item 字段表，定宽三列 1806 / 301 / 2951 缇，居中、无单元格边距，
%         行高最小 540 缇；每行 \texttt{w:line="360"} 即 1.5 倍，且贴网格，
%         所以行距是 $1.5 \times 19.75 = 29.625$，不是 $1.5 \times$ 自然行高
% \end{itemize}
%
% 范例首页只有密级，当前模板还含论文/设计勾选框；比较版面时应核对段间距，不能直接比较绝对基线。
%    \begin{macrocode}
\tl_const:Nn \c__hit_titlepage_layout_tl { document-grid / lines / pitch = 19.75bp , }
\dim_const:Nn \c__hit_titlepage_label_dim { 90.3bp }
\dim_const:Nn \c__hit_titlepage_colon_dim { 15.05bp }
\dim_const:Nn \c__hit_titlepage_value_dim { 147.55bp }
%    \end{macrocode}
%
% 先以零间隔段试排，按剩余版心高度计算可加入的 39 bp 空段数，最多三个。
% 增加导师字段或题目折行时，由这些间隔段让出空间。
% \cs{hit@titlepage@fit:N} 的参数宏接受间隔段数，计算结果保存在对应整型变量中。
% 内容按 docxlike 的段落规则试排，测量后恢复状态；间隔段数及溢出处理仍由本模块决定。
%    \begin{macrocode}
\box_new:N \l__hit_titlepage_box
\int_new:N \l__hit_titlepage_gap_int
\dim_const:Nn \c__hit_titlepage_gap_dim { 39bp }
%    \end{macrocode}
%
% 英文内封使用两列字段表，标签和内容分别量高并按行顶对齐。
%    \begin{macrocode}
\dim_const:Nn \c__hit_titlepage_en_label_dim { 213.1bp }
\dim_const:Nn \c__hit_titlepage_en_value_dim { 220.3bp }
\dim_const:Nn \c__hit_titlepage_en_cell_margin_dim { 5.4bp }
\cs_new_protected:Npn \hit@titlepage@fit:N #1
  {
    \docxlike_format_measure:Nn \l__hit_titlepage_box
      {
        \dim_set:Nn \tex_prevdepth:D { -1000pt }
        \dim_set_eq:NN \hsize \textwidth
        \dim_set_eq:NN \linewidth \textwidth
        \dim_zero:N \parindent
        \dim_zero:N \parskip
        #1 { 0 }
      }
    \int_set:Nn \l__hit_titlepage_gap_int
      {
        \int_min:nn { 3 }
          {
            \fp_to_int:n
              {
                floor
                  (
                    \dim_to_fp:n
                      { \textheight - \box_ht_plus_dp:N \l__hit_titlepage_box }
                    / \dim_to_fp:n { \c__hit_titlepage_gap_dim }
                  )
              }
          }
      }
    \int_compare:nNnT { \l__hit_titlepage_gap_int } < { 0 }
      {
        \msg_warning:nn { hithesis } { titlepage-overflow }
        \int_zero:N \l__hit_titlepage_gap_int
      }
  }
%    \end{macrocode}
%
%    \begin{macrocode}
\cs_new_protected:Npn \hit@titlepage@field:nn #1#2
  {
    \docxlike_format_par:nn { titlepage-field }
      {
        \hbox_to_wd:nn { \c__hit_titlepage_label_dim }
          { \heiti \hit@put@title {#1} \hfil }
        \hbox_to_wd:nn { \c__hit_titlepage_colon_dim }
          { \hit@term@titlepage@title@separator@zh \hfil }
        \hbox_to_wd:nn { \c__hit_titlepage_value_dim } { #2 \hfil }
      }
  }
\cs_new_protected:Npn \hit@titlepage@en@degree:
  { \hit@term@titlepage@degree@sentence }
%    \end{macrocode}
%
% 自动字号仍按二号题目的一行总宽是否超过 450 mm 判定，但字体、粗体、字距与
% 大小写须照实际的标题样式量；副题是否显示也与实排使用同一份内容。
% 二号只覆盖这一段的字号，不能用全局样式设置再套分组来模拟直接格式。
%    \begin{macrocode}
\tl_new:N \l__hit_titlepage_en_caps_tl
\tl_new:N \l__hit_titlepage_en_measure_text_tl
\bool_new:N \l__hit_titlepage_en_plain_bool
\bool_new:N \l__hit_titlepage_en_clipped_bool
\dim_new:N \l__hit_titlepage_en_width_dim
\dim_new:N \l__hit_titlepage_en_line_dim
\int_new:N \g__hit_titlepage_en_probe_badness_int
\box_new:N \l__hit_titlepage_en_probe_box
\dim_const:Nn \c__hit_titlepage_en_width_limit_dim { 450mm }
\tl_new:N \l__hit_titlepage_en_text_tl
\cs_new_protected:Npn \__hit_titlepage_en_title_prepare:
  {
    \hit@title@compose:nnN { en } { \hit@term@titlepage@title@separator@en }
      \l__hit_titlepage_en_text_tl
  }
\cs_new:Npn \hit@titlepage@en@title@text:
  { \tl_use:N \l__hit_titlepage_en_text_tl }
\cs_new_protected:Npn \__hit_titlepage_en_title_measure:
  {
    \skip_if_exist:NF \hit@etitlelength { \skip_new:N \hit@etitlelength }
    \group_begin:
      \char_set_active_eq:nN { 126 } \c_space_tl
      \__hit_titlepage_en_title_prepare:
      \tl_set_eq:NN \l__hit_titlepage_en_measure_text_tl \l__hit_titlepage_en_text_tl
      \cs_set:Npn \% { \c_percent_str }
      \cs_set:Npn \# { \c_hash_str }
      \cs_set:Npn \& { \char_generate:nn { 38 } { 12 } }
      \cs_set:Npn \_ { \c_underscore_str }
      \cs_set:Npn \$ { \c_dollar_str }
      \cs_set:Npn \{ { \c_left_brace_str }
      \cs_set:Npn \} { \c_right_brace_str }
      \protected@edef \l__hit_titlepage_en_measure_text_tl
        { \l__hit_titlepage_en_measure_text_tl }
      \bool_set_true:N \l__hit_titlepage_en_plain_bool
      \tl_map_inline:Nn \l__hit_titlepage_en_measure_text_tl
        {
          \tl_if_single_token:nTF {##1}
            {
              \token_if_cs:NT ##1
                {
                  \clist_if_in:nnF { \%, \#, \&, \_, \$, \{, \} } {##1}
                    { \bool_set_false:N \l__hit_titlepage_en_plain_bool }
                }
            }
            { \bool_set_false:N \l__hit_titlepage_en_plain_bool }
        }
      \docxlike_format_with:nnn { titlepage-en-title }
        { font = { size = erhao } }
        {
          \docxlike_format_apply_par:n { titlepage-en-title }
          \bool_if:NTF \l__hit_titlepage_en_plain_bool
            {
              \docxlike_format_get:nnN { titlepage-en-title } { rPr/caps }
                \l__hit_titlepage_en_caps_tl
              \str_if_eq:VnT \l__hit_titlepage_en_caps_tl { true }
                {
                  \tl_set:Ne \l__hit_titlepage_en_measure_text_tl
                    { \text_uppercase:V \l__hit_titlepage_en_measure_text_tl }
                }
              \docxlike_format_measure_width:nnNN { \c__hit_titlepage_en_width_limit_dim }
                { \l__hit_titlepage_en_measure_text_tl }
                \l__hit_titlepage_en_width_dim \l__hit_titlepage_en_clipped_bool
            }
            { \__hit_titlepage_en_title_probe: }
        }
      \use:e
        {
          \exp_not:N \group_end:
          \exp_not:N \skip_set:Nn \exp_not:N \hit@etitlelength
            { \dim_use:N \l__hit_titlepage_en_width_dim }
          \bool_if:NTF \l__hit_titlepage_en_clipped_bool
            { \exp_not:N \bool_set_true:N } { \exp_not:N \bool_set_false:N }
          \exp_not:N \l__hit_titlepage_en_clipped_bool
        }
  }
% 含排版命令时保留实际内容，定宽试排是否折行，不把排版命令传给纯文本接口。
% 试排使用统一的固定行高以区分一行与多行，不让中西文字体的自然高差误判折行；实排行距不变。
\cs_new_protected:Npn \__hit_titlepage_en_title_probe:
  {
    \dim_set:Nn \l__hit_titlepage_en_line_dim { 2 \l_docxlike_format_size_dim }
    \int_gzero:N \g__hit_titlepage_en_probe_badness_int
    \docxlike_format_measure:Nn \l__hit_titlepage_en_probe_box
      {
        \dim_set:Nn \tex_prevdepth:D { -1000pt }
        \dim_set_eq:NN \hsize \c__hit_titlepage_en_width_limit_dim
        \dim_set_eq:NN \linewidth \hsize
        \dim_set:Nn \hfuzz { \c_max_dim }
        \exp_args:NV \__hit_titlepage_en_title_probe_text:n \l__hit_titlepage_en_text_tl
      }
    \bool_set:Nn \l__hit_titlepage_en_clipped_bool
      {
        \dim_compare_p:nNn { \box_ht_plus_dp:N \l__hit_titlepage_en_probe_box }
          > { \l__hit_titlepage_en_line_dim + 4sp }
        || \int_compare_p:nNn { \g__hit_titlepage_en_probe_badness_int } > { 10000 }
      }
    \dim_set_eq:NN \l__hit_titlepage_en_width_dim \c__hit_titlepage_en_width_limit_dim
  }
\cs_new_protected:Npn \__hit_titlepage_en_title_probe_text:n #1
  {
    \docxlike_format_par:nnn { titlepage-en-title }
      { paragraph = { spacing = { line-spacing = exactly , at = \dim_use:N \l__hit_titlepage_en_line_dim , before = 0bp , after = 0bp } } }
      {
        #1 \par
        \int_gset:Nn \g__hit_titlepage_en_probe_badness_int { \tex_badness:D }
      }
  }
\cs_new_protected:Npn \hit@titlepage@en@title:
  {
    \__hit_titlepage_en_title_prepare:
    \exp_args:NV \__hit_titlepage_en_title:n \l__hit_titlepage_en_text_tl
  }
\cs_new_protected:Npn \__hit_titlepage_en_title:n #1
  {
    \str_case:VnF \g_hit_titlepage_title_en_xiaoer_tl
      {
        { true } { \docxlike_format_par:nn { titlepage-en-title } }
        { auto }
          {
            \__hit_titlepage_en_title_measure:
            \bool_if:NTF \l__hit_titlepage_en_clipped_bool
              { \docxlike_format_par:nn { titlepage-en-title } }
              { \hit@titlepage@en@title@erhao:n }
          }
      }
      { \hit@titlepage@en@title@erhao:n }
      {#1}
  }
\cs_new_protected:Npn \hit@titlepage@en@title@erhao:n #1
  {
    \docxlike_format_par:nnn { titlepage-en-title }
      { font = { size = erhao } } {#1}
  }
% 判空前展开字段，避免把空字段的宏名误判为非空内容。
\cs_new_protected:Npn \hit@titlepage@en@fields:
  {
    \hit@titlepage@en@field:nn
      { \hit@term@titlepage@author@en } { \hit@info@author@en }
    \hit@titlepage@en@field:nn
      { \hit@term@titlepage@supervisor@en } { \hit@info@supervisor@en }
    \hit@titlepage@en@field:nn
      { \hit@term@titlepage@associate@supervisor@en }
      { \hit@info@associate@supervisor@en }
    \hit@titlepage@en@field:nn
      { \hit@term@titlepage@industry@supervisor@en } { \hit@info@industry@supervisor@en }
    \hit@titlepage@en@field:nn
      { \hit@term@titlepage@degree@applied@en } { \hit@info@degree@applied@en }
    \hit@titlepage@en@field:nn
      { \hit@term@titlepage@major@en } { \hit@info@speciality@en }
    \__hit_titlepage_en_field:nnn { titlepage-en-value-condensed }
