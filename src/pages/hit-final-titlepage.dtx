% \begin{macro}{\hit@titlepage@line}
% 第二封面的信息表不画下划线，字段名走黑体。哈尔滨本科那张七行、其余那张九行，
% 行型完全一样。带星号的不出 \cs{\textbackslash\textbackslash}，给最后一行用。
%    \begin{macrocode}
\NewDocumentCommand \hit@titlepage@line { s m m }
  { {\heiti \hit@put@title{#2}}~&~#3 \IfBooleanF {#1} { \\ ~ } }
%    \end{macrocode}
% \end{macro}
% 勾选框在 \file{src/pages/hit-checkbox.dtx}，与深圳本科报告首页共用。
%    \begin{macro}{\hit@titlepage@bachelor}
%    \begin{macrocode}
%    \end{macrocode}
%
% 内封那一节与封面同档，\texttt{docGrid} 的 \texttt{linePitch} 是 395 缇。
% 序列取值（本科书写范例第三页，批注段换成同高空段）：
% \begin{itemize}
%   \item 标签，宋体小二加粗，不贴网格
%   \item 中文题目，黑体二号，\emph{贴网格}
%   \item 题目与字段之间三个间隔段，\texttt{w:line="780" w:lineRule="exact"}，
%         即固定值 39\,bp
%   \item 字段表，定宽三列 1806 / 301 / 2951 缇，居中、无单元格边距，
%         行高最小 540 缇；每行 \texttt{w:line="360"} 即 1.5 倍，且贴网格，
%         所以行距是 $1.5 \times 19.75 = 29.625$，不是 $1.5 \times$ 自然行高
% \end{itemize}
%
% 范例那一页第一行是“密级：公开”，我们这一版第一行还带毕业论文与毕业设计的
% 勾选框，两份模板不同版，所以绝对基线不对拍，对的是相对间距。
%    \begin{macrocode}
\tl_const:Nn \c__hit_titlepage_layout_tl { document-grid / lines / pitch = 19.75bp , }
\dim_const:Nn \c__hit_titlepage_label_dim { 90.3bp }
\dim_const:Nn \c__hit_titlepage_colon_dim { 15.05bp }
\dim_const:Nn \c__hit_titlepage_value_dim { 147.55bp }
%    \end{macrocode}
%
% 题目与字段之间那三个间隔段是内封唯一可让的地方。范例那一页七个字段，而副导师、
% 合作导师这两项有就多两行，一行 29.625，三个间隔段共 117，正好抵四行。所以先按
% 没有间隔段排一遍量高，再看版心还剩多少、塞得下几个。
%
% \cs{hit@titlepage@fit:N}\meta{宏} 把\meta{宏}\marg{间隔段数}排一遍量高，
% 算出能塞下几个，存进 \cs{l\_\_hit\_titlepage\_gap\_int}。
%    \begin{macrocode}
\box_new:N \l__hit_titlepage_box
\int_new:N \l__hit_titlepage_gap_int
\dim_const:Nn \c__hit_titlepage_gap_dim { 39bp }
%    \end{macrocode}
%
% 英文内封的字段是 7 行 2 列的表，列宽 4262 与 4406 缇。范例里标签落在
% \texttt{x0=87.4}、取值落在 \texttt{x0=300.5}，两者差 213.1 正是第一列宽。
%    \begin{macrocode}
\dim_const:Nn \c__hit_titlepage_en_label_dim { 213.1bp }
\dim_const:Nn \c__hit_titlepage_en_value_dim { 220.3bp }
\cs_new_protected:Npn \hit@titlepage@fit:N #1
  {
    \vbox_set:Nn \l__hit_titlepage_box
      {
        \dim_set_eq:NN \hsize \textwidth
        \dim_set_eq:NN \linewidth \textwidth
        \dim_zero:N \parindent
        \dim_zero:N \parskip
        #1 { 0 }
      }
    \int_set:Nn \l__hit_titlepage_gap_int
      {
        \int_min:nn { 3 }
          {
            \fp_to_int:n
              {
                floor
                  (
                    \dim_to_fp:n
                      { \textheight - \box_ht_plus_dp:N \l__hit_titlepage_box }
                    / \dim_to_fp:n { \c__hit_titlepage_gap_dim }
                  )
              }
          }
      }
    \int_compare:nNnT { \l__hit_titlepage_gap_int } < { 0 }
      {
        \msg_warning:nn { hithesis } { titlepage-overflow }
        \int_zero:N \l__hit_titlepage_gap_int
      }
  }
%    \end{macrocode}
%
%    \begin{macrocode}
\cs_new_protected:Npn \hit@titlepage@field:nn #1#2
  {
    \docxlike_format_par:nn { titlepage-field }
      {
        \hbox_to_wd:nn { \c__hit_titlepage_label_dim }
          { \heiti \hit@put@title {#1} \hfil }
        \hbox_to_wd:nn { \c__hit_titlepage_colon_dim }
          { \hit@term@titlepage@title@separator@zh \hfil }
        \hbox_to_wd:nn { \c__hit_titlepage_value_dim } { #2 \hfil }
      }
  }
\cs_new_protected:Npn \hit@titlepage@en@degree:
  { \hit@term@titlepage@degree@sentence }
\cs_new_protected:Npn \hit@titlepage@en@title:
  {
    \skip_if_exist:NF \hit@etitlelength { \skip_new:N \hit@etitlelength }
    \hbox_set:Nn \l_tmpa_box
      {
        \erhao \hit@info@title@cover@en
        \hit@if@subtitle@T
          { \hit@term@titlepage@title@separator@en \hit@info@title@subtitle@en }
      }
    \dim_set:Nn \hit@etitlelength { \box_wd:N \l_tmpa_box }
    \str_case:VnF \g_hit_titlepage_title_en_xiaoer_tl
      {
        { true } { \docxlike_format_par:nn { titlepage-en-title } }
        { auto }
          {
            \dim_compare:nNnTF { \hit@etitlelength } > { 450mm }
              { \docxlike_format_par:nn { titlepage-en-title } }
              { \hit@titlepage@en@title@erhao:n }
          }
      }
      { \hit@titlepage@en@title@erhao:n }
      {
        \hit@info@title@cover@en
        \hit@if@subtitle@T { \hit@term@titlepage@title@separator@en \hit@info@title@subtitle@en }
      }
  }
\cs_new_protected:Npn \hit@titlepage@en@title@erhao:n #1
  {
    \group_begin:
      \docxlike_format_set:n { titlepage-en-title = { font = { size = erhao } } }
      \docxlike_format_par:nn { titlepage-en-title } {#1}
    \group_end:
  }
% 各行没填就不排，判的是字段的值（\texttt{e} 型展开），从前 \texttt{n} 型判的是
% 宏名本身，永远非空，范例没有副导师的英文内封多出两行空标签。
\cs_new_protected:Npn \hit@titlepage@en@fields:
  {
    \hit@titlepage@en@field:nn
      { \hit@term@titlepage@author@en } { \hit@info@author@en }
    \hit@titlepage@en@field:nn
      { \hit@term@titlepage@supervisor@en } { \hit@info@supervisor@en }
    \hit@titlepage@en@field:nn
      { \hit@term@titlepage@associate@supervisor@en }
      { \hit@info@associate@supervisor@en }
    \hit@titlepage@en@field:nn
      { \hit@term@titlepage@co@supervisor@en } { \hit@info@co@supervisor@en }
    \hit@titlepage@en@field:nn
      { \hit@term@titlepage@degree@applied@en } { \hit@term@titlepage@degree@of@discipline@en }
    \hit@titlepage@en@field:nn
      { \hit@term@titlepage@major@en } { \hit@info@major@en }
    \hit@titlepage@en@field:nn
      { \hit@term@titlepage@affiliation@en } { \hit@info@affiliation@en }
    \hit@titlepage@en@field:nn
      { \hit@term@titlepage@date@en } { \hit@info@date@en }
    \hit@titlepage@en@field:nn
      { \hit@term@titlepage@institution@en } { \hit@term@titlepage@university@en }
  }
%    \end{macrocode}
%
% \emph{取值那一格要能折行。}范例的 Speciality 是 Mechanical Manufacturing and
% Automation，Word 里折成两行：取值格的段落是固定值 18\,bp（\texttt{w:line="360"
% exact}），格子左右各 5.4\,bp 的边距，可用宽 209.5\,bp；标签格是固定值 22\,bp。
% 一行的高是两格里高的那个，单行 22、折两行 36，范例里 Speciality 到 Affiliation
% 正是 36.0。这里取值排进一个顶对齐的 \cs{parbox}，行距钉 18\,bp，行数从
% \cs{prevgraf} 读，多出 22 的那一截在这一行后面补上。
%
% \emph{折行的那一格才收紧到 18。} 范例里单行的取值格与标签格同是固定值 22
% （\texttt{w:line="440"}），只有折成两行的 Speciality 那一格写 18
% （\texttt{w:line="360"}）：22 的两行是 44，那一行就比别人高出一截，收到 18
% 正好 36。所以这里先按 18 排一遍数行数，一行的改用标签那一格的固定值重排。
%
% \emph{两格的首行基线不一定在一条线上。} 固定值行距下基线落在格顶下方 0.8 倍
% 盒高（\cs{c\_docxlike\_format\_exact\_tl}），标签格 22 算下来 17.6，取值格 18
% 算下来 14.4，所以折行那一格的首行比标签高 3.2；单行的两格同值，也就同基线。
% \cs{parbox}\oarg{t} 是把首行基线对到当前基线上，差的正是这一段，装盒之后
% 抬一抬。范例里 Speciality 那一行取值 584.9、标签 587.9，正是这 3.0。
% 抬完把盒的高深都清零：这一行多高由标签那一格的撑杆定，折行多出来的那一截
% 在下面另补，盒子自己再参与一次行高的话每一行都会往下掉 3.2，逐行累加。
%    \begin{macrocode}
\dim_const:Nn \c__hit_titlepage_en_value_lead_dim { 18bp }
\dim_new:N \g__hit_titlepage_label_lead_dim
\dim_new:N \g__hit_titlepage_lead_dim
\dim_new:N \l__hit_titlepage_lead_dim
\int_new:N \g__hit_titlepage_value_lines_int
\box_new:N \l__hit_titlepage_value_box
\cs_new_protected:Npn \__hit_titlepage_en_value_box:n #1
  {
    \hbox_set:Nn \l__hit_titlepage_value_box
      {
        \parbox [t] { \c__hit_titlepage_en_value_dim - 10.8bp }
          {
            \dim_set_eq:NN \baselineskip \l__hit_titlepage_lead_dim
            \dim_set:Nn \lineskiplimit { -\maxdimen }
            \skip_zero:N \lineskip
            \skip_zero:N \parskip
            \raggedright
            #1 \par
            \int_gset:Nn \g__hit_titlepage_value_lines_int { \prevgraf }
          }
      }
  }
\cs_new_protected:Npn \hit@titlepage@en@field:nn #1#2
  {
    \tl_if_empty:eF {#2}
      {
        \docxlike_format_par:nn { titlepage-en-field }
          {
            \dim_gset_eq:NN \g__hit_titlepage_label_lead_dim \l_docxlike_format_lead_dim
            \hbox_to_wd:nn { \c__hit_titlepage_en_label_dim }
              { \bfseries #1 \hit@term@titlepage@title@separator@en \hfil }
            \dim_set_eq:NN \l__hit_titlepage_lead_dim
              \c__hit_titlepage_en_value_lead_dim
            \__hit_titlepage_en_value_box:n {#2}
            \int_compare:nNnT { \g__hit_titlepage_value_lines_int } < { 2 }
              {
                \dim_set_eq:NN \l__hit_titlepage_lead_dim \l_docxlike_format_lead_dim
                \__hit_titlepage_en_value_box:n {#2}
              }
            \hbox_set:Nn \l__hit_titlepage_value_box
              {
                \box_move_up:nn
                  {
                    \l_docxlike_format_first_dim
                    - \c_docxlike_format_exact_tl \l__hit_titlepage_lead_dim
                  }
                  { \box_use:N \l__hit_titlepage_value_box }
              }
            \box_set_ht:Nn \l__hit_titlepage_value_box { 0pt }
            \box_set_dp:Nn \l__hit_titlepage_value_box { 0pt }
            \hbox_to_wd:nn { \c__hit_titlepage_en_value_dim }
              { \box_use:N \l__hit_titlepage_value_box \hfil }
            \dim_gset_eq:NN \g__hit_titlepage_lead_dim \l__hit_titlepage_lead_dim
          }
        \dim_compare:nNnT
          { \g__hit_titlepage_lead_dim * \g__hit_titlepage_value_lines_int }
          > { \g__hit_titlepage_label_lead_dim }
          {
            \par
            \vspace*
              {
                \g__hit_titlepage_lead_dim * \g__hit_titlepage_value_lines_int
                  - \g__hit_titlepage_label_lead_dim
              }
          }
      }
  }
%    \end{macrocode}
%
% 勾选的是哪一项由类选项 \option{design} 定，两个标签本身是词条。
%    \begin{macrocode}
