% \iffalse meta-comment
%
% hit-final-titlepage.dtx 是内封（扉页）
%
% \fi
%
% \section{内封}
%
% \changes{v3.2a}{2026/10/06}{本科三校区内封统一，学位论文及博士后内封按对应 Word 模板排版；
%   长题目可缩减间隔段，英文信息栏支持折行，空字段不占行，标签与内容分别应用样式}
%
%    \begin{macrocode}
%<*final-titlepage>
\bool_if:NT \g__hit_final_bool
  {
%    \end{macrocode}
%
% \changes{v3.1d}{2025/03/03}{增加哈尔滨本科的第二封面。\issue[172]}
% 内封按博士后、本科、硕博三种版式分派。
%    \begin{macrocode}
\cs_new_protected:Npn \hit@titlepage
  {
    \bool_if:NTF \g__hit_postdoc_bool
      { \hit@titlepage@postdoc }
      {
        \bool_if:NTF \g__hit_bachelor_bool
          { \hit@titlepage@bachelor }
          { \hit@titlepage@other }
      }
  }
%    \end{macrocode}
%
% 内封照《出站报告封皮模板》第二页排，与封面同一节，所以也是只有行网格、行跨度 16.3\,bp。
% 这一页的单倍段与 1.5 倍段都贴网格：三号题目一行占两格，四号英文题目一行一格（纯西文的行
% 按 Times 算行高，16.1 不到一格），六行四号的栏目（1.5 倍）一行两格。中文题目与封面一样是
% 两段，取题目的上下两部分，第二部分空着也留那一段。栏目下面那个 1.5 倍的空段按空段排
% （\cs{hitenter*}）：段落标记是 Times，单倍不到一格，1.5 倍就是 1.5 格，24.45\,bp；
% 当成有字的段按宋体算会是两格。栏目段首行缩进 1400 缇即五个字，栏名撑到七个字、研究工作起止时间
% 那两行八个字，模板里冒号就是错开的，照排。
%    \begin{macrocode}
\cs_new_protected:Npn \__hit_titlepage_postdoc_field:nn #1#2
  {
    \docxlike_format_par:nnn { cover-postdoc }
      {
        paragraph =
          {
            indentation = { special = first-line , by = 70bp } ,
            spacing = { line-spacing = multiple , at = 1.5 } ,
          } ,
      }
      { #1 \hit@term@titlepage@separator@postdoc #2 }
  }
\cs_new_protected:Npn \hit@titlepage@postdoc
  {
    \hit@layout@push@part:n { titlepage }
    \group_begin:
      \dim_zero:N \parindent
      \dim_zero:N \parskip
      \docxlike_format_par:nnn { cover-postdoc }
        { font = { size = sanhao } , paragraph = { spacing = { line-spacing = single } } }
        { \textcolor [ rgb ] { 1 , 1 , 1 } { \hit@term@titlepage@hi } }
      \docxlike_format_par:nnn { cover-postdoc }
        {
          font = { size = sanhao } ,
          paragraph = { alignment = centered , spacing = { line-spacing = single } } ,
        }
        { \hit@info@title@line@one@zh }
      \docxlike_format_par:nnn { cover-postdoc }
        {
          font = { size = sanhao } ,
          paragraph = { alignment = centered , spacing = { line-spacing = single } } ,
        }
        { \hit@info@title@line@two@zh }
      \docxlike_format_par:nnn { cover-postdoc } { font = { size = sanhao } } { }
      \docxlike_format_par:nnn { cover-postdoc }
        {
          font = { all-caps = true , latin-line = true } ,
          paragraph = { alignment = centered , spacing = { line-spacing = single } } ,
        }
        { \hit@info@title@cover@en }
      \prg_replicate:nn { 2 }
        {
          \docxlike_format_par:nnn { cover-postdoc }
            { font = { size = sanhao } , paragraph = { spacing = { line-spacing = single } } } { }
        }
      \prg_replicate:nn { 2 } { \docxlike_format_par:nnn { cover-postdoc } { } { } }
      \__hit_titlepage_postdoc_field:nn
        { \hit@term@titlepage@author@postdoc@zh } { \hit@info@author@zh }
      \__hit_titlepage_postdoc_field:nn
        { \hit@term@titlepage@co@supervisor@postdoc@zh } { \hit@info@supervisor@zh }
      \__hit_titlepage_postdoc_field:nn
        { \hit@term@titlepage@station@postdoc } { \hit@info@station@zh }
      \__hit_titlepage_postdoc_field:nn
        { \hit@term@titlepage@major@postdoc@zh } { \hit@info@speciality@zh }
      \__hit_titlepage_postdoc_field:nn
        { \hit@term@titlepage@research@start@date@postdoc } { \hit@info@research@start@date@zh }
      \__hit_titlepage_postdoc_field:nn
        { \hit@term@titlepage@research@end@date@postdoc } { \hit@info@research@end@date@zh }
      \hitenter*
        [
          font = { size = sihao , latin-text-font = Times~New~Roman } ,
          paragraph = { spacing = { line-spacing = multiple , at = 1.5 } } ,
        ]
      \prg_replicate:nn { 3 }
        {
          \docxlike_format_par:nnn { cover-postdoc }
            {
              paragraph =
                {
                  alignment = centered ,
                  spacing = { line-spacing = exactly , at = 12bp , before = 8.15bp , after = 8.15bp } ,
                } ,
            }
            { }
        }
      \docxlike_format_par:nnn { cover-postdoc }
        {
          paragraph =
            {
              alignment = centered ,
              spacing = { line-spacing = exactly , at = 12bp , before = 8.15bp , after = 8.15bp } ,
            } ,
        }
        { \hit@term@titlepage@university@zh （ \hit@term@titlepage@campus ） }
      \docxlike_format_par:nnn { cover-postdoc }
        {
          paragraph =
            { alignment = centered , spacing = { line-spacing = multiple , at = 1.5 } } ,
        }
        { \hit@info@date@zh }
    \group_end:
    \hit@layout@pop@part:
  }
%    \end{macrocode}
% \begin{macro}{\hit@titlepage@line}
% 第二封面的信息表不画下划线，字段名走黑体。哈尔滨本科那张七行、其余那张九行，
% 行型完全一样。带星号的不出 \cs{\textbackslash\textbackslash}，给最后一行用。
%    \begin{macrocode}
\NewDocumentCommand \hit@titlepage@line { s m m }
  { {\heiti \hit@put@title{#2}}~&~#3 \IfBooleanF {#1} { \\ ~ } }
%    \end{macrocode}
% \end{macro}
% 勾选框在 \file{src/pages/hit-checkbox.dtx}，与深圳本科报告首页共用。
%    \begin{macro}{\hit@titlepage@bachelor}
%    \begin{macrocode}
%    \end{macrocode}
%
% 本科内封与外封的网格行距相同，linePitch 为 395 缇（19.75 bp）。
% 序列取值（本科书写范例第三页，批注段换成同高空段）：
% \begin{itemize}
%   \item 标签，宋体小二加粗，不贴网格
%   \item 中文题目，黑体二号，\emph{贴网格}
%   \item 题目与字段之间三个间隔段，\texttt{w:line="780" w:lineRule="exact"}，
%         即固定值 39\,bp
%   \item 字段表，定宽三列 1806 / 301 / 2951 缇，居中、无单元格边距，
%         行高最小 540 缇；每行 \texttt{w:line="360"} 即 1.5 倍，且贴网格，
%         所以行距是 $1.5 \times 19.75 = 29.625$，不是 $1.5 \times$ 自然行高
% \end{itemize}
%
% 范例首页只有密级，当前模板还含论文/设计勾选框；比较版面时应核对段间距，不能直接比较绝对基线。
%    \begin{macrocode}
\tl_const:Nn \c__hit_titlepage_layout_tl { document-grid / lines / pitch = 19.75bp , }
\dim_const:Nn \c__hit_titlepage_label_dim { 90.3bp }
\dim_const:Nn \c__hit_titlepage_colon_dim { 15.05bp }
\dim_const:Nn \c__hit_titlepage_value_dim { 147.55bp }
%    \end{macrocode}
%
% 先以零间隔段试排，按剩余版心高度计算可加入的 39 bp 空段数，最多三个。
% 增加导师字段或题目折行时，由这些间隔段让出空间。
% \cs{hit@titlepage@fit:N} 的参数宏接受间隔段数，计算结果保存在对应整型变量中。
%    \begin{macrocode}
\box_new:N \l__hit_titlepage_box
\int_new:N \l__hit_titlepage_gap_int
\dim_const:Nn \c__hit_titlepage_gap_dim { 39bp }
%    \end{macrocode}
%
% 英文内封使用两列字段表，标签和内容分别量高并按行顶对齐。
%    \begin{macrocode}
\dim_const:Nn \c__hit_titlepage_en_label_dim { 213.1bp }
\dim_const:Nn \c__hit_titlepage_en_value_dim { 220.3bp }
\dim_const:Nn \c__hit_titlepage_en_cell_margin_dim { 5.4bp }
\cs_new_protected:Npn \hit@titlepage@fit:N #1
  {
    \vbox_set:Nn \l__hit_titlepage_box
      {
        \dim_set_eq:NN \hsize \textwidth
        \dim_set_eq:NN \linewidth \textwidth
        \dim_zero:N \parindent
        \dim_zero:N \parskip
        #1 { 0 }
      }
    \int_set:Nn \l__hit_titlepage_gap_int
      {
        \int_min:nn { 3 }
          {
            \fp_to_int:n
              {
                floor
                  (
                    \dim_to_fp:n
                      { \textheight - \box_ht_plus_dp:N \l__hit_titlepage_box }
                    / \dim_to_fp:n { \c__hit_titlepage_gap_dim }
                  )
              }
          }
      }
    \int_compare:nNnT { \l__hit_titlepage_gap_int } < { 0 }
      {
        \msg_warning:nn { hithesis } { titlepage-overflow }
        \int_zero:N \l__hit_titlepage_gap_int
      }
  }
%    \end{macrocode}
%
%    \begin{macrocode}
\cs_new_protected:Npn \hit@titlepage@field:nn #1#2
  {
    \docxlike_format_par:nn { titlepage-field }
      {
        \hbox_to_wd:nn { \c__hit_titlepage_label_dim }
          { \heiti \hit@put@title {#1} \hfil }
        \hbox_to_wd:nn { \c__hit_titlepage_colon_dim }
          { \hit@term@titlepage@title@separator@zh \hfil }
        \hbox_to_wd:nn { \c__hit_titlepage_value_dim } { #2 \hfil }
      }
  }
\cs_new_protected:Npn \hit@titlepage@en@degree:
  { \hit@term@titlepage@degree@sentence }
\cs_new_protected:Npn \hit@titlepage@en@title:
  {
    \skip_if_exist:NF \hit@etitlelength { \skip_new:N \hit@etitlelength }
    \hbox_set:Nn \l_tmpa_box
      {
        \erhao \hit@info@title@cover@en
        \hit@if@subtitle@lang:nT { en }
          { \hit@term@titlepage@title@separator@en \hit@info@title@subtitle@en }
      }
    \dim_set:Nn \hit@etitlelength { \box_wd:N \l_tmpa_box }
    \str_case:VnF \g_hit_titlepage_title_en_xiaoer_tl
      {
        { true } { \docxlike_format_par:nn { titlepage-en-title } }
        { auto }
          {
            \dim_compare:nNnTF { \hit@etitlelength } > { 450mm }
              { \docxlike_format_par:nn { titlepage-en-title } }
              { \hit@titlepage@en@title@erhao:n }
          }
      }
      { \hit@titlepage@en@title@erhao:n }
      {
        \hit@info@title@cover@en
        \hit@if@subtitle@lang:nT { en } { \hit@term@titlepage@title@separator@en \hit@info@title@subtitle@en }
      }
  }
\cs_new_protected:Npn \hit@titlepage@en@title@erhao:n #1
  {
    \group_begin:
      \docxlike_format_set:n { titlepage-en-title = { font = { size = erhao } } }
      \docxlike_format_par:nn { titlepage-en-title } {#1}
    \group_end:
  }
% 判空前展开字段，避免把空字段的宏名误判为非空内容。
\cs_new_protected:Npn \hit@titlepage@en@fields:
  {
    \hit@titlepage@en@field:nn
      { \hit@term@titlepage@author@en } { \hit@info@author@en }
    \hit@titlepage@en@field:nn
      { \hit@term@titlepage@supervisor@en } { \hit@info@supervisor@en }
    \hit@titlepage@en@field:nn
      { \hit@term@titlepage@associate@supervisor@en }
      { \hit@info@associate@supervisor@en }
    \hit@titlepage@en@field:nn
      { \hit@term@titlepage@industry@supervisor@en } { \hit@info@industry@supervisor@en }
    \hit@titlepage@en@field:nn
      { \hit@term@titlepage@degree@applied@en } { \hit@info@degree@applied@en }
    \hit@titlepage@en@field:nn
      { \hit@term@titlepage@major@en } { \hit@info@speciality@en }
    \__hit_titlepage_en_field:nnn { titlepage-en-value-condensed }
      { \hit@term@titlepage@affiliation@en } { \hit@info@affiliation@en }
    \__hit_titlepage_en_field:nnn { titlepage-en-value-condensed }
      { \hit@term@titlepage@date@en } { \hit@info@date@en }
    \hit@titlepage@en@field:nn
      { \hit@term@titlepage@institution@en } { \hit@term@titlepage@university@en }
  }
%    \end{macrocode}
%
% 英文范例的字段格左右边距各 5.4 bp。单行标签和内容用固定 22 bp 行距，
% 多行内容用固定 18 bp；先按 18 bp 试排，若只有一行，再用标签行距重排。
% 行高取标签与内容两者的较大值，多行内容超出的高度在行后补足。
%
% Word 固定行距的基线位于行顶下方 0.8 倍行距处，因此 18 bp 内容的首行比
% 22 bp 标签高 3.2 bp。顶对齐 parbox 须补这个偏移，并清除自身高深，避免重复增加行高。
% Affiliation 与 Date of Defence 使用单独的紧缩样式；全角冒号按范例使用粗黑体。
%    \begin{macrocode}
\dim_const:Nn \c__hit_titlepage_en_value_lead_dim { 18bp }
\dim_new:N \g__hit_titlepage_label_lead_dim
\dim_new:N \g__hit_titlepage_lead_dim
\dim_new:N \l__hit_titlepage_lead_dim
\int_new:N \g__hit_titlepage_value_lines_int
\box_new:N \l__hit_titlepage_value_box
\cs_new_protected:Npn \__hit_titlepage_en_value_box:nn #1#2
  {
    \hbox_set:Nn \l__hit_titlepage_value_box
      {
        \parbox [t] { \c__hit_titlepage_en_value_dim - 10.8bp }
          {
            \docxlike_format_apply_par:n {#1}
            \dim_set_eq:NN \baselineskip \l__hit_titlepage_lead_dim
            \dim_set:Nn \lineskiplimit { -\maxdimen }
            \skip_zero:N \lineskip
            \skip_zero:N \parskip
            \raggedright
            \cs_set_eq:NN \\ \newline
            #2 \par
            \int_gset:Nn \g__hit_titlepage_value_lines_int { \prevgraf }
          }
      }
  }
\cs_new_protected:Npn \hit@titlepage@en@field:nn
  { \__hit_titlepage_en_field:nnn { titlepage-en-value } }
\cs_new_protected:Npn \__hit_titlepage_en_field:nnn #1#2#3
  {
    \tl_if_empty:eF {#3}
      {
        \docxlike_format_par:nn { titlepage-en-field }
          {
            \dim_gset_eq:NN \g__hit_titlepage_label_lead_dim \l_docxlike_format_lead_dim
            \skip_horizontal:n
              {
                ( \linewidth - \c__hit_titlepage_en_label_dim - \c__hit_titlepage_en_value_dim ) / 2
                + \c__hit_titlepage_en_cell_margin_dim
              }
            \hbox_to_wd:nn { \c__hit_titlepage_en_label_dim }
              {
                \docxlike_table_begin:
                \bfseries #2 { \heiti \hit@term@titlepage@title@separator@en } \hfil
              }
            \dim_set_eq:NN \l__hit_titlepage_lead_dim
              \c__hit_titlepage_en_value_lead_dim
            \__hit_titlepage_en_value_box:nn {#1} {#3}
            \int_compare:nNnT { \g__hit_titlepage_value_lines_int } < { 2 }
              {
                \dim_set_eq:NN \l__hit_titlepage_lead_dim \l_docxlike_format_lead_dim
                \__hit_titlepage_en_value_box:nn {#1} {#3}
              }
            \hbox_set:Nn \l__hit_titlepage_value_box
              {
                \box_move_up:nn
                  {
                    \l_docxlike_format_first_dim
                    - \c_docxlike_format_exact_tl \l__hit_titlepage_lead_dim
                  }
                  { \box_use:N \l__hit_titlepage_value_box }
              }
            \box_set_ht:Nn \l__hit_titlepage_value_box { 0pt }
            \box_set_dp:Nn \l__hit_titlepage_value_box { 0pt }
            \hbox_to_wd:nn { \c__hit_titlepage_en_value_dim }
              { \box_use:N \l__hit_titlepage_value_box \hfil }
            \dim_gset_eq:NN \g__hit_titlepage_lead_dim \l__hit_titlepage_lead_dim
          }
        \dim_compare:nNnT
          { \g__hit_titlepage_lead_dim * \g__hit_titlepage_value_lines_int }
          > { \g__hit_titlepage_label_lead_dim }
          {
            \par
            \vspace*
              {
                \g__hit_titlepage_lead_dim * \g__hit_titlepage_value_lines_int
                  - \g__hit_titlepage_label_lead_dim
              }
          }
      }
  }
%    \end{macrocode}
%
% 勾选的是哪一项由类选项 \option{design} 定，两个标签本身是词条。
%    \begin{macrocode}
\cs_new_protected:Npn \hit@titlepage@bachelor@body:n #1
  {
      \docxlike_format_par:nn { titlepage-mark }
        {
          \hbox_to_wd:nn { \textwidth }
            {
              \hit@if@option@TF { practice }
                { \hit@empty@box } { \hit@checked@box }
              \hit@term@titlepage@mark@dissertation \quad
              \hit@if@option@TF { practice }
                { \hit@checked@box } { \hit@empty@box }
              \hit@term@titlepage@mark@practice
              \hfil
              \hit@term@titlepage@secrecy \hit@term@titlepage@title@separator@zh
              \hit@info@secrecy
            }
        }
      \hitenter*[lines=1,font={size=xiaosi,latin-text-font=Times New Roman},paragraph={spacing={line-spacing=multiple,at=1}}]
      \hitenter*[lines=2,font={size=xiaosi,latin-text-font=Times New Roman},paragraph={snap-to-grid=true,spacing={line-spacing=multiple,at=1}}]
      \docxlike_format_par:nn { titlepage-label }
        { \hit@term@titlepage@document@type@level \hit@term@titlepage@document@type }
      \hitenter*[lines=1,font={size=xiaosi,asian-text-font=SimSun},paragraph={spacing={line-spacing=exactly,at=19.75bp}}]
      \hitenter*[lines=1,font={size=xiaosi,asian-text-font=SimSun},paragraph={spacing={line-spacing=multiple,at=1.25}}]
      \docxlike_format_par:nn { titlepage-title } { \hit@info@title@cover@zh }
      \hit@if@subtitle@T
        {
          \docxlike_format_par:nnn { titlepage-title } { font = { size = xiaoer } }
            { ——\hit@info@title@subtitle@zh }
        }
      \hitenter*[lines=2,font={size=xiaosi,asian-text-font=SimSun},paragraph={spacing={line-spacing=exactly,at=19.75bp}}]
      \hitenter*[lines=#1,font={size=erhao,asian-text-font=SimSun},paragraph={spacing={line-spacing=exactly,at=39bp}}]
      \dim_set_eq:NN \hit@title@width \c__hit_titlepage_label_dim
      \hit@titlepage@field:nn
        { \hit@term@titlepage@author@zh } { \hit@info@author@zh }
      \hit@titlepage@field:nn
        { \hit@term@titlepage@student@id } { \hit@info@student@id }
      \hit@titlepage@field:nn
        { \hit@term@titlepage@supervisor@zh } { \hit@info@supervisor@zh }
      \hit@titlepage@field:nn
        { \hit@term@titlepage@major@zh } { \hit@info@speciality@zh }
      \hit@titlepage@field:nn
        { \hit@term@titlepage@affiliation@zh } { \hit@info@affiliation@zh }
      \hit@titlepage@field:nn
        { \hit@term@titlepage@date@zh } { \hit@info@date@zh }
      \hit@titlepage@field:nn
        { \hit@term@titlepage@institution@zh } { \hit@term@titlepage@university@zh }
  }
\cs_new_protected:Npn \hit@titlepage@bachelor
  {
    \exp_args:Nx \docxlike_page_setup_push:n
      {
        \exp_not:V \g__hit_layout_msword_tl
        \exp_not:V \c__hit_titlepage_layout_tl
      }
    \hit@titlepage@fit:N \hit@titlepage@bachelor@body:n
    \group_begin:
      \dim_zero:N \parindent
      \dim_zero:N \parskip
      \exp_args:NV \hit@titlepage@bachelor@body:n \l__hit_titlepage_gap_int
    \group_end:
    \docxlike_page_setup_pop:
  }
%    \end{macrocode}
%    \end{macro}
