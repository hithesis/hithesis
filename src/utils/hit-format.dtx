%    \end{macrocode}
%
% \option{bottom} 底下再套一层键值表，写哪一档就进哪一档的存储。
%
% 分档用 \cs{group\_begin:} 圈起来，出了组当前档自动复原，所以套着写也不乱。
% 存储那一头全是全局赋值，不受组的影响。判重的表是局部的，跟着组走——这是对的，
% 档外写 \option{line-spacing}、档里写 \option{line-white} 不算冲突。
%    \begin{macrocode}
\keys_define:nn { hit / format / bottom }
  {
    if-ragged .code:n = { \__hit_format_layer:nn { ragged } {#1} } ,
    if-flush  .code:n = { \__hit_format_layer:nn { flush } {#1} } ,
    unknown .code:n =
      { \msg_warning:nnV { hithesis } { unknown-key } \l_keys_key_str } ,
  }
\cs_new_protected:Npn \__hit_format_bottom:n #1
  { \hit@keys@set:nn { hit / format / bottom } {#1} }
\cs_new_protected:Npn \__hit_format_layer:nn #1#2
  {
    \group_begin:
      \tl_set:Nn \l__hit_format_layer_tl {#1}
      \prop_clear:N \l__hit_format_claim_prop
      \hit@keys@set:nn { hit / format / property } {#2}
    \group_end:
