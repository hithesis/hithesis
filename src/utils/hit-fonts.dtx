%
% \subsection{封面上的美术字}
%
% \changes{v3.2a}{2026/08/13}{封面上那两处美术字改成有字体就排字体、没字体才贴图，
%   由 \option{cover-script} 决定}
% 封面上有两处不是正文字体排的：本科报告封面底下的「哈尔滨工业大学教务处制」是
% 隶书，威海本科封面的「毕业设计（论文）」是华文新魏。原先一律贴事先转好的 PDF。
%
% 贴图的毛病是选不中、搜不到，缩放之后与正文两样。有字体就该排字体。但装不装得上
% 这两个字体是机器的事，所以两条路都留着，由 \option{cover-script} 选：
% \texttt{auto} 有字体就排字体、没有就贴图，\texttt{font} 与 \texttt{image} 各自钉死。
%
% 探测走 \cs{fontspec\_font\_if\_exist:nTF}，与上面挑英文字体是同一套。不查
% \cs{lishu} 那种字体命令：那个只在 \option{fontset} 取 \texttt{windows} 时才有定义，
% 而字体装没装上与 \option{fontset} 选哪套是两回事。
%    \begin{macrocode}
\bool_new:N \g__hit_lishu_bool
\bool_new:N \g__hit_xinwei_bool
\cs_new_protected:Npn \__hit_cover_font:nnN #1#2#3
  {
    \fontspec_font_if_exist:nTF {#1}
      {
        \bool_gset_true:N #3
        \use:x { \exp_not:N \newCJKfontfamily \exp_not:c {#2} { \exp_not:n {#1} } }
      }
      { }
  }
%    \end{macrocode}
%
% 探测要等基础类把 \pkg{fontspec} 与 \pkg{xeCJK} 装上，所以排进 \cs{hit@preconfig}
% 的队列，与 \cs{hit@setup@date} 同一时机。共享层跑在基础类之前，写在顶层会因为
% \cs{fontspec\_font\_if\_exist:nTF} 还没定义而报未定义控制序列。
%    \begin{macrocode}
\hit@preconfig
  {
    \__hit_cover_font:nnN { LiSu } { hit@cover@lishu } \g__hit_lishu_bool
    \__hit_cover_font:nnN { STXinwei } { hit@cover@xinwei } \g__hit_xinwei_bool
  }
%    \end{macrocode}
%
% \begin{macro}{\hit@cover@script:nnn}
% \meta{有没有这个字体}\marg{排字体的代码}\marg{贴图的代码}。
% \option{cover-script} 写 \texttt{font} 而机器上没这个字体时给一句提示再贴图——
% 钉死了却办不到，不说一声排出来会与预期两样。
%    \begin{macrocode}
\cs_new_protected:Npn \hit@cover@script:nnn #1#2#3
  {
    \str_case:onF { \hit@cover@script }
      {
        { image } {#3}
        { font }
          {
            \bool_if:NTF #1 {#2}
              { \msg_warning:nn { hithesis } { cover-script-no-font } #3 }
          }
      }
      { \bool_if:NTF #1 {#2} {#3} }
  }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\hit@cover@bottommark,\hit@cover@title@weihai}
% 两处美术字各自的排法。尺寸是照原图逐像素标定出来的，两条路排出来一样。
%
% \textbf{落款} 隶书小二，正好与原图一致：墨迹量出来 194.88 $\times$ 11.28\,pt，
% 原图 195.12 $\times$ 11.52，差 0.24\,pt，即 300\,dpi 下的一个像素。不用缩放。
%
% \textbf{题名} 原图不是原样排出来的，是横向压到 0.98、纵向拉到 1.095 的结果——
% 八个字逐个量，横比都在 0.974 到 1.018 之间，纵比都在 1.089 到 1.104 之间，
% 规律一致。所以字体这一路要补上同样的非等比缩放才对得上。
%
% 缩放之后墨迹在盒子里不居中：「（」「）」两侧的边距不对称，量出来偏左 9.6\,pt，
% 所以按左对齐放，再垫 $-4.4$\,pt。标完左边界完全重合，右边界与宽高各差 0.24\,pt。
%
% 两处都要把 \cs{CJKglue} 归零。\pkg{xeCJK} 在正文里给汉字之间留一段可伸缩的胶
% 好让整行对齐，美术字这里不该有：题名八个字七个间隙，带上这段胶整整宽出 11\,pt。
% 原图本来也是紧排的。
%
% 竖直方向还要往下挪 0.72\,pt。挪的时候得写成
% \cs{raisebox}\marg{-0.72pt}\oarg{\cs{height}}\oarg{\cs{depth}}：只给一个参数的话
% 盒子的高度跟着变，外面那圈垂直胶会把这点位移抵消掉，排出来一动不动。
%
% \textbf{归零必须写在 \cs{selectfont} 之后。} \cs{selectfont} 会按新字号把
% \cs{CJKglue} 重设一遍，写在前面等于白写——排出来仍旧宽 11\,pt，逐字量左边界
% 是均匀累积的每字距 2.2\,pt，正是这段胶。
%    \begin{macrocode}
\cs_new_protected:Npn \hit@cover@bottommark
  {
    \hit@cover@script:nnn \g__hit_lishu_bool
      {
        {
          \hit@cover@lishu
          \fontsize { 18bp } { 18bp } \selectfont
          \cs_set_eq:NN \CJKglue \prg_do_nothing:
          哈尔滨工业大学教务处制
        }
      }
      { \includegraphics { hit-bachelor-report-bottommark } }
  }
\cs_new_protected:Npn \hit@cover@title@weihai
  {
    \hit@cover@script:nnn \g__hit_xinwei_bool
      {
        \makebox [ 10.5cm ] [ l ]
          {
            \kern -4.4pt
            \raisebox { -0.72pt } [ \height ] [ \depth ]
              { \scalebox { 1.01724 } [ 1.08904 ]
              {
                {
                  \hit@cover@xinwei
                  \fontsize { 40bp } { 40bp } \selectfont
                  \cs_set_eq:NN \CJKglue \prg_do_nothing:
                  毕业设计（论文）
                }
              } }
          }
      }
      { \includegraphics [ width = 10.5cm ] { hit-weihai-bachelor-title } }
  }
%    \end{macrocode}
% \end{macro}
