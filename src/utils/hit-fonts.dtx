% \begin{macro}{\hit@cover@bottommark}
% \changes{v3.2a}{2026/08/16}{删掉 \cs{hit@cover@title@weihai}，威海本科内封没了}
% 落款那处美术字的排法。尺寸是照原图逐像素标定出来的，两条路排出来一样：
% 隶书小二，墨迹量出来 194.88 $\times$ 11.28\,pt，原图 195.12 $\times$ 11.52，
% 差 0.24\,pt，即 300\,dpi 下的一个像素。不用缩放。
%
% 要把 \cs{CJKglue} 归零。\pkg{xeCJK} 在正文里给汉字之间留一段可伸缩的胶
% 好让整行对齐，美术字这里不该有，原图本来也是紧排的。
%
% \textbf{归零必须写在 \cs{selectfont} 之后。} \cs{selectfont} 会按新字号把
% \cs{CJKglue} 重设一遍，写在前面等于白写，逐字量左边界是均匀累积的每字距，
% 正是这段胶。
%    \begin{macrocode}
\cs_new_protected:Npn \hit@cover@bottommark
  {
    \hit@cover@script:nnn \g__hit_lishu_bool
      {
        {
          \hit@cover@lishu
          \fontsize { 18bp } { 18bp } \selectfont
          \cs_set_eq:NN \CJKglue \prg_do_nothing:
          哈尔滨工业大学教务处制
        }
      }
      { \includegraphics { hit-bachelor-report-bottommark } }
  }
%    \end{macrocode}
