% \changes{v3.2a}{2026/08/07}{\cs{hit@def@fontsize} 改名
%   \cs{\_\_hit\_define\_font\_size:nn}，它只在本文件里用}
% 定义一个字号命令，参数为名称与磅数。字号与行距解耦，行距由可选参数给出，
% 默认 1.3 倍。下面十七个字号的取值，\hithesis{} 与 \CTeX、MS~Word、WPS、Adobe
% 的选择一致，模板自己只用到其中十一个，其余留给用户。
%
% \changes{v3.2a}{2026/08/13}{字号顺带存成常量 \cs{c\_\_hit\_font\_size\_}\meta{名}\cs{\_dim}，
%   给 \texttt{hit/format} 族的 \option{size} 取用}
% 磅数除了包进命令体，还存一份常量 \cs{c\_\_hit\_font\_size\_}\meta{名}\cs{\_dim}。
% \texttt{format} 族的 \option{size} 键收 \texttt{sanhao} 这种名字，要把它换算成长度，
% 读的就是这份常量。不另抄一张表，改磅数只改这里一处。
%    \begin{macrocode}
\cs_new_protected:Npn \__hit_define_font_size:nn #1#2
  {
    \exp_args:Nc \NewDocumentCommand {#1} { O{1.3} }
      { \fontsize {#2} { ##1 \dimexpr #2 } \selectfont }
    \dim_const:cn { c__hit_font_size_#1_dim } {#2}
  }
%    \end{macrocode}
