% \begin{macro}{\hit@cover@row}
% \changes{v3.2a}{0000/00/00}{封面表格里「字段名加下划线填空」的行型抽成
%   \cs{hit@cover@row}，格宽与对齐做成两个可设的量}
% \cs{hit@cover@row}\marg{字段名}\marg{值} 排封面表格的一行：左格是字段名，
% 右格是一条 \cs{hit@cover@fieldwd} 宽的下划线，值按 \cs{hit@cover@fieldalign}
% 对齐。带星号的不出 \cs{\textbackslash\textbackslash}，给表格最后一行用。
%
% 深圳与其余校区的本科封面原先是两整段几乎一样的表格，差别只在值是左对齐还是
% 居中（\cs{makebox} 不给对齐参数就是居中，等同于 \texttt{c}），以及行的顺序。
% 对齐做成量之后，两段就只剩行的顺序不同了。
%    \begin{macrocode}
\dim_new:N \hit@cover@fieldwd
\dim_set:Nn \hit@cover@fieldwd { 6.1cm }
\tl_new:N \hit@cover@fieldalign
\tl_set:Nn \hit@cover@fieldalign { c }
\NewDocumentCommand \hit@cover@row { s m m }
  {
    {\hit@put@title{#2}}~&~\underline{\makebox[\hit@cover@fieldwd][\hit@cover@fieldalign]{#3}}
    \IfBooleanF {#1} { \\ } ~
  }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\hit@cover@line}
