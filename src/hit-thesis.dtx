%
% 其他包，表格、数学符号包
% \changes{v1.0.06}{2017/10/25}{此处添加子图最后一行图题是否居中选项}
%    \begin{macrocode}
\RequirePackage{tabularx}
\RequirePackage{xltabular}
\RequirePackage{varwidth}
%    \end{macrocode}
%
% 此处changepage环境用来控制索引页面的左右边距，规范中给出的示例的边距要大于正文。
% \changes{v1.0.10}{2018/02/19}{修改了索引的间距，使其更符合规范中的示例}
%    \begin{macrocode}
\RequirePackage{changepage}
\RequirePackage{multicol}
\RequirePackage[below]{placeins}%允许上一个section的浮动图形出现在下一个section的开始部分,还提供\FloatBarrier命令,使所有未处理的浮动图形立即被处理
\RequirePackage{flafter}       % 使得所有浮动体不能被放置在其浮动环境之前，以免浮动体在引述它的文本之前出现.
\RequirePackage{multirow}       %使用Multirow宏包，使得表格可以合并多个row格
\RequirePackage{subcaption}%支持子图，必须在 ccaption 之前
\RequirePackage{ccaption} %支持双语标题
%    \end{macrocode}
%
% \changes{v3.2a}{0000/00/00}{\cs{bicaption} 支持省略英文图表名的四参数写法}
% \pkg{ccaption} 的 \cs{bicaption} 是五个参数，第四个是第二条题注用的图表名，
% 用户得写成 \texttt{Fig.} 加一个负细空格才能把 \cs{fnum@figure} 插的空格抵掉。
% 这里让第四个参数可以省略，省略时取 \option{const} 族里的 \option{efigurename}
% 与 \option{etablename}。五个参数的写法照旧——那才是 \pkg{ccaption} 的标准形式，
% 换到别的模板不用改。
%    \begin{macrocode}
\cs_new_eq:NN \__hit_bicaption:w \bicaption
\msg_new:nnn { hithesis } { bicaption-five-args }
  {
    \iow_char:N \\ bicaption~不再接受五个参数。 \\
    英文图表名请改用~\iow_char:N \\ hitsetup{const={efigurename=...}}~设置， \\
    调用处只写~\iow_char:N \\ bicaption[标签]{中文题}{英文题}。
  }
\cs_new_protected:Npn \__hit_bicaption:nnnnn #1#2#3#4#5
  {
    \tl_if_novalue:nTF {#1}
      { \__hit_bicaption:w {#2} {#3} {#4} {#5} }
      { \__hit_bicaption:w [#1] {#2} {#3} {#4} {#5} }
%    \end{macrocode}
%
% 旧的五参数写法会在这里剩下一个 \marg{英文题} 掉进正文。探一眼，撞见就报错，
% 免得静默排出来。题注后面正常不会紧跟花括号组。
%    \begin{macrocode}
    \peek_meaning:NT \c_group_begin_token
      { \msg_error:nn { hithesis } { bicaption-five-args } }
  }
\RenewDocumentCommand \bicaption { o +m +m +g }
  {
    \IfNoValueTF {#4}
      { \__hit_bicaption:nnnnn {#1} { } {#2} { \use:c { hit@e \@captype name } } {#3} }
      { \__hit_bicaption:nnnnn {#1} {#2} {#3} { \use:c { hit@e \@captype name } } {#4} }
  }
%    \end{macrocode}
%
% \changes{v3.2a}{0000/00/00}{\pkg{subfigure} 换成 \pkg{subcaption}，旧写法
%   由兼容层接住（\issue[284]）}
% \pkg{subfigure} 二十多年没人维护，与 \pkg{cleveref}、\pkg{hyperref} 配合有问题，
% 换成 \pkg{subcaption}。旧写法由兼容层接住。\pkg{subfigure} 的六个长度用户文档里在用
% （示例正文就有 \cs{setlength}\marg{\cs{subfigcapskip}}），照原值声明；
% \cs{subfigure} 与 \cs{subtable} 转成 \cs{subcaptionbox}，外面套回
% \pkg{subfigure} 的上下留白，这样版面能对上，计数器、标签、图目录条目和
% 超链接锚点则由 \pkg{subcaption} 负责。
%    \begin{macrocode}
\skip_new:N \subfigtopskip     \skip_set:Nn \subfigtopskip    { 5pt }
\skip_new:N \subfigcapskip     \skip_set:Nn \subfigcapskip    { 0pt }
\skip_new:N \subfigbottomskip  \skip_set:Nn \subfigbottomskip { 5pt }
\dim_new:N  \subfigcaptopadj   \dim_set:Nn  \subfigcaptopadj  { 3pt }
\dim_new:N  \subfigcapmargin   \dim_set:Nn  \subfigcapmargin  { 0pt }
\skip_new:N \subfiglabelskip
\skip_set:Nn \subfiglabelskip { 0.33em~plus~0.07em~minus~0.03em }
%    \end{macrocode}
%
% \cs{subcaptionbox} 要求 \cs{label} 写在图题里，而旧写法把它写在内容里
% （\pkg{subfigure} 自己 \cs{let} 掉 \cs{label} 来接）。这里照样接住：内容先
% 装箱，装箱时把 \cs{label} 的参数记下来，再塞回图题参数末尾。
%    \begin{macrocode}
\box_new:N \l__hit_sub_box
\box_new:N \l__hit_subcap_box
\box_new:N \l__hit_submeas_box
\dim_new:N \l__hit_subtot_dim
\tl_new:N \g__hit_sublabel_tl
\cs_new_eq:NN \__hit_sub_label:n \label
\cs_new_protected:Npn \__hit_subfloat:nn #1#2
  {
    \tl_gclear:N \g__hit_sublabel_tl
    \hbox_set:Nn \l__hit_sub_box
      {
        \cs_set_protected:Npn \label ##1 { \tl_gset:Nn \g__hit_sublabel_tl {##1} }
        #2
      }
%    \end{macrocode}
%
% 图题先单独装进 \cs{vbox} 再放进竖直列表。\pkg{caption} 排图题时会先放一条零高
% \cs{hrule}（\cs{vspace} 在竖直模式下的常规动作），\cs{hrule} 会掐掉 \TeX\ 的
% 行间胶，图与图题之间就少了一整个 \cs{baselineskip}。装箱之后 \cs{vbox} 的高度
% 就是首行基线的位置，行间胶照常算，与 \pkg{subfigure} 的结果一致。
%    \begin{macrocode}
    \tl_if_empty:NF \g__hit_subpending_tl
      {
        \tl_gset:Nx \g__hit_sublabel_tl { \g__hit_subpending_tl }
        \tl_gclear:N \g__hit_subpending_tl
      }
    \dim_compare:nNnT { \box_wd:N \l__hit_sub_box } = { 0pt }
      { \box_set_wd:Nn \l__hit_sub_box { \linewidth } }
%    \end{macrocode}
%
% \pkg{subfigure} 单行子图题排成裸 \cs{hbox}，高深随文字；排不下才退回
% \cs{parbox}，那时才有 strut。\pkg{caption} 一律带 strut，深度固定，图之后的
% 材料会高一截。照 \pkg{subfigure} 的做法先拿同样的字体量一遍宽度，装得下就
% 关掉 strut。量的时候计数器还没走，\cs{thesubfigure} 拿到的是上一个号，宽度
% 一样，不影响判断。
%    \begin{macrocode}
    \hbox_set:Nn \l__hit_submeas_box
      {
        \subcapsize \thesubfigure \hskip \subfiglabelskip #1
      }
    \tex_setbox:D \l__hit_subcap_box \tex_vbox:D
      {
        \hsize \box_wd:N \l__hit_sub_box
        \linewidth \hsize
        \captionsetup [ sub ] { strut = false }
        \bool_if:NT \g__hit_subreuse_bool
          {
            \addtocounter { sub \@captype } { -1 }
            \bool_gset_false:N \g__hit_subreuse_bool
          }
        \bool_gset_false:N \g__hit_subskiplabel_bool
        \subcaption
          {
            #1
            \bool_if:NF \g__hit_subskiplabel_bool
              {
                \tl_if_empty:NF \g__hit_sublabel_tl
                  { \exp_args:NV \__hit_sub_label:n \g__hit_sublabel_tl }
              }
          }
      }
%    \end{macrocode}
%
% \pkg{subfigure} 的子表题在表上方（\cs{ifsubtabletopcap}），子图题在图下方。
% 盒子是这里手工摆的，\pkg{caption} 的 \option{position} 管不到，按 \cs{@captype}
% 自己分。上方时上下留白对调，并按 \pkg{subfigure} 的做法补 \cs{subfigcaptopadj}。
%    \begin{macrocode}
%    \end{macrocode}
%
% \pkg{subfigure} 多行子图题用 \cs{parbox}\texttt{[t]}：高度是首行的高度，其余算深度。
% \cs{vbox} 相反，把一切折进高度、深度为 0，放进竖直列表时参考点就错了。这里拿
% 量宽度那个 \cs{hbox} 的高度当首行高度，把图题盒子的高深重设一遍。单行时结果与
% \pkg{subfigure} 的裸 \cs{hbox} 逐值相同。
%    \begin{macrocode}
    \tl_gclear:N \g__hit_sublabel_tl
    \dim_set:Nn \l__hit_subtot_dim
      { \box_ht:N \l__hit_subcap_box + \box_dp:N \l__hit_subcap_box }
    \box_set_ht:Nn \l__hit_subcap_box { \box_ht:N \l__hit_submeas_box }
    \box_set_dp:Nn \l__hit_subcap_box
      { \l__hit_subtot_dim - \box_ht:N \l__hit_submeas_box }
    \leavevmode
    \str_if_eq:eeTF { \@captype } { table }
      {
        \vtop
          {
            \hsize \box_wd:N \l__hit_sub_box
            \vbox
              {
                \vskip \subfigbottomskip
                \box_use_drop:N \l__hit_subcap_box
              }
            \vskip \subfigcapskip
            \vskip \subfigcaptopadj
            \box_use_drop:N \l__hit_sub_box
            \vskip \subfigtopskip
          }
      }
      {
        \vtop
          {
            \hsize \box_wd:N \l__hit_sub_box
            \vbox { \vskip \subfigtopskip \box_use_drop:N \l__hit_sub_box }
            \vskip \subfigcapskip
            \box_use_drop:N \l__hit_subcap_box
            \vskip \subfigbottomskip
          }
      }
  }
%    \end{macrocode}
%
% \pkg{subcaption} 把 \texttt{subfigure} 和 \texttt{subtable} 定义成环境，而
% \cs{begin}\marg{subfigure} 展开出来就是 \cs{subfigure}，跟旧的命令写法同名。
% 两套语法要并存，只能在入口按 \cs{@currenvir} 分流：从 \cs{begin} 进来的走
% \pkg{subcaption} 的环境，直接调用的走兼容壳。
%    \begin{macrocode}
\cs_new_eq:NN \__hit_subfig_env: \subfigure
\cs_new_eq:NN \__hit_subtab_env: \subtable
\cs_set_protected:Npn \subfigure
  {
    \str_if_eq:eeTF { \@currenvir } { subfigure }
      { \__hit_subfig_env: }
      { \__hit_subfloat_cmd: }
  }
\cs_set_protected:Npn \subtable
  {
    \str_if_eq:eeTF { \@currenvir } { subtable }
      { \__hit_subtab_env: }
      { \__hit_subfloat_cmd: }
  }
%    \end{macrocode}
%
% 旧写法有三个习惯用法，兼容期内都要接住：
% \begin{itemize}
% \item \cs{subfigure}\marg{\cs{label}\marg{键}}：内容是空的，只为了把标签挂到
%   下一个编号上。这里记下标签留给下一个子图，本身什么也不排。
% \item 紧跟其后的 \cs{addtocounter}\marg{subfigure}\marg{-2}：那是给上面那招凑
%   计数器用的，\pkg{subcaption} 的计数器语义不同，直接吃掉。
% \item \cs{subfigure}\oarg{英文}\marg{\cs{subfigure}\oarg{中文}\marg{图}}：双语
%   子图题的套娃，拆开转成 \cs{bisubcaption}。
% \end{itemize}
%    \begin{macrocode}
\tl_new:N \g__hit_subpending_tl
\cs_new_protected:Npn \__hit_sub_eat:w \addtocounter #1#2
  { \str_if_eq:nnF {#1} { subfigure } { \addtocounter {#1} {#2} } }
\cs_new_protected:Npn \__hit_sub_eat_rewind:
  {
    \peek_remove_spaces:n
      { \peek_meaning:NT \addtocounter { \__hit_sub_eat:w } }
  }
%    \end{macrocode}
%
% 双语子图题照旧写法的结构递归摆一次：内层是「图 + 中文题」，外层把它整个当内容
% 再排一次英文题。两行之间那段 \cs{subfigbottomskip} 是这么来的，在图题文本里补
% 不出来。外层排图题前把计数器退一格，两行才共用同一个编号，与旧写法一致。
%    \begin{macrocode}
\bool_new:N \g__hit_subreuse_bool
\bool_new:N \g__hit_subskiplabel_bool
\cs_new_protected:Npn \__hit_sub_bi:nnn #1#2#3
  {
    \__hit_subfloat:nn {#2}
      {
        \bool_gset_true:N \g__hit_subskiplabel_bool
        \__hit_subfloat:nn {#1} {#3}
        \bool_gset_true:N \g__hit_subreuse_bool
      }
  }
%    \end{macrocode}
%
% \changes{v3.2a}{0000/00/00}{旧写法加废弃提示（\issue[284]）}
% 旧写法的提示。每种只报一次，用 \cs{\_\_hit\_warn\_once:nnn} 记名。\pkg{subfigure}
% 专有的开关与命令没有对应写法，报出来总比「未定义控制序列」强。
%    \begin{macrocode}
\msg_new:nnn { hithesis } { deprecated-subfig }
  {
    #2 \\
    请改写成~\iow_char:N \\ subfigure[\iow_char:N \\ bisubcaption{中文}{英文}]%
    {\iow_char:N \\ label{键}图}。 \\
    旧写法将在~v4.1（2028~年主要版本）中移除。
  }
\msg_new:nnn { hithesis } { removed-subfig }
  {
    \iow_char:N \\ #1~是~subfigure~宏包的东西，模板已改用~subcaption，这条已经失效。 \\
    请改用~\iow_char:N \\ #2。
  }
\msg_new:nnn { hithesis } { mapped-subfig }
  {
    \iow_char:N \\ #1~是~subfigure~宏包的开关，已自动转成~
    \iow_char:N \\ captionsetup[sub]{#2}。 \\
    建议直接改用新写法，兼容将在~v4.1（2028~年主要版本）中移除。
  }
\cs_new_protected:Npn \__hit_sub_dropped:nn #1#2
  { \__hit_warn_once:nnn {#1} { removed-subfig } {#2} }
\cs_new_protected:Npn \__hit_sub_switch:nnnn #1#2#3#4
  {
    \cs_new_protected:cpn { #1 true }
      {
        \__hit_warn_once:nnn { if#1 } { mapped-subfig } { #2 = #3 }
        \captionsetup [ sub ] { #2 = #3 }
      }
    \cs_new_protected:cpn { #1 false }
      {
        \__hit_warn_once:nnn { if#1 } { mapped-subfig } { #2 = #4 }
        \captionsetup [ sub ] { #2 = #4 }
      }
  }
\__hit_sub_switch:nnnn { subcaphang }
  { format } { hang } { plain }
\__hit_sub_switch:nnnn { subcapcenter }
  { justification } { centering } { justified }
\__hit_sub_switch:nnnn { subcapcenterlast }
  { justification } { centerlast } { justified }
\__hit_sub_switch:nnnn { subcapnooneline }
  { singlelinecheck } { false } { true }
\__hit_sub_switch:nnnn { subcapraggedright }
  { justification } { raggedright } { justified }
\cs_new_protected:Npn \listsubcaptions
  { \__hit_sub_dropped:nn { listsubcaptions } { captionsetup[sub]{list=true} } }
%    \end{macrocode}
%
% 拆嵌套写法之前先提示。
%    \begin{macrocode}
\cs_new_protected:Npn \__hit_sub_unnest:nw #1 \subfigure [#2]#3 \q_stop
  {
    \__hit_warn_once:nnn { nested-subfigure } { deprecated-subfig }
      { 嵌套的~subfigure~写法已不推荐。 }
    \__hit_sub_bi:nnn {#2} {#1} {#3}
  }
\cs_new_protected:Npn \__hit_sub_bi:w \bisubcaption #1#2 \q_stop #3
  { \__hit_sub_bi:nnn {#1} {#2} {#3} }
\cs_new_protected:Npn \__hit_sub_nocap:n #1
  {
    \tl_gclear:N \g__hit_sublabel_tl
    \hbox_set:Nn \l__hit_sub_box
      {
        \cs_set_protected:Npn \label ##1 { \tl_gset:Nn \g__hit_sublabel_tl {##1} }
        #1
      }
    \dim_compare:nNnTF { \box_wd:N \l__hit_sub_box } = { 0pt }
      {
        \tl_gset_eq:NN \g__hit_subpending_tl \g__hit_sublabel_tl
        \__hit_warn_once:nnn { empty-subfigure } { deprecated-subfig }
          { 用空的~subfigure~占标签已不推荐。 }
        \leavevmode
        \__hit_sub_eat_rewind:
      }
      { \__hit_subfloat:nn { } { \box_use_drop:N \l__hit_sub_box } }
  }
\NewDocumentCommand \__hit_subfloat_cmd: { o m }
  {
    \IfNoValueTF {#1}
      { \__hit_sub_nocap:n {#2} }
      {
        \tl_if_head_eq_meaning:nNTF {#2} \subfigure
          { \__hit_sub_unnest:nw {#1} #2 \q_stop }
          {
            \tl_if_head_eq_meaning:nNTF {#1} \bisubcaption
              { \__hit_sub_bi:w #1 \q_stop {#2} }
              {
                \tl_if_in:nnT {#2} { \subfigure }
                  {
                    \__hit_warn_once:nnn { unrecognised-nesting }
                      { deprecated-subfig }
                      { 内容里有~subfigure，但不在最前面，认不出是双语写法。 }
                  }
                \__hit_subfloat:nn {#1} {#2}
              }
          }
      }
  }
%    \end{macrocode}
%
