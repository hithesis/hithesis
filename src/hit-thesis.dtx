        \skip_set:Nn \textfloatsep { 8.50398bp~plus~2.83465bp~minus~0bp }
        \skip_set:Nn \floatsep     { 12bp~plus~2.83465bp~minus~0bp }
      }
      {
        \skip_set:Nn \intextsep    { 8.50398bp }
        \skip_set:Nn \textfloatsep { 8.50398bp }
        \skip_set:Nn \floatsep     { 12bp }
      }
