\cs_new_protected:Npn \hit@makeabstract
  {
    \hit@clearpage
    \bool_if:NT \g__hit_english_bool
      {
        \addtocontents { toc } { \nobreakspace { } \hfill \textbf { Page } \par }
        \addtocontents { \ext@table }
          { { \noindent \sihao \textbf { Table } \nobreakspace { } \hfill \textbf { Page } } \par }
        \addtocontents { \ext@figure }
          { { \noindent \sihao \textbf { Figure } \nobreakspace { } \hfill \textbf { Page } } \par }
      }
    \hit@appendix@chapter * { \cabstractcname } [ \cabstractename ]
