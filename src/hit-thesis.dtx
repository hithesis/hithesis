\bool_if:NT \g__hit_library_bool { \bool_gset_false:N \g__hit_openright_bool }
\cs_set_eq:NN \hit@cleardoublepage \cleardoublepage
\cs_new:Npn \hit@clearemptydoublepage
  { \clearpage { \pagestyle { hit@empty } \hit@cleardoublepage } }
\cs_set_eq:NN \cleardoublepage \hit@clearemptydoublepage
