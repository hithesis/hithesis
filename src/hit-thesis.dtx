%
% 将其余选项默认传递给 \pkg{ctexbook}。
%    \begin{macrocode}
\keys_define:nn { hit / class }
  {
    unknown .code:n =
      {
        \tl_if_empty:nTF {#1}
          { \exp_args:NV \PassOptionsToClass \l_keys_key_str { ctexbook } }
          {
            \use:x
              {
                \exp_not:N \PassOptionsToClass
                  { \l_keys_key_str = \exp_not:n {#1} } { ctexbook }
              }
          }
      } ,
  }
%    \end{macrocode}
%
% 解析转发到模块的选项。
%    \begin{macrocode}
\tl_new:N \g__hit_toc_english_tl  \tl_gset:Nn \g__hit_toc_english_tl { auto }
\tl_new:N \g__hit_toc_blank_tl    \tl_gset:Nn \g__hit_toc_blank_tl   { auto }
\tl_new:N \g__hit_toc_four_tl     \tl_gset:Nn \g__hit_toc_four_tl    { auto }
\tl_new:N \g__hit_pnline_main_tl   \tl_gset:Nn \g__hit_pnline_main_tl  { auto }
\tl_new:N \g__hit_pnline_front_tl  \tl_gset:Nn \g__hit_pnline_front_tl { auto }
\tl_new:N \g__hit_headrule_tl      \tl_gset:Nn \g__hit_headrule_tl     { auto }
\keys_define:nn { hit / class }
  {
    tocfour  .code:n = { \tl_gset:Nn \g__hit_toc_four_tl    {#1} } ,
    tocblank .code:n = { \tl_gset:Nn \g__hit_toc_blank_tl   {#1} } ,
    engtoc   .code:n = { \tl_gset:Nn \g__hit_toc_english_tl {#1} } ,
    bsmainpagenumberline  .code:n = { \tl_gset:Nn \g__hit_pnline_main_tl  {#1} } ,
    bsfrontpagenumberline .code:n = { \tl_gset:Nn \g__hit_pnline_front_tl {#1} } ,
    bsheadrule            .code:n = { \tl_gset:Nn \g__hit_headrule_tl     {#1} } ,
    tocfour  .default:n = { true } , tocblank .default:n = { true } ,
    engtoc   .default:n = { true } ,
    bsmainpagenumberline  .default:n = { true } ,
    bsfrontpagenumberline .default:n = { true } ,
    bsheadrule            .default:n = { true } ,
  }
\ProcessKeyOptions [~hit~/~class~]
%    \end{macrocode}
