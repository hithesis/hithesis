% 按照我工要求，页面中标题之下不少于一行。
% ^^A ======================================================================
% ^^A Module book-chapter: 章节标题格式（字号、缩进、间距、编号样式）（book）
% ^^A ======================================================================
%    \begin{macrocode}
%<*thesis-chapter>
%    \end{macrocode}
%
% \changes{v3.2a}{0000/00/00}{标题字体、目录里章标题的字体与节号之后的间隔
%   迁到 expl3，四个重复的 \cs{ifboolexpr} 收敛成两个函数。}
% \cs{hit@title@font} 是标题字体，\cs{hit@chaptoc@font} 是目录里章标题的字体
% （注意别跟 \file{book-toc} 里的 \cs{hit@chaptoc@font} 弄混，那个只在
% \option{toc/sans-font} 打开时才定义）。\cs{hit@sectionsep} 与
% \cs{hit@sectionsepsz} 是节号与节名之间的间隔，两者只差哈尔滨本科算不算进
% \cs{quad}。四个都可展开，能直接写进 \cs{ctexset} 的取值。
%    \begin{macrocode}
\cs_new:Npn \hit@title@font
  { \bool_if:NTF \g__hit_arialtitle_bool { \sffamily } { \heiti } }
\cs_new:Npn \hit@chaptoc@font
  { \bool_if:NTF \g__hit_arialtitle_bool { \sffamily \heiti } { \heiti } }
\cs_new:Npn \__hit_sectionsep:n #1
  {
    \bool_lazy_or:nnTF
      {
        \bool_lazy_and_p:nn
          { \bool_if_p:N \g__hit_harbin_bool } { \bool_if_p:N \g__hit_master_bool }
      }
      { \bool_lazy_and_p:nn {#1} { \bool_if_p:N \g__hit_bachelor_bool } }
      { \quad } { \enspace }
  }
\cs_new:Npn \hit@sectionsepsz
  { \__hit_sectionsep:n { \bool_if_p:N \g__hit_shenzhen_bool } }
\cs_new:Npn \hit@sectionsep
  {
    \__hit_sectionsep:n
      {
        \bool_lazy_or_p:nn
          { \bool_if_p:N \g__hit_shenzhen_bool } { \bool_if_p:N \g__hit_harbin_bool }
      }
  }
%    \end{macrocode}
