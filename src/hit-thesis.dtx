%
%
%    \begin{macrocode}
%<*thesiscls-load>
%    \end{macrocode}
%
% 使用 \pkg{ctexbook} 类，优于调用 \pkg{ctex} 宏包。
%    \begin{macrocode}
\LoadClass[a4paper,openany,UTF8,zihao=-4,scheme=plain]{ctexbook}
\bool_gset_true:N \g__hit_base_class_loaded_bool
%    \end{macrocode}
%</thesiscls-load>
%
% ^^A ======================================================================
% ^^A Module thesiscfg: 学位论文类的固定词汇（回放配置队列）
% ^^A ======================================================================
%    \begin{macrocode}
%<*thesiscfg>
\hit@apply@presetup
\AfterPreamble
  {
    \hit@format@apply@body:
    \hit@format@apply@headings:n
      { chapter , section , subsection , subsubsection }
    \hit@format@apply@font:nN { header } \hit@header@font
    \hit@format@apply@font:nN { footer } \hit@footer@font
  }
%</thesiscfg>
%    \end{macrocode}
%
% 常量的默认值在 \file{src/setup/hit-defaults.dtx}，它在每个 \cs{file} 块的最前面读进来，
% 只记不执行；这一句把记下的东西按原顺序回放，位置就是原先配置所在的位置。
% 报告类的 \texttt{reportcfg} 是同样一句。
%
%
%<*thesiscls-tail>
%    \begin{macrocode}
\AtEndOfClass{\sloppy}
%    \end{macrocode}
