%
% \changes{v3.2a}{0000/00/00}{\option{style/glue} 决定的伸缩量抽成
%   \cs{hit@glueskip} 与 \cs{hit@gluesize}，原地重复了二十多次的
%   \cs{ifhit@glue} 判断收敛到这两个函数里。}
% \cs{hit@if} 是按标志位二选一：\cs{hit@if}\marg{flag}\marg{真}\marg{假}；
% \cs{hit@iffontset}\marg{名字}\marg{真}\marg{假} 比对 \option{fontset}，
% \cs{hit@ifnotempty}\marg{宏}\marg{真} 在宏非空时执行，
% \cs{hit@ifwider}\marg{长度}\marg{阈值}\marg{真}\marg{假} 与 \cs{hit@ifwiderdim}
% 比长度，\cs{hit@ifmore}\marg{整数}\marg{阈值}\marg{真} 比整数。
% \cs{hit@ifT}\marg{flag}\marg{真} 是只有真分支的那一半。
% 另有几个组合判断：\cs{hit@ifand} 是两个标志位同时成立；\cs{hit@ifhrbmd} 是
% 哈尔滨硕博；\cs{hit@ifgrad} 是哈尔滨硕博或深圳硕士；\cs{hit@ifstudenttype}
% 决定要不要在封面上标出学生类别；\cs{hit@ifszmaorhrbbs} 是深圳硕士或哈尔滨本科。
% 参数从 expl3 之外传进来，里面的空格照原样保留。注意原写法里 \cs{fi} 之后的
% 空格会被记号化跳过，换成以 \texttt{\}} 结尾之后那个空格就成了真的空格，
% 所以替换时要把它一起吃掉。
%
% 标题前后的间距与行距。\option{style/glue} 开时给伸缩量，关时是固定值。
% 两个函数都可展开，所以能直接写在 \cs{ctexset} 的取值里。

%    \begin{macrocode}
\cs_new:Npn \hit@if #1#2#3 { \bool_if:cTF { g__hit_#1_bool } {#2} {#3} }
\cs_new:Npn \hit@ifT #1#2 { \bool_if:cT { g__hit_#1_bool } {#2} }
\cs_new:Npn \hit@iffontset #1#2#3
  { \str_if_eq:eeTF { \hit@fontset } {#1} {#2} {#3} }
\cs_new_protected:Npn \hit@ifnotempty #1#2 { \tl_if_empty:NF #1 {#2} }
%    \end{macrocode}
%
% \changes{v3.2a}{0000/00/00}{加 \cs{hit@ifsame}，替掉三处 \cs{ifthenelse}}
% \cs{hit@ifsame}\marg{甲}\marg{乙}\marg{真}\marg{假} 比两段文字是否相同。不能用
% \cs{str\_if\_eq:eeTF}，那是完全展开后比较，遇上 \cs{hspace} 这类不可展开的命令
% 会留下悬空的 \cs{fi}；被比的正是章标题，\cs{cabstractcname} 在非本科档就是
% 「摘\cs{hspace}\marg{\cs{ccwd}}要」。这里照 \cs{ifthenelse}\marg{\cs{equal}…}
% 的做法先各自 \cs{protected@edef} 一遍，把 robust 命令挡住，再比记号表。
%    \begin{macrocode}
\tl_new:N \l__hit_cmpa_tl
\tl_new:N \l__hit_cmpb_tl
\cs_new_protected:Npn \hit@ifsame #1#2#3#4
  {
    \group_begin:
      \protected@edef \l__hit_cmpa_tl {#1}
      \protected@edef \l__hit_cmpb_tl {#2}
      \tl_if_eq:NNTF \l__hit_cmpa_tl \l__hit_cmpb_tl
        { \group_end: #3 }
        { \group_end: #4 }
  }
\cs_new:Npn \hit@ifwider #1#2#3#4 { \dim_compare:nNnTF {#1} > {#2} {#3} {#4} }
\cs_new:Npn \hit@ifwiderdim #1#2#3#4 { \dim_compare:nNnTF {#1} > {#2} {#3} {#4} }
\cs_new:Npn \hit@ifmore #1#2#3 { \int_compare:nNnT {#1} > {#2} {#3} }
\cs_new:Npn \hit@ifand #1#2#3#4
  {
    \bool_lazy_and:nnTF
      { \bool_if_p:c { g__hit_#1_bool } } { \bool_if_p:c { g__hit_#2_bool } } {#3} {#4}
  }
\cs_new:Npn \hit@ifhrbmd #1#2
  {
    \bool_lazy_and:nnTF
      { \bool_if_p:N \g__hit_harbin_bool }
      {
        \bool_lazy_or_p:nn
          { \bool_if_p:N \g__hit_master_bool } { \bool_if_p:N \g__hit_doctor_bool }
      }
      {#1} {#2}
  }
\cs_new:Npn \hit@ifszmaorhrbbs #1#2
  {
    \bool_lazy_or:nnTF
      {
        \bool_lazy_and_p:nn
          { \bool_if_p:N \g__hit_shenzhen_bool } { \bool_if_p:N \g__hit_master_bool }
      }
      {
        \bool_lazy_and_p:nn
          { \bool_if_p:N \g__hit_harbin_bool } { \bool_if_p:N \g__hit_bachelor_bool }
      }
      {#1} {#2}
  }
\cs_new:Npn \hit@ifgrad #1#2
  {
    \bool_lazy_or:nnTF
      {
        \bool_lazy_and_p:nn
          { \bool_if_p:N \g__hit_harbin_bool }
          {
            \bool_lazy_or_p:nn
              { \bool_if_p:N \g__hit_master_bool } { \bool_if_p:N \g__hit_doctor_bool }
          }
      }
      {
        \bool_lazy_and_p:nn
          { \bool_if_p:N \g__hit_shenzhen_bool } { \bool_if_p:N \g__hit_master_bool }
      }
      {#1} {#2}
  }
\cs_new:Npn \hit@ifstudenttype #1
  {
    \bool_lazy_all:nF
      {
        { ! \bool_if_p:N \g__hit_shenzhen_bool }
        { ! \bool_if_p:N \g__hit_master_bool }
        { \bool_if_p:N \g__hit_fulltime_bool }
      }
      {#1}
  }
\cs_new:Npn \hit@glueskip #1#2
  { \bool_if:NTF \g__hit_glue_bool { #1~plus~#2~minus~0bp } { #1 } }
\cs_new:Npn \hit@gluesize #1#2#3
  {
    \bool_if:NTF \g__hit_glue_bool
      { \fontsize {#1} { #2~plus~#3 } } { \fontsize {#1} {#2} }
  }
%    \end{macrocode}
