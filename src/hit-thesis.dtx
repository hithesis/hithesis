    \bool_if:NTF \g__hit_openright_bool { \cleardoublepage } { \clearpage }
    \bool_if:NTF \g__hit_zijvword_bool
      { \ziju { 0.05416667 } }
      { \bool_if:NT \g__hit_zijvregu_bool { \ziju { 0.05580808 } } }
  }
