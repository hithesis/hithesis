% \changes{v3.2a}{0000/00/00}{页码装饰与页眉横线的开关改为三态，本科与非本科
%   走同一套逻辑。装饰形式仍按学位区分：本科用 \cs{hspace}，其余用不断行空格。}
% \option{pagenumberline} 的 \texttt{auto}：正文一律带装饰；前置部分除深圳与
% 威海本科外都带。\option{headrule} 的 \texttt{auto} 一律为真。
%    \begin{macrocode}
\cs_new_protected:Npn \hit@pagenum@main
  {
    \__hit_tri_if:NnTF \g__hit_pnline_main_tl { \c_true_bool }
      { \hit@pagenum@decorated } { \hit@pagenum@plain }
  }
\cs_new_protected:Npn \hit@pagenum@front
  {
    \__hit_tri_if:NnTF \g__hit_pnline_front_tl
      {
        ! \bool_lazy_and_p:nn
            { \bool_if_p:N \g__hit_bachelor_bool }
            {
              \bool_lazy_or_p:nn
                { \bool_if_p:N \g__hit_shenzhen_bool }
                { \bool_if_p:N \g__hit_weihai_bool }
            }
      }
      { \hit@pagenum@decorated } { \hit@pagenum@plain }
  }
\cs_new_protected:Npn \hit@book@rule
  {
    \__hit_tri_if:NnTF \g__hit_headrule_tl { \c_true_bool }
      { \hit@book@headrule } { \cs_set:Npn \headrulewidth { 0pt } }
  }
\cs_new_protected:Npn \hit@book@foot
  {
    \fancyfoot [C]
      {
        \xiaowu
        \legacy_if:nTF { @mainmatter }
          { \hit@pagenum@main } { \hit@pagenum@front }
      }
  }
