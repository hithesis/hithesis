%%  examples/
%%  ├── hitart
%%  │   ├── reportplus
%%  │   └── reports
%%  └── hitbook
%%      ├── chinese
%%      └── english
\generate{
    %% book：同 art / artplus，模块按运行期顺序内联进 cls。
    \file{\jobname book.cls}{
    \from{\jobname.dtx}{thesiscls}
    \from{hit-fonts.dtx}{shared-fonts}
    \from{hit-math.dtx}{shared-math}
    \from{hit-table.dtx}{shared-table}
    \from{hit-footnote.dtx}{shared-footnote}
    \from{hit-publist.dtx}{shared-publist}
    \from{hit-meta.dtx}{shared-meta}
    \from{hit-thesis.dtx}{thesis-options}
    \from{hit-thesis.dtx}{thesiscls-load}
    \from{hit-thesis.dtx}{thesis-fonts}
    \from{hit-thesis.dtx}{thesis-meta}
    \from{hit-thesis.dtx}{thesis-pagestyle}
    \from{hit-thesis.dtx}{thesis-frontmatter}
    \from{hit-thesis.dtx}{thesis-chapter}
    \from{hit-thesis.dtx}{thesis-bib}
    \from{hit-thesis.dtx}{thesis-appendix}
    \from{hit-thesis.dtx}{thesis-deps-a}
    \from{hit-thesis.dtx}{thesis-hyperlink}
    \from{hit-thesis.dtx}{thesis-deps-b}
    \from{hit-thesis.dtx}{thesis-geometry}
    \from{hit-thesis.dtx}{thesis-deps-c}
    \from{hit-thesis.dtx}{thesis-glossary}
    \from{hit-thesis.dtx}{thesis-mainmatter}
    \from{hit-thesis.dtx}{thesis-paragraph}
    \from{hit-thesis.dtx}{thesis-footnote}
    \from{hit-thesis.dtx}{thesis-math}
    \from{hit-thesis.dtx}{thesis-floats}
    \from{hit-thesis.dtx}{thesis-toc}
    \from{hit-thesis.dtx}{thesiscfg}
    \from{\jobname.dtx}{thesiscfg-tail}
    \from{hit-thesis.dtx}{thesiscls-tail}
    }
    %% artplus：模块内容按运行期加载顺序直接拼进 cls，不再生成 modules/*.sty。
    %% docstrip 按 \from 的书写顺序输出，与守卫在 dtx 里的位置、dtx 之间的先后
    %% 都无关。子图题与固定词汇两个模块与 art 共用，从 hit-report.dtx 取。
    \file{\jobname artplus.cls}{
    \from{\jobname.dtx}{szreportcls}
    \from{hit-fonts.dtx}{shared-fonts}
    \from{hit-math.dtx}{shared-math}
    \from{hit-table.dtx}{shared-table}
    \from{hit-footnote.dtx}{shared-footnote}
    \from{hit-publist.dtx}{shared-publist}
    \from{hit-meta.dtx}{shared-meta}
    \from{hitsz-report.dtx}{szreport-options}
    \from{hitsz-report.dtx}{szreportcls-load}
    \from{hitsz-report.dtx}{szreport-fonts}
    \from{hitsz-report.dtx}{szreport-meta}
    \from{hitsz-report.dtx}{szreport-pagestyle}
    \from{hitsz-report.dtx}{szreport-frontmatter}
    \from{hitsz-report.dtx}{szreport-chapter}
    \from{hitsz-report.dtx}{szreport-bib}
    \from{hitsz-report.dtx}{szreport-deps-a}
    \from{hitsz-report.dtx}{szreport-hyperlink}
    \from{hitsz-report.dtx}{szreport-deps-b}
    \from{hitsz-report.dtx}{szreport-geometry}
    \from{hitsz-report.dtx}{szreport-deps-c}
    \from{hit-report.dtx}{report-subfig}
    \from{hit-report.dtx}{reportcfg}
    \from{hitsz-report.dtx}{szreportcls-tail}
    }
    %% art：同 artplus，模块按运行期顺序内联进 cls。
    \file{\jobname art.cls}{
    \from{\jobname.dtx}{reportcls}
    \from{hit-fonts.dtx}{shared-fonts}
    \from{hit-math.dtx}{shared-math}
    \from{hit-table.dtx}{shared-table}
    \from{hit-footnote.dtx}{shared-footnote}
    \from{hit-publist.dtx}{shared-publist}
    \from{hit-meta.dtx}{shared-meta}
    \from{hit-report.dtx}{report-options}
    \from{hit-report.dtx}{reportcls-load}
    \from{hit-report.dtx}{report-fonts}
    \from{hit-report.dtx}{report-meta}
    \from{hit-report.dtx}{report-floats}
    \from{hit-report.dtx}{report-pagestyle}
    \from{hit-report.dtx}{report-frontmatter}
    \from{hit-report.dtx}{report-chapter}
    \from{hit-report.dtx}{report-bib}
    \from{hit-report.dtx}{report-deps-a}
    \from{hit-report.dtx}{report-hyperlink}
    \from{hit-report.dtx}{report-deps-b}
    \from{hit-report.dtx}{report-geometry}
    \from{hit-report.dtx}{report-deps-c}
    \from{hit-report.dtx}{report-subfig}
    \from{hit-report.dtx}{report-toc}
    \from{hit-report.dtx}{reportcfg}
    \from{hit-report.dtx}{reportcls-tail}
    }
    \usepreamble\istpreamble
    \file{\jobname.ist}{\from{\jobname.dtx}{ist}}
    \usepreamble\defaultpreamble\usepostamble\defaultpostamble
    \file{dtx-style.sty}{\from{\jobname.dtx}{dtx-style}}
}




\generate{
    \usepostamble\empty
    \file{\jobname.bst}{\from{hithesis-bst.dtx}{bst}}
    \file{hitszthesis.bst}{\from{hithesis-bst.dtx}{shenzhenbst}}
}

\edef\epspreamble{\perCent!PS-Adobe-3.0 EPSF-3.0}
\generate{\usepreamble\epspreamble
	\usepostamble\empty
	\file{hitlogo.eps}{\from{hithesis-eps.dtx}{hitlogo}}
	\file{bthesistitle.eps}{\from{hithesis-eps.dtx}{bthesistitle}}
  \file{shenzhenbthesistitle.eps}{\from{hithesis-eps.dtx}{shenzhenbthesistitle}}
	\file{zfb.eps}{\from{hithesis-eps.dtx}{zfb}}
  \file{hrb-bachelor-bottommark.eps}{\from{hithesis-eps.dtx}{hrb-bachelor-bottommark}}
}

\edef\epspreamble{\perCent!PS-Adobe-2.0 EPSF-1.2}
\generate{\usepreamble\epspreamble
	\usepostamble\empty
	\file{golfer.eps}{\from{hithesis-eps.dtx}{golfer}}
}

