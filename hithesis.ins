  \Msg{* \space\space hithesisart.cfg}
  \Msg{* \space\space hithesis.sty}
  \Msg{* \space\space hithesis.ist}
  \Msg{* \space\space hithesis.bst}
  \Msg{* \space\space hitszthesis.bst}
  \Msg{* \space\space hithesis-logo.eps}
  \Msg{* \space\space hithesis-bthesistitle.eps}
  \Msg{* \space\space hithesis-shenzhenbthesistitle.eps}
  \Msg{* \space\space hithesis-hrb-bachelor-bottommark.eps}
  \Msg{* \space\space hithesis-zfb.eps}
  \Msg{* \space\space hithesis-golfer.eps}
  \Msg{*}
