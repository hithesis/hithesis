%%  examples/
%%  ├── hitart
%%  │   ├── reportplus
%%  │   └── reports
%%  └── hitbook
%%      ├── chinese
%%      └── english
\generate{
    %% book：与 art 一样，模块按运行期顺序内联进 cls。
    %% 配置在 hit-defaults.dtx，三份输出共用，排在每个块的最前面。排末尾会报
    %% Incompatible order of input files：docstrip 的输入文件表是全局只增的，
    %% 一个被多份输出共用的文件只有排在最前，各份输出要求的先后才彼此相容。
    %% 配置因此是「早读晚生效」——\hitpresetup 先记进队列，各个类在原先配置所在
    %% 的位置调用 \hit@apply@presetup 回放。
    \file{hit-thesis.cls}{
    \from{\jobname.dtx}{thesiscls}
    \from{hit-defaults.dtx}{shared-defaults,thesis-defaults}
    \from{hit-messages.dtx}{shared-messages}
    \from{hit-lang.dtx}{shared-lang}
    \from{hit-fonts.dtx}{shared-fonts}
    \from{hit-math.dtx}{shared-math}
    \from{hit-table.dtx}{shared-table}
    \from{hit-footnote.dtx}{shared-footnote}
    \from{hit-list.dtx}{shared-list}
    \from{hit-hyperlink.dtx}{shared-hyperlink}
    \from{hit-title.dtx}{shared-title}
    \from{hit-spread.dtx}{shared-spread}
    \from{hit-date.dtx}{shared-date}
    \from{hit-caption.dtx}{shared-caption}
    \from{hit-subfigure.dtx}{shared-subfigure}
    \from{hit-key-engine.dtx}{shared-key-engine}
    \from{hit-option-engine.dtx}{shared-option-engine}
    \from{hit-bibstyle.dtx}{shared-bibstyle}
    \from{hit-structure.dtx}{shared-structure}
    \from{hit-thesis-keylist.dtx}{thesis-options}
    \from{hit-thesis.dtx}{thesiscls-load}
    \from{hit-thesis.dtx}{thesis-fonts}
    \from{hit-thesis-keylist.dtx}{thesis-keylist}
    \from{hit-thesis-pagestyle.dtx}{thesis-pagestyle}
    \from{hit-thesis-cover.dtx}{thesis-cover}
    \from{hit-thesis-abstract.dtx}{thesis-abstract}
    \from{hit-thesis-toc.dtx}{thesis-toc-lists}
    \from{hit-thesis-heading.dtx}{thesis-chapter}
    \from{hit-thesis-bib.dtx}{thesis-bib}
    \from{hit-thesis-appendix.dtx}{thesis-appendix}
    \from{hit-thesis-backmatter.dtx}{thesis-backmatter}
    \from{hit-thesis-statement.dtx}{thesis-statement}
    \from{hit-thesis-resolution.dtx}{thesis-resolution}
    \from{hit-thesis.dtx}{thesis-deps-a}
    \from{hit-thesis.dtx}{thesis-hyperlink}
    \from{hit-thesis.dtx}{thesis-deps-b}
    \from{hit-thesis-geometry.dtx}{thesis-geometry}
    \from{hit-thesis.dtx}{thesis-deps-c}
    \from{hit-thesis.dtx}{thesis-glossary}
    \from{hit-thesis-matter.dtx}{thesis-mainmatter}
    \from{hit-thesis-paragraph.dtx}{thesis-paragraph}
    \from{hit-thesis.dtx}{thesis-footnote}
    \from{hit-thesis.dtx}{thesis-math}
    \from{hit-thesis-float.dtx}{thesis-floats}
    \from{hit-thesis-toc.dtx}{thesis-toc}
    \from{hit-thesis.dtx}{thesiscls-tail}
    \from{hit-thesis.dtx}{thesiscfg}
    }
    %% art：同 book，模块按运行期顺序内联进 cls。深圳博士中期也在这里，
    %% 由 campus/type/stage 三个选项选中，hithesisartplus.cls 只是转发。
    \file{hit-report.cls}{
    \from{\jobname.dtx}{reportcls}
    \from{hit-defaults.dtx}{shared-defaults,report-defaults}
    \from{hit-messages.dtx}{shared-messages}
    \from{hit-lang.dtx}{shared-lang}
    \from{hit-fonts.dtx}{shared-fonts}
    \from{hit-math.dtx}{shared-math}
    \from{hit-table.dtx}{shared-table}
    \from{hit-footnote.dtx}{shared-footnote}
    \from{hit-list.dtx}{shared-list}
    \from{hit-hyperlink.dtx}{shared-hyperlink}
    \from{hit-title.dtx}{shared-title}
    \from{hit-spread.dtx}{shared-spread}
    \from{hit-date.dtx}{shared-date}
    \from{hit-caption.dtx}{shared-caption}
    \from{hit-subfigure.dtx}{shared-subfigure}
    \from{hit-key-engine.dtx}{shared-key-engine}
    \from{hit-option-engine.dtx}{shared-option-engine}
    \from{hit-bibstyle.dtx}{shared-bibstyle}
    \from{hit-structure.dtx}{shared-structure}
    \from{hit-report-keylist.dtx}{report-options}
    \from{hit-report.dtx}{reportcls-load}
    \from{hit-report.dtx}{report-fonts}
    \from{hit-report-keylist.dtx}{report-keylist}
    \from{hit-report-float.dtx}{report-floats}
    \from{hit-report-pagestyle.dtx}{report-pagestyle}
    \from{hit-report-cover.dtx}{report-cover}
    \from{hit-report-heading.dtx}{report-chapter}
    \from{hit-report-bib.dtx}{report-bib}
    \from{hit-report.dtx}{report-deps-a}
    \from{hit-report.dtx}{report-hyperlink}
    \from{hit-report.dtx}{report-deps-b}
    \from{hit-report-geometry.dtx}{report-geometry}
    \from{hit-report.dtx}{report-deps-c}
    \from{hit-report.dtx}{report-subfig}
    \from{hit-report-toc.dtx}{report-toc}
    \from{hit-report-matter.dtx}{report-matter}
    \from{hit-report.dtx}{reportcfg}
    \from{hit-report.dtx}{reportcls-tail}
    }
    \usepreamble\istpreamble
    \file{\jobname.ist}{\from{hit-ist.dtx}{ist}}
    \usepreamble\defaultpreamble\usepostamble\defaultpostamble
    %% 派发类：kind 选交付物种类，转发给 hit-thesis 或 hit-report。
    \file{\jobname.cls}{\from{\jobname.dtx}{dispatch}}
    %% 三个旧类名只剩转发用的空壳，实现全在 hit-thesis.cls 与 hit-report.cls。
    \file{\jobname book.cls}{\from{\jobname.dtx}{book-stub}}
    \file{\jobname art.cls}{\from{\jobname.dtx}{art-stub}}
    \file{\jobname artplus.cls}{\from{\jobname.dtx}{artplus-stub}}
    %% 示例宏包：v3.1e 的 hithesis.sty 原样搬回来，连文件名一起，
    %% 老文档的 \usepackage{hithesis} 不用改。
    \file{\jobname.sty}{\from{hit-sty.dtx}{hit-sty}}
    \file{dtx-style.sty}{\from{hit-dtx-style.dtx}{dtx-style}}
}




\generate{
    \usepostamble\empty
    \file{\jobname.bst}{\from{hit-bst.dtx}{bst}}
    \file{hitszthesis.bst}{\from{hit-bst.dtx}{shenzhenbst}}
}

\edef\epspreamble{\perCent!PS-Adobe-3.0 EPSF-3.0}
\generate{\usepreamble\epspreamble
	\usepostamble\empty
	\file{hitlogo.eps}{\from{hit-eps.dtx}{hitlogo}}
	\file{bthesistitle.eps}{\from{hit-eps.dtx}{bthesistitle}}
  \file{shenzhenbthesistitle.eps}{\from{hit-eps.dtx}{shenzhenbthesistitle}}
	\file{zfb.eps}{\from{hit-eps.dtx}{zfb}}
  \file{hrb-bachelor-bottommark.eps}{\from{hit-eps.dtx}{hrb-bachelor-bottommark}}
}

\edef\epspreamble{\perCent!PS-Adobe-2.0 EPSF-1.2}
\generate{\usepreamble\epspreamble
	\usepostamble\empty
	\file{golfer.eps}{\from{hit-eps.dtx}{golfer}}
}

