  \Msg{* \space\space hithesisart.cls}
  \Msg{* \space\space hithesisartplus.cls}
  \Msg{* \space\space hithesis.ist}
  \Msg{* \space\space hithesis.bst}
  \Msg{* \space\space hitszthesis.bst}
  \Msg{* \space\space hitlogo.eps}
  \Msg{* \space\space bthesistitle.eps}
  \Msg{* \space\space shenzhenbthesistitle.eps}
  \Msg{* \space\space golfer.eps}
  \Msg{* \space\space zfb.eps}
  \Msg{* \space\space hrb-bachelor-bottommark.eps}
  \Msg{*}
  \Msg{* To produce the documentation run the files ending with}
  \Msg{* `.dtx' through LaTeX.}
  \Msg{*}
  \Msg{* Happy TeXing!}
  \Msg{***********************************************************}}

\endbatchfile
