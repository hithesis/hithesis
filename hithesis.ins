%% Only the shared runtime files are generated here, into the current
%% directory. Copies for the example templates are made separately by
%% make_release_pkg.sh (see that script for the per-example file list).
\generate{
    \file{\jobname book.cls}{\from{\jobname.dtx}{bookcls}}
    \file{\jobname art.cls}{\from{\jobname.dtx}{artcls}}
    \file{\jobname artplus.cls}{\from{\jobname.dtx}{artpluscls}}
    \usepreamble\cfgpreamble
    \file{\jobname book.cfg}{\from{\jobname.dtx}{bookcfg}}
    \file{\jobname art.cfg}{\from{\jobname.dtx}{artcfg}}
    \usepreamble\istpreamble
    \file{\jobname.ist}{\from{\jobname.dtx}{ist}}
    \usepreamble\defaultpreamble\usepostamble\defaultpostamble
    \file{dtx-style.sty}{\from{\jobname.dtx}{dtx-style}}
    \file{\jobname.sty}{\from{\jobname.dtx}{hithesis-style}}
}


\generate{
    \usepostamble\empty
    \file{\jobname.bst}{\from{\jobname.dtx}{bst}}
    \file{hitszthesis.bst}{\from{\jobname.dtx}{shenzhenbst}}
}

\edef\epspreamble{\perCent!PS-Adobe-3.0 EPSF-3.0}
\generate{\usepreamble\epspreamble
	\usepostamble\empty
	\file{hithesis-logo.eps}{\from{\jobname.dtx}{hitlogo}}
	\file{hithesis-bthesistitle.eps}{\from{\jobname.dtx}{bthesistitle}}
  \file{hithesis-shenzhenbthesistitle.eps}{\from{\jobname.dtx}{shenzhenbthesistitle}}
	\file{hithesis-zfb.eps}{\from{\jobname.dtx}{zfb}}
  \file{hithesis-hrb-bachelor-bottommark.eps}{\from{\jobname.dtx}{hrb-bachelor-bottommark}}
}

\edef\epspreamble{\perCent!PS-Adobe-2.0 EPSF-1.2}
\generate{\usepreamble\epspreamble
	\usepostamble\empty
	\file{hithesis-golfer.eps}{\from{\jobname.dtx}{golfer}}
}

