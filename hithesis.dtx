% 释），首先来看推荐的 \texttt{xelatex} 方式：
% \begin{shell}
% # 1. 发现里面的引用关系，文件后缀 .tex 可以省略
% $ xelatex thesis
%
% # 2. 编译参考文件源文件，生成 bbl 文件
% $ bibtex thesis
%
% # 3. 下面解决引用
% $ xelatex thesis
% $ xelatex thesis   # 如果不需要生成索引此时生成完整的 pdf 文件
% $ splitindex thesis -- -s hithesis.ist  # 自动生成索引
% $ xelatex thesis.tex
% \end{shell}
%
% \subsubsection{latexmk}
