Public Sub AutoNew()
    EnsureGlobal: HITInstallButtons
    On Error Resume Next
    If LCase$(Application.ActiveDocument.AttachedTemplate.FullName) = LCase$(ThisDocument.FullName) Then StripPresetData Application.ActiveDocument
    On Error GoTo 0
End Sub

