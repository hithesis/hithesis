Attribute VB_Name = "HITContinuationTools"
Option Explicit

' Windows Word tool. All processing stays inside Word/VBA and MSXML.
' The document to edit is the source; generated documents are derived outputs.
Private Const WNS As String = "http://schemas.openxmlformats.org/wordprocessingml/2006/main"
Private Const PNS As String = "http://schemas.microsoft.com/office/2006/xmlPackage"
Private Const PRESETS As String = "urn:hithesis:single-file-word-template:v1"
Private Const SRC_TABLE As String = "HITAutoSourceTableCaption"
Private Const GEN_TABLE As String = "HITAutoGeneratedTableCaption"
Private Const FIG_START As String = "HITAutoFigureStart"
Private Const FIG_END As String = "HITAutoFigureEnd"
Private Const FIG_CAP As String = "HITAutoFigureCaptionTemplate"
Private Const FIG_EN As String = "HITAutoFigureEnglishTemplate"
Private Const TOOL_STYLE As String = "HITToolInstruction"
Private Const ROLE As String = "HITAutoContinuationRole"
Private Const BAR_NAME As String = "HITHESIS.SingleFile.Continuations"
Private Const MACRO_PREFIX As String = "HITContinuationTools."
Private gBusy As Boolean, gInstalling As Boolean, gTest As Boolean
Private gTestRoot As String, gLastError As String, gLastResult As String
Private gNextBook As Long, gNextDrawing As Long, gNextShape As Long

Private Function U(ParamArray values() As Variant) As String
    Dim value As Variant
    For Each value In values: U = U & ChrW(CLng(value)): Next
End Function

Private Function Dict() As Object
    Set Dict = CreateObject("Scripting.Dictionary")
End Function

Private Function NewXml(ByVal value As String) As Object
    Dim doc As Object
    Set doc = CreateObject("MSXML2.DOMDocument.6.0")
    doc.async = False: doc.preserveWhiteSpace = True
    If Not doc.LoadXML(value) Then Err.Raise 5100, , doc.parseError.reason
    doc.setProperty "SelectionLanguage", "XPath"
    doc.setProperty "SelectionNamespaces", "xmlns:pkg='" & PNS & "' xmlns:w='" & WNS & _
        "' xmlns:wp='http://schemas.openxmlformats.org/drawingml/2006/wordprocessingDrawing'"
    Set NewXml = doc
End Function

Private Function MainBody(ByVal flat As Object) As Object
    Set MainBody = flat.selectSingleNode("/pkg:package/pkg:part[@pkg:name='/word/document.xml']/pkg:xmlData/w:document/w:body")
    If MainBody Is Nothing Then Err.Raise 5101, , "Missing Word main story."
End Function

Private Function XNodes(ByVal parent As Object, ByVal query As String) As Collection
    Dim result As New Collection, node As Object
    For Each node In parent.selectNodes(query): result.Add node: Next
    Set XNodes = result
End Function

Private Function El(ByVal parent As Object, ByVal name As String) As Object
    Set El = parent.ownerDocument.createNode(1, "w:" & name, WNS)
End Function

Private Sub WA(ByVal node As Object, ByVal name As String, ByVal value As String)
    Dim attr As Object
    Set attr = node.ownerDocument.createNode(2, "w:" & name, WNS)
    attr.Text = value: node.Attributes.setNamedItem attr
End Sub

Private Function AV(ByVal node As Object, ByVal name As String) As String
    Dim attr As Object
    Set attr = node.Attributes.getNamedItem(name)
    If Not attr Is Nothing Then AV = attr.Text
End Function

Private Function PP(ByVal p As Object) As Object
    Dim pr As Object
    Set pr = p.selectSingleNode("w:pPr")
    If pr Is Nothing Then
        Set pr = El(p, "pPr")
        If p.firstChild Is Nothing Then p.appendChild pr Else p.insertBefore pr, p.firstChild
    End If
    Set PP = pr
End Function

Private Function StyleOf(ByVal p As Object) As String
    Dim n As Object
    Set n = p.selectSingleNode("w:pPr/w:pStyle")
    If Not n Is Nothing Then StyleOf = AV(n, "w:val")
End Function

Private Sub SetStyle(ByVal p As Object, ByVal name As String)
    Dim pr As Object, old As Object, n As Object
    Set pr = PP(p): Set old = pr.selectSingleNode("w:pStyle")
    If Not old Is Nothing Then pr.removeChild old
    Set n = El(p, "pStyle"): WA n, "val", name
    If pr.firstChild Is Nothing Then pr.appendChild n Else pr.insertBefore n, pr.firstChild
End Sub

Private Sub KeepNext(ByVal p As Object, ByVal yes As Boolean)
    Dim pr As Object, old As Object, n As Object, position As Object
    Set pr = PP(p): Set old = pr.selectSingleNode("w:keepNext")
    If Not old Is Nothing Then pr.removeChild old
    Set n = El(p, "keepNext"): WA n, "val", IIf(yes, "1", "0")
    Set position = pr.firstChild
    If Not position Is Nothing Then
        If position.nodeName = "w:pStyle" Then Set position = position.nextSibling
    End If
    If position Is Nothing Then pr.appendChild n Else pr.insertBefore n, position
End Sub

Private Function TextOf(ByVal p As Object) As String
    Dim n As Object
    For Each n In p.selectNodes(".//w:t | .//w:tab | .//w:br | .//w:cr")
        If n.nodeName = "w:t" Then TextOf = TextOf & n.Text Else TextOf = TextOf & " "
    Next
End Function

Private Function IsSpace(ByVal ch As String) As Boolean
    IsSpace = (ch = " " Or ch = vbTab Or ch = vbCr Or ch = vbLf Or ch = U(&H3000) Or ch = ChrW(160) Or ch = ChrW(&H2002))
End Function

Private Function IsDigit(ByVal ch As String) As Boolean
    IsDigit = (Len(ch) = 1 And ch >= "0" And ch <= "9")
End Function

Private Function LabelOf(ByVal value As String, ByVal kind As String) As String
    Dim i As Long, j As Long, start As Long, ch As String
    value = Replace(value, ChrW(&H200B), ""): i = 1
    Do While i <= Len(value) And IsSpace(Mid$(value, i, 1)): i = i + 1: Loop
    If Mid$(value, i, 1) <> kind Then Err.Raise 5102, , "Caption label not found: " & value
    LabelOf = kind: i = i + 1
    Do While i <= Len(value) And IsSpace(Mid$(value, i, 1)): i = i + 1: Loop
    start = i
    Do While i <= Len(value) And IsDigit(Mid$(value, i, 1)): LabelOf = LabelOf & Mid$(value, i, 1): i = i + 1: Loop
    If i = start Then Err.Raise 5103, , "Caption number not found."
    Do
        j = i
        Do While j <= Len(value) And IsSpace(Mid$(value, j, 1)): j = j + 1: Loop
        ch = Mid$(value, j, 1)
        If ch <> "-" And ch <> U(&HFF0D) Then Exit Do
        j = j + 1
        Do While j <= Len(value) And IsSpace(Mid$(value, j, 1)): j = j + 1: Loop
        If Not IsDigit(Mid$(value, j, 1)) Then Exit Do
        LabelOf = LabelOf & "-": i = j
        Do While i <= Len(value) And IsDigit(Mid$(value, i, 1)): LabelOf = LabelOf & Mid$(value, i, 1): i = i + 1: Loop
    Loop
End Function

Private Function Continued(ByVal captionId As String, ByVal isTable As Boolean) As String
    Continued = captionId & U(&HFF08, &H7EED) & IIf(isTable, U(&H8868), U(&H56FE)) & U(&HFF09)
End Function

Private Sub SetCaption(ByVal p As Object, ByVal value As String)
    Dim rp As Object, n As Object, r As Object, t As Object, children As Collection
    Set rp = p.selectSingleNode("w:r/w:rPr")
    If Not rp Is Nothing Then Set rp = rp.cloneNode(True)
    Set children = XNodes(p, "*")
    For Each n In children: If n.nodeName <> "w:pPr" Then p.removeChild n
    Next
    Set r = El(p, "r"): If Not rp Is Nothing Then r.appendChild rp
    Set t = El(p, "t"): t.Text = value: r.appendChild t: p.appendChild r
End Sub

Private Sub SetRole(ByVal flat As Object, ByVal value As String)
    Dim settings As Object, vars As Object, entry As Object, compat As Object
    Set settings = flat.selectSingleNode("/pkg:package/pkg:part[@pkg:name='/word/settings.xml']/pkg:xmlData/w:settings")
    If settings Is Nothing Then Err.Raise 5104, , "Missing document settings."
    Set vars = settings.selectSingleNode("w:docVars")
    If vars Is Nothing Then
        Set vars = El(settings, "docVars"): Set compat = settings.selectSingleNode("w:compat")
        If compat Is Nothing Then
            settings.appendChild vars
        ElseIf compat.nextSibling Is Nothing Then
            settings.appendChild vars
        Else
            settings.insertBefore vars, compat.nextSibling
        End If
    End If
    Set entry = vars.selectSingleNode("w:docVar[@w:name='" & ROLE & "']")
    If entry Is Nothing Then Set entry = El(vars, "docVar"): WA entry, "name", ROLE: vars.appendChild entry
    WA entry, "val", value
End Sub

Private Function Models(ByVal flat As Object) As Object
    Dim body As Object, children As Collection, tables As New Collection, figures As New Collection
    Dim n As Object, p As Object, rowList As Collection, item As Object, i As Long, j As Long, finish As Long, capAt As Long
    Dim region As New Collection, content As Collection, units As Collection, unit As Collection, caps As Collection
    Dim prefix As Collection, suffix As Collection, k As Long, pic As Object
    Set body = MainBody(flat): Set children = XNodes(body, "*")
    If body.selectNodes("w:p[w:pPr/w:pStyle/@w:val='" & FIG_START & "']").Length <> _
       body.selectNodes("w:p[w:pPr/w:pStyle/@w:val='" & FIG_END & "']").Length Then _
       Err.Raise 5106, , "Figure start/end markers are unbalanced. Restore the source marker styles."
    For i = 1 To children.Count
        Set n = children(i)
        If n.nodeName = "w:tbl" Then
            Set rowList = XNodes(n, "w:tr")
            If rowList.Count > 0 Then
                Set p = rowList(1).selectSingleNode("w:tc/w:p")
                If Not p Is Nothing Then
                    If StyleOf(p) = SRC_TABLE Then
                        If rowList.Count < 3 Then Err.Raise 5105, , "Managed table has no data rows."
                        Set item = Dict(): item.Add "first", n: item.Add "last", n: item.Add "node", n
                        item.Add "captionId", LabelOf(TextOf(p), U(&H8868))
                        Set content = New Collection
                        For j = 3 To rowList.Count: content.Add rowList(j): Next
                        item.Add "rows", content: tables.Add item
                    End If
                End If
            End If
        End If
    Next
    i = 1
    Do While i <= children.Count
        If StyleOf(children(i)) <> FIG_START Then
            i = i + 1
        Else
            finish = 0
            For j = i + 1 To children.Count
                If StyleOf(children(j)) = FIG_END Then finish = j: Exit For
            Next
            If finish = 0 Then Err.Raise 5106, , "Figure group end marker missing."
            Set region = New Collection
            For j = i + 1 To finish - 1: region.Add children(j): Next
            capAt = 0
            For j = 1 To region.Count
                If StyleOf(region(j)) = FIG_CAP Then capAt = j: Exit For
            Next
            If capAt = 0 Then Err.Raise 5107, , "Normal figure caption template missing."
            Set caps = New Collection: caps.Add region(capAt): k = capAt + 1
            If k <= region.Count Then
                If StyleOf(region(k)) = FIG_EN Then caps.Add region(k): k = k + 1
            End If
            Set suffix = New Collection
            For j = k To region.Count: suffix.Add region(j): Next
            Set units = New Collection: Set prefix = New Collection: Set unit = Nothing
            For j = 1 To capAt - 1
                Set n = region(j): Set pic = n.selectSingleNode(".//w:drawing | .//w:pict")
                If Not pic Is Nothing Then Set unit = New Collection: units.Add unit
                If unit Is Nothing Then prefix.Add n Else unit.Add n
            Next
            If units.Count = 0 Then Err.Raise 5107, , "A registered figure group has no picture blocks."
            Set item = Dict(): item.Add "first", children(i): item.Add "last", children(finish)
            item.Add "units", units: item.Add "captions", caps: item.Add "prefix", prefix: item.Add "suffix", suffix
            item.Add "captionId", LabelOf(TextOf(caps(1)), U(&H56FE)): figures.Add item
            i = finish + 1
        End If
    Loop
    If figures.Count <> body.selectNodes("w:p[w:pPr/w:pStyle/@w:val='" & FIG_CAP & "']").Length Then _
       Err.Raise 5107, , "Figure caption registration is incomplete. Restore the source marker styles."
    Set Models = Dict(): Models.Add "tables", tables: Models.Add "figures", figures
End Function

Private Function CleanClone(ByVal source As Object) As Object
    Dim node As Object, n As Object, a As Object, remove As Collection, names As Object, oldId As String, newId As String
    Set node = source.cloneNode(True): Set remove = XNodes(node, ".//w:bookmarkStart | .//w:bookmarkEnd")
    For Each n In remove: n.parentNode.removeChild n: Next
    Set names = Dict()
    For Each n In node.selectNodes(".//*")
        If n.baseName = "shape" Then
            oldId = AV(n, "id")
            If Len(oldId) Then
                gNextShape = gNextShape + 1: newId = "HITAutoShape" & CStr(gNextShape)
                names(oldId) = newId: n.setAttribute "id", newId
            End If
        End If
        If n.baseName = "docPr" Or n.baseName = "cNvPr" Then
            If Len(AV(n, "id")) Then n.setAttribute "id", CStr(gNextDrawing): gNextDrawing = gNextDrawing + 1
        End If
    Next
    For Each n In node.selectNodes(".//*")
        If names.Exists(AV(n, "ShapeID")) Then n.setAttribute "ShapeID", names(AV(n, "ShapeID"))
        If n.baseName = "OLEObject" And Len(AV(n, "ObjectID")) Then
            n.setAttribute "ObjectID", "_HITAuto" & CStr(gNextShape) & "_" & CStr(gNextDrawing): gNextDrawing = gNextDrawing + 1
        End If
    Next
    Set CleanClone = node
End Function

Private Sub InitIds(ByVal body As Object)
    Dim n As Object
    gNextBook = 1: gNextDrawing = 10000: gNextShape = 0
    For Each n In body.selectNodes(".//w:bookmarkStart")
        If CLng(AV(n, "w:id")) >= gNextBook Then gNextBook = CLng(AV(n, "w:id")) + 1
    Next
    For Each n In body.selectNodes(".//wp:docPr")
        If CLng(AV(n, "id")) >= gNextDrawing Then gNextDrawing = CLng(AV(n, "id")) + 1
    Next
End Sub

Private Function Book(ByVal nodes As Collection, ByVal name As String) As String
    Dim first As Object, last As Object, n As Object, p As Object, start As Object, finish As Object
    For Each n In nodes
        If n.nodeName = "w:p" Then
            If first Is Nothing Then Set first = n
            Set last = n
        Else
            For Each p In n.selectNodes(".//w:p")
                If first Is Nothing Then Set first = p
                Set last = p
            Next
        End If
    Next
    If first Is Nothing Then Err.Raise 5108, , "Cannot mark an empty block."
    Set start = El(first, "bookmarkStart"): WA start, "id", CStr(gNextBook): WA start, "name", name
    Set finish = El(first, "bookmarkEnd"): WA finish, "id", CStr(gNextBook): gNextBook = gNextBook + 1
    Set n = first.selectSingleNode("w:pPr")
    If n Is Nothing Then
        If first.firstChild Is Nothing Then first.appendChild start Else first.insertBefore start, first.firstChild
    ElseIf n.nextSibling Is Nothing Then
        first.appendChild start
    Else
        first.insertBefore start, n.nextSibling
    End If
    last.appendChild finish: Book = name
End Function

Private Function One(ByVal node As Object) As Collection
    Set One = New Collection: One.Add node
End Function

Private Function BreakP(ByVal body As Object) As Object
    Dim p As Object, pr As Object, sp As Object, n As Object, rp As Object
    Set p = El(body, "p"): Set pr = El(body, "pPr"): p.appendChild pr
    Set n = El(body, "pageBreakBefore"): pr.appendChild n
    Set n = El(body, "snapToGrid"): WA n, "val", "0": pr.appendChild n
    Set sp = El(body, "spacing"): WA sp, "before", "0": WA sp, "after", "0": WA sp, "line", "20": WA sp, "lineRule", "exact": pr.appendChild sp
    Set rp = El(body, "rPr"): Set n = El(body, "sz"): WA n, "val", "2": rp.appendChild n: pr.appendChild rp
    Set BreakP = p
End Function

Private Sub ReplaceSpan(ByVal body As Object, ByVal first As Object, ByVal last As Object, ByVal nodes As Collection)
    Dim n As Object, current As Object, following As Object, done As Boolean
    For Each n In nodes: body.insertBefore n, first: Next
    Set current = first
    Do
        done = (current Is last): Set following = current.nextSibling
        body.removeChild current
        If done Then Exit Do
        Set current = following
        If current Is Nothing Then Err.Raise 5109, , "Invalid replacement boundary."
    Loop
End Sub

Private Function EmptyPlan() As Object
    Set EmptyPlan = Dict(): EmptyPlan.Add "tables", Dict(): EmptyPlan.Add "figures", Dict()
End Function

Private Function Render(ByVal sourceXml As String, ByVal plan As Object, ByRef spec As Object) As Object
    Dim flat As Object, body As Object, model As Object, tables As Collection, figures As Collection
    Dim table As Object, figure As Object, rowList As Collection, headers As Collection, rows As Collection
    Dim sizes As Collection, groups As Collection, group As Variant, nodes As Collection, unit As Collection, caps As Collection
    Dim part As Object, cap As Object, n As Object, p As Object, entry As Object, item As Object
    Dim i As Long, j As Long, k As Long, ti As Long, gi As Long, fi As Long, ci As Long, offset As Long, size As Variant, ui As Variant
    Dim originalMarks As Object
    Dim tableSpec As New Collection, figureSpec As New Collection, captions As Collection, unitBooks As Collection, captionBooks As Collection
    Set flat = NewXml(sourceXml): Set body = MainBody(flat): Set model = Models(flat): InitIds body
    Set originalMarks = BookmarkNames(body)
    Set tables = model("tables"): Set figures = model("figures")
    If tables.Count + figures.Count = 0 Then Err.Raise 5119, , "No registered table or figure groups remain."
    For ti = 1 To tables.Count
        Set table = tables(ti): Set rows = table("rows")
        If plan("tables").Exists(CStr(ti - 1)) Then
            Set sizes = plan("tables")(CStr(ti - 1))
        Else
            Set sizes = New Collection: sizes.Add rows.Count
        End If
        Set nodes = New Collection: offset = 0: fi = 0
        For Each size In sizes
            Set part = table("node").cloneNode(True): Set rowList = XNodes(part, "w:tr")
            For Each n In rowList: part.removeChild n: Next
            Set headers = XNodes(table("node"), "w:tr")
            For j = 1 To 2
                If fi = 0 Then Set n = headers(j).cloneNode(True) Else Set n = CleanClone(headers(j))
                For Each p In n.selectNodes("w:tc/w:p"): KeepNext p, True: Next
                part.appendChild n
            Next
            Set cap = part.selectSingleNode("w:tr/w:tc/w:p"): SetStyle cap, GEN_TABLE
            If fi > 0 Then SetCaption cap, Continued(table("captionId"), True)
            For j = offset + 1 To offset + CLng(size): part.appendChild rows(j).cloneNode(True): Next
            Set entry = Dict(): entry.Add "id", "T" & CStr(ti - 1) & "F" & CStr(fi)
            entry.Add "group", ti - 1: entry.Add "bookmark", Book(One(cap), "HITAC_T" & CStr(ti - 1) & "F" & CStr(fi))
            entry.Add "offset", offset: entry.Add "count", CLng(size): tableSpec.Add entry
            If fi > 0 Then nodes.Add BreakP(body)
            nodes.Add part: offset = offset + CLng(size): fi = fi + 1
        Next
        If offset <> rows.Count Then Err.Raise 5110, , "Table partition lost rows."
        ReplaceSpan body, table("first"), table("last"), nodes
    Next
    For gi = 1 To figures.Count
        Set figure = figures(gi): Set groups = New Collection
        If plan("figures").Exists(CStr(gi - 1)) Then
            Set groups = plan("figures")(CStr(gi - 1))
        Else
            For i = 1 To figure("units").Count
                Set unit = New Collection: unit.Add i - 1: groups.Add unit
            Next
        End If
        Set nodes = New Collection: Set unitBooks = New Collection: Set captionBooks = New Collection
        For Each n In figure("prefix"): nodes.Add n.cloneNode(True): Next
        ci = 0
        For Each group In groups
            If ci > 0 And plan("figures").Exists(CStr(gi - 1)) Then nodes.Add BreakP(body)
            For Each ui In group
                Set unit = New Collection
                For Each n In figure("units")(CLng(ui) + 1)
                    Set p = n.cloneNode(True): KeepNext p, True: unit.Add p
                Next
                unitBooks.Add Book(unit, "HITAC_F" & CStr(gi - 1) & "U" & CStr(ui))
                For Each n In unit: nodes.Add n: Next
            Next
            Set caps = New Collection
            For j = 1 To IIf(ci = 0, figure("captions").Count, 1)
                If ci = 0 Then Set p = figure("captions")(j).cloneNode(True) Else Set p = CleanClone(figure("captions")(j))
                If ci > 0 Then SetCaption p, Continued(figure("captionId"), False)
                SetStyle p, GEN_TABLE: KeepNext p, (ci = 0 And j < figure("captions").Count): caps.Add p
            Next
            captionBooks.Add Book(caps, "HITAC_F" & CStr(gi - 1) & "C" & CStr(ci))
            For Each n In caps: nodes.Add n: Next
            ci = ci + 1
        Next
        For Each n In figure("suffix"): nodes.Add n.cloneNode(True): Next
        Set entry = Dict(): entry.Add "id", gi - 1: entry.Add "units", unitBooks: entry.Add "captions", captionBooks: entry.Add "groups", groups
        figureSpec.Add entry: ReplaceSpan body, figure("first"), figure("last"), nodes
    Next
    Set nodes = XNodes(body, "w:p[w:pPr/w:pStyle/@w:val='" & TOOL_STYLE & "']")
    For Each n In nodes: body.removeChild n: Next
    CheckBookmarks body, originalMarks
    SetRole flat, "generated"
    Set spec = Dict(): spec.Add "tables", tableSpec: spec.Add "figures", figureSpec
    Set Render = flat
End Function

Private Function BookmarkNames(ByVal body As Object) As Object
    Dim names As Object, n As Object, key As String
    Set names = Dict()
    For Each n In body.selectNodes(".//w:bookmarkStart")
        key = AV(n, "w:id")
        If names.Exists(key) Then Err.Raise 5140, , "Duplicate bookmark identity."
        names.Add key, AV(n, "w:name")
    Next
    Set BookmarkNames = names
End Function

Private Sub CheckBookmarks(ByVal body As Object, ByVal original As Object)
    Dim names As Object, ends As Object, n As Object, key As Variant
    Set names = BookmarkNames(body): Set ends = Dict()
    For Each n In body.selectNodes(".//w:bookmarkEnd")
        key = AV(n, "w:id")
        If ends.Exists(key) Then Err.Raise 5141, , "Duplicate bookmark end."
        ends.Add key, True
    Next
    If names.Count <> ends.Count Then Err.Raise 5142, , "Unbalanced bookmarks."
    For Each key In names.Keys
        If Not ends.Exists(key) Then Err.Raise 5143, , "Bookmark end missing."
    Next
    For Each key In original.Keys
        If Not names.Exists(key) Then Err.Raise 5144, , "A source bookmark would be removed."
        If names(key) <> original(key) Then Err.Raise 5145, , "A source bookmark would change identity."
    Next
End Sub

Private Function PageAt(ByVal doc As Object, ByVal position As Long) As Long
    PageAt = CLng(doc.Range(position, position + 1).Information(3))
End Function

Private Function Position(ByVal doc As Object, ByVal name As String) As Object
    Dim r As Object, item As Object, last As Long
    If Not doc.Bookmarks.Exists(name) Then Err.Raise 5111, , "Generated bookmark missing: " & name
    Set r = doc.Bookmarks(name).Range: last = r.End - 1: If last < r.Start Then last = r.Start
    Set item = Dict(): item.Add "start", PageAt(doc, r.Start): item.Add "end", PageAt(doc, last)
    item.Add "text", r.Text: item.Add "pictures", r.InlineShapes.Count: Set Position = item
End Function

Private Function Measure(ByVal doc As Object, ByVal spec As Object) As Object
    Dim result As Object, tables As New Collection, figures As New Collection, item As Object, entry As Object
    Dim table As Object, row As Object, rows As Collection, record As Object, units As Collection, caps As Collection
    Dim name As Variant, i As Long, last As Long
    Set result = Dict(): result.Add "pages", doc.ComputeStatistics(2)
    For Each entry In spec("tables")
        Set table = doc.Bookmarks(entry("bookmark")).Range.Tables(1): Set rows = New Collection
        For i = 1 To table.Rows.Count
            Set row = table.Rows(i).Range: last = row.End - 2: If last < row.Start Then last = row.Start
            Set record = Dict(): record.Add "start", PageAt(doc, row.Start): record.Add "end", PageAt(doc, last): record.Add "text", row.Text
            rows.Add record
        Next
        Set item = Dict(): item.Add "group", entry("group"): item.Add "id", entry("id"): item.Add "rows", rows: tables.Add item
    Next
    For Each entry In spec("figures")
        Set units = New Collection: Set caps = New Collection
        For Each name In entry("units"): units.Add Position(doc, CStr(name)): Next
        For Each name In entry("captions"): caps.Add Position(doc, CStr(name)): Next
        Set item = Dict(): item.Add "id", entry("id"): item.Add "units", units: item.Add "captions", caps: item.Add "groups", entry("groups"): figures.Add item
    Next
    result.Add "tables", tables: result.Add "figures", figures: Set Measure = result
End Function

Private Function NextPlan(ByVal measured As Object, ByVal oldPlan As Object) As Object
    Dim plan As Object, entry As Object, row As Object, rows As Collection, sizes As Collection
    Dim groups As Collection, current As Collection, unit As Object, cap As Object, group As Variant
    Dim units As Collection, i As Long, ci As Long, index As Variant, page As Long, count As Long, key As String
    Set plan = EmptyPlan()
    For Each entry In measured("tables")
        key = CStr(entry("group")): Set rows = entry("rows")
        If rows.Count < 3 Then Err.Raise 5112, , "Empty generated table fragment."
        page = rows(3)("start")
        For i = 1 To 2
            If rows(i)("start") <> page Or rows(i)("end") <> page Then Err.Raise 5113, , "Table header orphaned."
        Next
        If Not plan("tables").Exists(key) Then plan("tables").Add key, New Collection
        Set sizes = plan("tables")(key): count = 0: page = 0
        For i = 3 To rows.Count
            Set row = rows(i)
            If row("start") <> row("end") Then Err.Raise 5114, , "A data row exceeds one page."
            If page <> row("start") And count > 0 Then sizes.Add count: count = 0
            page = row("start"): count = count + 1
        Next
        If count > 0 Then sizes.Add count
    Next
    For Each entry In measured("figures")
        key = CStr(entry("id")): Set units = entry("units"): Set groups = New Collection
        If Not oldPlan("figures").Exists(key) Then
            Set current = Nothing: page = 0
            For i = 1 To units.Count
                Set unit = units(i)
                If unit("pictures") < 1 Or unit("start") <> unit("end") Then Err.Raise 5115, , "Picture block does not fit a page."
                If current Is Nothing Then
                    Set current = New Collection: groups.Add current
                ElseIf page <> unit("start") Then
                    Set current = New Collection: groups.Add current
                End If
                current.Add i - 1: page = unit("start")
            Next
        Else
            ci = 1
            For Each group In entry("groups")
                Set cap = entry("captions")(ci)
                If cap("start") <> cap("end") Then Err.Raise 5116, , "Figure caption split."
                If units(CLng(group(group.Count)) + 1)("end") <> cap("start") Then Err.Raise 5117, , "Figure caption orphaned."
                Set current = Nothing: page = 0
                For Each index In group
                    Set unit = units(CLng(index) + 1)
                    If unit("start") <> unit("end") Then Err.Raise 5118, , "Picture block split."
                    If current Is Nothing Then
                        Set current = New Collection: groups.Add current
                    ElseIf page <> unit("start") Then
                        Set current = New Collection: groups.Add current
                    End If
                    current.Add CLng(index): page = unit("start")
                Next
                ci = ci + 1
            Next
        End If
        plan("figures").Add key, groups
    Next
    Set NextPlan = plan
End Function

Private Function PlanKey(ByVal plan As Object) As String
    Dim key As Variant, value As Variant, group As Variant
    For Each key In plan("tables").Keys
        PlanKey = PlanKey & "T" & CStr(key) & ":"
        For Each value In plan("tables")(key): PlanKey = PlanKey & CStr(value) & ",": Next
        PlanKey = PlanKey & ";"
    Next
    For Each key In plan("figures").Keys
        PlanKey = PlanKey & "F" & CStr(key) & ":"
        For Each group In plan("figures")(key)
            For Each value In group: PlanKey = PlanKey & CStr(value) & ",": Next
            PlanKey = PlanKey & "/"
        Next
        PlanKey = PlanKey & ";"
    Next
End Function

Private Function LayoutKey(ByVal measured As Object) As String
    Dim entry As Object, row As Object, unit As Object, cap As Object
    LayoutKey = CStr(measured("pages"))
    For Each entry In measured("tables")
        LayoutKey = LayoutKey & "|" & entry("id")
        For Each row In entry("rows"): LayoutKey = LayoutKey & ":" & CStr(row("start")) & "," & CStr(row("end")) & row("text"): Next
    Next
    For Each entry In measured("figures")
        For Each unit In entry("units"): LayoutKey = LayoutKey & "U" & CStr(unit("start")) & "," & CStr(unit("end")) & CStr(unit("pictures")): Next
        For Each cap In entry("captions"): LayoutKey = LayoutKey & "C" & CStr(cap("start")) & "," & CStr(cap("end")) & cap("text"): Next
    Next
End Function

Private Function DocumentRole(ByVal doc As Object) As String
    On Error Resume Next
    DocumentRole = doc.Variables(ROLE).Value
    On Error GoTo 0
End Function

Private Function NewRunFolder(ByVal parent As String) As String
    Dim fso As Object, base As String, path As String, serial As Long
    Set fso = CreateObject("Scripting.FileSystemObject")
    base = fso.BuildPath(parent, U(&H66F4, &H65B0, &H7ED3, &H679C))
    If Not fso.FolderExists(base) Then fso.CreateFolder base
    path = fso.BuildPath(base, "Word-" & Format$(Now, "yyyymmdd-hhnnss"))
    Do While fso.FolderExists(path): serial = serial + 1: path = fso.BuildPath(base, "Word-" & Format$(Now, "yyyymmdd-hhnnss") & "-" & CStr(serial)): Loop
    fso.CreateFolder path: NewRunFolder = path
End Function

Private Function XmlText(ByVal value As String) As String
    Dim i As Long
    value = Replace(value, Chr$(11), vbLf)
    For i = 0 To 31
        If i <> 9 And i <> 10 And i <> 13 Then value = Replace(value, Chr$(i), "")
    Next
    XmlText = value
End Function

Private Sub SaveResult(ByVal path As String, ByVal source As Object, ByVal measured As Object, ByVal plan As Object, ByVal rounds As Long)
    Dim report As Object, root As Object, n As Object, entry As Object, row As Object, i As Long, group As Variant, ci As Long, unit As Object
    Set report = NewXml("<result/>"): Set root = report.documentElement
    root.setAttribute "source", source.FullName: root.setAttribute "pages", CStr(measured("pages"))
    root.setAttribute "rounds", CStr(rounds): root.setAttribute "plan", PlanKey(plan)
    For Each entry In measured("tables")
        Set n = report.createElement("table"): n.setAttribute "id", entry("id")
        n.setAttribute "page", CStr(entry("rows")(1)("start")): n.setAttribute "dataRows", CStr(entry("rows").Count - 2)
        n.setAttribute "caption", XmlText(entry("rows")(1)("text")): root.appendChild n
        i = 0
        For Each row In entry("rows")
            Set n = report.createElement("row"): n.setAttribute "table", entry("id"): n.setAttribute "index", CStr(i)
            n.setAttribute "page", CStr(row("start")): n.setAttribute "end", CStr(row("end"))
            n.Text = XmlText(row("text")): root.appendChild n: i = i + 1
        Next
    Next
    For Each entry In measured("figures")
        i = 0
        For Each unit In entry("units")
            Set n = report.createElement("unit"): n.setAttribute "group", CStr(entry("id")): n.setAttribute "index", CStr(i)
            n.setAttribute "page", CStr(unit("start")): n.setAttribute "end", CStr(unit("end"))
            n.setAttribute "pictures", CStr(unit("pictures")): n.Text = XmlText(unit("text")): root.appendChild n: i = i + 1
        Next
        ci = 1
        For Each group In entry("groups")
            Set n = report.createElement("figure"): n.setAttribute "group", CStr(entry("id"))
            n.setAttribute "page", CStr(entry("captions")(ci)("start")): n.setAttribute "blocks", CStr(group.Count)
            n.setAttribute "caption", XmlText(entry("captions")(ci)("text")): root.appendChild n: ci = ci + 1
        Next
    Next
    report.Save path: gLastResult = report.XML
End Sub

Public Sub HITUpdateContinuations()
    Dim source As Object, work As Object, flat As Object, spec As Object, plan As Object, proposed As Object, measured As Object
    Dim sourceXml As String, folder As String, trace As String, xmlPath As String, pdfPath As String, previous As String
    Dim i As Long, ready As Boolean, screen As Boolean, alerts As Long, errorText As String
    If gBusy Then Exit Sub
    gLastError = "": gLastResult = ""
    On Error GoTo Failed
    If Application.Documents.Count = 0 Then Err.Raise 5120, , "Open a source document first."
    Set source = Application.ActiveDocument
    If source Is ThisDocument Then Err.Raise 5121, , "Create a source from this template first."
    If DocumentRole(source) <> "source" Then Err.Raise 5122, , "Update the source document, not a generated document."
    If Len(source.Path) = 0 Then
        If gTest Then Err.Raise 5123, , "Test source is not saved."
        If Application.Dialogs(84).Show = 0 Then Exit Sub
    End If
    If Not source.Saved Then source.Save
    gBusy = True: screen = Application.ScreenUpdating: alerts = Application.DisplayAlerts
    Application.ScreenUpdating = False: Application.DisplayAlerts = 0
    sourceXml = source.WordOpenXML: folder = NewRunFolder(source.Path): trace = folder & "\trace"
    MkDir trace: Set plan = EmptyPlan()
    For i = 0 To 9
        Application.StatusBar = "HIT: updating captions, pass " & CStr(i + 1)
        Set flat = Render(sourceXml, plan, spec)
        xmlPath = trace & "\candidate-" & Format$(i, "00") & ".xml": flat.Save xmlPath
        Set work = Application.Documents.Open(FileName:=xmlPath, ConfirmConversions:=False, ReadOnly:=False, AddToRecentFiles:=False, Visible:=True)
        work.Activate: Application.ActiveWindow.View.Type = 3: work.Repaginate
        pdfPath = trace & "\candidate-" & Format$(i, "00") & ".pdf": work.ExportAsFixedFormat pdfPath, 17
        Set measured = Measure(work, spec): Set proposed = NextPlan(measured, plan)
        ready = (PlanKey(plan) = PlanKey(proposed) And previous = LayoutKey(measured))
        If ready Then
            work.SaveAs2 FileName:=folder & "\output.docx", FileFormat:=12, AddToRecentFiles:=False
            work.Repaginate: work.ExportAsFixedFormat folder & "\output.pdf", 17
            Set measured = Measure(work, spec)
            Set proposed = NextPlan(measured, plan)
            If PlanKey(plan) <> PlanKey(proposed) Then Err.Raise 5124, , "Pagination changed after saving; trace retained."
            SaveResult folder & "\result.xml", source, measured, plan, i + 1
            Exit For
        End If
        If PlanKey(plan) = PlanKey(proposed) Then previous = LayoutKey(measured) Else previous = ""
        Set plan = proposed: work.Close SaveChanges:=0: Set work = Nothing
    Next
    If Not ready Then Err.Raise 5125, , "Pagination did not converge; trace retained."
    Application.DisplayAlerts = alerts: Application.ScreenUpdating = screen: Application.StatusBar = False: gBusy = False
    work.Activate
    If Not gTest Then MsgBox U(&H66F4, &H65B0, &H5B8C, &H6210) & vbCrLf & folder, vbInformation
    Exit Sub
Failed:
    errorText = Err.Description: gLastError = errorText
    On Error Resume Next
    If Not work Is Nothing Then work.Close SaveChanges:=0
    If gBusy Then Application.DisplayAlerts = alerts: Application.ScreenUpdating = screen
    Application.StatusBar = False: gBusy = False
    If Not gTest Then MsgBox errorText, vbExclamation, "HIT"
End Sub

Public Sub HITInstallButtons()
    Dim bar As Object, control As Object
    If gInstalling Or gBusy Then Exit Sub
    gInstalling = True
    On Error Resume Next
    Application.CommandBars(BAR_NAME).Delete
    On Error GoTo Finished
    Set bar = Application.CommandBars.Add(Name:=BAR_NAME, Position:=1, MenuBar:=False, Temporary:=True)
    Set control = bar.Controls.Add(Type:=1): control.Caption = U(&H65B0, &H5EFA, &H535A, &H58EB)
    control.OnAction = MACRO_PREFIX & "HITNewDoctor": control.Style = 2
    Set control = bar.Controls.Add(Type:=1): control.Caption = U(&H65B0, &H5EFA, &H672C, &H79D1)
    control.OnAction = MACRO_PREFIX & "HITNewBachelor": control.Style = 2
    Set control = bar.Controls.Add(Type:=1): control.Caption = U(&H52A0, &H957F, &H6F14, &H793A)
    control.OnAction = MACRO_PREFIX & "HITNewDemo": control.Style = 2
    Set control = bar.Controls.Add(Type:=1): control.Caption = U(&H66F4, &H65B0, &H7EED, &H8868) & "/" & U(&H7EED, &H56FE)
    control.OnAction = MACRO_PREFIX & "HITUpdateContinuations": control.Style = 2: control.BeginGroup = True
    bar.Visible = True
Finished:
    gInstalling = False
End Sub

Private Sub EnsureGlobal()
    Dim addin As Object
    On Error Resume Next
    Set addin = Application.AddIns.Add(FileName:=ThisDocument.FullName, Install:=True)
    On Error GoTo 0
End Sub

Private Sub StripPresetData(ByVal doc As Object)
    Dim part As Object, parts As Object, i As Long
    If doc Is ThisDocument Then Exit Sub
    Set parts = doc.CustomXMLParts.SelectByNamespace(PRESETS)
    For i = parts.Count To 1 Step -1: parts(i).Delete: Next
End Sub

Private Sub NewPreset(ByVal presetId As String)
    Dim part As Object, store As Object, node As Object, flat As Object, doc As Object, path As String
    On Error GoTo Failed
    gLastError = "": Set part = ThisDocument.CustomXMLParts.SelectByNamespace(PRESETS)(1)
    Set store = NewXml(part.XML)
    Set node = store.selectSingleNode("/*[local-name()='presets']/*[local-name()='preset'][@id='" & presetId & "']/*[local-name()='payload']")
    If node Is Nothing Then Err.Raise 5130, , "Embedded source preset is missing."
    Set flat = NewXml(node.Text): path = Environ$("TEMP") & "\HIT-source-" & Format$(Now, "yyyymmdd-hhnnss") & ".xml": flat.Save path
    Set doc = Application.Documents.Open(FileName:=path, ConfirmConversions:=False, ReadOnly:=False, AddToRecentFiles:=False)
    doc.AttachedTemplate = ThisDocument.FullName: StripPresetData doc
    If gTest Then
        doc.SaveAs2 FileName:=gTestRoot & "\source-" & presetId & ".docx", FileFormat:=12, AddToRecentFiles:=False
    Else
        With Application.Dialogs(84)
            .Format = 12: .Name = "HIT-" & presetId & "-source.docx"
            If .Show = 0 Then doc.Close SaveChanges:=0
        End With
    End If
    HITInstallButtons
    Exit Sub
Failed:
    gLastError = Err.Description
    If Not gTest Then MsgBox gLastError, vbExclamation, "HIT"
End Sub

