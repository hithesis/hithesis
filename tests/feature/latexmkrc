# vim: set ft=perl:
# 按功能的回归每份工作目录里一份（tests/feature/run.lua 拷进去）。引擎由命令行给。
# 成果页与索引照 examples/demo/latexmkrc：成果页的条目另跑一次 bibtex，索引跑 splitindex。
$bibtex_use = 2;
$bibtex = 'internal hit_pub_bibtex';
sub hit_pub_bibtex {
   my $ret = system( "bibtex", $$Psource );
   my $pub = $$Psource;
   $pub =~ s/\.aux$//;
   $pub .= "-pub";
   if ( -e "$pub.aux" ) { system( "bibtex", $pub ); }
   return $ret;
}
$makeindex = 'internal splitindex';
sub splitindex {
   my $ret1 = system( "makeindex", "-s", "hithesis.ist", $$Psource );
   my $ret2 = system( "splitindex", $$Psource, "--", "-s", "hithesis.ist" );
   return $ret1 || $ret2;
}
