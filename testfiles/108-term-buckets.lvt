\input{regression-test}
\documentclass[fontset=fandol]{hithesis}
\begin{document}
\START
\ExplSyntaxOn
\TEST{Buckets~and~fields~with~the~same~name}{
  \hitsetup{overrides={
    algorithm={input={读入}},
    caption={algorithm={伪代码}[Pseudocode]},
    degree-type={academic={学术学位}[Academic]},
    number-separator={section={甲}[B]}
  }}
  \TYPE{input=\use:c{hit@term@algorithm@input}}
  \TYPE{caption=\use:c{hit@term@caption@algorithm@zh}/\use:c{hit@term@caption@algorithm@en}}
  \TYPE{degree=\use:c{hit@term@degree@type@academic@zh}}
  \TYPE{separator=\use:c{hit@term@after@section@number@zh}/\use:c{hit@term@after@section@number@en}}
  \hitsetup{overrides={base={campus-full={<number-separator-section-zh>}}}}
  \TYPE{separator-reference=\use:c{hit@term@base@campus@full}}
}
\TEST{Shenzhen~names~and~legacy~references}{
  \hitsetup{overrides={cover={report-student-id-shenzhen={学籍号}[ID]}}}
  \TYPE{id=\use:c{hit@term@cover@report@student@id@shenzhen@zh}}
  \hitsetup{overrides={cover-sz-id={学号}[Student~ID],base={campus-full={<cover-sz-id-zh>}}}}
  \TYPE{legacy=\use:c{hit@term@cover@report@student@id@shenzhen@zh};reference=\use:c{hit@term@base@campus@full}}
  \hitsetup{overrides={cover={report-student-id-shenzhen={编号}}}}
  \TYPE{updated-reference=\use:c{hit@term@base@campus@full}}
}
\TEST{Standard~names~follow~heading~terms}{
  \hitsetup{overrides={references={heading={文献}[References]},index={heading={查索}[Index]}}}
  \TYPE{bibliography=\bibname;index=\indexname}
}
\ExplSyntaxOff
\END
\end{document}
