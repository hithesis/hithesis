% 画圈的数据与几何：分组、字体键、查表后的缩放与偏移。口径与 Typst quan 0.3.0 的 digit-fit 一致。
\input{regression-test}
\documentclass[fontset=fandol]{hithesis}
\begin{document}
\makeatletter
\ExplSyntaxOn
% 圈号字体在第一次画圈时才声明，声明时 fontspec 会往日志里写一段，放在计时开始之前。
\__hit_quan_font_ensure:
\START
\TEST{数字分组}{
  \clist_map_inline:nn { 1, 5, 11, 12, 21, 22, 35, 40, 99 }
    {
      \int_set:Nn \l__hit_quan_value_int {#1}
      \str_set:Nx \l__hit_quan_digits_str { \int_use:N \l__hit_quan_value_int }
      \__hit_quan_group:
      \TYPE{#1=\l__hit_quan_group_tl}
    }
}
\TEST{字体键取自宋体角色}{
  \TYPE{family=\g__hit_quan_family_tl}
}
\TEST{查表后的缩放与偏移（100bp，常规）}{
  \fontsize{100bp}{120bp}\selectfont
  \clist_map_inline:nn { 1, 5, 11, 21, 36 }
    {
      \int_set:Nn \l__hit_quan_value_int {#1}
      \str_set:Nx \l__hit_quan_digits_str { \int_use:N \l__hit_quan_value_int }
      \bool_set_false:N \l__hit_quan_bold_bool
      \__hit_quan_measure_ref:
      \__hit_quan_geometry:
      \__hit_quan_fit:
      \TYPE{#1:~sx=\fp_to_decimal:n{round(\l__hit_quan_sx_fp,3)}~dx/H=\fp_to_decimal:n{round(\l__hit_quan_dx_fp/\l__hit_quan_h_fp,4)}~dy/H=\fp_to_decimal:n{round(\l__hit_quan_dy_fp/\l__hit_quan_h_fp,4)}~t/H=\fp_to_decimal:n{round(\l__hit_quan_t_fp/\l__hit_quan_h_fp,5)}}
    }
}
\TEST{查表后的缩放与偏移（100bp，粗体）}{
  \fontsize{100bp}{120bp}\selectfont
  \clist_map_inline:nn { 11, 21 }
    {
      \int_set:Nn \l__hit_quan_value_int {#1}
      \str_set:Nx \l__hit_quan_digits_str { \int_use:N \l__hit_quan_value_int }
      \bool_set_true:N \l__hit_quan_bold_bool
      \__hit_quan_measure_ref:
      \__hit_quan_geometry:
      \__hit_quan_fit:
      \TYPE{#1:~sx=\fp_to_decimal:n{round(\l__hit_quan_sx_fp,3)}~dx/H=\fp_to_decimal:n{round(\l__hit_quan_dx_fp/\l__hit_quan_h_fp,4)}~t/H=\fp_to_decimal:n{round(\l__hit_quan_t_fp/\l__hit_quan_h_fp,5)}}
    }
}
\TEST{画出来的圈不撑高行}{
  \fontsize{10bp}{12bp}\selectfont
  \hbox_set:Nn \l_tmpa_box { \quan{21} }
  \TYPE{ht=\dim_compare:nNnTF{\box_ht:N\l_tmpa_box}<{10bp}{ok}{high}}
}
\end{document}
