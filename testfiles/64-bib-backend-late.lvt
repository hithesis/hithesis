% demo 的主文件把 \hitsetup 全写在 \begin{document} 之后，这条路必须把话说清。
\input{regression-test}
\documentclass[fontset=fandol,degree-level=master,campus=harbin]{hit-thesis}
\begin{document}
\START
\ExplSyntaxOn

\TEST{backend~in~body~errors}{
  \hitsetup { bib = { backend = biber } }
  \IfPackageLoadedTF { biblatex }
    { \iow_term:n { biblatex ~ loaded } } { \iow_term:n { biblatex ~ not ~ loaded } }
  \IfPackageLoadedTF { gbt7714 }
    { \iow_term:n { gbt7714 ~ loaded } } { \iow_term:n { gbt7714 ~ missing } }
}

\ExplSyntaxOff
\END
