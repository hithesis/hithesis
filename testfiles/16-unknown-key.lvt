% 键名拼错时要有提示。
% hit/class 族认不出的键有两种来路：基础类还没加载时是写在 \documentclass 里给
% 基础类的选项，照旧传过去；加载完之后再出现只可能是 \hitsetup 里拼错了。
% 后者原先默默传给基础类等于扔掉，一百多个带连字符的键名，静默丢值最难查。
%
% 这里断言的是警告本身，因为警告就是这个改动的全部行为。同时确认值确实没被
% 存进任何地方，别出现“警告了但也生效了”这种半吊子状态。
\input{regression-test}
\documentclass[fontset=fandol,degree-level=doctor,campus=harbin]{hit-thesis}
\begin{document}
\START
\TEST{常量键拼错要报警告}{
  \hitsetup{const={cshoolname={拼错了}}}
}
\TEST{元信息字段拼错要报警告}{
  \hitsetup{info={ctitel={也拼错了}}}
}
\makeatletter
\TEST{拼错的值没有被存下来}{
  \typeout{typo=[\ifdefined\hit@cshoolname 存了\else 没存\fi]}
  \typeout{school-zh=[\hit@school@zh]}
}
\makeatother
\END
\end{document}
