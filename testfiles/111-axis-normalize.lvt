\input{regression-test}
\documentclass[stage=proposal,campus=shenzhen,degree-level=bachelor,fontset=fandol]{hithesis}
\begin{document}
\START
\ExplSyntaxOn
\TEST{Order~and~known~aliases}{
  \use:c{hit@axis@parse:n}{cover-university-bachelor-shenzhen-zh}
  \TYPE{canonical=\l__hit_axis_canonical_tl}
  \use:c{hit@axis@parse:n}{caption-equation-design-shenzhen-opening-hss}
  \TYPE{aliases=\l__hit_axis_canonical_tl}
  \use:c{hit@axis@parse:n}{cover-university-!doctor-shenzhen}
  \TYPE{negative=\l__hit_axis_canonical_tl}
}
\TEST{Overrides~and~references~use~canonical~keys}{
  \hitsetup{overrides={cover={university-bachelor-shenzhen={新校名}[New~University]},
    base={campus-full={<cover-university-bachelor-shenzhen-zh>}}}}
  \TYPE{value=\use:c{hit@term@cover@university@shenzhen@bachelor@zh}}
  \TYPE{reference=\use:c{hit@term@base@campus@full}}
  \hitsetup{overrides={cover={university-shenzhen-bachelor={另一校名}}}}
  \TYPE{separate-call=\use:c{hit@term@base@campus@full}}
  \hitsetup{overrides={caption={equation-bachelor-shenzhen={本档等式}[Equation]}}}
  \TYPE{new-variant=\equationautorefname}
  \TYPE{stored=\cs_if_exist_use:cF{hit@term@caption@equation@shenzhen@bachelor@zh}{missing}}
  \TYPE{declared=\keys_if_exist:nnTF{hit/overrides-internal}{caption-equation-shenzhen-bachelor-zh}{yes}{no}}
  \hitsetup{overrides={caption={equation-shenzhen-!bachelor={其他档等式}[Equation]}}}
  \TYPE{nonmatching=\equationautorefname}
}
\TEST{Invalid~conditions~do~not~silently~overwrite}{
  \msg_redirect_name:nnn{hithesis}{axis-repeat}{none}
  \msg_redirect_name:nnn{hithesis}{axis-invalid}{none}
  \msg_redirect_name:nnn{hithesis}{axis-negate-lang}{none}
  \msg_redirect_name:nnn{hithesis}{override-repeat}{none}
  \msg_redirect_name:nnn{hithesis}{unknown-key}{none}
  \clist_map_inline:nn{cover-title-doctor-doctor,cover-title-doctor-master,cover-title-doctor-!doctor,cover-title-!,cover-title-!zh}{
    \use:c{hit@axis@parse:n}{#1}
    \TYPE{#1=\bool_if:NTF\l__hit_axis_valid_bool{accepted}{rejected}}
  }
  \hitsetup{overrides={cover={university-bachelor-shenzhen={第一值},university-shenzhen-bachelor={第二值}}}}
  \TYPE{duplicate-keeps=\use:c{hit@term@cover@university@shenzhen@bachelor@zh}}
  \hitsetup{overrides={caption={figure-mars={错误名称}}}}
  \TYPE{unknown-not-declared=\keys_if_exist:nnTF{hit/overrides-internal}{caption-figure-mars}{no}{yes}}
}
\ExplSyntaxOff
\END
\end{document}
