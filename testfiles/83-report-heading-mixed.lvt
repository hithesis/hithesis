% 报告从 \section 起头之后又写 \chapter：结构写乱了，报错，这一个先当节排。
\input{regression-test}
\documentclass[fontset=fandol,degree-level=master,campus=harbin,stage=proposal]{hithesis}
\begin{document}
\START
\makeatletter
\section{甲}
\TEST{从 section 起，section 是节}{
  \typeout{section=[\thesection]}
}
\TEST{后面写 chapter 报错，排成下一节}{
  \chapter{乙}
  \typeout{chapter=[\thesection]}
}
\makeatother
\END
\end{document}
