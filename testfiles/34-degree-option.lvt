% degree-level 选项与旧名 type。
%
% v3.2a 把学位选项从 type 改名成 degree-level：加了派发类的 kind 之后，type 与 kind
% 两个名字都读作“种类”，一个管学位一个管交付物，分不清。
%
% 旧名不能直接删，v3.1e 就发出去了。它做成转发键：type=doctor 等价于
% degree-level=doctor，另由 \__hit_check_class_options: 扫 \@classoptionslist 时提示一次。
%
% 断言两件事：两个名字落到同一个标志位；提示走的是 renamed-load-option 那条
% 而不是 renamed-option——后者会让用户把加载期选项挪进 \hitsetup，那是错的建议。
% 提示在装类时发出，早于 \START，tlg 收不到，所以这里只钉取值。
\input{regression-test}
\documentclass[fontset=fandol,type=doctor,campus=harbin]{hit-thesis}
\begin{document}
\START
\makeatletter
\TEST{旧名 type 仍旧落到 doctor}{
  \typeout{doctor=\hit@if@option@TF{doctor}{yes}{no}}
  \typeout{bachelor=\hit@if@option@TF{bachelor}{yes}{no}}
  \typeout{master=\hit@if@option@TF{master}{yes}{no}}
}
\makeatother
\END
\end{document}
