% 类不靠 hithesis.sty 也得自足。
%
% 45 变体全都 \usepackage{hithesis}，所以“类要用的包被错挪进了 sty”这种错
% 它们一个都抓不到——2026 年就漏过一次：xeCJKfntef 挪进 sty 之后，封面的
% \hit@put@title 里那个 CJKfilltwosides 没人提供了，45 变体照样逐字节相同。
%
% 这里只加载文档类，把类自己会用到第三方宏包的几处都跑一遍：封面标题的定宽
% 两端对齐、摘要环境的整体抓取、索引页的边距与分栏。缺包就是 Undefined
% control sequence 或 Environment ... undefined，测试直接失败。
\input{regression-test}
\documentclass[fontset=fandol,degree-level=master,campus=harbin]{hit-thesis}
\begin{document}
\START
\makeatletter

\TEST{封面标题的定宽两端对齐（xeCJKfntef 的 CJKfilltwosides）}{
  \setbox0\hbox{\hit@put@title[10cm]{标题}}
  \typeout{put-title-ok}
}

\TEST{摘要环境把整段收进变量（内核的 +b 参数类型）}{
  \begin{abstract-zh}
  第一段。

  第二段。
  \end{abstract-zh}
  \begin{abstract-en}
  One paragraph.
  \end{abstract-en}
  \typeout{abstract-collected}
}

\TEST{索引页的边距与分栏（changepage 与 multicol）}{
  \typeout{adjustwidth=\ifdefined\adjustwidth defined\else MISSING\fi}
  \typeout{multicols=\ifdefined\multicols defined\else MISSING\fi}
}

\TEST{类不该依赖只给用户预装的那几个}{
  \typeout{multirow=\ifdefined\multirow loaded\else absent\fi}
  \typeout{FloatBarrier=\ifdefined\FloatBarrier loaded\else absent\fi}
}

\makeatother
\END
\end{document}
