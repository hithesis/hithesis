% 选项解析：深圳硕士。这一组在示例文档里不会被单独暴露，
% 42 变体只能看到最终版面，看不到选项解析出来的结果本身。
%
% 断言的是解析后生效的校区、学位和派生出的学位名这三个值。见 02 的说明：
% 基线只记录值、不记录内部表示，实现换写法时基线不动。
\input{regression-test}
\documentclass[fontset=fandol,type=master,campus=shenzhen]{hithesisbook}
\begin{document}
\START
\makeatletter
\TEST{生效的校区与学位}{
  \typeout{campus=\ifhit@shenzhen shenzhen\else
                  \ifhit@harbin harbin\else
                  \ifhit@weihai weihai\else none\fi\fi\fi}
  \typeout{degree=\ifhit@bachelor bachelor\else
                  \ifhit@master master\else
                  \ifhit@doctor doctor\else
                  \ifhit@postdoc postdoc\else none\fi\fi\fi\fi}
}
\TEST{派生的学位名称}{
  \typeout{cxuewei=\hit@cxuewei}
}
\makeatother
\END
\end{document}
