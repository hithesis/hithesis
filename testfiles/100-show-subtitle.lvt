\input{regression-test}
\documentclass{hithesis}
\begin{document}
\START
\makeatletter
\ExplSyntaxOn
\cs_new_protected:Npn \test_subtitle_state:
  {
    \typeout{setting=\g__hit_subtitle_tl}
    \tl_set:Nn \l_tmpa_tl {hidden}
    \hit@if@subtitle@lang:nT{zh}{\tl_set:Nn \l_tmpa_tl {shown}}
    \typeout{zh=\l_tmpa_tl}
    \tl_set:Nn \l_tmpa_tl {hidden}
    \hit@if@subtitle@lang:nT{en}{\tl_set:Nn \l_tmpa_tl {shown}}
    \typeout{en=\l_tmpa_tl}
  }
\TEST{Subtitle~visibility~uses~show-subtitle}{
  \hitsetup{info={subtitle={副题}[]},show-subtitle=auto}
  \test_subtitle_state:
  \hitsetup{show-subtitle=false}
  \test_subtitle_state:
  \hitsetup{show-subtitle}
  \test_subtitle_state:
  \hitsetup{show-subtitle=auto,info={subtitle={}[Subtitle]}}
  \test_subtitle_state:
}
\ExplSyntaxOff
\makeatother
\END
\end{document}
