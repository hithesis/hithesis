% 双语题注的短标题与 \label。
%
% \caption[短标题]{中文题}[英文题] 里的短标题该进插图索引，\label 该拿到图号。
% 两件事都容易断：\pkg{ccaption} 的 \bicaption 可选参数是 \label 不是短标题，
% 接错位置短标题就没了；\bicaption 又把整段包在组里，\caption 设的 \@currentlabel
% 是局部的，出了组就没了，写在后面的 \label 只能拿到章节号。
%
% 断言两件事：写进插图索引的条目是短标题不是完整题注；每条题注之后
% \@currentlabel 是图号——\label 拿到的就是它。一遍编译就能测，不必等交叉引用。
%
% 20-caption.lvt 钉的是派发到哪个分支，两份互补。
\input{regression-test}
\documentclass[fontset=fandol,degree-level=doctor,campus=harbin]{hithesisbook}
\makeatletter
\let\hit@test@acl\addcontentsline
\renewcommand\addcontentsline[3]{\typeout{[目录] #1: #3}\hit@test@acl{#1}{#2}{#3}}
\makeatother
\begin{document}
\START
\chapter{测试章}
\begin{figure}
\caption[短甲]{很长的中文题注甲}
\makeatletter\TEST{只写中文题：索引条目与 label}{\typeout{label=\@currentlabel}}\makeatother
\end{figure}
\begin{figure}
\caption[短乙]{很长的中文题注乙}[English caption]
\makeatletter\TEST{中英双语：索引条目与 label}{\typeout{label=\@currentlabel}}\makeatother
\end{figure}
\END
\end{document}
