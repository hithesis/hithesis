  \typeout{listtheorems=\ifdefined\listtheorems 有\else 丢了\fi}
  \typeout{ltfontsize=\ifdefined\ltfontsize 有\else 丢了\fi}
  \typeout{quan=\ifdefined\quan 有\else 丢了\fi}
  \typeout{theorembodyfont=\ifdefined\theorembodyfont 有\else 丢了\fi}
  \typeout{theoremclass=\ifdefined\theoremclass 有\else 丢了\fi}
