\input{regression-test}
\documentclass[fontset=fandol,degree-level=master]{hithesis}
\hitsetup{info={title={中文题目}[English Title],author={张三}[Zhang San],subtitle={副题}[Subtitle]}}
\begin{document}
\START
\makeatletter
\TEST{Paired values and keep}{
  \typeout{title-zh=[\hit@info@title@cover@zh]}
  \typeout{title-en=[\hit@info@title@cover@en]}
  \hitsetup{info={title={\keepvalue}[New English],author={新作者}}}
  \typeout{title-zh=[\hit@info@title@cover@zh]}
  \typeout{title-en=[\hit@info@title@cover@en]}
  \typeout{subtitle=[\hit@info@title@subtitle@zh]}
  \typeout{author-en=[\hit@info@author@en]}
}
\TEST{Local language direction}{
  {\bilingualswapon\hitsetup{info={author={New Author}[中文作者]}}}
  \typeout{author-zh=[\hit@info@author@zh]}
  \typeout{author-en=[\hit@info@author@en]}
  \hitsetup{info={author={恢复中文}}}
  \typeout{author-zh=[\hit@info@author@zh]}
}
\TEST{Single fields and literal brackets}{
  \hitsetup{info={student-id={123}[456],report-number={{A}[B]}}}
  \typeout{id=[\hit@info@student@id]}
  \typeout{report=[\hit@info@report@number]}
}
\TEST{No global keep command}{
  \ifdefined\keepvalue\typeout{keep=defined}\else\typeout{keep=undefined}\fi
}
\TEST{Marker is compared without execution}{
  {\def\keepvalue{\typeout{BAD-EXECUTION}}
   \hitsetup{info={author={\keepvalue}[Updated Author]}}}
  \typeout{author-zh=[\hit@info@author@zh]}
  \typeout{author-en=[\hit@info@author@en]}
  \ifdefined\keepvalue\typeout{keep=defined}\else\typeout{keep=undefined}\fi
}
\makeatother
\END
\end{document}
