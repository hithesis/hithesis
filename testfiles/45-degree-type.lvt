% degree-type：学术学位与专业学位。
%
% degree-level 管的是学士硕士博士，学术还是专业是另一个维度，所以分成两个选项，不是往
% degree-level 的取值表里再塞两个。
%
% 取值造出 \g__hit_academic_bool 与 \g__hit_professional_bool，于是
% \hitsetup[degree-type=professional] 这样的条件也写得出来。
%
% 封面上那行学生类别按它给默认值。专业学位的具体类别（工程硕士、工商管理硕士这些）
% 一个选项表达不了，还是要自己写 student-type，写了就盖掉默认值——presetup 在用户
% 的 \hitsetup 之前回放，所以用户的值一定在后面。最后一条钉的就是这个先后。
%
% 注意 \makeatletter：文档体里 @ 不是字母，\hit@if@condition:nT 会被拆成 \hit 加一
% 串普通字符，条件根本不求值，两个分支都当正文执行，看着像“条件全命中”。
% 元信息字段要写在 zh={} 里，顶层裸名字不认，这也钉一条。
\input{regression-test}
\documentclass[fontset=fandol,degree-level=master,campus=shenzhen]{hithesis}
\begin{document}
\START
\makeatletter
\TEST{默认学术学位}{
  \typeout{academic=\hit@if@option@TF{academic}{yes}{no}}
  \typeout{professional=\hit@if@option@TF{professional}{yes}{no}}
  \typeout{zh=[\hit@student@type@zh]}
  \typeout{en=[\hit@student@type@en]}
}
\ExplSyntaxOn
\TEST{条件按标志位求值，不是见到就命中}{
  \hit@if@condition:nT { degree-type=academic }     { \typeout{命中academic} }
  \hit@if@condition:nT { degree-type=professional } { \typeout{命中professional} }
  \hit@if@condition:nT { degree-level=master }            { \typeout{命中master} }
  \hit@if@condition:nT { degree-level=doctor }            { \typeout{命中doctor} }
}
\ExplSyntaxOff
\TEST{取值写错要报错}{
  \hitsetup{degree-type=quan}
}
\TEST{用户自己写的 student-type 盖掉默认值}{
  \hitsetup{info={zh={student-type={（工程硕士）}}}}
  \typeout{zh=[\hit@student@type@zh]}
}
\makeatother
\END
\end{document}
