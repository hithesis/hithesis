% 示例宏包 hithesis.sty。
%
% v3.1e 的示例目录里有个 hithesis.sty，装的是示例文档自己要用的东西：术语词条、
% 染色体示意图的绘图宏、九个数学记号速记、\num 的分组空格。类里一句都没调用它们。
%
% 断言这些名字确实由宏包给出。03-user-macros.lvt 那边反着断言类里没有它们，
% 两份一起钉住这条分界线。
\input{regression-test}
\documentclass[fontset=fandol,degree-level=doctor,campus=harbin]{hit-thesis}
\usepackage{hithesis}
\begin{document}
\START
\makeatletter
\TEST{绘图宏}{
  \typeout{rcell=\ifdefined\rcell yes\else MISSING\fi}
  \typeout{gseg=\ifdefined\gseg yes\else MISSING\fi}
  \typeout{tcellfive=\ifdefined\tcellfive yes\else MISSING\fi}
}
\TEST{数学记号}{
  \typeout{theVector=\ifdefined\theVector yes\else MISSING\fi}
  \typeout{theNetwork=\ifdefined\theNetwork yes\else MISSING\fi}
}
\TEST{术语与算法}{
  \typeout{gtssbp=\ifdefined\gtssbp yes\else MISSING\fi}
  \typeout{AlgoBiCaption=\ifdefined\AlgoBiCaption yes\else MISSING\fi}
  \typeout{foocaption=\ifdefined\foocaption yes\else MISSING\fi}
}
\TEST{排命令名}{
  \typeout{cs=\ifdefined\cs yes\else MISSING\fi}
  \typeout{cmd=\ifdefined\cmd yes\else MISSING\fi}
}
\makeatother
\END
\end{document}
