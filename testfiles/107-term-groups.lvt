\input{regression-test}
\documentclass[fontset=fandol]{hithesis}
\begin{document}
\START
\ExplSyntaxOn
\TEST{Grouped~names~share~standard~commands}{
  \TYPE{reference-equation=\equationautorefname;list-equation=\equationname}
  \hitsetup{overrides={
    caption={figure={照片}[Photo],table={清单}[Table]},
    table-of-contents={heading={目次}[Contents]},
    list-of-equations={heading={公式目录}[Equations],entry-name={公式条目}[Equation]},
    mainmatter={chapter-name={第,章}[{Chapter~,}]}
  }}
  \TYPE{figure=\figurename;table=\tablename;toc=\contentsname}
  \TYPE{auto-figure=\figureautorefname;auto-table=\tableautorefname}
  \TYPE{equation-list=\listequationname;entry=\equationname}
  \TYPE{chapter=\tl_use:c{g__hit_term_ctex_chapter-name_tl}}
}
\TEST{Legacy~keys~and~canonical~references}{
  \hitsetup{overrides={caption={equation={等式}[Equation]}}}
  \TYPE{reference-equation=\equationautorefname;list-equation=\equationname}
  \hitsetup{overrides={figurename={图像},base={campus-full={<caption-figure>}}}}
  \TYPE{legacy=\figurename;reference=\use:c{hit@term@base@campus@full}}
  \hitsetup{overrides={caption={figure={插图}}}}
  \TYPE{updated-reference=\use:c{hit@term@base@campus@full}}
  \hitsetup{overrides={caption={figure={\keepvalue}[Illustration]}}}
  \TYPE{kept=\figurename}
  \hitsetup{overrides={base={campus-full={<mainmatter-chapter-name>}}}}
  \TYPE{chapter-reference=\use:c{hit@term@base@campus@full}}
}
\TEST{English~primary~and~single~value}{
  \group_begin:
  \bool_set_true:N\g__hit_en_bool
  \hitsetup{overrides={caption={figure={Photograph}[照片]}}}
  \TYPE{english=\figurename}
  \hitsetup{overrides={caption={figure={Image}}}}
  \TYPE{single=\figurename}
  \group_end:
}
\ExplSyntaxOff
\END
\end{document}
