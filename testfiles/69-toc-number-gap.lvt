% \option{toc}/\option{number-gap}：目录编号后间距的两套算法。
%
% 定长间距（默认 1\ccwd）与量宽取齐（auto）：裸键也是 1\ccwd，长度照收。
% 断言打的是排完一条条目后导出的悬挂宽——量宽档是编号盒宽（实宽加半个
% 字号），定长档是实宽加间距，章条目与节条目各走各的分支。
\input{regression-test}
\documentclass[fontset=fandol,degree-level=doctor,campus=harbin]{hit-thesis}
\begin{document}
\START
\makeatletter
\ExplSyntaxOn
\cs_new_protected:Npn \ENTRY
  {
    \vbox_set:Nn \l_tmpa_box
      { \l@chapter { \numberline { 第1章 } 标题 } { 5 } }
    \iow_term:x { hang = \dim_use:N \g__hit_toc_hang_dim }
  }
\TEST{default~gives~one~ccwd}{ \ENTRY }
\TEST{bare~key~gives~one~ccwd}{
  \hitsetup{ toc = { number-gap } } \ENTRY
}
\TEST{a~length~is~taken~as~is}{
  \hitsetup{ toc = { number-gap = 2em } } \ENTRY
}
\TEST{auto~measures~the~number~column}{
  \hitsetup{ toc = { number-gap = auto } } \ENTRY
}
\TEST{section~entry~follows~in~fixed~mode}{
  \hitsetup{ toc = { number-gap } }
  \vbox_set:Nn \l_tmpa_box
    { \l@section { \numberline { 1.1 } 标题 } { 6 } }
  \iow_term:x { hang = \dim_use:N \g__hit_toc_hang_dim }
}
\ExplSyntaxOff
\END
