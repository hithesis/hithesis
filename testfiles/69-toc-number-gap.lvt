% \option{toc}/\option{number-align} 三态与 \option{toc}/\option{number-gap}。
%
% natural（默认）是编号实宽加间距；left 是量宽取齐，列宽取额定列宽与
% 实宽加半个间距的较大者；right 编号右贴额定列缘、右侧再空足间距，章条目
% 没有额定列宽、退化成 natural。断言打的是排完条目后导出的悬挂宽。
\input{regression-test}
\documentclass[fontset=fandol,degree-level=doctor,campus=harbin]{hit-thesis}
\begin{document}
\START
\makeatletter
\ExplSyntaxOn
\cs_new_protected:Npn \CHAPENTRY
  {
    \vbox_set:Nn \l_tmpa_box
      { \l@chapter { \numberline { 第1章 } 标题 } { 5 } }
    \iow_term:x { hang = \dim_use:N \g__hit_toc_hang_dim }
  }
\cs_new_protected:Npn \SECENTRY
  {
    \vbox_set:Nn \l_tmpa_box
      { \l@section { \numberline { 1.1 } 标题 } { 6 } }
    \iow_term:x { hang = \dim_use:N \g__hit_toc_hang_dim }
  }
\TEST{natural~default~gives~width~plus~one~ccwd}{ \CHAPENTRY }
\TEST{gap~length~applies}{
  \hitsetup{ toc = { number-gap = 2em } } \CHAPENTRY
}
\TEST{left~measures~with~half~gap}{
  \hitsetup{ toc = { number-align = left , number-gap = 1\ccwd } }
  \CHAPENTRY
}
\TEST{left~section~keeps~rated~column}{ \SECENTRY }
\TEST{right~section~pads~to~column~edge}{
  \hitsetup{ toc = { number-align = right } } \SECENTRY
}
\TEST{right~chapter~falls~back~to~natural}{ \CHAPENTRY }
\ExplSyntaxOff
\END
