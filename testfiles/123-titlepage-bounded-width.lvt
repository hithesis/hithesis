\input{regression-test}
\documentclass[degree-level=master,fontset=fandol]{hithesis}
\makeatletter
\ExplSyntaxOn
\msg_redirect_module:nnn{fontspec}{info}{none}
\skip_if_exist:NF \hit@etitlelength { \skip_new:N \hit@etitlelength }
\ExplSyntaxOff
\makeatother
\begin{document}
\START
\makeatletter
\ExplSyntaxOn
\TEST{Very~long~Latin~and~CJK~titles~saturate~without~a~large~hbox}{
  \hitsetup{info={title={测试题目}[\prg_replicate:nn{6000}{a}]}}
  \__hit_titlepage_en_title_measure:
  \TYPE{latin-clipped=\bool_if:NTF\l__hit_titlepage_en_clipped_bool{yes}{no}}
  \TYPE{latin-width=\dim_compare:nNnTF{\hit@etitlelength}={450mm}{limited}{unlimited}}
  \hitsetup{info={title={测试题目}[\prg_replicate:nn{2000}{字}]}}
  \__hit_titlepage_en_title_measure:
  \TYPE{cjk-clipped=\bool_if:NTF\l__hit_titlepage_en_clipped_bool{yes}{no}}
}
\TEST{Escapes~and~nonbreaking~spaces~remain~valid~title~text}{
  \hitsetup{info={title={测试题目}[Research~\&~Development~50\%]}}
  \__hit_titlepage_en_title_measure:
  \TYPE{clipped=\bool_if:NTF\l__hit_titlepage_en_clipped_bool{yes}{no}}
  \TYPE{short-width=\dim_compare:nNnTF{\hit@etitlelength}<{450mm}{below-limit}{at-limit}}
}
\TEST{Formatted~titles~use~a~bounded~paragraph~trial}{
  \hitsetup{info={title={测试题目}[\textit{Short~title}]}}
  \__hit_titlepage_en_title_measure:
  \TYPE{short-formatted=\bool_if:NTF\l__hit_titlepage_en_clipped_bool{wrapped}{single-line}}
  \hitsetup{info={title={测试题目}[\textit{\prg_replicate:nn{85}{a}}]}}
  \__hit_titlepage_en_title_measure:
  \TYPE{near-limit-formatted=\bool_if:NTF\l__hit_titlepage_en_clipped_bool{wrapped}{single-line}}
  \hitsetup{info={title={测试题目}[\textit{\prg_replicate:nn{100}{a}}]}}
  \__hit_titlepage_en_title_measure:
  \TYPE{long-formatted=\bool_if:NTF\l__hit_titlepage_en_clipped_bool{wrapped}{single-line}}
}
\ExplSyntaxOff
\makeatother
\END
\end{document}
