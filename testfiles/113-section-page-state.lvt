\input{regression-test}
\documentclass[stage=proposal,degree-level=master,fontset=fandol]{hithesis}
\ExplSyntaxOn\msg_redirect_module:nnn{fontspec}{info}{none}\ExplSyntaxOff
\docxlikesetup{page-number-format={number-format=decimal}}
\begin{document}
\START
\ExplSyntaxOn
\TEST{Headfoot~measurement~preserves~pending~paragraph~state}{
  \dim_gset:Nn\g__docxlike_format_prev_after_dim{8bp}
  \dim_gset:Nn\g__docxlike_format_pending_after_dim{8bp}
  \bool_gset_true:N\g__docxlike_format_after_placed_bool
  \bool_gset_true:N\g_docxlike_section_start_bool
  \tl_gset:Nn\g__docxlike_format_keep_tl{true}
  \tl_set:Nn\l_tmpa_tl{Header~measurement}
  \__docxlike_headfoot_build:nN{header}\l_tmpa_tl
  \TYPE{previous-after=\dim_compare:nNnTF{\g__docxlike_format_prev_after_dim}={8bp}{yes}{no}}
  \TYPE{pending-after=\dim_compare:nNnTF{\g__docxlike_format_pending_after_dim}={8bp}{yes}{no}}
  \TYPE{section-start=\bool_if:NTF\g_docxlike_section_start_bool{yes}{no}}
  \TYPE{after-placed=\bool_if:NTF\g__docxlike_format_after_placed_bool{yes}{no}}
  \TYPE{keep-next=\g__docxlike_format_keep_tl}
}
\TEST{Continuous~section~keeps~the~old~page~number~format}{
  \hbox:n{Old~section~body}
  \sectionbreak[continuous,page-number-format={number-format=upper-roman}]
  \TYPE{body-page=\thepage}
  \tl_set:Nn\l_tmpa_tl{\TYPE{headfoot-page=\thepage}}
  \group_begin:
  \__docxlike_headfoot_page_thepage:
  \__docxlike_headfoot_build:nN{footer}\l_tmpa_tl
  \group_end:
}
\TEST{Class-owned~headfoot~keeps~the~class~page~number~format}{
  \docxlike_headfoot_put:nn{footer}{\TYPE{class-headfoot-page=\thepage}}
}
\TEST{Paged~section~cannot~be~replaced~by~an~old~continuous~mark}{
  \sectionbreak[next,page-number-format={number-format=decimal}]
  \TYPE{new-section=\int_use:N\g_docxlike_section_int}
  \hbox:n{New~section~body}\clearpage
  \TYPE{page-section=\int_use:N\g__docxlike_headfoot_page_section_int}
}
\ExplSyntaxOff
\END
\end{document}
