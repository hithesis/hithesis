% 显式配置须修改真正的重置链，算法和清单也要跟随，附录不得改回默认。
\input{regression-test}
\documentclass[fontset=fandol,degree-level=master]{hithesis}
\hitsetup{caption-numbering-by-top-level-heading=false,equation-numbering-by-top-level-heading=false}
\begin{document}
\START
\makeatletter
\ExplSyntaxOn
\cs_new_protected:Npn \NEXT
  { \clist_map_inline:nn { figure , table , equation , algocf , lstlisting } { \stepcounter{##1} } }
\cs_new_protected:Npn \NUMBERS
  {
    \typeout{figure=[\thefigure],table=[\thetable],equation=[\theequation]}
    \typeout{algorithm=[\thealgocf],listing=[\thelstlisting]}
  }
\TEST{Preamble~continuous~numbering}{
  \stepcounter{chapter}\NEXT\NUMBERS
  \stepcounter{chapter}\NEXT\NUMBERS
}
\TEST{Equation~switch~is~independent}{
  \hitsetup{equation-numbering-by-top-level-heading=true}
  \stepcounter{chapter}\NEXT\NUMBERS
}
\TEST{All~counters~reset~by~chapter}{
  \hitsetup{caption-numbering-by-top-level-heading=true}
  \stepcounter{chapter}\NEXT\NUMBERS
  \typeout{Hfigure=[\theHfigure],Hequation=[\theHequation]}
}
\TEST{Auto~restores~original~reset~chains}{
  \hitsetup{caption-numbering-by-top-level-heading=auto,equation-numbering-by-top-level-heading=auto}
  \stepcounter{chapter}\NEXT\NUMBERS
}
\TEST{Appendix~keeps~continuous~numbering}{
  \hitsetup{caption-numbering-by-top-level-heading=false,equation-numbering-by-top-level-heading=false}
  \appendix
  \stepcounter{chapter}\NEXT\NUMBERS
  \stepcounter{chapter}\NEXT\NUMBERS
}
\TEST{Auto~in~appendix~restores~letter~prefix}{
  \hitsetup{caption-numbering-by-top-level-heading=auto,equation-numbering-by-top-level-heading=auto}
  \stepcounter{chapter}\NEXT\NUMBERS
}
\TEST{Symbol~list~does~not~force~chapter~numbering}{
  \hitsetup{caption-numbering-by-top-level-heading=false}
  \cs_set_protected:Npn \hit@frontlist@open:nn #1#2 { }
  \__hit_symbols_open:\__hit_symbols_close:
  \setcounter{table}{7}
  \typeout{table-after-symbols=[\thetable]}
}
\ExplSyntaxOff
\makeatother
\END
\end{document}
