% degree-level=postdoc 定死 kind=thesis。
%
% kind 只有 thesis、proposal、interim 三个取值，degree-level 才有 postdoc。博士后只写研究
% 报告，没有开题与中期，所以这两个选项存在一个不可能的组合。原先写了会一路炸：
% 派发类照 kind 转给报告类，报告类的 degree-level 不接受 postdoc，报「选项 degree-level 不接受
% 取值 postdoc」，接着 \bool_lazy_or:nnF 参数不完整，最后连 \begin{document} 都丢，
% 一共 7 个错误。
%
% 现在 degree-level=postdoc 一出现就按学位论文类派发，kind 写什么都不看。旧名 type=postdoc
% 同样管用。
%
% 断言的是派发到了哪个类：\g__hit_thesis_bool 只有学位论文类置真，报告类置假；
% \g__hit_postdoc_bool 只有学位论文类的 degree-level 造得出来。冲突提示不断言，它在
% \documentclass 时就发了，早于 \START，抓不到。
\input{regression-test}
\documentclass[fontset=fandol,kind=proposal,degree-level=postdoc,campus=harbin]{hithesis}
\begin{document}
\START
\ExplSyntaxOn
\TEST{冲突组合派发到学位论文类}{
  \typeout{thesis=\bool_if:NTF \g__hit_thesis_bool {是}{否}}
  \typeout{report=\bool_if:NTF \g__hit_report_bool {是}{否}}
  \typeout{postdoc标志位=\cs_if_exist:NTF \g__hit_postdoc_bool {有}{没有}}
  \typeout{postdoc为真=\bool_if:NTF \g__hit_postdoc_bool {是}{否}}
}
\ExplSyntaxOff
\END
\end{document}
