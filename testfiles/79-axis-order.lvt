% 档位值写错顺序当场报错。
%
% 剥是从末段往前、轴序严格递减。header-doctor-shenzhen 剥掉 shenzhen（校区，
% 第二根）之后遇到 doctor（学位，第三根），三不小于二，停下——剩下的
% header-doctor 整串成了名字，与 header 是两个互不相干的东西，查表永远查不到。
%
% 这一条先前只在注释里写着“当场看得出表写歧义了”，其实看不出来：不报错，
% 排出来是不带后缀那一份。加检查时抓出仓库里一处真的写错了位置的键。
\input{regression-test}
\documentclass[fontset=fandol,degree-level=doctor,campus=harbin]{hithesis}
\makeatletter\ExplSyntaxOn
\hit@hook@new:nn { good-shenzhen-doctor } { 顺序对 }
\hit@hook@new:nn { bad-doctor-shenzhen } { 顺序错 }
\ExplSyntaxOff\makeatother
\begin{document}
\START
\makeatletter\ExplSyntaxOn
\TEST{顺序对的剥得干净}{
  \hit@axis@parse:n { good-shenzhen-doctor }
  \typeout{good-剩下=[\l__hit_axis_term_tl]}
}
\TEST{顺序错的当场报错}{
  \hit@axis@parse:n { bad-doctor-shenzhen }
}
\ExplSyntaxOff\makeatother
\END
\end{document}
