% 符号表环境 symbols，以及只供老文档的 denotation。
%
% symbols 是 enumitem 的 description 列表，一行一个符号；可选参数收键值，
% labelwidth 改第一列宽度、subheading 给这一段加小标题；不含等号的裸值当宽度，
% 所以 v3.1e 的 \begin{denotation}[3cm] 那种写法照样认。
%
% denotation 退回 v3.1e 原样：排标题、重置表号、正文随用户写，没有列表机制也没有
% 星号版。symbols* 接手“自己写表格”那条路。
\input{regression-test}
\documentclass[fontset=fandol,degree-level=doctor,campus=harbin]{hithesis}
\begin{document}
\START
\makeatletter
\ExplSyntaxOn
\TEST{symbols 是列表，默认宽度 2.5cm}{
  \begin{symbols}
  \item[$R$] 实数集
  \end{symbols}
  \iow_term:x { 宽度 = \tl_use:N \l__hit_symbols_width_tl }
}
\TEST{裸值当宽度，v3.1e 的写法照认}{
  \begin{symbols}[4cm]
  \item[$R$] 实数集
  \end{symbols}
  \iow_term:x { 宽度 = \tl_use:N \l__hit_symbols_width_tl }
}
\TEST{键值收 labelwidth 与 subheading}{
  \begin{symbols}[labelwidth=3cm, subheading=符号]
  \item[$R$] 实数集
  \end{symbols}
  \iow_term:x { 宽度 = \tl_use:N \l__hit_symbols_width_tl }
}
\TEST{星号版不开列表，正文自己写表格}{
  \begin{symbols*}
  \begin{tabular}{cc}
  量的名称 & 单位符号\\
  频率 & Hz\\
  \end{tabular}
  \end{symbols*}
}
\TEST{denotation 还在，正文随用户写}{
  \begin{denotation}
  \begin{tabular}{cc}
  量的名称 & 单位符号\\
  频率 & Hz\\
  \end{tabular}
  \end{denotation}
}
\ExplSyntaxOff
\makeatother
\END
\end{document}
