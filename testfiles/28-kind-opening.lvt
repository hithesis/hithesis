% 派发类 hithesis.cls：kind=proposal 直接传给报告类。
%
% kind 本身不往下转发，两个真类都不认这个键；写错了会有中文提示。
% 断言装上的是 hit-report（\resolution 没有），stage 被置成 proposal。
\input{regression-test}
\documentclass[fontset=fandol,kind=proposal,degree-level=doctor,campus=shenzhen]{hithesis}
\begin{document}
\START
\makeatletter
\TEST{kind=proposal 装的是报告类}{
  \typeout{resolution=\ifdefined\resolution 有\else 无\fi}
}
\TEST{stage 与其余选项}{
  \typeout{proposal=\hit@if@option@TF{proposal}{yes}{no}}
  \typeout{interim=\hit@if@option@TF{interim}{yes}{no}}
  \typeout{shenzhen=\hit@if@option@TF{shenzhen}{yes}{no}}
  \typeout{doctor=\hit@if@option@TF{doctor}{yes}{no}}
}
\makeatother
\END
\end{document}
