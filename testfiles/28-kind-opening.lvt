% 派发类 hithesis.cls：kind=opening 转成报告类的 stage=opening。
%
% kind 本身不往下转发，两个真类都不认这个键；写错了会有中文提示。
% 断言装上的是 hit-report（\resolution 没有），stage 被置成 opening。
\input{regression-test}
\documentclass[fontset=fandol,kind=opening,degree-level=doctor,campus=shenzhen]{hithesis}
\begin{document}
\START
\makeatletter
\TEST{kind=opening 装的是报告类}{
  \typeout{resolution=\ifdefined\resolution 有\else 无\fi}
}
\TEST{stage 与其余选项}{
  \typeout{opening=\hit@if@option@TF{opening}{yes}{no}}
  \typeout{midterm=\hit@if@option@TF{midterm}{yes}{no}}
  \typeout{shenzhen=\hit@if@option@TF{shenzhen}{yes}{no}}
  \typeout{doctor=\hit@if@option@TF{doctor}{yes}{no}}
}
\makeatother
\END
\end{document}
