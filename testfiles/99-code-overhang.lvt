\input{regression-test}
\documentclass{hithesis}
\begin{document}
\START
\ExplSyntaxOn
\sys_if_engine_luatex:T
  {\lua_now:n{assert(docxlike.linebreak.code_optimal==false,"hithesis~must~default~to~greedy")}}
\TEST{Code~overhang~defaults~and~template~auto}{
  \typeout{default-enabled=\bool_if:NTF\l__docxlike_code_overhang_bool{yes}{no}}
  \typeout{default-relative=\bool_if:NTF\l__docxlike_code_overhang_relative_bool{yes}{no}}
  \typeout{default-ratio=\l__docxlike_code_overhang_ratio_tl}
  \hitsetup{code-overhang=true,code-overhang-page-inset=8mm}
  \typeout{explicit-enabled=\bool_if:NTF\l__docxlike_code_overhang_bool{yes}{no}}
  \typeout{explicit-inset=\dim_compare:nNnTF{\l__docxlike_code_overhang_page_inset_dim}={8mm}{yes}{no}}
  \typeout{explicit-relative=\bool_if:NTF\l__docxlike_code_overhang_relative_bool{yes}{no}}
  \hitsetup{code-overhang=false}
  \typeout{disabled=\bool_if:NTF\l__docxlike_code_overhang_bool{no}{yes}}
  \hitsetup{code-overhang=auto,code-overhang-page-inset=auto}
  \typeout{auto-enabled=\bool_if:NTF\l__docxlike_code_overhang_bool{yes}{no}}
  \typeout{auto-relative=\bool_if:NTF\l__docxlike_code_overhang_relative_bool{yes}{no}}
  \typeout{auto-ratio=\l__docxlike_code_overhang_ratio_tl}
}
\ExplSyntaxOff
\END
