% 合并后的 title 键。
% 取值带两套断点：花括号分组给“题目栏是两条固定线”的封面，\\ 给自由排的封面，
% 尾随方括号是副语言题目；副标题由 subtitle 单独设置。
%
% 断言解析进三格之后的结果，不断言排出来什么。\\ 在两条线与扁平两种取用里都要被
% 屏蔽掉，所以基线里那两处看到的是“\\ 不见了”。
\input{regression-test}
\documentclass[fontset=fandol,degree-level=doctor,campus=harbin]{hithesis}
\hitsetup{info={title={第一段\\自由断}{第二段}[Only one segment],subtitle={副标题}}}
\begin{document}
\START
\makeatletter
\TEST{三格各就各位}{
  \typeout{first=[\hit@info@title@first@zh]}
  \typeout{second=[\hit@info@title@second@zh]}
  \typeout{subtitle=[\hit@info@title@subtitle@zh]}
}
\TEST{自由排的封面保留反斜杠断行}{
  \typeout{cover=[\detokenize\expandafter{\hit@info@title@first@zh}]}
}
\TEST{只写一段时第二格为空}{
  \typeout{en-first=[\hit@info@title@first@en]}
  \typeout{en-second=[\hit@info@title@second@en]}
}
\TEST{题目内容中的分组原样保存}{
  \hitsetup{info={title={\keepvalue}[{\bfseries 粗}其余部分]}}
  \typeout{fallback=[\detokenize\expandafter{\hit@info@title@first@en}]}
}
\makeatother
\END
\end{document}
