% 合并后的 title 键。
% 取值带两套断点：花括号分组给“题目栏是两条固定线”的封面，\\ 给自由排的封面，
% 方括号是副标题。三种取用方式各取各的，42 变体只看得到最终版面，看不出解析对不对。
%
% 断言解析进三格之后的结果，不断言排出来什么。\\ 在两条线与扁平两种取用里都要被
% 屏蔽掉，所以基线里那两处看到的是“\\ 不见了”。
\input{regression-test}
\documentclass[fontset=fandol,degree-level=doctor,campus=harbin]{hit-thesis}
\hitsetup{info={zh={title={第一段\\自由断}{第二段}[副标题]}}}
\hitsetup{info={en={title={Only one segment}}}}
\begin{document}
\START
\makeatletter
\TEST{三格各就各位}{
  \typeout{first=[\hit@title@first@zh]}
  \typeout{second=[\hit@title@second@zh]}
  \typeout{subtitle=[\hit@title@subtitle@zh]}
}
\TEST{自由排的封面保留反斜杠断行}{
  \typeout{cover=[\detokenize\expandafter{\hit@title@first@zh}]}
}
\TEST{只写一段时第二格为空}{
  \typeout{en-first=[\hit@title@first@en]}
  \typeout{en-second=[\hit@title@second@en]}
}
\TEST{以花括号组开头要报警告并整条回退}{
  \hitsetup{info={en={title={{\bfseries 粗}其余部分}}}}
  \typeout{fallback=[\detokenize\expandafter{\hit@title@first@en}]}
}
\makeatother
\END
\end{document}
