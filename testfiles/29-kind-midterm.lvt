% 派发类 hithesis.cls：kind=midterm 转成报告类的 stage=midterm。
%
% 深圳博士中期原先要单独一个类名 hithesisartplus，现在是三个选项的组合。
\input{regression-test}
\documentclass[fontset=fandol,kind=midterm,level=doctor,campus=shenzhen]{hithesis}
\begin{document}
\START
\makeatletter
\TEST{kind=midterm 走深圳博士中期那条}{
  \typeout{midterm=\hit@if@option@TF{midterm}{yes}{no}}
  \typeout{opening=\hit@if@option@TF{opening}{yes}{no}}
  \typeout{szdm=\hit@if@shenzhen@doctor@midterm@TF{yes}{no}}
}
\makeatother
\END
\end{document}
