% 派发类 hithesis.cls：kind=interim 直接传给报告类。
%
% 深圳博士中期原先要单独一个类名 hithesisartplus，现在是三个选项的组合。
\input{regression-test}
\documentclass[fontset=fandol,kind=interim,degree-level=doctor,campus=shenzhen]{hithesis}
\begin{document}
\START
\makeatletter
\TEST{kind=interim 走深圳博士中期那条}{
  \typeout{interim=\hit@if@option@TF{interim}{yes}{no}}
  \typeout{proposal=\hit@if@option@TF{proposal}{yes}{no}}
  \typeout{szdm=\hit@if@shenzhen@doctor@interim@TF{yes}{no}}
}
\makeatother
\END
\end{document}
