% 报告类的 \appendix：节号变 A、B、C。
%
% 这一条 49 个变体一格都盖不到（examples 里没有一处用 \appendix），而它恰恰是
% 换基类时唯一压不回去的一条：\cls{ctexart} 的 \appendix 改的是 section 那四个
% 宏，\cls{ctexbook} 那份用 \gdef 写死了改 chapter，换过去节号会从 A 变回 1。
% 所以模板自己写了一份，这里钉住它。
%
% 断言的是 \thesection 的取值，不是排出来的样子——样子由 ctexset 管，这里只问
% 编号形态对不对。
\input{regression-test}
\documentclass[fontset=fandol,degree-level=master,campus=harbin,stage=proposal]{hithesis}
\begin{document}
\START
\makeatletter
\section{正文一节}
\TEST{正文里是阿拉伯节号}{
  \typeout{before=[\thesection]}
}
\appendix
\section{附录一节}
\subsection{附录子节}
\TEST{appendix 之后节号变字母}{
  \typeout{after=[\thesection]}
  \typeout{sub=[\thesubsection]}
}
\makeatother
\END
\end{document}
