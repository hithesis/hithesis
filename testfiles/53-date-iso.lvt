% 日期字段收 ISO 数字，各处按自己的语言排，写到哪级排到哪级。
%
% 四件事：补零与不补零都认；写年月日就排年月日、只写年就排年，不截不催；
% 非 ISO 原样排另报一句；默认值是东八区今天的年月。
%
% 断言打的是排版结果，所以要装进盒子再量——取值是个 protected 宏，
% \typeout 打出来只是宏名。这里改用 \typeout 打不出，换成把结果写进文件流。
\input{regression-test}
\documentclass[fontset=fandol,degree-level=master,campus=harbin]{hit-thesis}
\begin{document}
\START
\makeatletter
\ExplSyntaxOn
\tl_new:N \l_shown_tl
\cs_new_protected:Npn \SHOW #1#2
  {
    \hbox_set:Nn \l_tmpa_box { #2 }
    \iow_term:x { #1 ~ 宽度 = \dim_use:N \box_wd:N \l_tmpa_box }
  }

% 补零与不补零同解，排出来一样宽
\TEST{zero padding is normalized}{
  \hitsetup{ info = { date-zh = {2026-07} } }
  \SHOW { a } \hit@info@date@zh
  \hitsetup{ info = { date-zh = {2026-7} } }
  \SHOW { b } \hit@info@date@zh
}

% 写到哪级排到哪级：年月日比年月宽一截，中英一个规矩
\TEST{precision follows the value}{
  \hitsetup{ info = { date-zh = {2026-07-07} } }
  \SHOW { zhday } \hit@info@date@zh
  \hitsetup{ info = { date-en = {2026-07-07} } }
  \SHOW { enday } \hit@info@date@en
  \hitsetup{ info = { date-en = {2026-07} } }
  \SHOW { enmonth } \hit@info@date@en
}

% 只写年就排年，不催补
\TEST{year only prints year}{
  \hitsetup{ info = { date-zh = {2026} } }
  \SHOW { yearonly } \hit@info@date@zh
}

% 非 ISO：原样排，另报一句
\TEST{non iso prints verbatim}{
  \hitsetup{ info = { date-zh = {二〇二六年六月} } }
  \SHOW { verbatim } \hit@info@date@zh
}

% 同一个字段只报一次
\TEST{warned once per field}{
  \hitsetup{ info = { date-zh = {超新星纪元} } }
  \SHOW { again } \hit@info@date@zh
}
\ExplSyntaxOff
\makeatother
\END
\end{document}
