% 派发类 hithesis.cls：kind 写错时报中文提示，按 thesis 兜底。
%
% 不能硬失败：\LoadClass 之前出错的话，后面整份文档都没有类可用，
% 报出来的几百个错都指不到病根。
%
% 提示是在装类的时候发的，早于 \START，tlg 收不到，所以这里钉的是兜底装了哪个类。
\input{regression-test}
\documentclass[fontset=fandol,kind=zhongqi,degree-level=doctor,campus=harbin]{hithesis}
\begin{document}
\START
\makeatletter
\TEST{兜底装的是学位论文类}{
  \typeout{resolution=\ifdefined\resolution 有\else 无\fi}
}
\makeatother
\END
\end{document}
