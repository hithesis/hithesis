% 报告以 section 为顶层，不能沿用 book 的 chapter 重置链。
\input{regression-test}
\documentclass[fontset=fandol,degree-level=master,campus=shenzhen,stage=proposal]{hithesis}
\hitsetup{caption-numbering-by-top-level-heading=true,equation-numbering-by-top-level-heading=true}
\begin{document}
\START
\makeatletter
\ExplSyntaxOn
\cs_new_protected:Npn \NEXT
  { \clist_map_inline:nn { figure , table , equation , algocf , lstlisting } { \stepcounter{##1} } }
\cs_new_protected:Npn \NUMBERS
  {
    \typeout{figure=[\thefigure],table=[\thetable],equation=[\theequation]}
    \typeout{algorithm=[\thealgocf],listing=[\thelstlisting]}
  }
\TEST{All~counters~reset~by~section}{
  \stepcounter{section}\NEXT\NUMBERS
  \stepcounter{section}\NEXT\NUMBERS
  \typeout{Hfigure=[\theHfigure],Hequation=[\theHequation]}
}
\TEST{Subsection~does~not~reset~them}{
  \stepcounter{subsection}\NEXT\NUMBERS
}
\TEST{Continuous~caption~numbering~is~independent}{
  \hitsetup{caption-numbering-by-top-level-heading=false}
  \stepcounter{section}\NEXT\NUMBERS
}
\TEST{Continuous~equations~also~survive~section~changes}{
  \hitsetup{equation-numbering-by-top-level-heading=false}
  \stepcounter{section}\NEXT\NUMBERS
}
\TEST{Auto~restores~the~report~defaults}{
  \hitsetup{caption-numbering-by-top-level-heading=auto,equation-numbering-by-top-level-heading=auto}
  \stepcounter{section}\NEXT\NUMBERS
}
\ExplSyntaxOff
\makeatother
\END
\end{document}
