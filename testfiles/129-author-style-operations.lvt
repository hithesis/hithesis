\input{regression-test}
\documentclass[degree-level=doctor,fontset=fandol]{hithesis}
\ExplSyntaxOn
\msg_redirect_module:nnn{fontspec}{info}{none}
\tl_new:N\l__hit_author_value_tl
\hitsetup{styles={HITAuthorParent={based-on=Normal,font={latin-bold=true,latin-line=true,snap-to-grid=true},paragraph={snap-to-grid=true}}}}
\group_begin:
\bool_set_true:N\g_docxlike_format_defaults_bool
\hitsetup{styles={HITAuthorChild={based-on=HITAuthorParent,font={latin-bold=false,latin-line=false,snap-to-grid=false},paragraph={snap-to-grid=false,spacing={line-spacing=exactly,at=14bp}}}}}
\group_end:
\cs_new_protected:Npn\AuthorValue:nn#1#2{
 \docxlike_format_get:nnN{HITAuthorChild}{#1}\l__hit_author_value_tl
 \TYPE{#2=\l__hit_author_value_tl}}
\ExplSyntaxOff
\begin{document}
\START
\ExplSyntaxOn
\TEST{Class~short~keys~reset~to~registered~defaults}{
 \hitsetup{styles={HITAuthorChild={font={latin-bold=true,latin-line=true,snap-to-grid=true},paragraph={snap-to-grid=true,spacing={line-range={18bp~2}}}}}}
 \docxlike_style_reset:nn{HITAuthorChild}{font/latin-bold,font/latin-line,font/snap-to-grid,paragraph/snap-to-grid,paragraph/spacing/line-range}
 \AuthorValue:nn{latin-bold}{latin-bold}
 \AuthorValue:nn{latin-line}{latin-line}
 \AuthorValue:nn{rPr/snapToGrid}{font-grid}
 \AuthorValue:nn{pPr/snapToGrid}{paragraph-grid}
 \AuthorValue:nn{pPr/spacing/lineRule}{line-rule}
 \docxlike_format_get:nnN{HITAuthorChild}{ext/line-2}\l__hit_author_value_tl
 \TYPE{second-endpoint=\tl_if_empty:NTF\l__hit_author_value_tl{empty}{nonempty}}
}
\TEST{Class~short~keys~can~inherit~the~parent~again}{
 \docxlike_style_inherit:nn{HITAuthorChild}{font/latin-bold,font/latin-line,font/snap-to-grid,paragraph/snap-to-grid}
 \AuthorValue:nn{latin-bold}{latin-bold}
 \AuthorValue:nn{latin-line}{latin-line}
 \AuthorValue:nn{rPr/snapToGrid}{font-grid}
 \AuthorValue:nn{pPr/snapToGrid}{paragraph-grid}
}
\ExplSyntaxOff
\END
\end{document}
