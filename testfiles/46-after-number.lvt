% 编号之后排什么：标题四级与图题表题。
%
% 这批常量的默认值不能写成一个数：章号之后排多宽，本部硕士与深圳本科是一个全角，
% 其余是半个；报告类还要看开题还是中期。判断本来就写在各个 \ctexset 块里，一块一份。
% 所以常量默认留空，各块把自己原有的取值当兜底传进来。空就用兜底，非空就用常量。
%
% \hit@after@number:nnn 判空不能用 \tl_if_empty:cTF。常量是 \cs_gset:cpx 建的，
% 那是 \long 宏；\tl_if_empty:N 拿不是 \long 的 \c_empty_tl 比意义，空常量会判成
% 非空，接着 \use:c 取到空宏，间距静悄悄地消失——45 个变体全变、页数一页不变。
% 所以拿一个同样由 \cs_new:Npn 建的空宏来比。这条是本测试最要紧的一项。
%
% 注意 \makeatletter：文档体里 @ 不是字母，\hit@after@number:nnn 会被拆成 \hit 加
% 一串普通字符，看着像每次都返回原文。
\input{regression-test}
\documentclass[fontset=fandol,degree-level=doctor,campus=harbin]{hithesis}
\begin{document}
\START
\makeatletter
\ExplSyntaxOn
\TEST{默认为空，走各块自己的兜底}{
  \typeout{chapter=[\hit@after@number:nnn{chapter}{zh}{兜底}]}
  \typeout{section=[\hit@after@number:nnn{section}{zh}{兜底}]}
  \typeout{figure=[\hit@after@number:nnn{figure@caption}{zh}{兜底}]}
  \typeout{table=[\hit@after@number:nnn{table@caption}{zh}{兜底}]}
}
\TEST{单设一级}{
  \hitsetup{const={zh={after-chapter-number={甲}}}}
  \typeout{chapter=[\hit@after@number:nnn{chapter}{zh}{兜底}]}
  \typeout{section=[\hit@after@number:nnn{section}{zh}{兜底}]}
}
\TEST{after-heading-number 铺到四级}{
  \hitsetup{const={zh={after-heading-number={乙}}}}
  \typeout{chapter=[\hit@after@number:nnn{chapter}{zh}{兜底}]}
  \typeout{section=[\hit@after@number:nnn{section}{zh}{兜底}]}
  \typeout{subsection=[\hit@after@number:nnn{subsection}{zh}{兜底}]}
  \typeout{subsubsection=[\hit@after@number:nnn{subsubsection}{zh}{兜底}]}
}
\TEST{铺完再单设某一级仍然管用}{
  \hitsetup{const={zh={after-section-number={丙}}}}
  \typeout{section=[\hit@after@number:nnn{section}{zh}{兜底}]}
  \typeout{chapter=[\hit@after@number:nnn{chapter}{zh}{兜底}]}
}
\TEST{图题表题各设各的}{
  \hitsetup{const={zh={after-figure-caption-number={丁},
                       after-table-caption-number={戊}}}}
  \typeout{figure=[\hit@after@number:nnn{figure@caption}{zh}{兜底}]}
  \typeout{table=[\hit@after@number:nnn{table@caption}{zh}{兜底}]}
}
\TEST{zh 设了不影响 en}{
  \typeout{chapter-en=[\hit@after@number:nnn{chapter}{en}{兜底}]}
  \hitsetup{const={en={after-chapter-number={己}}}}
  \typeout{chapter-en=[\hit@after@number:nnn{chapter}{en}{兜底}]}
  \typeout{chapter-zh=[\hit@after@number:nnn{chapter}{zh}{兜底}]}
}
\ExplSyntaxOff
\makeatother
\END
\end{document}
