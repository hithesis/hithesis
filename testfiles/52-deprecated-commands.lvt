% \resolution 与 \authorization 是 v3.1e 的写法，v3.2a 起由 struct 的
% defense 与 declarations 两个键接管，用户再调它们要给一句废弃提示。
%
% 两件事：用户调是要提示的；类自己排这一页走的是内部命令，不能跟着提示。
%
% 排版的活拦下来只打印，测试里没有扫描件也没有名单。
\input{regression-test}
\documentclass[fontset=fandol,degree-level=doctor,campus=harbin]{hithesis}
\makeatletter
\RenewDocumentCommand\hit@resolution@place{so}{\typeout{[排] 决议}}
\RenewDocumentCommand\hit@declarations@place{so}{\typeout{[排] 声明与权限}}
\renewcommand\include[1]{\typeout{[include] #1}}
\renewcommand\tableofcontents{\typeout{[类自排] 目录}}
\makeatother
\begin{document}
\START
\TEST{用户调旧命令要提示}{
  \resolution
  \authorization
}

\TEST{同一个命令只提示一次}{
  \resolution*[figures/x.pdf]
  \authorization*[figures/x.pdf]
}

\hitsetup{ struct = { backmatter = { defense = auto, declarations = true } } }
\TEST{类自排不提示}{
  \hitbackmatter
}
\END
\end{document}
