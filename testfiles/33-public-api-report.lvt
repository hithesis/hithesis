% 公开面的存在性断言（报告类）。
%
% LaTeX 没有模块作用域，类里定义的不带 @ 与 _ : 的名字，用户在正文里就能直接调用。
% 那批名字是接口，改名或弄丢都会让老文档报 Undefined control sequence，而 45 个
% 变体测不出来：它们只编示例，示例不会把每个公开宏都用一遍。
%
% 名单出自 .github/public-api.txt 的三个“公开”小节，由 scripts/check-api.py 维护。
% 这里只断言“还在”，不断言行为，行为由各自的专门测试管。
%
% 名单变了要同步改这里；这里红了说明有人动了公开面，先看 CONTRIBUTING 4.1 节。
\input{regression-test}
\documentclass[fontset=fandol,degree-level=doctor,kind=proposal,campus=shenzhen]{hit-report}
\makeatletter
\begin{document}
\START

\TEST{公开宏都还在}{
  \typeout{bisubcaption=\ifdefined\bisubcaption 有\else 丢了\fi}
  \typeout{hit=\ifdefined\hit 有\else 丢了\fi}
  \typeout{hitbackmatter=\ifdefined\hitbackmatter 有\else 丢了\fi}
  \typeout{hitfrontmatter=\ifdefined\hitfrontmatter 有\else 丢了\fi}
  \typeout{hitsetup=\ifdefined\hitsetup 有\else 丢了\fi}
  \typeout{inlinecite=\ifdefined\inlinecite 有\else 丢了\fi}
  \typeout{listsubcaptions=\ifdefined\listsubcaptions 有\else 丢了\fi}
  \typeout{listtheorems=\ifdefined\listtheorems 有\else 丢了\fi}
  \typeout{ltfontsize=\ifdefined\ltfontsize 有\else 丢了\fi}
  \typeout{quan=\ifdefined\quan 有\else 丢了\fi}
  \typeout{theorembodyfont=\ifdefined\theorembodyfont 有\else 丢了\fi}
  \typeout{theoremclass=\ifdefined\theoremclass 有\else 丢了\fi}
  \typeout{theoremheaderfont=\ifdefined\theoremheaderfont 有\else 丢了\fi}
  \typeout{theoremlisttype=\ifdefined\theoremlisttype 有\else 丢了\fi}
  \typeout{theoremnumbering=\ifdefined\theoremnumbering 有\else 丢了\fi}
  \typeout{theorempostwork=\ifdefined\theorempostwork 有\else 丢了\fi}
  \typeout{theoremprework=\ifdefined\theoremprework 有\else 丢了\fi}
  \typeout{theoremseparator=\ifdefined\theoremseparator 有\else 丢了\fi}
