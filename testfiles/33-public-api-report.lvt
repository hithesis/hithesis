  \typeout{thref=\ifdefined\thref 有\else 丢了\fi}
  \typeout{makebackcover=\ifdefined\makebackcover 有\else 丢了\fi}
  \typeout{CJKtoday=\ifdefined\CJKtoday 有\else 丢了\fi}
  \typeout{bibauthor=\ifdefined\bibauthor 有\else 丢了\fi}
  \typeout{makecover=\ifdefined\makecover 有\else 丢了\fi}
