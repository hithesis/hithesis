% form 照 iota-hit 分学位论文与实践成果：dissertation（默认）勾毕业论文，practice 勾毕业设计；
% thesis、design 是它们的别名。它只动“交的是论文还是成果”那对标志位，学位层次照旧。
% 旧选项 design 仍然能用，写了提示一次；开发版的 degree-level=bachelor* 撤了，写了报错指路。
\input{regression-test}
\documentclass[fontset=fandol,degree-level=bachelor,form=practice,campus=harbin]{hithesis}
\begin{document}
\START
\makeatletter
\ExplSyntaxOn
\cs_new_protected:Npn \FLAGS #1
  {
    \iow_term:x
      {
        #1 :~
        bachelor = \bool_if:NTF \g__hit_bachelor_bool { Y } { N } ~
        master = \bool_if:NTF \g__hit_master_bool { Y } { N } ~
        practice = \bool_if:NTF \g__hit_practice_bool { Y } { N } ~
        dissertation = \bool_if:NTF \g__hit_dissertation_bool { Y } { N }
      }
  }

\TEST{form=practice}{ \FLAGS { practice } }

\TEST{form=dissertation}{
  \hitsetup{ form = dissertation }
  \FLAGS { dissertation }
}

\TEST{design and thesis are aliases}{
  \hitsetup{ form = design }
  \FLAGS { design }
  \hitsetup{ form = thesis }
  \FLAGS { thesis }
}

\TEST{form on another level leaves that level}{
  \hitsetup{ degree-level = master , form = practice }
  \FLAGS { master-practice }
}

\TEST{old design option still works and warns}{
  \hitsetup{ degree-level = bachelor , design = true }
  \FLAGS { design-true }
}

\TEST{warned only once}{
  \hitsetup{ design = false }
  \FLAGS { design-false }
}

\TEST{star is gone}{
  \hitsetup{ degree-level = bachelor* }
  \FLAGS { bachelor-star }
}
\ExplSyntaxOff
\makeatother
\END
\end{document}
