% zh 与 en 分组写法。
% 分组只是把里面每个键名接上后缀再转发，所以断言的是带后缀的正式键存进了什么，
% 这样万一转发写错了（比如后缀接反、或者漏掉没有配对的键）都会露出来。
%
% info 与 const 两族各测一组：前者的值由用户填，后者有默认值要被覆盖。
% 同时混一个没有配对的键在分组外面，确认两种写法能并存。
\input{regression-test}
\documentclass[fontset=fandol,degree-level=doctor,campus=harbin]{hit-thesis}
\hitsetup{info={
  zh = { title={中文题目}, author={张三}, discipline={工学} },
  en = { title={English Title}, author={Zhang San} },
  student-id = {1180800000},
}}
\hitsetup{const={
  zh = { school={某某大学} },
  en = { school={Some University} },
}}
\begin{document}
\START
\makeatletter
\TEST{分组写法存进带后缀的正式键}{
  \typeout{title-zh=[\hit@title@flat@zh]}
  \typeout{title-en=[\hit@title@cover@en]}
  \typeout{author-zh=[\hit@author@zh]}
  \typeout{author-en=[\hit@author@en]}
}
\TEST{分组外的键照常}{
  \typeout{student-id=[\hit@student@id]}
}
\TEST{常量族同样认分组}{
  \typeout{school-zh=[\hit@school@zh]}
  \typeout{school-en=[\hit@school@en]}
}
\TEST{引用分组里设的值}{
  \typeout{degree-level=[\hit@degree@of@discipline@format@zh]}
}
\makeatother
\END
\end{document}
