% 双语值分别存入中英文字段；元信息与词条覆盖使用同一语法。
% 同时混一个没有配对的键在分组外面，确认两种写法能并存。
\input{regression-test}
\documentclass[fontset=fandol,degree-level=doctor,campus=harbin]{hithesis}
\hitsetup{info={
  title={中文题目}[English Title], author={张三}[Zhang San], degree-applied={工学博士},
  student-id = {1180800000},
}}
\hitsetup{overrides={
  base = { university={某某大学}[Some University] },
}}
\begin{document}
\START
\makeatletter
\TEST{分组写法存进带后缀的正式键}{
  \typeout{title-zh=[\hit@info@title@flat@zh]}
  \typeout{title-en=[\hit@info@title@cover@en]}
  \typeout{author-zh=[\hit@info@author@zh]}
  \typeout{author-en=[\hit@info@author@en]}
}
\TEST{分组外的键照常}{
  \typeout{student-id=[\hit@info@student@id]}
}
\TEST{词条族同样认分组}{
  \typeout{university-zh=[\hit@term@base@university@zh]}
  \typeout{university-en=[\hit@term@base@university@en]}
}
\TEST{申请学位写全称}{
  \typeout{degree-applied=[\hit@info@degree@applied@zh]}
}
\makeatother
\END
\end{document}
