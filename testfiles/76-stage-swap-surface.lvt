% 同一份正文换个 stage 编，正文里能用的东西两档都得在。
%
% 起因：把示例的 final.tex 从 stage=final 改成 stage=proposal，报了 115 个错，
% 绝大多数是未定义控制序列。查下来是五样只在终稿那一档加载：tikz、xcolor、
% tabularray、splitidx（\hitindex 要的 \sindex）、glossaries-extra（\abbr 要的）。
% 这几样都是正文里能用的，不是哪一页专有的，报告没有它们只是历史遗留。
%
% 这里钉正面：报告那一档这些命令与环境都取得到。反面（终稿专有的整章环境
% 在报告里报一句提示）由 77 号钉。
%
% 断言存在性，不断言排出来的样子。
\input{regression-test}
\documentclass[fontset=fandol,degree-level=doctor,campus=harbin,stage=proposal]{hithesis}
\begin{document}
\START
\makeatletter
\TEST{画图与颜色}{
  \typeout{tikz=\ifcsname tikzpicture\endcsname 有\else 无\fi}
  \typeout{xcolor=\ifdefined\definecolor 有\else 无\fi}
}
\TEST{表格}{
  \typeout{tabularray=\ifcsname tblr\endcsname 有\else 无\fi}
  \typeout{booktabs-lib=\ifcsname booktabs\endcsname 有\else 无\fi}
}
\TEST{索引与缩略语}{
  \typeout{hitindex=\ifdefined\hitindex 有\else 无\fi}
  \typeout{sindex=\ifdefined\sindex 有\else 无\fi}
  \typeout{abbr=\ifdefined\abbr 有\else 无\fi}
  \typeout{abbrs=\ifdefined\abbrs 有\else 无\fi}
}
\TEST{双语题注那条链}{
  \typeout{caption-separator=\ifdefined\hit@caption@separator 有\else 无\fi}
  \typeout{caption-font=\ifcsname hit@caption@font:\endcsname 有\else 无\fi}
}
\makeatother
\END
\end{document}
