% \hitindex 与 \abbr 的索引挂钩。\hitindex 照 iota 的 idx，写什么排什么、按汉字归边。
%
% 索引与缩略语是两件事：索引答“在哪几页”，缩略语答“这个缩写是什么”。但要索引
% 的词与要缩写的词重合度高，所以缩写用一次就顺带登记一次索引，开关是
% abbr/indexing，单处用可选参数压过。
%
% 中文索引要拼音排序键，自动查 xpinyin 推首字，写了 pinyin 就以写的为准。
%
% \sindex 会往 .idx 写文件，测试里拦下来只打印，只看写了什么、写了几条。
\input{regression-test}
\documentclass[fontset=fandol,degree-level=doctor,campus=harbin]{hithesis}
\hitsetup{ abbr = {
  SCNA = {zh=体细胞拷贝数变异, en=Somatic copy number alteration},
  SVM  = {Support Vector Machine},
  CO   = {凸优化},
} }
\makeatletter
\RenewDocumentCommand\sindex{om}{\typeout{[#1] #2}}
\makeatother
\begin{document}
\START

\TEST{abbr 顺带登记两个索引}{ \abbr{SCNA} }

\TEST{只有西文的条目不进中文索引}{ \abbr{SVM} }

\TEST{只有中文的条目不进英文索引}{ \abbr{CO} }

\TEST{局部关掉就不登记}{ \abbr[indexing=false]{SCNA} }

\TEST{hitindex 按汉字归边，一个词只进一个索引}{ \hitindex{段誉} \hitindex{Xu Zhu} }

\TEST{entry 另给词条，带星号只登记}{ \hitindex[entry=乔峰]{乔帮主} \hitindex*{ 虚竹 } }

\TEST{pinyin 写了就以写的为准}{ \hitindex[pinyin=zhong4]{体重} }

\ExplSyntaxOn
\TEST{全局关掉}{
  \hitsetup { abbr = { indexing = false } }
  \abbr{SCNA}
  \hitsetup { abbr = { indexing = true } }
}
\ExplSyntaxOff

% 首次形式跟这一段的语种拼：中文版里的英文段排英文那套、半角括号。
\ExplSyntaxOn
\cs_new_protected:Npn \test_long:n #1
  {
    \__hit_abbr_localize:n {#1}
    \glsletentryfield \l_tmpa_tl {#1} { long }
    \typeout { \tl_use:N \l_tmpa_tl }
  }
\TEST{缩写的首次形式跟这一段的语种}{
  \test_long:n { SCNA }
  \test_long:n { SVM }
  \tl_gset:Nn \g__hit_part_lang_tl { en }
  \test_long:n { SCNA }
  \test_long:n { CO }
  \tl_gclear:N \g__hit_part_lang_tl
  \test_long:n { CO }
}
\ExplSyntaxOff
\END
\end{document}
