% \hitindex 与 \abbr 的索引挂钩。
%
% 索引与缩略语是两件事：索引答“在哪几页”，缩略语答“这个缩写是什么”。但要索引
% 的词与要缩写的词重合度高，所以缩写用一次就顺带登记一次索引，开关是
% abbr/indexing，单处用可选参数压过。
%
% 中文索引要拼音排序键，自动查 xpinyin 推首字，写了 pinyin 就以写的为准。
%
% \sindex 会往 .idx 写文件，测试里拦下来只打印，只看写了什么、写了几条。
\input{regression-test}
\documentclass[fontset=fandol,degree-level=doctor,campus=harbin]{hithesis}
\hitsetup{ abbr = {
  SCNA = {zh=体细胞拷贝数变异, en=Somatic copy number alteration},
  SVM  = {Support Vector Machine},
  CO   = {凸优化},
} }
\makeatletter
\RenewDocumentCommand\sindex{om}{\typeout{[#1] #2}}
\makeatother
\begin{document}
\START

\TEST{abbr 顺带登记两个索引}{ \abbr{SCNA} }

\TEST{只有西文的条目不进中文索引}{ \abbr{SVM} }

\TEST{只有中文的条目不进英文索引}{ \abbr{CO} }

\TEST{局部关掉就不登记}{ \abbr[indexing=false]{SCNA} }

\TEST{hitindex 收键值，两个索引都记}{ \hitindex{zh=乔峰, en=Qiao Feng} }

\TEST{裸值按汉字归边}{ \hitindex{段誉} \hitindex{Xu Zhu} }

\TEST{pinyin 写了就以写的为准}{ \hitindex{zh=体重, pinyin=zhong4} }

\ExplSyntaxOn
\TEST{全局关掉}{
  \hitsetup { abbr = { indexing = false } }
  \abbr{SCNA}
  \hitsetup { abbr = { indexing = true } }
}
\ExplSyntaxOff
\END
\end{document}
