\input{regression-test}
\documentclass[stage=proposal,campus=shenzhen,degree-level=master,fontset=fandol]{hithesis}
\begin{document}
\START
\ExplSyntaxOn
\TEST{Continuous~section~inherits~settings~and~keeps~chapter~counters}{
  \sectionbreak[continuous,page-setup={layout={different-first-page=true}}]
  \TYPE{word-section=\int_use:N\g_docxlike_section_int}
  \TYPE{report-section=\thesection}
  \TYPE{page=\thepage}
  \TYPE{first-page=\__docxlike_section_get:nn{2}{titlePg}}
  \sectionbreak[continuous,columns=auto,page-setup=auto,page-number-format=auto]
  \TYPE{word-section=\int_use:N\g_docxlike_section_int}
  \TYPE{inherited-first-page=\__docxlike_section_get:nn{3}{titlePg}}
}
\TEST{Conflicting~or~unknown~types~do~not~insert~a~break}{
  \msg_redirect_name:nnn{hithesis}{sectionbreak-types}{warning}
  \msg_redirect_name:nnn{hithesis}{sectionbreak-key}{warning}
  \sectionbreak[next,odd]
  \TYPE{after-conflict=\int_use:N\g_docxlike_section_int}
  \sectionbreak[not-a-break]
  \TYPE{after-unknown=\int_use:N\g_docxlike_section_int}
}
\ExplSyntaxOff
\END
\end{document}
