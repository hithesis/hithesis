% 三个旧类名的空壳。v3.2a 把类改名成与源文件同名的 hit-thesis 与 hit-report，
% 旧名 hithesisbook、hithesisart、hithesisartplus 各留一个转发用的空壳，
% v4.1a（2027 年主要版本）移除。
%
% CI 里编的是现行示例，用的全是新名，空壳断了不会有人发现。这里钉住转发本身：
% 用旧名加载之后，类的身份、选项解析出来的值都要与新名一致。
%
% 一份 lvt 只能写一个 \documentclass，所以三个空壳分成三份：本文件试
% hithesisbook，24 试 hithesisart，hithesisartplus 在 07 里已经钉过。
%
% 断言的是选项解析结果与基础类身份，不断言提示文案——文案改了不该让测试红。
\input{regression-test}
\documentclass[fontset=fandol,degree-level=doctor,campus=harbin]{hithesisbook}
\begin{document}
\START
\makeatletter
\TEST{空壳转发到 hit-thesis}{
  \typeout{loaded=\@ifclassloaded{hit-thesis}{yes}{no}}
  \typeout{stub-still-named=\@ifclassloaded{hithesisbook}{yes}{no}}
}
\TEST{选项照常传过去了}{
  \typeout{campus=\hit@if@option@TF{harbin}{harbin}{other}}
  \typeout{type=\hit@if@option@TF{doctor}{doctor}{other}}
  \typeout{degree-level-zh=\hit@degree@level@zh}
}
\makeatother
\END
\end{document}
