% structure 族与两个骨架宏。
%
% 前置与后置的顺序是规范定死的，改由类负责排，用户只说哪个部件用哪个文件。
% 这里断言两件事：没声明的部件一个都不排；声明了的按规范顺序排，中间该有的
% 类自排页面（决议、授权）也在正确位置。
%
% 用 \include 会去读外部文件，测试里没有那些文件，所以把 \include 与 \input
% 都换成打印文件名，只看调用顺序。类自排的几页也拦下来，同样只打印。
\input{regression-test}
\documentclass[fontset=fandol,type=doctor,campus=harbin]{hithesis}
\makeatletter
\renewcommand\include[1]{\typeout{[include] #1}}
\renewcommand\input[1]{\typeout{[input] #1}}
\renewcommand\bibliographystyle[1]{\typeout{[bibstyle] #1}}
\renewcommand\bibliography[1]{\typeout{[bib] #1}}
\renewcommand\resolution{\typeout{[类自排] 决议}}
\renewcommand\authorization{\typeout{[类自排] 授权}}
\renewcommand\tableofcontents{\typeout{[类自排] 目录}}
\makeatother
\begin{document}
\START
\TEST{什么都不声明时后置一片空白}{
  \hitbackmatter
}
\hitsetup{ structure = {
  denotation       = {front/denotation},
  contents         = true,
  conclusion       = {back/conclusion},
  bib              = {reference},
  appendix         = {back/appA},
  publications     = {back/publications},
  resolution       = true,
  index            = {back/ceindex},
  authorization    = true,
  acknowledgements = {back/acknowledgements},
  resume           = {back/resume},
} }
\TEST{声明齐了按规范顺序排}{
  \hitbackmatter
}
\hitsetup{ structure = { resume = false, index = false, bib-style = {hitszthesis} } }
\TEST{取 false 的部件跳过，bib-style 可换}{
  \hitbackmatter
}
\END
\end{document}
