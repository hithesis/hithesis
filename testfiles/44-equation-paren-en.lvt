% 英文论文下 math/numbering-parenthesis-style 无效，一律半角。
%
% 跟 43 是同一个键，只是文档类选项换成 lang=en。单独一个文件是因为语言在
% \documentclass 时就定了，同一份文档里切不了。
%
% 显式写 full 也还是半角，这是规定的行为，不是没生效。
\input{regression-test}
\documentclass[fontset=fandol,degree-level=master,campus=shenzhen,lang=en]{hithesis}
\begin{document}
\START
\ExplSyntaxOn
\TEST{英文默认半角}{
  \typeout{括号=\__hit_equation_paren:nn {全角}{半角}}
}
\TEST{英文显式写full还是半角}{
  \hitsetup{ math = { numbering-parenthesis-style = full } }
  \typeout{括号=\__hit_equation_paren:nn {全角}{半角}}
}
\TEST{英文写half也是半角}{
  \hitsetup{ math = { numbering-parenthesis-style = half } }
  \typeout{括号=\__hit_equation_paren:nn {全角}{半角}}
}
\ExplSyntaxOff
\END
\end{document}
