% 报告类的布尔选项默认值，与 08 同理。art 与 artplus 各自声明了一份同名选项，
% 两个类都要钉，免得将来只改了一边。
%
% 目录不是独立标志位，是目录这个部件在 shown=auto 时排不排。默认值仍旧要钉：
% 这一格报告有目录。
\input{regression-test}
\documentclass[fontset=fandol,degree-level=bachelor,stage=proposal,campus=harbin]{hithesis}
\ExplSyntaxOn
\cs_new_protected:Npn \hitshowcontents
  {
    \use:c { hit@part@if:nnTF } { table-of-contents } { auto }
      { \typeout { table-of-contents(auto)=true } }
      { \typeout { table-of-contents(auto)=false } }
  }
\ExplSyntaxOff
\begin{document}
\START
\makeatletter
\TEST{art 的布尔选项默认值}{
  \typeout{debug=\hit@if@option@TF{debug}{true}{false}}
  \typeout{newtxmath=\hit@if@option@TF{newtxmath}{true}{false}}
  \typeout{print=\hit@if@option@TF{print}{true}{false}}
  \typeout{raggedbottom=\hit@if@option@TF{raggedbottom}{true}{false}}
  \hitshowcontents
}
\makeatother
\END
\end{document}
