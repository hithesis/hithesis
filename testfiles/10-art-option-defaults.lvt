% 报告类的布尔选项默认值，与 08 同理。art 与 artplus 各自声明了一份同名选项，
% 两个类都要钉，免得将来只改了一边。
%
% toc 现在不是独立标志位，它写的是 structure 的 contents。默认值仍旧要钉：
% 报告不写就有目录。
\input{regression-test}
\documentclass[fontset=fandol,degree-level=bachelor,kind=proposal,campus=harbin]{hit-report}
\ExplSyntaxOn
\cs_new:Npn \hitshowcontents { \tl_use:c { g__hit_structure_contents_tl } }
\ExplSyntaxOff
\begin{document}
\START
\makeatletter
\TEST{art 的布尔选项默认值}{
  \typeout{debug=\hit@if@option@TF{debug}{true}{false}}
  \typeout{newtxmath=\hit@if@option@TF{newtxmath}{true}{false}}
  \typeout{print=\hit@if@option@TF{print}{true}{false}}
  \typeout{raggedbottom=\hit@if@option@TF{raggedbottom}{true}{false}}
  \typeout{structure/contents=\hitshowcontents}
}
\makeatother
\END
\end{document}
