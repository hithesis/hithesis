% 双语题注走哪条路。
% \caption{主}[副] 是新写法；\bicaption 仅保留 v3.1e 的五参数形式。排出来的版面在
% 42 变体里看得到，但看不出走的是哪个分支，所以这里把两个分支换成打印，直接钉
% 派发结果。
%
% 换分支要在 begindocument/end 之后——\caption 的接管挂在那个钩子上，早了会被
% caption 宏包盖掉。
\input{regression-test}
\documentclass[fontset=fandol,degree-level=doctor,campus=harbin]{hithesis}
\begin{document}
\makeatletter
\ExplSyntaxOn
\cs_set_protected:Npn \hit@bilingual@caption #1#2#3
  { \typeout{分支=双语 中=#2 英=#3} }
\cs_set_protected:Npn \hit@single@caption #1#2
  { \typeout{分支=单语 中=#2} }
\RenewDocumentCommand \hit@original@caption { o m }
  {\typeout{旧题注=[#2]}}
\cs_set_protected:Npn \hit@caption@repeat:nn #1#2
  {\typeout{旧副题=[#2]}}
\ExplSyntaxOff
\makeatother
\START
\TEST{给了英文题就双语}{
  \begin{figure}\caption{中文题}[English caption]\end{figure}
}
\TEST{不给英文题就单语}{
  \begin{figure}\caption{只有中文}\end{figure}
}
\TEST{短标题不影响派发}{
  \begin{figure}\caption[短]{中文题}[English caption]\end{figure}
}
\TEST{开关关死时按单语排}{
  \hitsetup{styles={bilingual-caption=false}}
  \begin{figure}\caption{中文题}[English caption]\end{figure}
  \hitsetup{styles={bilingual-caption=true}}
}
\TEST{bicaption 保留已发布五参数写法}{
  \begin{figure}\bicaption[l3]{}{中文旧题}{Fig.}{Legacy English}\end{figure}
}
\END
\end{document}
