% 双语题注走哪条路。
% \caption{中}[英] 是新写法，\bicaption 的三种旧写法都要接得住。排出来的版面在
% 42 变体里看得到，但看不出走的是哪个分支，所以这里把两个分支换成打印，直接钉
% 派发结果。
%
% 换分支要在 begindocument/end 之后——\caption 的接管挂在那个钩子上，早了会被
% caption 宏包盖掉。
\input{regression-test}
\documentclass[fontset=fandol,degree-level=doctor,campus=harbin]{hit-thesis}
\begin{document}
\makeatletter
\ExplSyntaxOn
\cs_set_protected:Npn \hit@bilingual@caption #1#2#3
  { \typeout{分支=双语 中=#2 英=#3} }
\cs_set_protected:Npn \hit@single@caption #1#2
  { \typeout{分支=单语 中=#2} }
\ExplSyntaxOff
\makeatother
\START
\TEST{给了英文题就双语}{
  \begin{figure}\caption{中文题}[English caption]\end{figure}
}
\TEST{不给英文题就单语}{
  \begin{figure}\caption{只有中文}\end{figure}
}
\TEST{短标题不影响派发}{
  \begin{figure}\caption[短]{中文题}[English caption]\end{figure}
}
\TEST{开关关死时按单语排}{
  \hitsetup{style={bilingual-caption=false}}
  \begin{figure}\caption{中文题}[English caption]\end{figure}
  \hitsetup{style={bilingual-caption=true}}
}
\TEST{bicaption 三参数旧写法转成双语}{
  \begin{figure}\bicaption[l3]{三参数}{Three args}\end{figure}
}
\END
\end{document}
