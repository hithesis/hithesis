% 摘要环境改名之后旧名还能用。
% cabstract / eabstract 在 v3.1e 就是公开环境名，改成 abstract-zh / abstract-en
% 之后旧名保留到 v4.1：仍然可用，用一次提示一次。
%
% 断言的是收集到的正文，不是提示文案——文案改了不该让测试红。
\input{regression-test}
\documentclass[fontset=fandol,degree-level=doctor,campus=harbin]{hit-thesis}
\begin{document}
\START
\begin{abstract-zh}新名收到的中文摘要\end{abstract-zh}
\begin{eabstract}旧名收到的英文摘要\end{eabstract}
\makeatletter
\TEST{新名与旧名都存进了同一处}{
  \typeout{zh=[\hit@abstract@zh]}
  \typeout{en=[\hit@abstract@en]}
}
\makeatother
\END
\end{document}
