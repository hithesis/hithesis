% 老写法的摘要环境还能用。
% cabstract / eabstract 在 v3.1e 就是公开环境名。新写法是 abstract 环境，写在哪就在哪排；
% 旧名只给老写法的 \makecover 收正文，保留到 v4：仍然可用，用一次提示一次。
%
% 断言的是收集到的正文，不是提示文案——文案改了不该让测试红。
\input{regression-test}
\documentclass[fontset=fandol,degree-level=doctor,campus=harbin]{hithesis}
\begin{document}
\START
\begin{cabstract}旧名收到的中文摘要\end{cabstract}
\begin{eabstract}旧名收到的英文摘要\end{eabstract}
\makeatletter
\TEST{两个旧名各存一处}{
  \typeout{zh=[\hit@abstract@zh]}
  \typeout{en=[\hit@abstract@en]}
}
\makeatother
\END
\end{document}
