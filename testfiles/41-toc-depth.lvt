% 目录排到第几级。
%
% 原先是布尔选项 tocfour，开就是四级、关就是三级。级数本来就是个数，做成开关
% 只是因为规范里只用到两档。v3.2a 改名 toc/depth，直接写级数。
%
% 顺带钉住三件事。旧名 tocfour 仍然管用，true 当 4、false 当 3；tocblank 已经
% 废弃，写了只提示不做事；这个键写在导言区就生效——原先 \setcounter{tocdepth}
% 跟着类文件走，那时候 \hitsetup 还没执行，写了不起作用。
%
% \ExplSyntaxOn 写进 \TEST 的花括号参数是空操作，参数在那之前就记号化完了，
% 所以带下划线的名字要先在导言区包一层，这条坑 08-book-option-defaults 里也踩过。
\input{regression-test}
\documentclass[fontset=fandol,degree-level=doctor,campus=harbin]{hithesis}
\ExplSyntaxOn
\cs_new:Npn \hitshowtocdepth { \int_use:N \g__hit_toc_depth_int }
\ExplSyntaxOff
\begin{document}
\START
\makeatletter
\TEST{默认三级}{
  \typeout{toc-depth=\hitshowtocdepth}
  \typeout{tocdepth=\the\c@tocdepth}
}
\TEST{导言区之后写四级也改得到}{
  \hitsetup{ toc = { depth = 4 } }
  \typeout{toc-depth=\hitshowtocdepth}
}
\TEST{旧名 tocfour 当四级}{
  \hitsetup{ tocfour = true }
  \typeout{toc-depth=\hitshowtocdepth}
}
\TEST{旧名 tocfour=false 当三级}{
  \hitsetup{ tocfour = false }
  \typeout{toc-depth=\hitshowtocdepth}
}
\TEST{tocblank 已废弃，认这个键但什么也不做}{
  \hitsetup{ tocblank = true }
  \typeout{还活着}
}
\makeatother
\END
\end{document}
