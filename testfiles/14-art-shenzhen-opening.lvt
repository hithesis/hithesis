% 深圳本科选项、嵌套/扁平元信息兼容和字体条件闭合。
\input{regression-test}
\documentclass[fontset=fandol,type=bachelor,stage=opening,campus=shenzhen]{hithesisart}
\begin{document}
\START
\makeatletter
\TEST{Shenzhen bachelor defaults}{
  \typeout{szbachelor=\ifhit@szbachelor true\else false\fi}
  \typeout{shenzhenfonts=\ifhit@shenzhenfonts true\else false\fi}
  \typeout{reporttype=\hit@reporttype}
  \typeout{tocdepth=\the\c@tocdepth}
}
\TEST{Nested cover selection and reset}{
  \hitsetup{info={reporttype=thesis}}
  \typeout{reporttype=\hit@reporttype}
  \hitsetup{info={reporttype=design}}
  \typeout{reporttype=\hit@reporttype}
  \hitsetup{info={reporttype=none}}
  \typeout{reporttype=\hit@reporttype}
}
\ExplSyntaxOn
\msg_redirect_name:nnn { hithesis } { flat-info } { none }
\ExplSyntaxOff
\TEST{Legacy flat cover selection}{
  \hitsetup{reporttype=thesis}
  \typeout{reporttype=\hit@reporttype}
}
\TEST{Font size keeps conditionals balanced}{
  \edef\beforelevel{\the\currentiflevel}
  \normalsize\normalsize
  \typeout{ifdelta=\number\numexpr\currentiflevel-\beforelevel\relax}
  \typeout{baselineskip=\the\baselineskip}
}
\makeatother
\END
\end{document}
