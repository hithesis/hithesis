\input{regression-test}
\documentclass[fontset=fandol]{hithesis}
\begin{document}
\START
\ExplSyntaxOn
\TEST{Part~titles~and~column~titles}{
  \hitsetup{overrides={
    references={title={文献}[References]},index={title={查索}[Index]},
    table-of-contents={title={目次}[Contents]},
    defense={title={答辩页}[Defense],column-title={职称}}
  }}
  \TYPE{bibliography=\bibname;index=\indexname;toc=\contentsname}
  \TYPE{defense=\use:c{hit@term@resolution@heading@zh};column=\use:c{hit@term@resolution@title}}
  \hitsetup{overrides={resolution-title={职位}}}
  \TYPE{legacy-column=\use:c{hit@term@resolution@title};defense=\use:c{hit@term@resolution@heading@zh}}
}
\TEST{List~names~inherit~but~can~be~overridden}{
  \hitsetup{overrides={caption={figure={照片}[Photo],table={表格}[Table]}}}
  \TYPE{figure-list=\__hit_list_entry_name:n{figure};table-list=\__hit_list_entry_name:n{table}}
  \hitsetup{overrides={list-of-figures={image={插图}[Illustration]},list-of-equations={equation={公式条目}[Equation]}}}
  \TYPE{figure-list=\__hit_list_entry_name:n{figure};caption=\figurename}
  \TYPE{equation-list=\__hit_list_entry_name:n{equation};reference=\equationautorefname}
}
\TEST{Imprint~and~report~title~labels}{
  \hitsetup{overrides={cover={imprint={学校制},
    document-type={报告}[Report],title={题目}[Title],
    report-imprint-shenzhen={教务部制}[Office]}}}
  \TYPE{imprint=\use:c{hit@term@cover@bottommark}}
  \TYPE{report=\use:c{hit@term@cover@document@type@zh};label=\use:c{hit@term@cover@title@zh};imprint=\use:c{hit@term@cover@report@bottommark@shenzhen@zh}}
  \hitsetup{overrides={cover={title={新题目}[New~title]}}}
  \TYPE{updated-label=\use:c{hit@term@cover@title@zh};report=\use:c{hit@term@cover@document@type@zh}}
}
\ExplSyntaxOff
\END
\end{document}
