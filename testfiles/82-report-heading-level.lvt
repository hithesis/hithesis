% 报告的标题层级：正文第一个编号标题所在的那一级是顶级。从 \chapter 起的，
% \chapter 排成节、\section 排成条、\subsection 排成款，\subsubsection 落在款以下报错；
% \paragraph 在新版面下一律报错。
%
% 断言的是编号形态与报错，不是排出来的样子。
\input{regression-test}
\documentclass[fontset=fandol,degree-level=master,campus=harbin,stage=proposal]{hithesis}
\begin{document}
\START
\makeatletter
\chapter{顶级}
\TEST{从 chapter 起，chapter 是节}{
  \typeout{chapter=[\thesection] chapter-counter=[\the\c@chapter]}
}
\section{第二级}
\TEST{section 是条}{
  \typeout{section=[\thesubsection]}
}
\subsection{第三级}
\TEST{subsection 是款}{
  \typeout{subsection=[\thesubsubsection]}
}
\TEST{subsubsection 落在款以下，报错}{
  \subsubsection{第四级}
}
\TEST{paragraph 报错}{
  \paragraph{段}
}
\makeatother
\END
\end{document}
