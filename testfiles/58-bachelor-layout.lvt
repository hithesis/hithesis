% 本科的新版面：hit-defaults 里那份哈深本科配置算出来的版心与正文参数。
%
% 断言的数都来自“本科毕业论文书写范例（理工类）”，来路记在 src/setup/hit-defaults.dtx。
% 版心宽 = 210mm - 2*85.05bp，高 = 297mm - 107.75bp - 85.05bp；正文行距
% 1.25*1.297*12bp = 19.455bp；首行基线 1.0156*12bp = 12.1872bp；
% 首行缩进 2*12.6719bp = 25.34bp；字距胶 12.6719bp - 12bp = 0.6719bp。
% 网格余量只在纵向也对齐时才整段发给 rightskip；正文的横轴自 9d7710e 起是
% true（范例 docGrid charSpace=1861 实测），纵轴仍是 false，所以 rightskip
% 拿到的是每字的网格胶而不是零。
%
% 第二组换 v2-layout={bachelor=true}，退回 v3.1e 的版心，正文那几个量一个不设。
\input{regression-test}
\documentclass[fontset=fandol,degree-level=bachelor,campus=harbin]{hit-thesis}
\begin{document}
\START
\makeatletter
\ExplSyntaxOn
\TEST{new~layout~geometry}{
  \iow_term:x { textwidth = \dim_use:N \textwidth }
  \iow_term:x { textheight = \dim_use:N \textheight }
  \iow_term:x { headheight = \dim_use:N \headheight }
  \iow_term:x { headsep = \dim_use:N \headsep }
  \iow_term:x { footskip = \dim_use:N \footskip }
}
\TEST{new~layout~reserve}{
  \iow_term:x { 行深 = \dim_use:N \hit@body@depth }
  \iow_term:x { colht = \dim_use:N \@colht }
  \iow_term:x { colroom = \dim_use:N \@colroom }
  \iow_term:x { vsize = \dim_use:N \vsize }
  \iow_term:x { maxdepth = \dim_use:N \maxdepth }
}
% Word 的 Normal 样式 widowControl=0，孤行寡行控制全程关闭，四个罚分跟着归零。
% clubpenalty 之后会被 \@afterheading 改成 1，这里量的是第一个标题之前的值。
\TEST{new~layout~penalties}{
  \iow_term:x { clubpenalty = \int_use:N \clubpenalty }
  \iow_term:x { widowpenalty = \int_use:N \widowpenalty }
  \iow_term:x { displaywidowpenalty = \int_use:N \displaywidowpenalty }
  \iow_term:x { brokenpenalty = \int_use:N \brokenpenalty }
}
\TEST{new~layout~body}{
  \iow_term:x { 网格行距 = \dim_use:N \g_hit_msword_lead_dim }
  \iow_term:x { 网格字距 = \dim_use:N \g_hit_msword_char_dim }
  \iow_term:x { 正文行距 = \dim_use:N \g_hit_body_lead_dim }
  \iow_term:x { 首行基线 = \dim_use:N \topskip }
  \iow_term:x { 首行缩进 = \dim_use:N \parindent }
  \iow_term:x { 字距胶 = \dim_eval:n { \g_hit_msword_char_dim - \g_hit_body_size_dim } }
  \hit@format@slack:
  \iow_term:x { 网格余量 = \dim_use:N \g_hit_msword_slack_dim }
  \iow_term:x { rightskip = \skip_use:N \rightskip }
}
\cs_new_protected:Npn \LEVEL #1
  {
    \hit@format@compute:n {#1}
    \iow_term:x
      {
        #1 ~ 行距 = \dim_use:N \l_hit_format_lead_dim
        ~ 首行 = \dim_use:N \l_hit_format_first_dim
        ~ 段前 = \dim_use:N \l_hit_format_before_dim
        ~ 段后 = \dim_use:N \l_hit_format_after_dim
      }
  }
\TEST{new~layout~headings}{
  \LEVEL{chapter} \LEVEL{section}
  \LEVEL{subsection} \LEVEL{subsubsection}
}
\ExplSyntaxOff
\makeatother
\END
\end{document}
