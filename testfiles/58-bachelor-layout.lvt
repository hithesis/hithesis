% 本科的新版面：hit-defaults 里那份哈深本科配置算出来的版心与正文参数。
%
% 断言的数都来自“本科毕业论文书写范例（理工类）”，来路记在 src/setup/hit-defaults.dtx。
% 版心宽 = 210mm - 2*85.05bp，高 = 297mm - 107.75bp - 85.05bp；正文行距
% 1.25*1.297*12bp = 19.455bp；首行基线 1.0156*12bp = 12.1872bp；
% 首行缩进 2*12.675bp = 25.35bp；字距胶 12.675bp - 12bp = 0.675bp。
%
% 第二组换 old-layout={bachelor=true}，退回 v3.1e 的版心，正文那几个量一个不设。
\input{regression-test}
\documentclass[fontset=fandol,degree-level=bachelor,campus=harbin]{hit-thesis}
\begin{document}
\START
\makeatletter
\ExplSyntaxOn
\TEST{new~layout~geometry}{
  \iow_term:x { textwidth = \dim_use:N \textwidth }
  \iow_term:x { textheight = \dim_use:N \textheight }
  \iow_term:x { headheight = \dim_use:N \headheight }
  \iow_term:x { headsep = \dim_use:N \headsep }
  \iow_term:x { footskip = \dim_use:N \footskip }
}
\TEST{new~layout~body}{
  \iow_term:x { 网格行距 = \dim_use:N \g_hit_msword_lead_dim }
  \iow_term:x { 网格字距 = \dim_use:N \g_hit_msword_char_dim }
  \iow_term:x { 正文行距 = \dim_use:N \g_hit_body_lead_dim }
  \iow_term:x { 首行基线 = \dim_use:N \topskip }
  \iow_term:x { 首行缩进 = \dim_use:N \parindent }
  \iow_term:x { 字距胶 = \dim_use:N \g_hit_msword_glue_dim }
}
\cs_new_protected:Npn \LEVEL #1
  {
    \hit@format@compute:n {#1}
    \iow_term:x
      {
        #1 ~ 行距 = \dim_use:N \l_hit_format_lead_dim
        ~ 首行 = \dim_use:N \l_hit_format_first_dim
        ~ 段前 = \dim_use:N \l_hit_format_before_dim
        ~ 段后 = \dim_use:N \l_hit_format_after_dim
      }
  }
\TEST{new~layout~headings}{
  \LEVEL{chapter} \LEVEL{section}
  \LEVEL{subsection} \LEVEL{subsubsection}
}
\ExplSyntaxOff
\makeatother
\END
\end{document}
