% hithesisartplus 的元信息字段，与 06 互为镜像。
% ctitleone / ctitletwo / cenrolldate 是 artplus 独有，ctype 是 art 独有。
% 两个文件一起才能证明这两份字段清单没有互相渗漏。
\input{regression-test}
\documentclass[fontset=fandol,type=doctor,stage=midterm,campus=shenzhen]{hithesisartplus}
\hitsetup{
  ctitleone={测试标题上行},
  ctitletwo={测试标题下行},
  cenrolldate={2026 年 9 月},
}
\begin{document}
\START
\makeatletter
\TEST{阶段标志位}{
  \show\ifhit@opening
  \show\ifhit@midterm
}
\TEST{artplus 独有的字段}{
  \show\hit@ctitleone
  \show\hit@ctitletwo
  \show\hit@cenrolldate
}
\TEST{art 的字段不该出现在 artplus 里}{
  \show\hit@ctype
}
\makeatother
\END
\end{document}
