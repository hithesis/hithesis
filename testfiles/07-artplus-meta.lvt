% hithesisartplus 的元信息字段，与 06 互为镜像。两个文件一起才能证明这两份
% 字段清单没有互相渗漏。
\input{regression-test}
\documentclass[fontset=fandol,type=doctor,stage=midterm,campus=shenzhen]{hithesisartplus}
\hitsetup{
  ctitleone={测试标题上行},
  ctitletwo={测试标题下行},
  cenrolldate={2026 年 9 月},
}
\begin{document}
\START
\makeatletter
\TEST{生效的阶段}{
  \typeout{stage=\ifhit@opening opening\else
                 \ifhit@midterm midterm\else none\fi\fi}
}
\TEST{artplus 独有字段的取值}{
  \typeout{ctitleone=[\hit@ctitleone]}
  \typeout{ctitletwo=[\hit@ctitletwo]}
  \typeout{cenrolldate=[\hit@cenrolldate]}
}
\TEST{art 的字段不该出现在 artplus 里}{
  \typeout{ctype=\ifdefined\hit@ctype LEAKED\else absent\fi}
}
\makeatother
\END
\end{document}
