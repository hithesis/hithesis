% hithesisartplus 现在只是个转发到 hithesisart 的空壳，深圳博士中期是
% campus=shenzhen,degree-level=doctor,kind=interim 这一格。这里钉的是空壳本身：
%
%   1. 不带任何选项也能编——空壳先补齐三个选项再转发，老文档里 \documentclass
%      不写选项的写法也接得住
%   2. 三个选项组合出来的判断确实选中了深圳博士中期这一格
%   3. 深圳博士中期用到的字段照旧收得到值
%
% 空壳在 v4.1（2027 年主要版本）移除，届时整份测试一起删。
\input{regression-test}
\documentclass{hithesisartplus}
\hitsetup{ info = {
  zh = { title = {测试标题上行}{测试标题下行} },
  enroll-date-zh = {2026-09},
} }
\begin{document}
\START
\makeatletter
\TEST{空壳补齐的三个选项}{
  \typeout{campus=\hit@if@option@TF{shenzhen}{shenzhen}{\hit@if@option@TF{harbin}{harbin}{\hit@if@option@TF{weihai}{weihai}{none}}}}
  \typeout{type=\hit@if@option@TF{doctor}{doctor}{\hit@if@option@TF{master}{master}{\hit@if@option@TF{bachelor}{bachelor}{none}}}}
  \typeout{stage=\hit@if@option@TF{proposal}{proposal}{\hit@if@option@TF{interim}{interim}{none}}}
}
\TEST{组合判断选中了深圳博士中期}{
  \typeout{combination=\hit@if@shenzhen@doctor@interim@TF{hit}{miss}}
}
\TEST{深圳博士中期的字段取值}{
  \typeout{title-line-one-zh=[\hit@title@line@one@zh]}
  \typeout{title-line-two-zh=[\hit@title@line@two@zh]}
% 日期字段的取值是个格式化的宏，\typeout 打不开它，所以查存进去的原值。
  % 排出来长什么样归 53-date-iso 管。
  \typeout{enroll-date-zh=[\hit@enroll@date@zh@raw]}
}
\makeatother
\END
\end{document}
