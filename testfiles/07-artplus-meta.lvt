% 深圳博士中期的选项组合与元信息回归；版式暂沿用同阶段硕士模板。
\input{regression-test}
\documentclass[degree-level=doctor,campus=shenzhen,stage=interim]{hithesis}
\hitsetup{ info = {
  title = {测试标题上行}{测试标题下行},
  enroll-date-zh = {2026-09},
} }
\begin{document}
\START
\makeatletter
\TEST{空壳补齐的三个选项}{
  \typeout{campus=\hit@if@option@TF{shenzhen}{shenzhen}{\hit@if@option@TF{harbin}{harbin}{\hit@if@option@TF{weihai}{weihai}{none}}}}
  \typeout{type=\hit@if@option@TF{doctor}{doctor}{\hit@if@option@TF{master}{master}{\hit@if@option@TF{bachelor}{bachelor}{none}}}}
  \typeout{stage=\hit@if@option@TF{proposal}{proposal}{\hit@if@option@TF{interim}{interim}{none}}}
}
\TEST{组合判断选中了深圳博士中期}{
  \typeout{combination=\hit@if@option@TF{shenzhen}{\hit@if@option@TF{doctor}{\hit@if@option@TF{interim}{hit}{miss}}{miss}}{miss}}
}
\TEST{深圳博士中期的字段取值}{
  \typeout{title-line-one-zh=[\hit@info@title@line@one@zh]}
  \typeout{title-line-two-zh=[\hit@info@title@line@two@zh]}
% 日期字段的取值是个格式化的宏，\typeout 打不开它，所以查存进去的原值。
  % 排出来长什么样归 53-date-iso 管。
  \typeout{enroll-date-zh=[\hit@info@enroll@date@zh@raw]}
}
\makeatother
\END
\end{document}
