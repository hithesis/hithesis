% hithesisartplus 的元信息字段，与 06 互为镜像。两个文件一起才能证明这两份
% 字段清单没有互相渗漏。
\input{regression-test}
\documentclass[fontset=fandol,type=doctor,stage=midterm,campus=shenzhen]{hithesisartplus}
\hitsetup{
  title-line-one-cn={测试标题上行},
  title-line-two-cn={测试标题下行},
  enroll-date-cn={2026 年 9 月},
}
\begin{document}
\START
\makeatletter
\TEST{生效的阶段}{
  \typeout{stage=\hit@if@option@TF{opening}{opening}{\hit@if@option@TF{midterm}{midterm}{none}}}
}
\TEST{artplus 独有字段的取值}{
  \typeout{title-line-one-cn=[\hit@title@line@one@cn]}
  \typeout{title-line-two-cn=[\hit@title@line@two@cn]}
  \typeout{enroll-date-cn=[\hit@enroll@date@cn]}
}
\TEST{art 的字段不该出现在 artplus 里}{
  \typeout{report-type-cn=\ifdefined\hit@report@type@cn LEAKED\else absent\fi}
}
\makeatother
\END
\end{document}
