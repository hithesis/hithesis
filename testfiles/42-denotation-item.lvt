% denotation 收成 \item 列表，旧写法照常编译但提示加星号。
%
% 环境认不出用户要哪一种版式，靠探正文第一个记号：是 \item 就开 enumitem 列表，
% 不是就当旧写法，只出标题和表号，正文原样排。
%
% 四种情形：
%   一、\item 开头，开列表，不提示；
%   二、\begin{denotation} 后面先空一行再 \item，空行产生的 \par 要先吃掉，
%       否则会被误判成旧写法（这条是探测实现里最容易写错的地方）；
%   三、正文直接写表格，不开列表，提示一次；
%   四、denotation* 不探测，也不提示。
%
% 断言 \g__hit_denotation_list_bool：真表示开了列表。提示本身会进日志，tlg 里能看到
% 情形三有、情形一二四没有。
\input{regression-test}
\documentclass[fontset=fandol,degree-level=doctor,campus=harbin]{hithesis}
\begin{document}
\START
\ExplSyntaxOn
\TEST{item开头开列表}{
  \begin{denotation}
  \item[$R$] 实数集
  \end{denotation}
  \typeout{开列表=\bool_if:NTF \g__hit_denotation_list_bool {是}{否}}
}
\TEST{先空一行再item也认}{
  \begin{denotation}

  \item[$R$] 实数集
  \end{denotation}
  \typeout{开列表=\bool_if:NTF \g__hit_denotation_list_bool {是}{否}}
}
\TEST{旧写法照常排并提示}{
  \begin{denotation}
  \begin{tabular}{cc}
  量的名称 & 单位符号\\
  频率 & Hz\\
  \end{tabular}
  \end{denotation}
  \typeout{开列表=\bool_if:NTF \g__hit_denotation_list_bool {是}{否}}
}
\TEST{星号版不探测不提示}{
  \begin{denotation*}
  \begin{tabular}{cc}
  量的名称 & 单位符号\\
  频率 & Hz\\
  \end{tabular}
  \end{denotation*}
  \typeout{开列表=\bool_if:NTF \g__hit_denotation_list_bool {是}{否}}
}
\TEST{可选参数改第一列宽度}{
  \begin{denotation}[4cm]
  \item[$R$] 实数集
  \end{denotation}
  \typeout{宽度=\tl_use:N \g__hit_denotation_width_tl}
}
\ExplSyntaxOff
\END
\end{document}
