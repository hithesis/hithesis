% lang 选项。取值 zh 与 en，与字段后缀 -zh/-en 用同一套写法。
%
% 42 变体里英文版走的是 lang=en，但变体只比对最终 PDF，选项名或取值改错时
% 报错信息淹在编译日志里，这里把解析结果直接钉住。
%
% 断言两件事：一是 lang=en 选中英文、中文标志位同时关掉；二是 lang 不写时默认中文。
% 默认值那条放在同一份文档里试不了（选项只能在 \documentclass 写一次），
% 所以只测显式取值，默认值由 01-options 那份不带 lang 的文档顺带覆盖。
\input{regression-test}
\documentclass[fontset=fandol,degree-level=master,campus=shenzhen,lang=en]{hit-thesis}
\begin{document}
\START
\makeatletter
\TEST{lang=en 选中英文}{
  \typeout{lang=\hit@if@option@TF{en}{en}{\hit@if@option@TF{zh}{zh}{none}}}
  \typeout{en-and-zh-both-on=\hit@if@both@options@TF{en}{zh}{yes}{no}}
}
\makeatother
\END
\end{document}
