% 派发类 hithesis.cls：不写 kind 时按学位论文算。
%
% 派发类得在 \LoadClass 之前把 kind 读出来，读的是 \@classoptionslist 而不是
% l3keys——那时候还没有类可以挂键。断言装上的确实是 hit-thesis：\resolution
% 只有学位论文类有，\chapter 只有 ctexbook 有。同时确认 kind 之外的选项照常转发。
\input{regression-test}
\documentclass[fontset=fandol,degree-level=doctor,campus=harbin]{hithesis}
\begin{document}
\START
\makeatletter
\TEST{不写 kind 装的是学位论文类}{
  \typeout{resolution=\ifdefined\resolution 有\else 无\fi}
  \typeout{chapter=\ifdefined\chapter 有\else 无\fi}
}
\TEST{其余选项照常转发}{
  \typeout{doctor=\hit@if@option@TF{doctor}{yes}{no}}
  \typeout{harbin=\hit@if@option@TF{harbin}{yes}{no}}
}
\makeatother
\END
\end{document}
