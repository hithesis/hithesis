% bm 跟 unicode-math 的补救钩子。
%
% v3.1e 的 hithesis.sty 里 \RequirePackage{bm} 没有条件。用户升级后自己那份照旧
% 优先加载，而 bm 跟 v3.2a 默认的 unicode-math 不兼容：它把 \boldsymbol 换成只认
% 8 位 mathchar 的版本，公式里一出现希腊字母就报 Extended mathchar used as
% mathchar，完整示例实测 70 个。
%
% 类里挂了 package/bm/after 钩子，bm 真被装上时把 \bm 与 \boldsymbol 接回
% unicode-math 自己的 \symbf。
%
% 断言的是“接上了没有”，不是 \meaning 的展开，也不真排公式：\meaning 会把
% unicode-math 的内部名钉进基线，真排公式会把数学字体的加载日志卷进来，两样都
% 跨版本不稳（同样的理由见 21-legacy-document.lvt）。接上了就等于能排，\symbf
% 本身是 unicode-math 自己的命令。
%
% 提示文案不断言，文案改了不该让测试红。
\input{regression-test}
\documentclass[fontset=fandol,degree-level=doctor,campus=harbin]{hit-thesis}
\usepackage{bm}
\begin{document}
\START
\TEST{bm 与 boldsymbol 都接到了 symbf}{
  \typeout{bm=\ifx\bm\symbf 是\else 否\fi}
  \typeout{boldsymbol=\ifx\boldsymbol\symbf 是\else 否\fi}
}
\END
\end{document}
