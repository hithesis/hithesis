\input{regression-test}
\documentclass[stage=proposal,degree-level=master,fontset=fandol]{hithesis}
\ExplSyntaxOn\msg_redirect_module:nnn{fontspec}{info}{none}\ExplSyntaxOff
\begin{document}
\START
\ExplSyntaxOn
\TEST{OOXML~noColumnBalance~fills~columns~and~moves~the~next~section}{
  \TYPE{default-no-balance=\bool_if:NTF\g__docxlike_cols_no_balance_bool{true}{false}}
  \docxlikesetup{no-column-balance}
  \sectionbreak[continuous,columns={number-of-columns=3}]
  \hbox:n{First~column~body}
  \sectionbreak[continuous,columns={number-of-columns=1}]
  \TYPE{page-after-unbalanced=\thepage}
  \TYPE{new-section=\int_use:N\g_docxlike_section_int}
  \TYPE{columns-closed=\bool_if:NTF\g__docxlike_cols_open_bool{no}{yes}}
}
\TEST{Disabling~noColumnBalance~keeps~continuous~sections~on~the~page}{
  \docxlikesetup{no-column-balance=false}
  \sectionbreak[continuous,columns={number-of-columns=2}]
  \hbox:n{Balanced~column~body}
  \sectionbreak[continuous,columns={number-of-columns=1}]
  \TYPE{page-after-balanced=\thepage}
  \TYPE{new-section=\int_use:N\g_docxlike_section_int}
  \TYPE{columns-closed=\bool_if:NTF\g__docxlike_cols_open_bool{no}{yes}}
}
\ExplSyntaxOff
\END
\end{document}
