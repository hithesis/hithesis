% 专业学位实践成果的类别文本，以及外封局部参数的生效范围。
\input{regression-test}
\documentclass[fontset=fandol,degree-level=master,degree-type=professional,form=practice]{hithesis}
\begin{document}
\START
\makeatletter
\ExplSyntaxOn
\cs_set_protected:Npn \docxlike_format_par:nn #1#2
  { \str_if_eq:nnT {#1} { cover-type } { \typeout{cover=[#2]} } }
\cs_set_protected:Npn \docxlike_format_par:nnn #1#2#3 { }
\cs_set_protected:Npn \hit@cover@blank@zh:n #1 { }
\cs_set_protected:Npn \hit@cover@blank@en:n #1 { }
\cs_set_protected:Npn \__hit_cover_part:
  { \hit@cover@upto@en:nn { erhao } { 2 } }
\TEST{Default~practice~type}{
  \typeout{field=[\hit@info@practice@type]}
  \typeout{academic=[\hit@term@degree@type@academic@zh]}
  \hit@cover@upto@en:nn { erhao } { 2 }
}
\TEST{Global~field~updates~the~cover}{
  \hitsetup{info/practice-type={工程设计}}
  \hit@cover@upto@en:nn { erhao } { 2 }
}
\TEST{Dissertation~does~not~use~practice~type}{
  \hitsetup{form=dissertation}
  \hit@cover@upto@en:nn { erhao } { 2 }
  \hitsetup{form=practice}
}
\TEST{Cover~override~does~not~change~global~info}{
  \cover[practice-type={产品研发}]
  \typeout{global=[\hit@info@practice@type]}
  \typeout{after=[\hit@cover@practice@type]}
}
\TEST{Skipped~cover~also~discards~its~override}{
  \cover[shown=false,practice-type={Skipped}]
  \typeout{after=[\hit@cover@practice@type]}
}
\TEST{Explicit~category~text~still~wins}{
  \hitsetup{overrides={degree-type={自定类别}}}
  \hit@cover@upto@en:nn { erhao } { 2 }
}
\ExplSyntaxOff
\makeatother
\END
\end{document}
