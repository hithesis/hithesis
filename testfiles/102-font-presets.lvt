\documentclass[fontset=fandol]{hithesis}
\begin{document}
\START
\ExplSyntaxOn
\TEST{Font~preset~roles~and~inheritance}{
  \clist_map_inline:nn{windows,macos,founder,noto,fandol}{
    \prop_gclear:N\g__hit_font_roles_prop
    \__hit_font_preset_overlay:n{windows}
    \__hit_font_preset_overlay:n{#1}
    \typeout{preset=#1}
    \typeout{songti=\prop_item:Nn\g__hit_font_roles_prop{songti}}
    \typeout{kaishu=\prop_item:Nn\g__hit_font_roles_prop{kaishu}}
    \typeout{fangsong=\prop_item:Nn\g__hit_font_roles_prop{fangsong}}
    \typeout{mono=\prop_item:Nn\g__hit_font_roles_prop{mono}}
    \typeout{math=\prop_item:Nn\g__hit_font_roles_prop{math}}
    \typeout{inherited-lishu=\prop_item:Nn\g__hit_font_roles_prop{lishu}}
  }
}
\ExplSyntaxOff
\END
