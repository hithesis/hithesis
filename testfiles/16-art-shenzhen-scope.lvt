% 深圳字体开关不得改变其他校区；无需安装微软字体也应能通过。
\input{regression-test}
\documentclass[fontset=fandol,shenzhenfonts=true,type=bachelor,stage=opening,campus=harbin]{hithesisart}
\hitsetup{info={reporttype=design}}
\begin{document}
\START
\makeatletter
\TEST{Other campuses retain their layout}{
  \typeout{szbachelor=\ifhit@szbachelor true\else false\fi}
  \typeout{shenzhenfonts=\ifhit@shenzhenfonts true\else false\fi}
  \typeout{reporttype=\hit@reporttype}
  \typeout{szcover=\ifdefined\hit@szbachelor@cover LEAKED\else absent\fi}
  \edef\beforelevel{\the\currentiflevel}
  \normalsize\normalsize
  \typeout{ifdelta=\number\numexpr\currentiflevel-\beforelevel\relax}
  \typeout{baselineskip=\the\baselineskip}
}
\makeatother
\END
\end{document}
