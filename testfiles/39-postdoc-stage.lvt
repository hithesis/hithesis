% degree-level=postdoc 定死 stage=final。
%
% stage 只有 final、proposal、interim 三个取值，degree-level 才有 postdoc。博士后只写研究
% 报告，没有开题与中期，所以这两个选项存在一个不可能的组合。原先写了会一路炸：
% 派发类照 stage 转给报告类，报告类的 degree-level 不接受 postdoc，报「选项 degree-level 不接受
% 取值 postdoc」，接着 \bool_lazy_or:nnF 参数不完整，最后连 \begin{document} 都丢，
% 一共 7 个错误。
%
% 现在 degree-level=postdoc 一出现就把 stage 拉回 final，stage 写什么都不看。旧名
% type=postdoc 同样管用。
%
% 断言的是落到了哪一档：final 那一档 \g__hit_final_bool 与 \g__hit_final_body_bool
% 都真、\g__hit_report_body_bool 假；\g__hit_postdoc_bool 造得出来。冲突提示不断言，
% 它在 \documentclass 时就发了，早于 \START，抓不到。
\input{regression-test}
\documentclass[fontset=fandol,stage=proposal,degree-level=postdoc,campus=harbin]{hithesis}
\begin{document}
\START
\ExplSyntaxOn
\TEST{冲突组合落到终稿那一档}{
  \typeout{final=\bool_if:NTF \g__hit_final_bool {是}{否}}
  \typeout{final-body=\bool_if:NTF \g__hit_final_body_bool {是}{否}}
  \typeout{report-body=\bool_if:NTF \g__hit_report_body_bool {是}{否}}
  \typeout{postdoc标志位=\cs_if_exist:NTF \g__hit_postdoc_bool {有}{没有}}
  \typeout{postdoc为真=\bool_if:NTF \g__hit_postdoc_bool {是}{否}}
}
\ExplSyntaxOff
\END
\end{document}
