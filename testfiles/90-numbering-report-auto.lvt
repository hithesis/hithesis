% 本部本科开题的 auto 是图表按节、公式连续，不能用一个统一默认值覆盖。
\input{regression-test}
\documentclass[fontset=fandol,degree-level=bachelor,campus=harbin,stage=proposal]{hithesis}
\begin{document}
\START
\makeatletter
\ExplSyntaxOn
\cs_new_protected:Npn \NEXT
  { \clist_map_inline:nn { figure , table , equation } { \stepcounter{##1} } }
\cs_new_protected:Npn \NUMBERS
  { \typeout{figure=[\thefigure],table=[\thetable],equation=[\theequation]} }
\TEST{Variant~defaults~are~unchanged}{
  \stepcounter{section}\NEXT\NUMBERS
  \stepcounter{section}\NEXT\NUMBERS
}
\TEST{Explicit~settings~override~them~independently}{
  \hitsetup{caption-numbering-by-top-level-heading=false,equation-numbering-by-top-level-heading=true}
  \stepcounter{section}\NEXT\NUMBERS
}
\TEST{Auto~restores~the~mixed~variant~defaults}{
  \hitsetup{caption-numbering-by-top-level-heading=auto,equation-numbering-by-top-level-heading=auto}
  \stepcounter{section}\NEXT\NUMBERS
}
\ExplSyntaxOff
\makeatother
\END
\end{document}
