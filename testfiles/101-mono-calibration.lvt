\cs_new_protected:Npn \mono_dim_check:nn #1#2
  {\typeout{#1=\dim_compare:nNnTF{\dim_abs:n{#2}}<{.002bp}{yes}{no}}}
\TEST{Substitute~mono~font~uses~target~advance}{
  {\fontsize{12bp}{18bp}\ttfamily\selectfont
    \mono_dim_check:nn{actual-size}{\fontdimen6\font-11bp}}
  \hbox_set:Nn \l_tmpa_box {\fontsize{12bp}{18bp}\selectfont\texttt{中}}
  \mono_dim_check:nn{cjk-code-width}{\box_wd:N\l_tmpa_box-11bp}
  \typeout{calibrated=\bool_if:NTF\g_docxlike_mono_calibrated_bool{yes}{no}}
}
\TEST{Listing~keeps~target~line~metrics}{
  \docxlikesetup{styles={Normal={paragraph={spacing={line-spacing=multiple,at=1.25}}}}}
  \__hit_listing_font:
  \mono_dim_check:nn{listing-size}{\fontdimen6\font-11bp}
  \mono_dim_check:nn{listing-lead}{\l__hit_listing_lead_dim-17.5635bp}
  \mono_dim_check:nn{listing-ascent}{\l__hit_listing_ascent_dim-11.0452bp}
  \docxlikesetup{styles={Normal={paragraph={spacing={line-spacing=exactly,at=20bp}}}}}
  \__hit_listing_metrics:
  \mono_dim_check:nn{exact-lead}{\l__hit_listing_lead_dim-20bp}
  \mono_dim_check:nn{exact-ascent}{\l__hit_listing_ascent_dim-16bp}
}
