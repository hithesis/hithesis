\input{regression-test}
\documentclass[fontset=fandol]{hithesis}
\begin{document}
\START
\ExplSyntaxOn
\TEST{Complete~document~type~and~independent~title~label}{
  \TYPE{default-type=\use:c{hit@term@cover@document@type@zh}}
  \hitsetup{info={title={研究题目}[Research~title]},overrides={cover={
    document-type={独立文种}[Custom~document],title={题目标签：}[Subject:]}}}
  \TYPE{cover-type=\use:c{hit@cover@document@name}}
  \TYPE{label=\use:c{hit@term@cover@title@zh}}
  \TYPE{research=\use:c{hit@info@title@first@zh}}
  \TYPE{english-type=\use:c{hit@term@cover@document@type@en}}
}
\TEST{Old~report~title~entries~are~absent}{
  \clist_map_inline:nn{cover-report-title,cover-final-title,cover-report-title-shenzhen,cover-sz-name,cover-sz-title}{
    \TYPE{#1=\prop_if_in:NnTF\c__hit_term_key_alias_prop{#1}{alias}{absent}}
  }
  \clist_map_inline:nn{cover-report-heading-shenzhen-zh,cover-report-title-label-shenzhen-zh,cover-title-prefix}{
    \TYPE{#1=\keys_if_exist:nnTF{hit/overrides-internal}{#1}{declared}{absent}}
  }
  \group_begin:
    \msg_redirect_name:nnn{hithesis}{unknown-key}{none}
    \hitsetup{overrides={cover={report-title={不得生效}},cover-sz-name={不得生效}}}
  \group_end:
  \TYPE{after-old-key=\use:c{hit@cover@document@name}}
}
\ExplSyntaxOff
\END
\end{document}
