% 部件变体：同一个部件按轴分档，挑哪一档与词条查表同一套规则。
%
% 基准就是不写档位值的那一条——学位轴的基准是博士、校区轴的基准是哈尔滨。
% 变体只写不一样的那一小坨，要接着用基准就调 \hit@hook@base:n。
%
% 这里钉三件事：挑得对、段数多的赢、变体里回调得到基准。
\input{regression-test}
\documentclass[fontset=fandol,degree-level=doctor,campus=shenzhen]{hithesis}
\makeatletter\ExplSyntaxOn
\hit@hook@new:nn { probe } { 基准 }
\hit@hook@new:nn { probe-shenzhen } { 深圳［\hit@hook@base:n {probe}］ }
\hit@hook@new:nn { probe-weihai } { 威海 }
\hit@hook@new:nn { solo-master } { 只有硕士那一档 }
\hit@hook@new:nn { deep } { 基准 }
\hit@hook@new:nn { deep-shenzhen } { 只看校区 }
\hit@hook@new:nn { deep-shenzhen-doctor } { 校区加学位 }
\hit@hook@resolve:
\ExplSyntaxOff\makeatother
\begin{document}
\START
\makeatletter\ExplSyntaxOn
\TEST{挑到校区那一档，且回调得到基准}{
  \typeout{probe=[\cs_meaning:c {hit@hook@probe}]}
}
\TEST{段数多的赢}{
  \typeout{deep=[\cs_meaning:c {hit@hook@deep}]}
  \typeout{deep-base=[\cs_meaning:c {hit@hook@deep@base}]}
}
\TEST{一档都没命中就不绑，裸名仍是基准}{
  \typeout{solo=[\cs_if_exist:cTF {hit@hook@solo} {绑了} {没绑}]}
}
\ExplSyntaxOff\makeatother
\END
\end{document}
