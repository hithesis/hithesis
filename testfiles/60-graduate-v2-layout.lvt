% v2-layout={graduate=one|two}：硕博退回 v3.1e 的两套版心，正文那几个量一个不设。
%
% two 是版心 236mm 高，one 是 240mm，两套都居中。网格行距为零表示压根没走过
% \hit@msword@layout:n，正文行距回到 20.50394bp。
\input{regression-test}
\documentclass[fontset=fandol,degree-level=master,campus=harbin,
               v2-layout={graduate=two}]{hit-thesis}
\begin{document}
\START
\makeatletter
\ExplSyntaxOn
\TEST{graduate~two}{
  \iow_term:x { v2-layout = \hit@if@option@TF{layout_two}{true}{false} }
  \iow_term:x { textwidth = \dim_use:N \textwidth }
  \iow_term:x { textheight = \dim_use:N \textheight }
  \iow_term:x { 网格行距 = \dim_use:N \g_hit_msword_lead_dim }
  \iow_term:x { 正文行距 = \dim_use:N \g_hit_body_lead_dim }
}
% 旧版面不留行深：colroom 与 colht 相等，maxdepth 是内核默认的 6pt。
% 旧版面不动罚分，仍是内核默认的 150/150/50/100。
\TEST{old~layout~penalties}{
  \iow_term:x { clubpenalty = \int_use:N \clubpenalty }
  \iow_term:x { widowpenalty = \int_use:N \widowpenalty }
  \iow_term:x { displaywidowpenalty = \int_use:N \displaywidowpenalty }
  \iow_term:x { brokenpenalty = \int_use:N \brokenpenalty }
}
\TEST{old~layout~no~reserve}{
  \iow_term:x { 行深 = \dim_use:N \hit@body@depth }
  \iow_term:x { colht = \dim_use:N \@colht }
  \iow_term:x { colroom = \dim_use:N \@colroom }
  \iow_term:x { maxdepth = \dim_use:N \maxdepth }
}
\ExplSyntaxOff
\makeatother
\END
\end{document}
