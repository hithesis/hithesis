% hithesisart 的阶段与元信息字段。art 与 artplus 各自定义了一份 \hit@def@term
% 和一份字段清单，守卫一旦被重构串线，一个类就会拿到另一个类的字段。这里连正面
% （该有的有）带反面（不该有的没有）一起钉住：ctype 是 art 独有，ctitleone 与
% cenrolldate 是 artplus 独有。07 是它的镜像。
%
% 断言字段的值与存在性，不断言存储方式。
\input{regression-test}
\documentclass[fontset=fandol,type=bachelor,stage=opening,campus=harbin]{hithesisart}
\hitsetup{
  ctype={开题报告},
  cauthor={张三},
}
\begin{document}
\START
\makeatletter
\TEST{生效的阶段}{
  \typeout{stage=\ifhit@opening opening\else
                 \ifhit@midterm midterm\else none\fi\fi}
}
\TEST{art 独有字段的取值}{
  \typeout{ctype=[\hit@ctype]}
  \typeout{cauthor=[\hit@cauthor]}
  \typeout{ctitlecover=[\hit@ctitlecover]}
}
\TEST{artplus 的字段不该出现在 art 里}{
  \typeout{ctitleone=\ifdefined\hit@ctitleone LEAKED\else absent\fi}
  \typeout{cenrolldate=\ifdefined\hit@cenrolldate LEAKED\else absent\fi}
}
\makeatother
\END
\end{document}
