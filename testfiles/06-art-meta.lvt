% hithesisart 的阶段与元信息字段。art 与 artplus 各自定义了一份 \hit@define@term
% 和一份字段清单，守卫一旦被重构串线，一个类就会拿到另一个类的字段。这里连正面
% （该有的有）带反面（不该有的没有）一起钉住：report-type-zh 是 art 独有，station-zh 与
% enroll-date-zh 是 artplus 独有。07 是它的镜像。
%
% 断言字段的值与存在性，不断言存储方式。
\input{regression-test}
\documentclass[fontset=fandol,type=bachelor,stage=opening,campus=harbin]{hithesisart}
\hitsetup{
  report-type-zh={开题报告},
  author-zh={张三},
}
\begin{document}
\START
\makeatletter
\TEST{生效的阶段}{
  \typeout{stage=\hit@if@option@TF{opening}{opening}{\hit@if@option@TF{midterm}{midterm}{none}}}
}
\TEST{art 独有字段的取值}{
  \typeout{report-type-zh=[\hit@report@type@zh]}
  \typeout{author-zh=[\hit@author@zh]}
  \typeout{title-zh=[\hit@title@cover@zh]}
}
\TEST{artplus 的字段不该出现在 art 里}{
  \typeout{station-zh=\ifdefined\hit@station@zh LEAKED\else absent\fi}
  \typeout{enroll-date-zh=\ifdefined\hit@enroll@date@zh LEAKED\else absent\fi}
}
\makeatother
\END
\end{document}
