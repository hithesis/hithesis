% hit-report 的阶段与元信息字段。深圳博士中期 v3.2a 并进本类之后，原先
% hit-reportplus 独有的 enroll-date-zh 也归本类，一份清单管十八格。
% 07 钉空壳那条转发路径。
%
% 两个键表在 v3.2a 合成一份之后，元信息字段是一整张表，两档共用。所以
% station-zh 这种终稿才印的字段在报告里也“在”，只是空着——这一条从
% “报告类不该有”改成“在但为空”，钉的是合并之后该有的样子：多出来的字段
% 不会凭空印出东西。
%
% 断言字段的值与存在性，不断言存储方式。
\input{regression-test}
\documentclass[fontset=fandol,degree-level=bachelor,stage=proposal,campus=harbin]{hithesis}
\hitsetup{
  report-type-zh={开题报告},
  author-zh={张三},
}
\begin{document}
\START
\makeatletter
\TEST{生效的阶段}{
  \typeout{stage=\hit@if@option@TF{proposal}{proposal}{\hit@if@option@TF{interim}{interim}{none}}}
}
\TEST{art 独有字段的取值}{
  \typeout{report-type-zh=[\hit@info@report@type@zh]}
  \typeout{author-zh=[\hit@info@author@zh]}
  \typeout{title-zh=[\hit@info@title@cover@zh]}
}
\TEST{深圳博士中期的字段并入本类}{
  \typeout{enroll-date-zh=\ifdefined\hit@info@enroll@date@zh present\else MISSING\fi}
}
\TEST{终稿才印的字段在报告里存在但为空}{
  \typeout{station-zh=\ifdefined\hit@info@station@zh present\else MISSING\fi}
  \typeout{station-zh-value=[\hit@info@station@zh]}
}
\makeatother
\END
\end{document}
