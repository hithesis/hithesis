% hithesisart 的阶段标志位与元信息字段。
% 前三个测试全是 hithesisbook，art 与 artplus 一个都没覆盖，而这两个类各自
% 定义了一份 \hit@def@term 和一份字段清单，guard 一旦被重构串线，一个类就会
% 拿到另一个类的字段。这里连正面（该有的有）带反面（不该有的没有）一起钉住：
% ctitlecover / ctype 是 art 独有，ctitleone 是 artplus 独有。
\input{regression-test}
\documentclass[fontset=fandol,type=bachelor,stage=opening,campus=harbin]{hithesisart}
\hitsetup{
  ctype={开题报告},
  cauthor={张三},
}
\begin{document}
\START
\makeatletter
\TEST{阶段标志位}{
  \show\ifhit@opening
  \show\ifhit@midterm
}
\TEST{art 独有的字段}{
  \show\hit@ctype
  \show\hit@cauthor
  \show\hit@ctitlecover
}
\TEST{artplus 的字段不该出现在 art 里}{
  \show\hit@ctitleone
  \show\hit@cenrolldate
}
\makeatother
\END
\end{document}
