% hithesisart 的阶段与元信息字段。深圳博士中期 v3.2a 并进本类之后，原先
% hithesisartplus 独有的 enroll-date-zh 也归本类，一份清单管十八格。这里连正面
% （该有的有）带反面（别的类的不该有）一起钉住：station-zh 是 hithesisbook 的字段，
% 报告类不该有。07 钉空壳那条转发路径。
%
% 断言字段的值与存在性，不断言存储方式。
\input{regression-test}
\documentclass[fontset=fandol,degree-level=bachelor,kind=proposal,campus=harbin]{hit-report}
\hitsetup{
  report-type-zh={开题报告},
  author-zh={张三},
}
\begin{document}
\START
\makeatletter
\TEST{生效的阶段}{
  \typeout{stage=\hit@if@option@TF{proposal}{proposal}{\hit@if@option@TF{interim}{interim}{none}}}
}
\TEST{art 独有字段的取值}{
  \typeout{report-type-zh=[\hit@report@type@zh]}
  \typeout{author-zh=[\hit@author@zh]}
  \typeout{title-zh=[\hit@title@cover@zh]}
}
\TEST{深圳博士中期的字段并入本类}{
  \typeout{enroll-date-zh=\ifdefined\hit@enroll@date@zh present\else MISSING\fi}
}
\TEST{毕业论文的字段不该出现在报告类里}{
  \typeout{station-zh=\ifdefined\hit@station@zh LEAKED\else absent\fi}
}
\makeatother
\END
\end{document}
