% v3.1e 写法的文档还能不能用。
% 兼容期要维持到 v4.1（2027 年主要版本），而 CI 里编的是现行示例，用的全是新写法，
% 兼容层断了不会有人发现。这里把 v3.1e 的各种写法凑成一份最小文档，钉住它们。
%
% 覆盖的五处：
%   1. \usepackage{hithesis}  这一行加载到的是示例宏包，跟 v3.1e 一样。
%   2. 元信息字段的旧名，扁平写法与同名命令两种都试
%   3. 常量键的旧名（cthesisname 之类没发布过，不该生效；这里试的是发布过的那批）
%   4. cabstract / eabstract 两个环境
%
% \bicaption 的三种旧写法在 20-caption.lvt 里钉，那边断言的是派发到哪个分支，
% 不用在浮动体里真排一遍——真排会把数学字体的加载日志卷进基线，跨版本不稳。
%
% 断言的是值与旧宏包给的命令在不在，不断言提示文案——文案改了不该让测试红。
\input{regression-test}
\documentclass[fontset=fandol,degree-level=doctor,campus=harbin]{hit-thesis}
\usepackage{hithesis}
\hitsetup{
  ctitle={旧名设的题目},
  ctitlecover={旧名设的封面题目},
  cauthor={张三},
  cxueke={工学},
  csubtitle={旧名设的副标题},
}
\makeatletter
\ctitleone{第一行}
\ctitletwo{第二行}
\makeatother
\begin{cabstract}旧环境收的中文摘要\end{cabstract}
\begin{eabstract}旧环境收的英文摘要\end{eabstract}
\begin{document}
\START
\makeatletter
\TEST{旧的 usepackage 那一行照旧有效}{
  \typeout{foocaption=\ifdefined\foocaption 有\else MISSING\fi}
  \typeout{rcell=\ifdefined\rcell 有\else MISSING\fi}
  \typeout{num=\ifdefined\num 有\else MISSING\fi}
}
\TEST{元信息字段的旧名还能设值}{
  \typeout{title-zh=[\hit@title@flat@zh]}
  \typeout{author-zh=[\hit@author@zh]}
  \typeout{discipline-zh=[\hit@discipline@zh]}
}
\TEST{ctitleone/ctitletwo 分别写进两格}{
  \typeout{first=[\hit@title@first@zh]}
  \typeout{second=[\hit@title@second@zh]}
}
\TEST{csubtitle 写进副标题格}{
  \typeout{subtitle=[\hit@title@subtitle@zh]}
}
\TEST{cabstract/eabstract 收到了正文}{
  \typeout{zh=[\hit@abstract@zh]}
  \typeout{en=[\hit@abstract@en]}
}
\makeatother
\END
\end{document}
