% degree-level 取值末尾的星号表示毕业设计：bachelor 勾毕业论文，bachelor* 勾毕业设计。
%
% 星号只影响毕业设计那个标志位，学位层次照旧。旧选项 design 仍然能用，写了提示一次。
\input{regression-test}
\documentclass[fontset=fandol,degree-level=bachelor*,campus=harbin]{hit-thesis}
\begin{document}
\START
\makeatletter
\ExplSyntaxOn
\cs_new_protected:Npn \FLAGS #1
  {
    \iow_term:x
      {
        #1 :~
        bachelor = \bool_if:NTF \g__hit_bachelor_bool { Y } { N } ~
        master = \bool_if:NTF \g__hit_master_bool { Y } { N } ~
        design = \bool_if:NTF \g__hit_design_bool { Y } { N }
      }
  }

\TEST{star means design}{ \FLAGS { bachelor-star } }

\TEST{no star means thesis}{
  \hitsetup{ degree-level = bachelor }
  \FLAGS { bachelor }
}

\TEST{star on another level leaves that level}{
  \hitsetup{ degree-level = master* }
  \FLAGS { master-star }
}

\TEST{old design option still works and warns}{
  \hitsetup{ degree-level = bachelor , design = true }
  \FLAGS { design-true }
}

\TEST{warned only once}{
  \hitsetup{ design = false }
  \FLAGS { design-false }
}
\ExplSyntaxOff
\makeatother
\END
\end{document}
