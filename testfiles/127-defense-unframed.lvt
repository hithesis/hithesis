\ExplSyntaxOn\msg_redirect_module:nnn{fontspec}{info}{none}\ExplSyntaxOff
\begin{document}
\START
\makeatletter
\ExplSyntaxOn
\cs_set_protected:Npn \__hit_resolution_framed: {\TYPE{selected=framed}}
\cs_set_protected:Npn \__hit_resolution_unframed: {\TYPE{selected=unframed}}
\cs_set_protected:Npn \hit@resolution@place {\__hit_resolution_sheet:}
\bool_if_exist:cF{g__hit_part_done_defense_bool}{\bool_new:c{g__hit_part_done_defense_bool}}
\cs_new_protected:Npn \ResetDefense {\bool_gset_false:c{g__hit_part_done_defense_bool}}
\TEST{Default~and~auto~preserve~the~framed~layout}{
  \ResetDefense\defense
  \ResetDefense\defense[unframed=auto]
}
\TEST{Bare~unframed~and~explicit~true~select~the~unframed~layout}{
  \ResetDefense\defense[unframed]
  \ResetDefense\defense[unframed=true]
}
\TEST{False~and~a~subsequent~default~restore~the~framed~layout}{
  \ResetDefense\defense[unframed=false]
  \ResetDefense\defense[unframed]
  \ResetDefense\defense
}
\ExplSyntaxOff
\makeatother
\END
