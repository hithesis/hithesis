\input{regression-test}
\documentclass[degree-level=doctor,fontset=fandol]{hithesis}
\ExplSyntaxOn\msg_redirect_module:nnn{fontspec}{info}{none}\ExplSyntaxOff
\begin{document}
\START
\makeatletter
\ExplSyntaxOn
\TEST{Resolution~box~preserves~outside~paragraph~state~and~cell~style}{
  \__hit_resolution_calc:
  \tl_gset:Nn \g__hit_defense_resolution_tl { 第一段决议。\par 第二段决议。 }
  \dim_gset:Nn \g__docxlike_format_prev_after_dim { 8bp }
  \dim_gset:Nn \g__docxlike_format_pending_after_dim { 8bp }
  \bool_gset_true:N \g__docxlike_format_after_placed_bool
  \bool_gset_true:N \g_docxlike_section_start_bool
  \tl_gset:Nn \g__docxlike_format_keep_tl { true }
  \docxlike_format_get:nnN { resolution-cell } { pPr/ind/firstLine } \l_tmpa_tl
  \__hit_res_body:
  \TYPE{previous-after=\dim_compare:nNnTF{\g__docxlike_format_prev_after_dim}={8bp}{yes}{no}}
  \TYPE{pending-after=\dim_compare:nNnTF{\g__docxlike_format_pending_after_dim}={8bp}{yes}{no}}
  \TYPE{after-placed=\bool_if:NTF\g__docxlike_format_after_placed_bool{yes}{no}}
  \TYPE{section-start=\bool_if:NTF\g_docxlike_section_start_bool{yes}{no}}
  \TYPE{keep-next=\g__docxlike_format_keep_tl}
  \docxlike_format_get:nnN { resolution-cell } { pPr/ind/firstLine } \l_tmpb_tl
  \TYPE{style-restored=\tl_if_eq:NNTF\l_tmpa_tl\l_tmpb_tl{yes}{no}}
  \dim_set:Nn \l_tmpa_dim { \box_ht_plus_dp:N \l__hit_res_body_box }
  \__hit_res_body:
  \TYPE{repeat-height=\dim_compare:nNnTF{\box_ht_plus_dp:N\l__hit_res_body_box}={\l_tmpa_dim}{same}{different}}
}
\TEST{Resolution~paragraphs~retain~the~school~indent~without~a~character~grid}{
  \__hit_resolution_calc:
  \dim_zero:N \g_docxlike_page_char_dim
  \tl_gset:Nn \g__hit_defense_resolution_tl
    { \TYPE{indent=\dim_compare:nNnTF{\parindent}={2em}{two-em}{wrong}} 正文。 }
  \__hit_res_body:
}
