% toc/blank 默认关闭。
%
% 目录里第一章之前的那行空白，规范中没有要求。原先默认取 auto，auto 按语言判断，
% 中文文档就插，等于绝大多数人都被插了一行。v3.2a 起默认改成 false。
%
% 六个三态选项里只有这一个默认值不是 auto，所以单独钉一下，免得以后跟着别的一起
% 被改回 auto。auto 本身没有去掉，显式写就回到按语言判断。
%
% 断言的是 \g__hit_toc_blank_tl 的取值，以及 \__hit_tristate_if:NnT 在这个取值下
% 走哪一支。判断条件跟 \mainmatter 里那句一致：auto 时看是不是英文文档。
\input{regression-test}
\documentclass[fontset=fandol,degree=doctor,campus=harbin]{hithesis}
\begin{document}
\START
\ExplSyntaxOn
\TEST{默认不插空行}{
  \typeout{取值=\tl_use:N \g__hit_toc_blank_tl}
  \__hit_tristate_if:NnTF \g__hit_toc_blank_tl
    { ! \bool_if_p:N \g__hit_en_bool } {\typeout{插=是}} {\typeout{插=否}}
}
\TEST{写auto回到按语言判断}{
  \hitsetup{ toc = { blank = auto } }
  \typeout{取值=\tl_use:N \g__hit_toc_blank_tl}
  \__hit_tristate_if:NnTF \g__hit_toc_blank_tl
    { ! \bool_if_p:N \g__hit_en_bool } {\typeout{插=是}} {\typeout{插=否}}
}
\TEST{写true一律插}{
  \hitsetup{ toc = { blank = true } }
  \typeout{取值=\tl_use:N \g__hit_toc_blank_tl}
  \__hit_tristate_if:NnTF \g__hit_toc_blank_tl
    { ! \bool_if_p:N \g__hit_en_bool } {\typeout{插=是}} {\typeout{插=否}}
}
\TEST{写false一律不插}{
  \hitsetup{ toc = { blank = false } }
  \typeout{取值=\tl_use:N \g__hit_toc_blank_tl}
  \__hit_tristate_if:NnTF \g__hit_toc_blank_tl
    { ! \bool_if_p:N \g__hit_en_bool } {\typeout{插=是}} {\typeout{插=否}}
}
\ExplSyntaxOff
\END
\end{document}
