% 显式设置优先于 auto。旧名 bsfrontpagenumberline 写的是同一个三态变量，
% 所以旧名照常生效。
%
% 探针必须在导言区定义。写在 \TEST{} 参数里的 \ExplSyntaxOn 不起作用，
% 参数在读入时就已经记号化了。
\input{regression-test}
\documentclass[fontset=fandol,degree-level=bachelor,campus=weihai,bsfrontpagenumberline=true]{hit-thesis}
\ExplSyntaxOn
\cs_new_protected:Npn \showfront
  {
    \iow_term:x { setting = \g__hit_page_number_line_front_tl }
    \__hit_tristate_if:NnTF \g__hit_page_number_line_front_tl
      {
        ! \bool_lazy_and_p:nn { \bool_if_p:N \g__hit_bachelor_bool }
            {
              \bool_lazy_or_p:nn { \bool_if_p:N \g__hit_shenzhen_bool }
                                 { \bool_if_p:N \g__hit_weihai_bool }
            }
      }
      { \iow_term:n { resolved = decorated } }
      { \iow_term:n { resolved = plain } }
  }
\ExplSyntaxOff
\begin{document}
\START
\makeatletter
\TEST{显式设置优先于默认值}{
  \typeout{campus-harbin=\hit@if@option@TF{harbin}{true}{false}}
  \typeout{type-bachelor=\hit@if@option@TF{bachelor}{true}{false}}
  \showfront
}
\makeatother
\END
\end{document}
