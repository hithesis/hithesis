% 两个导师角色不能串位；旧版四个写入器仍各自写入对应栏。
\input{regression-test}
\documentclass[fontset=fandol,degree-level=doctor]{hithesis}
\ExplSyntaxOn
\msg_redirect_name:nnn { hithesis } { renamed-option } { none }
\ExplSyntaxOff
\hitsetup{info={
  supervisor={Main ZH}[Main EN],
  associate-supervisor={Associate ZH}[Associate EN],
  industry-supervisor={Industry ZH}[Industry EN],
}}
\begin{document}
\START
\makeatletter
\TEST{Distinct supervisor roles}{
  \typeout{main-zh=[\hit@info@supervisor@zh]}
  \typeout{associate-zh=[\hit@info@associate@supervisor@zh]}
  \typeout{industry-zh=[\hit@info@industry@supervisor@zh]}
  \typeout{main-en=[\hit@info@supervisor@en]}
  \typeout{associate-en=[\hit@info@associate@supervisor@en]}
  \typeout{industry-en=[\hit@info@industry@supervisor@en]}
  \typeout{associate-label=[\hit@term@titlepage@associate@supervisor@en]}
  \typeout{industry-label=[\hit@term@titlepage@industry@supervisor@en]}
}
\ExplSyntaxOn
\TEST{Titlepage~pairs~labels~with~the~right~fields}{
  \cs_set_protected:Npn \hit@titlepage@en@field:nn #1#2
    {
      \tl_if_eq:nnT {#2} { \hit@info@supervisor@en }
        { \typeout{main-row=[#1]/[#2]} }
      \tl_if_eq:nnT {#2} { \hit@info@associate@supervisor@en }
        { \typeout{associate-row=[#1]/[#2]} }
      \tl_if_eq:nnT {#2} { \hit@info@industry@supervisor@en }
        { \typeout{industry-row=[#1]/[#2]} }
    }
  \cs_set_protected:Npn \__hit_titlepage_en_field:nnn #1#2#3 { }
  \hit@titlepage@en@fields:
}
\ExplSyntaxOff
\TEST{Legacy supervisor fields keep their slots}{
  \hitsetup{info={cassosupervisor={Legacy Associate ZH},ecosupervisor={Legacy Industry EN}}}
  \ccosupervisor{Legacy Industry ZH}
  \eassosupervisor{Legacy Associate EN}
  \typeout{associate-zh=[\hit@info@associate@supervisor@zh]}
  \typeout{industry-zh=[\hit@info@industry@supervisor@zh]}
  \typeout{associate-en=[\hit@info@associate@supervisor@en]}
  \typeout{industry-en=[\hit@info@industry@supervisor@en]}
}
\TEST{Path updates only the selected role}{
  \hitsetup{info={industry-supervisor={\keepvalue}[Updated Industry]}}
  \typeout{main-en=[\hit@info@supervisor@en]}
  \typeout{associate-en=[\hit@info@associate@supervisor@en]}
  \typeout{industry-en=[\hit@info@industry@supervisor@en]}
}
\makeatother
\END
\end{document}
