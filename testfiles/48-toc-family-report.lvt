% 报告类也认 toc 一族。
%
% toc 族原先只在学位论文类里定义，报告里写 toc={depth=4} 会撞上 l3keys 的
% “未知模块”错误。族挪到共享层之后两个类都认。
%
% 三个键报告只做得了两个。depth 与 latin-sans 照常；english 报告没有，
% 一份报告只排一份目录，语言跟着 lang 走，所以覆盖成一条提示。
%
% depth 数的是级数：报告是 ctexart，最高一级是节，tocdepth 恰好等于级数；
% 学位论文有章，那边要减一。这条差别是这个测试的重点。
\input{regression-test}
\documentclass[fontset=fandol,kind=proposal,degree-level=master,campus=harbin]{hit-report}
\ExplSyntaxOn
\cs_new:Npn \hitshowtocdepth { \int_use:N \g__hit_toc_depth_int }
\cs_new:Npn \hitshowtoclatinsans
  { \bool_if:NTF \g__hit_toc_latin_sans_bool { true } { false } }
\cs_new:Npn \hitshowcontents { \tl_use:c { g__hit_structure_contents_tl } }
\ExplSyntaxOff
\begin{document}
\START
\makeatletter
\TEST{默认三级，报告的 tocdepth 与级数相等}{
  \typeout{toc-depth=\hitshowtocdepth}
  \typeout{tocdepth=\the\c@tocdepth}
}
\TEST{depth 改得动}{
  \hitsetup{ toc = { depth = 2 } }
  \typeout{toc-depth=\hitshowtocdepth}
}
\TEST{latin-sans 改得动}{
  \hitsetup{ toc = { latin-sans = true } }
  \typeout{latin-sans=\hitshowtoclatinsans}
}
\TEST{english 报告没有，提示一条}{
  \hitsetup{ toc = { english = true } }
  \typeout{还活着}
}
\TEST{toc 本身是 structure/contents 的别名}{
  \typeout{contents=\hitshowcontents}
  \hitsetup{ toc = false }
  \typeout{contents=\hitshowcontents}
  \hitsetup{ struct = { frontmatter = { contents = true } } }
  \typeout{contents=\hitshowcontents}
}
\makeatother
\END
\end{document}
