% 报告的目录也认 \tableofcontents 的那几个可选参数（存的地方是共享层的 toc 族变量）。
%
% depth 与 latin-sans 照常；lang 报告里没用，一份报告只排一份目录，语言跟着类选项 lang 走。
% toc={…} 那种族写法撤了，写了报错指路。
%
% depth 数的是级数：报告是 ctexart，最高一级是节，tocdepth 恰好等于级数；
% 学位论文有章，那边要减一。这条差别是这个测试的重点。
\input{regression-test}
\documentclass[fontset=fandol,stage=proposal,degree-level=master,campus=harbin]{hithesis}
\ExplSyntaxOn
\cs_new:Npn \hitshowtocdepth { \int_use:N \g__hit_toc_depth_int }
\cs_new:Npn \hitshowtoclatinsans
  { \bool_if:NTF \g__hit_toc_latin_sans_bool { true } { false } }
\cs_new_protected:Npn \hitshowcontents
  {
    \use:c { hit@part@if:nnTF } { table-of-contents } { auto }
      { \typeout { contents=true } } { \typeout { contents=false } }
  }
\ExplSyntaxOff
\begin{document}
\START
\makeatletter
\TEST{默认三级，报告的 tocdepth 与级数相等}{
  \typeout{toc-depth=\hitshowtocdepth}
  \typeout{tocdepth=\the\c@tocdepth}
}
\TEST{depth 改得动，tocdepth 当场跟上}{
  \csname hit@part@opts:nn\endcsname{table-of-contents}{depth=2}
  \typeout{tocdepth=\the\c@tocdepth}
  \typeout{toc-depth=\hitshowtocdepth}
}
\TEST{latin-sans 改得动}{
  \csname hit@part@opts:nn\endcsname{table-of-contents}{latin-sans}
  \typeout{latin-sans=\hitshowtoclatinsans}
}
\TEST{族写法撤了，报错指路}{
  \hitsetup{ toc = { english = true } }
  \typeout{还活着}
}
\TEST{toc 本身是目录部件在 shown=auto 时的默认值}{
  \hitshowcontents
  \hitsetup{ toc = false }
  \hitshowcontents
  \hitsetup{ toc = true }
  \hitshowcontents
}
\makeatother
\END
\end{document}
