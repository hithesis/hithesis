% 报告从 \chapter 写起时的 \appendix：\chapter 排成节，附录那一节的号变 A，
% 下一级跟着变 A.1。
%
% 与 73 号是一对。73 号钉的是从 \section 写起的那一支，这里钉的是从 \chapter
% 写起的：报告里没有章，章计数器停在零，\appendix 只走节那一份，偏移照正文定下的走。
\input{regression-test}
\documentclass[fontset=fandol,degree-level=master,campus=harbin,stage=proposal]{hithesis}
\begin{document}
\START
\makeatletter
\chapter{正文一章}
\section{正文一节}
\TEST{正文里 chapter 是节、section 是条}{
  \typeout{chap=[\the\c@chapter]}
  \typeout{sect=[\thesection]}
  \typeout{sub=[\thesubsection]}
}
\appendix
\chapter{附录一章}
\section{附录一节}
\TEST{appendix 之后节号变字母，下一级跟着走}{
  \typeout{sect=[\thesection]}
  \typeout{sub=[\thesubsection]}
}
\makeatother
\END
\end{document}
