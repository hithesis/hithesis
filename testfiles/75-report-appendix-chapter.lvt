% 报告类写了 \chapter 时的 \appendix：章号变 A、B、C，节号照旧带章号前缀。
%
% 与 73 号是一对。73 号钉的是没写 \chapter 那一支（节号变字母），这里钉的是
% 写了 \chapter 那一支：\appendix 要走 \cls{ctexbook} 原来那份，改章号不改节号。
% 判断靠章计数器，而 \cls{book} 的 \appendix 头一件事就是把它置零，所以模板
% 必须在调用底类那份之前问，这条断言就是在钉这个先后。
\input{regression-test}
\documentclass[fontset=fandol,degree-level=master,campus=harbin,stage=proposal]{hithesis}
\begin{document}
\START
\makeatletter
\chapter{正文一章}
\section{正文一节}
\TEST{正文里章号节号都是阿拉伯数字}{
  \typeout{chap=[\thechapter]}
  \typeout{sect=[\thesection]}
}
\appendix
\chapter{附录一章}
\section{附录一节}
\TEST{appendix 之后章号变字母，节号跟着走}{
  \typeout{chap=[\thechapter]}
  \typeout{sect=[\thesection]}
}
\makeatother
\END
\end{document}
