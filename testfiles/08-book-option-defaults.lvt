% 布尔选项的默认值。CONTRIBUTING §4.1 规定选项名与默认值不得改变，而这批默认值
% 现在没有任何测试钉住：改错一个，42 变体多半照编不误，只是排版悄悄变了。
%
% 选项层将来要迁到 l3keys，那次迁移最容易出的错就是默认值写反或漏写。本文件把
% 现状记录下来当作验收依据。它只读取、不改动任何接口。
%
% bsfrontpagenumberline 的默认值随校区与学位而定（哈尔滨本科为 true，其余为
% false），所以下面分两组文档类选项各钉一次。
\input{regression-test}
\documentclass[fontset=fandol,type=master,campus=harbin]{hithesisbook}
\begin{document}
\START
\makeatletter
\TEST{布尔选项默认值（哈尔滨硕士）}{
  \typeout{absupper=\hit@if{absupper}{true}{false}}
  \typeout{arialtitle=\hit@if{arialtitle}{true}{false}}
  \typeout{arialtoc=\hit@if{arialtoc}{true}{false}}
  \typeout{capcenterlast=\hit@if{capcenterlast}{true}{false}}
  \typeout{chapterbold=\hit@if{chapterbold}{true}{false}}
  \typeout{chapterhang=\hit@if{chapterhang}{true}{false}}
  \typeout{debug=\hit@if{debug}{true}{false}}
  \typeout{design=\hit@if{design}{true}{false}}
  \typeout{etitleauto=\hit@if{etitleauto}{true}{false}}
  \typeout{fulltime=\hit@if{fulltime}{true}{false}}
  \typeout{glue=\hit@if{glue}{true}{false}}
  \typeout{library=\hit@if{library}{true}{false}}
  \typeout{newtxmath=\hit@if{newtxmath}{true}{false}}
  \typeout{openright=\hit@if{openright}{true}{false}}
  \typeout{raggedbottom=\hit@if{raggedbottom}{true}{false}}
  \typeout{splitbibitem=\hit@if{splitbibitem}{true}{false}}
  \typeout{subcapcenterlast=\hit@if{subcapcenterlast}{true}{false}}
  \typeout{subtitle=\hit@if{subtitle}{true}{false}}
}
\makeatother
\END
\end{document}
