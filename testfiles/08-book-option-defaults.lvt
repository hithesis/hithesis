% 布尔选项的默认值。CONTRIBUTING §4.1 规定选项名与默认值不得改变，而这批默认值
% 现在没有任何测试钉住：改错一个，42 变体多半照编不误，只是排版悄悄变了。
%
% 选项层将来要迁到 l3keys，那次迁移最容易出的错就是默认值写反或漏写。本文件把
% 现状记录下来当作验收依据。它只读取、不改动任何接口。
%
% bsfrontpagenumberline 的默认值随校区与学位而定（哈尔滨本科为 true，其余为
% false），所以下面分两组文档类选项各钉一次。
\input{regression-test}
\documentclass[fontset=fandol,degree-level=master,campus=harbin]{hit-thesis}
\makeatletter
\ExplSyntaxOn
%% subtitle 是三态，取值放在 tl 里；\ExplSyntaxOn 写进 \TEST 的花括号参数是空操作，
%% 所以这里先在导言区包一个不带下划线的名字出来。
\cs_new:Npn \hitshowsubtitle { \tl_use:N \g__hit_subtitle_tl }
\ExplSyntaxOff
\makeatother
\begin{document}
\START
\makeatletter
\TEST{布尔选项默认值（哈尔滨硕士）}{
  \typeout{absupper=\hit@if@option@TF{absupper}{true}{false}}
  \typeout{capcenterlast=\hit@if@option@TF{capcenterlast}{true}{false}}
  \typeout{chapterbold=\hit@if@option@TF{chapterbold}{true}{false}}
  \typeout{chapterhang=\hit@if@option@TF{chapterhang}{true}{false}}
  \typeout{debug=\hit@if@option@TF{debug}{true}{false}}
  \typeout{design=\hit@if@option@TF{design}{true}{false}}
  \typeout{etitleauto=\hit@if@option@TF{etitleauto}{true}{false}}
  \typeout{fulltime=\hit@if@option@TF{fulltime}{true}{false}}
  \typeout{glue=\hit@if@option@TF{glue}{true}{false}}
  \typeout{heading-latin-sans=\hit@if@option@TF{heading_latin_sans}{true}{false}}
  \typeout{library=\hit@if@option@TF{library}{true}{false}}
  \typeout{newtxmath=\hit@if@option@TF{newtxmath}{true}{false}}
  \typeout{openright=\hit@if@option@TF{openright}{true}{false}}
  \typeout{raggedbottom=\hit@if@option@TF{raggedbottom}{true}{false}}
  \typeout{splitbibitem=\hit@if@option@TF{splitbibitem}{true}{false}}
  \typeout{subcapcenterlast=\hit@if@option@TF{subcapcenterlast}{true}{false}}
  \typeout{subtitle=\hitshowsubtitle}
  \typeout{toc-latin-sans=\hit@if@option@TF{toc_latin_sans}{true}{false}}
}
\makeatother
\END
\end{document}
