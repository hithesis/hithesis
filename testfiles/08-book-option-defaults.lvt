% 布尔选项的默认值。CONTRIBUTING §4.1 规定选项名与默认值不得改变，而这批默认值
% 现在没有任何测试钉住：改错一个，42 变体多半照编不误，只是排版悄悄变了。
%
% 选项层将来要迁到 l3keys，那次迁移最容易出的错就是默认值写反或漏写。本文件把
% 现状记录下来当作验收依据。它只读取、不改动任何接口。
%
% bsfrontpagenumberline 的默认值随校区与学位而定（哈尔滨本科为 true，其余为
% false），所以下面分两组文档类选项各钉一次。
\input{regression-test}
\documentclass[fontset=fandol,type=master,campus=harbin]{hithesisbook}
\begin{document}
\START
\makeatletter
\TEST{布尔选项默认值（哈尔滨硕士）}{
  \typeout{absupper=\ifhit@absupper true\else false\fi}
  \typeout{arialtitle=\ifhit@arialtitle true\else false\fi}
  \typeout{arialtoc=\ifhit@arialtoc true\else false\fi}
  \typeout{capcenterlast=\ifhit@capcenterlast true\else false\fi}
  \typeout{chapterbold=\ifhit@chapterbold true\else false\fi}
  \typeout{chapterhang=\ifhit@chapterhang true\else false\fi}
  \typeout{debug=\ifhit@debug true\else false\fi}
  \typeout{design=\ifhit@design true\else false\fi}
  \typeout{etitleauto=\ifhit@etitleauto true\else false\fi}
  \typeout{fulltime=\ifhit@fulltime true\else false\fi}
  \typeout{glue=\ifhit@glue true\else false\fi}
  \typeout{library=\ifhit@library true\else false\fi}
  \typeout{newtxmath=\ifhit@newtxmath true\else false\fi}
  \typeout{openright=\ifhit@openright true\else false\fi}
  \typeout{pifootnote=\ifhit@pifootnote true\else false\fi}
  \typeout{raggedbottom=\ifhit@raggedbottom true\else false\fi}
  \typeout{splitbibitem=\ifhit@splitbibitem true\else false\fi}
  \typeout{subcapcenterlast=\ifhit@subcapcenterlast true\else false\fi}
  \typeout{subtitle=\ifhit@subtitle true\else false\fi}
}
\makeatother
\END
\end{document}
