\input{regression-test}
\documentclass[stage=proposal,campus=shenzhen,degree-level=master,fontset=fandol]{hithesis}
\begin{document}
\START
\ExplSyntaxOn
\TEST{Shenzhen~proposal~uses~Word~layout~without~ctex}{
  \TYPE{ctex=\cs_if_exist:cTF{ver@ctexbook.cls}{yes}{no}}
  \TYPE{width-bp=\fp_eval:n{round(\dim_to_decimal_in_bp:n{\textwidth},2)}}
  \TYPE{height-bp=\fp_eval:n{round(\dim_to_decimal_in_bp:n{\textheight},2)}}
  \clist_map_inline:nn{Heading1,Heading2,Heading3,toc-heading}{
    \docxlike_format_compute:n{#1}
    \TYPE{#1:size=\fp_eval:n{round(\dim_to_decimal_in_bp:n{\l_docxlike_format_size_dim},2)};
      before=\fp_eval:n{round(\dim_to_decimal_in_bp:n{\l_docxlike_format_before_dim},2)};
      after=\fp_eval:n{round(\dim_to_decimal_in_bp:n{\l_docxlike_format_after_dim},2)}}
  }
  \stepcounter{section}\stepcounter{figure}\TYPE{figure=\thefigure}
  \stepcounter{section}\stepcounter{figure}\TYPE{figure=\thefigure}
  \TYPE{old-frame=\cs_if_exist:cTF{hit@report@shenzhen@doctor@frame@picture}{present}{removed}}
  \TYPE{old-heading=\cs_if_exist:cTF{hit@report@shenzhen@master@section@settings}{present}{removed}}
}
\TEST{Header~terms~and~complete~document~type}{
  \hitsetup{overrides={header-sz={旧入口页眉}[Old~header],cover={document-type={报告标题}[Report]}}}
  \TYPE{header=\use:c{hit@term@header@report}}
  \TYPE{cover=\use:c{hit@term@cover@document@type@zh}}
  \hitsetup{overrides={header={report-text-shenzhen={新入口页眉}}}}
  \TYPE{updated-header=\use:c{hit@term@header@report}}
}
\ExplSyntaxOff
\END
\end{document}
