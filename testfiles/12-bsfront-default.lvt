% bsfrontpagenumberline 的条件默认值。它要等 campus 与 type 解析完才能定，
% 所以默认值在选项后处理里补，而不是在声明处判断。四组分别覆盖：
% 哈尔滨本科（应为 true）、哈尔滨硕士与威海本科（应为 false）、
% 以及用户显式设置时不被默认值覆盖。
\input{regression-test}
\documentclass[fontset=fandol,type=bachelor,campus=weihai]{hithesisbook}
\begin{document}
\START
\makeatletter
\TEST{威海本科不套用哈尔滨本科的默认值}{
  \typeout{campus-harbin=\ifhit@harbin true\else false\fi}
  \typeout{type-bachelor=\ifhit@bachelor true\else false\fi}
  \typeout{bsfrontpagenumberline=\ifhit@bsfrontpagenumberline true\else false\fi}
}
\makeatother
\END
\end{document}
