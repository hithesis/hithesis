% 前置部分页码装饰的三态默认值。auto 的含义是「除深圳与威海本科外都带装饰」，
% 这里用威海本科验证反例。
%
% 探针必须在导言区定义。写在 \TEST{} 参数里的 \ExplSyntaxOn 不起作用，
% 参数在读入时就已经记号化了。
\input{regression-test}
\documentclass[fontset=fandol,type=bachelor,campus=weihai]{hithesisbook}
\ExplSyntaxOn
\cs_new_protected:Npn \showfront
  {
    \iow_term:x { setting = \g__hit_pnline_front_tl }
    \__hit_tri_if:NnTF \g__hit_pnline_front_tl
      {
        ! \bool_lazy_and_p:nn { \legacy_if_p:n { hit@bachelor } }
            {
              \bool_lazy_or_p:nn { \legacy_if_p:n { hit@shenzhen } }
                                 { \legacy_if_p:n { hit@weihai } }
            }
      }
      { \iow_term:n { resolved = decorated } }
      { \iow_term:n { resolved = plain } }
  }
\ExplSyntaxOff
\begin{document}
\START
\makeatletter
\TEST{威海本科的前置页码不带装饰}{
  \typeout{campus-harbin=\ifhit@harbin true\else false\fi}
  \typeout{type-bachelor=\ifhit@bachelor true\else false\fi}
  \showfront
}
\makeatother
\END
\end{document}
