% \hitsetup 的字段存储，以及关键词的分隔符插入。
% 前者由 \hit@def@term 批量生成，后者带 \@for 循环；42 变体只在封面上看到
% 最终结果，看不出多个关键词之间到底插没插分隔符、插了几个。
%
% 只用两个关键词：第一个走 \ifx\hit@ckeywords\@empty 的真分支不加分隔符，
% 第二个走假分支加一个，两条路都覆盖了，同时也证明末尾没多加。再多一个关键词
% 不增加覆盖，却会让基线里那行超过 79 字节被 TeX 折断。l3build 靠「行长恰好
% 等于 maxprintline」来识别并拼回折断的行，而中文一个字三字节，字节数对不上就
% 拼不回来，老版本 TeX Live 上这条会直接失败。写含中文的基线时行要留够余量。
\input{regression-test}
\documentclass[fontset=fandol,type=master,campus=harbin]{hithesisbook}
\hitsetup{
  ctitle={测试标题},
  cauthor={张三},
  ckeywords={甲,乙},
}
\begin{document}
\START
\makeatletter
\TEST{元信息字段的存储}{
  \show\hit@ctitle
  \show\hit@cauthor
}
\TEST{多关键词之间插入分隔符}{
  \showtokens\expandafter{\hit@ckeywords}
}
\makeatother
\END
\end{document}
