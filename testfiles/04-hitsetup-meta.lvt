% \hitsetup 的字段存储，以及关键词的分隔符插入。
% 前者由 \hit@define@term 批量生成，后者带 \@for 循环；42 变体只在封面上看到
% 最终结果，看不出多个关键词之间到底插没插分隔符、插了几个。
%
% 只用两个关键词：第一个走 \ifx\hit@keywords@zh\@empty 的真分支不加分隔符，
% 第二个走假分支加一个，两条路都覆盖了，同时也证明末尾没多加。
%
% 断言的是展开后的值。分隔符本身以 \csname ...\endcsname 的形式存着，所以在
% 测试里先把它定义成一个显眼的记号再展开，这样基线里看到的是“分隔符插在哪、
% 插了几次”，而不是存储用的记号序列。含中文的基线行要明显短于 79 字节，
% 超了会被 TeX 折断而 l3build 拼不回来（中文一字三字节，字节数对不上），
% 老版本 TeX Live 上会直接失败。
\input{regression-test}
\documentclass[fontset=fandol,degree-level=master,campus=harbin]{hit-thesis}
\hitsetup{
  title-zh={测试标题},
  author-zh={张三},
  keywords-zh={甲,乙},
}
\begin{document}
\START
\makeatletter
\TEST{元信息字段的取值}{
  \typeout{title-zh=[\hit@title@flat@zh]}
  \typeout{author-zh=[\hit@author@zh]}
}
\TEST{多关键词之间插入分隔符}{
  \def\hit@keywords@separator@zh{<SEP>}
  \typeout{keywords-zh=[\hit@keywords@zh]}
}
\makeatother
\END
\end{document}
