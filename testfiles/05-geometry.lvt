% 版心的三选一。newgeometry 有 one/two/no 三个互斥标志位，都没显式指定时
% 由一段兜底逻辑落到 two。42 变体全都不带 newgeometry，走的正是这条兜底；
% 兜底一旦被重构改坏，变体只会整体换一套版心，未必看得出是哪一步错了。
\input{regression-test}
\documentclass[fontset=fandol,type=master,campus=harbin]{hithesisbook}
\begin{document}
\START
\makeatletter
\TEST{没指定 newgeometry 时落到 two}{
  \show\ifhit@geometrynewone
  \show\ifhit@geometrynewtwo
  \show\ifhit@geometrynewno
}
\makeatother
\END
\end{document}
