% 版心的三选一。newgeometry 有 one/two/no 三个互斥取值，都不指定时由一段兜底
% 逻辑落到 two。42 变体全都不带 newgeometry，走的正是这条兜底；兜底一旦被改坏，
% 变体只会整体换一套版心，未必看得出是哪一步错的。
%
% 断言的是选中的取值加上它实际产生的版心尺寸。尺寸是这条逻辑真正的产出，
% 比标志位本身更接近“行为”。
\input{regression-test}
\documentclass[fontset=fandol,type=master,campus=harbin]{hithesisbook}
\begin{document}
\START
\makeatletter
\TEST{不指定 newgeometry 时的兜底取值}{
  \typeout{newgeometry=\ifhit@geometrynewone one\else
                       \ifhit@geometrynewtwo two\else
                       \ifhit@geometrynewno no\else none\fi\fi\fi}
}
\TEST{该取值产生的版心}{
  \typeout{textwidth=\the\textwidth}
  \typeout{textheight=\the\textheight}
}
\makeatother
\END
\end{document}
