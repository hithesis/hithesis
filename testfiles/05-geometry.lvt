% 走新版面还是旧版面，由 v2-layout 决定。什么都不写是新版面；本科写
% bachelor=true、硕博写 graduate=one|two 才退回旧版面，而 graduate 的兜底
% 只在旧版面那一支里补。45 变体全都不带 v2-layout，走的正是这条默认；
% 一旦被改坏，变体只会整体换一套版心，未必看得出是哪一步错的。
%
% 断言的是选中的取值加上它实际产生的版心尺寸。尺寸是这条逻辑真正的产出，
% 比标志位本身更接近“行为”。
\input{regression-test}
\documentclass[fontset=fandol,degree-level=master,campus=harbin]{hit-thesis}
\begin{document}
\START
\makeatletter
\TEST{不指定 v2-layout 时走新版面}{
  \typeout{v2-layout=\hit@if@option@TF{layout_two}{true}{false}}
  \typeout{graduate=\hit@if@option@TF{layout_two_graduate_one}{one}%
    {\hit@if@option@TF{layout_two_graduate_two}{two}{none}}}
  \typeout{bachelor=\hit@if@option@TF{layout_two_bachelor}{true}{false}}
}
\TEST{该取值产生的版心}{
  \typeout{textwidth=\the\textwidth}
  \typeout{textheight=\the\textheight}
}
\makeatother
\END
\end{document}
