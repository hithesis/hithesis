% 旧版面的二选一。old-layout 的 graduate 有 one/two 两个互斥取值，都不指定时由
% 一段兜底逻辑落到 two。45 变体全都不带 old-layout，走的正是这条兜底；兜底一旦
% 被改坏，变体只会整体换一套版心，未必看得出是哪一步错的。
%
% 断言的是选中的取值加上它实际产生的版心尺寸。尺寸是这条逻辑真正的产出，
% 比标志位本身更接近“行为”。
\input{regression-test}
\documentclass[fontset=fandol,degree-level=master,campus=harbin]{hit-thesis}
\begin{document}
\START
\makeatletter
\TEST{不指定 old-layout 时的兜底取值}{
  \typeout{graduate=\hit@if@option@TF{old_layout_graduate_one}{one}%
    {\hit@if@option@TF{old_layout_graduate_two}{two}{none}}}
  \typeout{bachelor=\hit@if@option@TF{old_layout_bachelor}{true}{false}}
}
\TEST{该取值产生的版心}{
  \typeout{textwidth=\the\textwidth}
  \typeout{textheight=\the\textheight}
}
\makeatother
\END
\end{document}
