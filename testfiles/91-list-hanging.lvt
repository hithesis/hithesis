\input{regression-test}
\documentclass[fontset=fandol,degree-level=master]{hithesis}
\begin{document}
\START
\makeatletter
\ExplSyntaxOn
\cs_new_protected:Npn \CHECKLIST #1
  {
    \typeout{#1:~hanging=\dim_compare:nNnTF {\itemindent} = {0pt}{yes}{no}}
    \typeout{#1:~left-positive=\dim_compare:nNnTF {\leftmargin} > {0pt}{yes}{no}}
  }
\ExplSyntaxOff
\TEST{Independent modes and nesting}{
  \hitsetup{enumerate-hanging=true,itemize-hanging=false}
  \setbox0=\vbox{\hsize=250pt
    \begin{enumerate}
    \item Outer.\CHECKLIST{enum}
      \begin{itemize}\item Inner.\CHECKLIST{item}\end{itemize}
      \begin{enumerate}\item Nested.\CHECKLIST{nested-enum}\end{enumerate}
    \end{enumerate}
  }
}
\TEST{Opposite modes}{
  \hitsetup{enumerate-hanging=false,itemize-hanging=true}
  \setbox0=\vbox{\hsize=250pt
    \begin{enumerate}\item Text.\CHECKLIST{enum}\end{enumerate}
    \begin{itemize}\item Text.\CHECKLIST{item}\end{itemize}
  }
}
\TEST{Auto restores original word layout}{
  \hitsetup{enumerate-hanging=auto,itemize-hanging=auto}
  \setbox0=\vbox{\hsize=250pt
    \begin{enumerate}\item Text.\CHECKLIST{enum}\end{enumerate}
    \begin{itemize}\item Text.\CHECKLIST{item}\end{itemize}
  }
}
\TEST{Explicit environment dimensions win}{
  \hitsetup{enumerate-hanging=true}
  \setbox0=\vbox{\hsize=250pt
    \begin{enumerate}[leftmargin=0pt,itemindent=20pt,labelwidth=10pt]
    \item Text.\CHECKLIST{explicit}
    \end{enumerate}
  }
}
\makeatother
\END
\end{document}
