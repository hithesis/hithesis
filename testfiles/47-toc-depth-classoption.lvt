% 目录级数写成类选项。
%
% 旧名 tocfour 是 v3.1e 的类选项，得继续能写在 \documentclass 里。这里钉住它
% 到得了 tocdepth：\setcounter 在 \AtBeginDocument 才执行，类选项当然更早，
% 所以两条路都通。tocdepth 数的是比章低几级，比 toc-depth 少一。
\input{regression-test}
\documentclass[fontset=fandol,degree-level=doctor,campus=harbin,tocfour]{hithesis}
\ExplSyntaxOn
\cs_new:Npn \hitshowtocdepth { \int_use:N \g__hit_toc_depth_int }
\ExplSyntaxOff
\begin{document}
\START
\makeatletter
\TEST{类选项 tocfour 等于四级}{
  \typeout{toc-depth=\hitshowtocdepth}
  \typeout{tocdepth=\the\c@tocdepth}
}
\makeatother
\END
\end{document}
