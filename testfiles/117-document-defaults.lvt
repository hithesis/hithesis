\input{regression-test}
\documentclass[stage=proposal,degree-level=master,fontset=fandol]{hithesis}
\ExplSyntaxOn\msg_redirect_module:nnn{fontspec}{info}{none}\ExplSyntaxOff
\docxlikesetup{doc-defaults={font={size=11bp,font-style=bold},
  paragraph={spacing={line-spacing=exactly,at=14bp}}},styles={
  DefaultsEmpty={paragraph={alignment=left}},
  DefaultsBold={based-on=DefaultsEmpty,font={font-style=bold}},
  DefaultsOff={based-on=DefaultsBold,font={font-style=regular}},
  DefaultsChar={style-type=character,font={font-style=bold}}}}
\begin{document}
\START
\ExplSyntaxOn
\TEST{Document~defaults~supply~font~and~paragraph~fallbacks}{
  \docxlike_format_get:nnN{DefaultsEmpty}{rPr/sz}\l_tmpa_tl\TYPE{size=\l_tmpa_tl}
  \docxlike_format_get:nnN{DefaultsEmpty}{rPr/b}\l_tmpa_tl\TYPE{bold=\l_tmpa_tl}
  \docxlike_format_compute:n{DefaultsEmpty}
  \TYPE{line=\dim_compare:nNnTF{\l_docxlike_format_lead_dim}={14bp}{yes}{no}}
}
\TEST{Nearest~based-on~boolean~overrides~its~base}{
  \docxlike_format_get:nnN{DefaultsBold}{rPr/b}\l_tmpa_tl\TYPE{repeated-true=\l_tmpa_tl}
  \docxlike_format_get:nnN{DefaultsOff}{rPr/b}\l_tmpa_tl\TYPE{leaf-false=\l_tmpa_tl}
}
\TEST{Character~toggle~is~relative~to~document~defaults}{
  \hbox:n{\normalfont\bfseries\docxrun[style=DefaultsChar]{\TYPE{default-relative-series=\use:c{f@series}}X}}
  \hbox:n{\normalfont\bfseries\docxrun[style=DefaultsChar,font-style=regular]{\TYPE{direct-off-series=\use:c{f@series}}X}}
}
\ExplSyntaxOff
\END
\end{document}
