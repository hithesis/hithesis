\input{regression-test}
\ExplSyntaxOn
\msg_redirect_module:nnn {hithesis}{warning}{error}
\ExplSyntaxOff
\documentclass[degree-level=master,lang=en]{hithesis}
\begin{document}
\START
\makeatletter
\ExplSyntaxOn
\TEST{Defaults~keep~their~language~in~an~English~document}{
  \typeout{title-zh=[\hit@info@title@cover@zh]}
  \typeout{title-en=[\hit@info@title@cover@en]}
  \typeout{supervisor-zh=[\hit@info@supervisor@zh]}
  \typeout{supervisor-en=[\hit@info@supervisor@en]}
  \typeout{abstract-zh=[\hit@term@abstract@heading@zh],en=[\hit@term@abstract@heading@en]}
  \typeout{discipline-zh=[\hit@info@discipline@zh],en=[\hit@info@discipline@en]}
  \typeout{number-gap=[\hit@after@number:nnn{chapter}{zh}{fallback}]}
}
\TEST{Preset~input~ignores~document~language~and~swap}{
  \group_begin:
    \bilingualswapon
    \bool_set_true:N \g_docxlike_format_defaults_bool
    \hitsetup{info={author={默认作者}[Default~Author]},
      overrides={titlepage={supervisor={指导教师}[Supervisor]}}}
    \hitsetup{info={author={\keepvalue}[Updated~Author]},
      overrides={titlepage={supervisor={\keepvalue}[Updated~Supervisor]}}}
  \group_end:
  \typeout{author-zh=[\hit@info@author@zh],en=[\hit@info@author@en]}
  \typeout{label-zh=[\hit@term@titlepage@supervisor@zh],en=[\hit@term@titlepage@supervisor@en]}
  \hitsetup{info={author={User~Author}[用户作者]}}
  \typeout{user-zh=[\hit@info@author@zh],en=[\hit@info@author@en]}
}
\TEST{Old~language~groups~and~suffixes~are~rejected}{
  \msg_redirect_module:nnn {hithesis}{warning}{warning}
  \hitsetup{info={author-zh={Wrong},zh={author={Wrong}}},
    overrides={titlepage={supervisor-zh={Wrong}},zh={titlepage={supervisor={Wrong}}}}}
  \hitsetup{overrides/titlepage-supervisor-zh={Wrong}}
  \typeout{author-zh=[\hit@info@author@zh]}
  \typeout{label-zh=[\hit@term@titlepage@supervisor@zh]}
  \keys_if_exist:nnTF {hit/info-internal}{zh}
    {\typeout{old-language-group=present}}{\typeout{old-language-group=absent}}
}
\TEST{Symbols~reject~old~language~maps}{
  \seq_gclear:N \g_hit_symbols_seq
  \msg_redirect_name:nnn {hithesis}{bilingual-syntax}{warning}
  \hitsetup{symbols={{$p$}={zh={压力},en={Pressure}}}}
  \typeout{old-symbol-count=\seq_count:N\g_hit_symbols_seq}
  \hitsetup{symbols={{$p$}={Pressure}[压力]}}
  \typeout{new-symbol-count=\seq_count:N\g_hit_symbols_seq}
}
\ExplSyntaxOff
\makeatother
\END
\end{document}
