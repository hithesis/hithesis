% 中期共享深圳本科版式，但保留自己的三级目录编号宽度。
\input{regression-test}
\documentclass[fontset=fandol,type=bachelor,stage=midterm,campus=shenzhen]{hithesisart}
\hitsetup{info={reporttype=design}}
\begin{document}
\START
\makeatletter
\TEST{Midterm configuration}{
  \typeout{szbachelor=\ifhit@szbachelor true\else false\fi}
  \typeout{reporttype=\hit@reporttype}
  \typeout{tocnumwidth=\the\cftsubsubsecnumwidth}
  \typeout{paperwidth=\the\paperwidth}
  \typeout{paperheight=\the\paperheight}
}
\TEST{Font size keeps conditionals balanced}{
  \edef\beforelevel{\the\currentiflevel}
  \normalsize\normalsize
  \typeout{ifdelta=\number\numexpr\currentiflevel-\beforelevel\relax}
}
\makeatother
\END
\end{document}
