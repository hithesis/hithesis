% 报告类不装 algorithm2e。
%
% 那一整段按章编号，而报告不排章。判据是 \g__hit_chapter_bool，不是
% “有没有 \chapter 计数器”——底类换成 \cls{ctexbook} 之后 \chapter 两边都有，
% 按它判会把整段连同三个依赖放进报告类，算法编号排成恒零章号的“0-1”。
\input{regression-test}
\documentclass[fontset=fandol,degree-level=master,campus=harbin,stage=proposal]{hithesis}
\usepackage{hithesis}
\begin{document}
\START
\makeatletter
\TEST{报告类没装 algorithm2e}{
  \typeout{algorithm2e=\@ifpackageloaded{algorithm2e}{yes}{no}}
  \typeout{ifoddpage=\@ifpackageloaded{ifoddpage}{yes}{no}}
}
\ExplSyntaxOn
\cs_new:Npn \chaptercheck { \bool_if:NTF \g__hit_chapter_bool { yes } { no } }
\ExplSyntaxOff
\TEST{这一档不排章}{
  \typeout{chapter-bool=\chaptercheck}
}
\makeatother
\END
\end{document}
