\input{regression-test}
\documentclass[fontset=fandol,degree-level=master]{hithesis}
\hitsetup{overrides={titlepage={supervisor={指导}[Supervisor]},references={heading={文献}[References]}}}
\hitsetup{abbreviations={FEM={long={有限元法}[Finite Element Method],long-plural={\keepvalue}[Finite Element Methods]}}}
\begin{document}
\START
\makeatletter
\ExplSyntaxOn
\TEST{Translated terms}{
  \typeout{zh=[\hit@term@titlepage@supervisor@zh]}
  \typeout{en=[\hit@term@titlepage@supervisor@en]}
  \typeout{references=[\hit@term@bibliography@heading@zh]}
  \hitsetup{overrides={titlepage={supervisro={错误}[Wrong]}}}
  \typeout{unchanged=[\hit@term@titlepage@supervisor@zh]}
}
\TEST{Plural defaults remain live}{
  \typeout{long-zh=[\hitabbrzh{FEM}]}
  \typeout{long-en=[\hitabbren{FEM}]}
  \hitsetup{abbreviations={FEM={long={新全称}[\keepvalue]}}}
  \__hit_abbr_localize:n{FEM}
  \typeout{new-zh=[\hitabbrzh{FEM}]}
  \glsletentryfield\l_tmpa_tl{FEM}{longpl}
  \typeout{plural=[\l_tmpa_tl]}
  \tl_set:Nn\g__hit_part_lang_tl{en}
  \__hit_abbr_localize:n{FEM}
  \glsletentryfield\l_tmpa_tl{FEM}{longpl}
  \typeout{english-plural=[\l_tmpa_tl]}
  \tl_clear:N\g__hit_part_lang_tl
}
\TEST{Omitted~plural~follows~the~current~full~name}{
  \hitsetup{abbreviations={ALT={long={项目}[Item]}}}
  \tl_set:Nn\g__hit_part_lang_tl{en}
  \__hit_abbr_localize:n{ALT}
  \glsletentryfield\l_tmpa_tl{ALT}{longpl}\typeout{default-plural=[\l_tmpa_tl]}
  \hitsetup{abbreviations={ALT={long={\keepvalue}[Thing]}}}
  \__hit_abbr_localize:n{ALT}
  \glsletentryfield\l_tmpa_tl{ALT}{longpl}\typeout{updated-plural=[\l_tmpa_tl]}
  \hitsetup{abbreviations={ALT={long-plural={\keepvalue}[auto]}}}
  \__hit_abbr_localize:n{ALT}
  \glsletentryfield\l_tmpa_tl{ALT}{longpl}\typeout{literal-auto=[\l_tmpa_tl]}
  \tl_clear:N\g__hit_part_lang_tl
}
\ExplSyntaxOff
\makeatother
\END
\end{document}
