% 深圳博士中期的布尔选项默认值，与 10（其余十七格）互为对照。两者现在是同一个类，
% 声明的选项也就同一份；差别只在 raggedbottom 与 toc：这一格默认关，别的格默认开。
% 这条差异靠 \ProcessKeyOptions 之后按组合翻转实现，用户在 \documentclass 里显式
% 写了就不翻，所以这里必须走不带这两个键的写法才测得到默认值。
\input{regression-test}
\documentclass[fontset=fandol,level=doctor,stage=midterm,campus=shenzhen]{hit-report}
\ExplSyntaxOn
\cs_new_protected:Npn \showopts
  {
    \clist_map_inline:nn
      { debug , newtxmath , print , raggedbottom , toc }
      {
        \iow_term:x
          {
            ##1 =
            \bool_if_exist:cTF { g__hit_##1_bool }
              { \bool_if:cTF { g__hit_##1_bool } { true } { false } }
              { 未声明 }
          }
      }
  }
\ExplSyntaxOff
\begin{document}
\START
\makeatletter
\TEST{深圳博士中期的布尔选项默认值}{
  \showopts
}
\makeatother
\END
\end{document}
