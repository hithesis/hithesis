% artplus 的布尔选项默认值，与 10 互为对照。两个报告类各声明一份同名选项，
% 分开钉住才能发现只改了一边的情况。
%
% artplus 只声明 raggedbottom 与 toc 两个，这两个键在 hit/style 和根族里注册过，
% 不声明就会报 Missing number。另外四个 artplus 没有对应实现，如实钉成「未声明」。
\input{regression-test}
\documentclass[fontset=fandol,type=doctor,stage=midterm,campus=shenzhen]{hithesisartplus}
\ExplSyntaxOn
\cs_new_protected:Npn \showopts
  {
    \clist_map_inline:nn
      { debug , newtxmath , pifootnote , print , raggedbottom , toc }
      {
        \iow_term:x
          {
            ##1 =
            \bool_if_exist:cTF { g__hit_##1_bool }
              { \bool_if:cTF { g__hit_##1_bool } { true } { false } }
              { 未声明 }
          }
      }
  }
\ExplSyntaxOff
\begin{document}
\START
\makeatletter
\TEST{artplus 的布尔选项默认值}{
  \showopts
}
\makeatother
\END
\end{document}
