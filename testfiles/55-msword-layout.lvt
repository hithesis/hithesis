% \docxlike_page_setup:n 把 Word 的页面设置换算成版面参数。
%
% 四件事：行距原样收；每页行数按缇往下截推出行距；行距与每页行数照对话框联动，
% 后写的算；上一次调用的键不留到下一次。
%
% 设版面是导言区的事，所以五次调用都在导言区做，结果先存进记号列表，
% 正文里 \START 之后再打出来。
\input{regression-test}
\documentclass[fontset=fandol,degree-level=master,campus=harbin]{hithesis}
\makeatletter
\ExplSyntaxOn
\cs_new_protected:Npn \RUN #1#2
  {
    \docxlike_page_setup:n {#2}
    \tl_new:c { l__test_#1_tl }
    \tl_set:cx { l__test_#1_tl }
      {
        行距 = \dim_use:N \g_docxlike_page_lead_dim
        ~ 字距 = \dim_use:N \g_docxlike_page_char_dim
        ~ 格数 = \int_use:N \g_docxlike_page_cells_int
      }
  }
\cs_new_protected:Npn \SHOW #1
  { \iow_term:x { #1 ~ \tl_use:c { l__test_#1_tl } } }

% 范例的设置：行距与字距都直接给
\RUN { given }
  {
    margins = { top = 3.8cm , bottom = 3cm , left = 3cm , right = 3cm } ,
    layout = { from-edge = { header = 3cm , footer = 2.3cm } } ,
    document-grid = { lines = { pitch = 19.55bp } , characters = { pitch = 12.45bp } } ,
  }

% 只给每页行数：版心高 229mm = 12982.68 缇，除以 30 往下截得 432 缇 = 21.6bp；
% 版心宽 150mm = 8503.94 缇，除以 34 得 250 缇 = 12.5bp
\RUN { derived }
  {
    margins = { top = 3.8cm , bottom = 3cm , left = 3cm , right = 3cm } ,
    layout = { from-edge = { header = 3cm , footer = 2.3cm } } ,
    document-grid = { lines = { lines-per-page = 30 } , characters = { characters-per-line = 34 } } ,
  }

% 先写行数再写行距，行距算
\RUN { pitchlast }
  {
    margins = { top = 3.8cm , bottom = 3cm , left = 3cm , right = 3cm } ,
    layout = { from-edge = { header = 3cm , footer = 2.3cm } } ,
    document-grid = { lines = { lines-per-page = 30 , pitch = 19.55bp } , characters = { pitch = 12.45bp } } ,
  }

% 先写行距再写行数，行数算，与只给行数一样
\RUN { lineslast }
  {
    margins = { top = 3.8cm , bottom = 3cm , left = 3cm , right = 3cm } ,
    layout = { from-edge = { header = 3cm , footer = 2.3cm } } ,
    document-grid = { lines = { pitch = 19.55bp , lines-per-page = 30 } , characters = { pitch = 12.45bp } } ,
  }

% 上一次调用的键不该留到下一次：这里只给行距与每行字数，字距该重新推
\RUN { reset }
  {
    margins = { top = 3.8cm , bottom = 3cm , left = 3cm , right = 3cm } ,
    layout = { from-edge = { header = 3cm , footer = 2.3cm } } ,
    document-grid = { lines = { pitch = 19.55bp } , characters = { characters-per-line = 34 } } ,
  }
\ExplSyntaxOff
\makeatother
\begin{document}
\START
\ExplSyntaxOn
\TEST{pitch~given}{ \SHOW { given } }
\TEST{lines~derive~pitch}{ \SHOW { derived } }
\TEST{pitch~written~last}{ \SHOW { pitchlast } }
\TEST{lines~written~last}{ \SHOW { lineslast } }
\TEST{keys~reset~between~calls}{ \SHOW { reset } }
\ExplSyntaxOff
\END
\end{document}
