% 对外暴露的命令必须存在。示例文档不一定用到每一个，
% 42 变体测不到“某个宏被重构弄丢了”。
%
% 只断言存在与否。这些是用户接口，CONTRIBUTING §4.1 规定不得删改；至于它们
% 各自展开成什么属于实现，重构过程中会变，不该由本文件钉住。
%
% \rcell 这类示例宏由 hithesis.sty 提供，不由类提供，钉在 36-example-package.lvt。
% 这里顺带断言类里没有它们：漏回类里就说明又并进去了。
\input{regression-test}
\documentclass[fontset=fandol,degree-level=doctor,campus=harbin]{hit-thesis}
\begin{document}
\START
\makeatletter
\TEST{对外命令都在}{
  \typeout{inlinecite=\ifdefined\inlinecite yes\else MISSING\fi}
  \typeout{bicaption=\ifdefined\bicaption yes\else MISSING\fi}
  \typeout{hitsetup=\ifdefined\hitsetup yes\else MISSING\fi}
  \typeout{citeup=\ifdefined\citeup yes\else MISSING\fi}
}
\TEST{示例宏不由类提供}{
  \typeout{rcell=\ifdefined\rcell IN-CLASS\else absent\fi}
  \typeout{theVector=\ifdefined\theVector IN-CLASS\else absent\fi}
  \typeout{AlgoBiCaption=\ifdefined\AlgoBiCaption IN-CLASS\else absent\fi}
}
\makeatother
\END
\end{document}
