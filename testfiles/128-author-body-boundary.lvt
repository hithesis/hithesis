\msg_redirect_module:nnn{fontspec}{info}{none}
\tl_new:N\l__hit_author_state_tl
\tl_new:N\l__hit_author_owner_tl
\dim_new:N\l__hit_author_leading_dim
\ExplSyntaxOff
\begin{document}
\START
\makeatletter\ExplSyntaxOn
\TEST{Body~geometry~is~cached~after~installation}{
  \TYPE{topskip-valid=\dim_compare:nNnTF{\topskip}<{1sp}{no}{yes}}
  \TYPE{cached-topskip=\skip_if_eq:nnTF{\topskip}{\g__hit_page_doc_topskip_skip}{same}{different}}
  \docxlike_native_boundary_get:NNN\l__hit_author_state_tl\l__hit_author_leading_dim\l__hit_author_owner_tl
  \TYPE{boundary=\l__hit_author_state_tl}
  \TYPE{leading=\dim_compare:nNnTF{\l__hit_author_leading_dim}={0pt}{zero}{nonzero}}
  \TYPE{owner=\tl_if_empty:NTF\l__hit_author_owner_tl{empty}{nonempty}}
}
\TEST{Repeated~installation~keeps~the~class~normalsize~and~display~skips}{
  \docxlike_body_install:n{cjk=external,normalsize=preserve,word-interline=false,rigid-ragged=false}
  \docxlike_body_install:n{}
  \small\normalsize
  \TYPE{body-size=\dim_compare:nNnTF{\dim_abs:n{\f@size pt-\g_docxlike_body_size_dim}}<{.001pt}{same}{different}}
  \TYPE{display-skip=\dim_compare:nNnTF{\belowdisplayskip}={8pt}{preserved}{changed}}
}
\ExplSyntaxOff\makeatother
\END
\end{document}
