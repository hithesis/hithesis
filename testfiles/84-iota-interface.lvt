% 校名与部件词条的公开接口：分组、路径及单页覆盖不能互相覆盖。
\input{regression-test}
\documentclass[fontset=fandol,degree-level=doctor]{hithesis}
\hitsetup{info={
  institution={Custom University}[English University],
}}
\hitsetup{overrides={
  references={heading={Custom References}},
  achievements={heading={Custom Achievements}},
  defense={chair={Custom Chair}},
  titlepage={university={\keepvalue}[Titlepage University]},
}}
\begin{document}
\START
\makeatletter
\TEST{Institution fields}{
  \typeout{institution-zh=[\hit@term@base@university@zh]}
  \typeout{institution-en=[\hit@term@base@university@en]}
  \typeout{titlepage-en=[\hit@term@titlepage@university@en]}
  \hitsetup{info={institution={\keepvalue}[Updated University]}}
  \typeout{updated-en=[\hit@term@base@university@en]}
  \typeout{titlepage-en=[\hit@term@titlepage@university@en]}
}
\TEST{Part override groups}{
  \typeout{references=[\hit@term@bibliography@heading@zh]}
  \typeout{achievements=[\hit@term@publications@heading@zh]}
  \typeout{defense=[\hit@term@resolution@chair]}
  \hitsetup{
    overrides={references={heading={\keepvalue}[English References]},
      achievements={heading={\keepvalue}[English Achievements]},
      defense={chair={Updated Chair}}},
  }
  \typeout{references-en=[\hit@term@bibliography@heading@en]}
  \typeout{achievements-en=[\hit@term@publications@heading@en]}
  \typeout{defense=[\hit@term@resolution@chair]}
}
\makeatother
\END
\end{document}
