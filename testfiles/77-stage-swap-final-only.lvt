% 终稿专有的整章环境，在报告那一档报一句说清楚的提示，并把整段跳过。
%
% 与 76 号是一对。76 钉“正文里能用的两档都在”，这里钉「整页级的只有终稿有，
% 而且报错报得干净」：不吞正文的话，LaTeX 先报一句“环境未定义”，接着照样把
% 整段排出来，\end 对不上，一路报到 \end{document}，原先是这个样子。
%
% 只断言环境定义在、且带 +b（吞正文）。提示本身在 \msg_error，抓不进 tlg 的
% 断言区，所以钉的是参数表。
\input{regression-test}
\documentclass[fontset=fandol,degree-level=doctor,campus=harbin,stage=proposal]{hithesis}
\begin{document}
\START
\makeatletter
\TEST{八个环境在报告里都有定义}{
  \typeout{conclusions=\ifcsname conclusions\endcsname 有\else 无\fi}
  \typeout{acknowledgements=\ifcsname acknowledgements\endcsname 有\else 无\fi}
  \typeout{resume=\ifcsname resume\endcsname 有\else 无\fi}
  \typeout{publication=\ifcsname publication\endcsname 有\else 无\fi}
  \typeout{pubgroup=\ifcsname pubgroup\endcsname 有\else 无\fi}
  \typeout{ceindex=\ifcsname ceindex\endcsname 有\else 无\fi}
}
\makeatother
\END
\end{document}
