% 终稿专有的整章环境，在报告那一档静默跳过。
%
% 与 76 号是一对。76 钉“正文里能用的两档都在”，这里钉「整页级的只有终稿有，
% 报告里写了不报错也不排」。不吞正文的话，LaTeX 先报一句“环境未定义”，接着
% 照样把整段排出来，\end 对不上，一路报到 \end{document}，改之前是这个样子。
%
% 这是本类唯一容许的静默失效，理由写在 src/pages/hit-final-backmatter.dtx 里。
% 断言两件事：环境在报告里有定义，并且用了它排不出任何东西。
\input{regression-test}
\documentclass[fontset=fandol,degree-level=doctor,campus=harbin,stage=proposal]{hithesis}
\begin{document}
\START
\makeatletter
\TEST{八个环境在报告里都有定义}{
  \typeout{conclusions=\ifcsname conclusions\endcsname 有\else 无\fi}
  \typeout{acknowledgements=\ifcsname acknowledgements\endcsname 有\else 无\fi}
  \typeout{correspondingaddr=\ifcsname correspondingaddr\endcsname 有\else 无\fi}
  \typeout{resume=\ifcsname resume\endcsname 有\else 无\fi}
  \typeout{publication=\ifcsname publication\endcsname 有\else 无\fi}
  \typeout{pubgroup=\ifcsname pubgroup\endcsname 有\else 无\fi}
  \typeout{doctorpublication=\ifcsname doctorpublication\endcsname 有\else 无\fi}
  \typeout{ceindex=\ifcsname ceindex\endcsname 有\else 无\fi}
}
\TEST{写了排不出东西，也不报错}{
  \setbox0=\vbox{\begin{conclusions}这一段不该出现在报告里。\end{conclusions}}
  \typeout{conclusions-高=\the\ht0, 深=\the\dp0}
  \setbox0=\vbox{\begin{pubgroup}[auto]{组名}条目\end{pubgroup}}
  \typeout{pubgroup-高=\the\ht0, 深=\the\dp0}
}
\makeatother
\END
\end{document}
