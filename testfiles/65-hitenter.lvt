% \hitenter：模拟 Word 里单独按一次回车留下的空段。
%
% 高度走版面制度同一条规则（空段行高 = 段落标记字体的自然行高 × 1.25），
% 不写死数值。可选参数是回车几次，也收新版面词汇（size、line-spacing、
% font-en/font-zh）。恰逢换页时不带星号的随页首丢弃，星号版逐行发真实
% 空行盒，页底装得下几行装几行。
%
% 量法：把“一行文字 + \hitenter + 一行文字”装进 \vbox 量总高，两次的差
% 就是那个空段占的高。空段高与字号绑定，所以这里同时钉住 12bp 正文档的值。
%
% \ExplSyntaxOn 写进 \TEST 的花括号参数是空操作（参数在那之前就记号化完了），
% 所以带下划线的名字先在导言区包一层。
\input{regression-test}
\documentclass[fontset=fandol,degree-level=bachelor,campus=harbin]{hit-thesis}
\ExplSyntaxOn
\box_new:N \l__hitenter_test_box
\cs_new_protected:Npn \hitentershow #1#2
  {
    \vbox_set:Nn \l__hitenter_test_box
      { \noindent 甲 \par #1 \noindent 乙 \par }
    \iow_term:x
      { #2 ~ 总高 = \dim_use:N \box_ht_plus_dp:N \l__hitenter_test_box }
  }
\ExplSyntaxOff
\begin{document}
\START
\makeatletter
\TEST{不写参数就是一个空段}{
  \hitentershow{}{无空段}
  \hitentershow{\hitenter}{一个}
}
\TEST{整数参数是回车几次}{
  \hitentershow{\hitenter[2]}{两个}
  \hitentershow{\hitenter[3]}{三个}
}
\TEST{星号版逐行发空行盒，中页几何与不带星号同值}{
  \hitentershow{\hitenter*}{星号一个}
  \hitentershow{\hitenter*[3]}{星号三个}
}
\TEST{可选参数收新版面词汇}{
  \hitentershow{\hitenter[lines=2]}{lines=2}
  \hitentershow{\hitenter[size=wuhao]}{五号}
  \hitentershow{\hitenter[line-spacing=25bp!]}{固定值}
  \hitentershow{\hitenter[line-spacing=10bp+]}{最小值取自然行高}
  \hitentershow{\hitenter[line-spacing=2]}{倍数二}
  \hitentershow{\hitenter[font-zh=songti]}{宋体段落标记}
}
\makeatother
\END
\end{document}
