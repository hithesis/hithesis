% 斜杠路径写法。
%
% 路径式与嵌套式均接受同一双语内容，路径两侧空格不影响解析。
%
% 断言三件事：两段路径与三段路径都存进带后缀的正式键；斜杠两边有空格照样认；
% 键名写错时报的是我们的中文提示，不是 l3keys 的英文错——路径式要是没接上族，
% 报错会退回 l3keys 那条，这里能看出来。
%
% 15-language-group.lvt 钉的是 zh = {...} 分组，两份走的是同一个子族，互为对照。
\input{regression-test}
\documentclass[fontset=fandol,degree-level=doctor,campus=harbin]{hithesis}
\hitsetup{
  info/title  = {两段路径},
  info/author = {张三},
  info / author = {张三}[Zhang San],
  overrides/base/university = {某某大学},
}
\begin{document}
\START
\makeatletter
\TEST{两段路径落在正式键上}{
  \typeout{title-zh=[\hit@info@title@flat@zh]}
}
\TEST{三段路径与分组等价}{
  \typeout{author-zh=[\hit@info@author@zh]}
  \typeout{university-zh=[\hit@term@base@university@zh]}
}
\TEST{斜杠两边可以有空格}{
  \typeout{author-en=[\hit@info@author@en]}
}
\TEST{路径里的键名写错走中文提示}{
  \hitsetup{ info/no-such-key = {1180800000} }
}
\makeatother
\END
\end{document}
