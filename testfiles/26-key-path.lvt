% 斜杠路径写法。
%
% l3keys 按最后一个斜杠切键名，左边当族名右边当键名，所以 info/title-zh 直接落在
% hit/info 族上，不用我们做什么。三段的 info/zh/title 要落在 hit/info/zh 上，那个
% 族得真的存在——它由 \__hit_declare_language_group:nn 声明，同一句也把 zh = {...}
% 分组键接到它上面，两种写法走同一条转发。
%
% 断言三件事：两段路径与三段路径都存进带后缀的正式键；斜杠两边有空格照样认；
% 键名写错时报的是我们的中文提示，不是 l3keys 的英文错——路径式要是没接上族，
% 报错会退回 l3keys 那条，这里能看出来。
%
% 15-language-group.lvt 钉的是 zh = {...} 分组，两份走的是同一个子族，互为对照。
\input{regression-test}
\documentclass[fontset=fandol,degree-level=doctor,campus=harbin]{hit-thesis}
\hitsetup{
  info/title-zh  = {两段路径},
  info/zh/author = {张三},
  info / en / author = {Zhang San},
  const/zh/school = {某某大学},
}
\begin{document}
\START
\makeatletter
\TEST{两段路径落在正式键上}{
  \typeout{title-zh=[\hit@title@flat@zh]}
}
\TEST{三段路径与分组等价}{
  \typeout{author-zh=[\hit@author@zh]}
  \typeout{school-zh=[\hit@school@zh]}
}
\TEST{斜杠两边可以有空格}{
  \typeout{author-en=[\hit@author@en]}
}
\TEST{路径里的键名写错走中文提示}{
  \hitsetup{ info/zh/student-id = {1180800000} }
}
\makeatother
\END
\end{document}
