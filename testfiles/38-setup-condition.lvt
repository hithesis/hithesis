% \hitsetup 的条件参数。
%
% 用户目录共用一份配置时，里面会同时出现两个类独有的键。不带条件写，不属于本类的
% 那些会走“不认识的键”警告，跟拼错键名拿到同一条提示，分不开。带上条件，不匹配
% 的整块直接跳过，连键都不去设。
%
% 条件语法与内部的 \hit@presetup 同一套：逗号是且，竖线是或，分号分组之间是或。
% 等号左边是装饰性的，右边匹配 \g__hit_<取值>_bool。
%
% 断言四件事：条件成立时设值生效；不成立时不生效、也不报“不认识的键”；条件取值
% 写错时报的是“不认识的取值”而不是 Undefined control sequence；不带条件照旧。
\input{regression-test}
\documentclass[fontset=fandol,degree-level=doctor,campus=harbin]{hit-thesis}
\hitsetup[kind=thesis]{ const = { declarations-heading-zh = {条件成立} } }
\hitsetup[kind=report]{ const = { bibliography-heading-zh  = {不该生效} } }
\hitsetup[campus=harbin,degree-level=doctor]{ const = { acknowledgement-heading-zh = {两个都成立} } }
\hitsetup[campus=shenzhen;campus=harbin]{ const = { defense-heading-zh = {分组之或} } }
\hitsetup{ const = { resume-heading-zh = {不带条件照旧} } }
\begin{document}
\START
\makeatletter
\TEST{条件成立时设值生效}{
  \typeout{declarations=[\hit@declarations@heading@zh]}
  \typeout{and=[\hit@acknowledgement@heading@zh]}
  \typeout{or=[\hit@defense@heading@zh]}
  \typeout{none=[\hit@resume@heading@zh]}
}
\TEST{条件不成立时不生效，也不报不认识的键}{
  \typeout{bib=[\hit@bibliography@heading@zh]}
}
\TEST{条件取值写错报的是不认识的取值}{
  \hitsetup[kind=nosuchthing]{ const = { index-heading-zh = {不该生效} } }
  \typeout{index=[\hit@index@heading@zh]}
}
\makeatother
\END
\end{document}
