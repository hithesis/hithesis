% 依赖的 xeCJK/ctex 内部接口。
%
% 标点与字符网格那套机器扒了 xeCJK 的字符类接口，其中三个是双下划线的私有
% 名字。这些不是 xeCJK 的公开 API，改版就可能改名。源码里已经用六重存在性
% 检查把着门，缺任何一个就整块不发并报 xecjk-punct-grid，不会静默出错。
%
% 这个测试把「当前装的 xeCJK/ctex 提供了哪几个」钉进基线。CI 的 TeX Live
% 矩阵跑 2022 到 2026 五个版本，哪个版本上少了哪一个，这里会直接差出来，
% 不必等到肉眼看排版走样。接口清单见 src/utils/hit-format.dtx 的
% \hit@format@punct@grid:。
%
% \ccwd 一并报：它是汉字步进，等于网格格宽说明网格真的装上了。
\input{regression-test}
\documentclass[fontset=fandol,degree-level=bachelor,campus=harbin]{hit-thesis}
\ExplSyntaxOn
\cs_new_protected:Npn \hitshowcs #1
  {
    \iow_term:x
      { #1 = \cs_if_exist:cTF {#1} { 在 } { 缺 } }
  }
\cs_new_protected:Npn \hitshowiface
  {
    \clist_map_inline:nn
      {
        xeCJK_pre_inter_class_toks:nnn ,
        xeCJK_copy_inter_class_toks:nnnn ,
        xeCJK_replace_inter_class_toks:nnnn ,
        xeCJK_new_class:n ,
        xeCJK_class_num:n ,
        __xeCJK_save_CJK_class:n ,
        __xeCJK_use_ecglue_skip: ,
        g__xeCJK_class_seq ,
        ctex_update_ccglue: ,
        l__ctex_ccglue_skip
      }
      { \hitshowcs {##1} }
  }
\cs_new_protected:Npn \hitshowgrid
  {
    \iow_term:x { ccwd = \dim_use:N \ccwd }
    \iow_term:x { 格宽 = \dim_use:N \g_hit_msword_char_dim }
  }
\ExplSyntaxOff
\begin{document}
\START
\makeatletter
\TEST{标点机器依赖的内部接口}{
  \hitshowiface
}
\TEST{网格装上了：汉字步进等于格宽}{
  \hitshowgrid
}
\makeatother
\END
\end{document}
