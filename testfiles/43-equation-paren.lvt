% math/numbering-parenthesis-style：公式编号两边括号的全角半角。
%
% 中文论文默认全角，取 half 换半角。英文论文（lang=en）不受这个键影响，一律半角，
% 所以判断是“不是英文”与“键取 full”相与，不是只看键。
%
% 判断写在 \hit@equation@paren@left 的宏体里现取现判，不是在设键时把括号定死：
% \hitsetup 在导言区才调用，那时 \tagform@ 早定义完了，定死的话键写在哪儿都没用。
% 这条钉的就是“设完键立刻生效、还能来回切”。
%
% 断言调 \__hit_equation_paren:nn，那正是 \hit@equation@paren@left 和 @right 共用的
% 那步判断。不直接展开那两个包装宏：它们是 protected，\typeout 展不开，而且全角括号
% 在 xeCJK 下是活动字符，写进日志没意义。这里传两个普通词进去看挑中哪一个。
\input{regression-test}
\documentclass[fontset=fandol,degree-level=doctor,campus=harbin]{hithesis}
\begin{document}
\START
\ExplSyntaxOn
\TEST{中文默认全角}{
  \typeout{括号=\__hit_equation_paren:nn {全角}{半角}}
}
\TEST{取half换半角}{
  \hitsetup{ math = { numbering-parenthesis-style = half } }
  \typeout{括号=\__hit_equation_paren:nn {全角}{半角}}
}
\TEST{取full换回全角}{
  \hitsetup{ math = { numbering-parenthesis-style = full } }
  \typeout{括号=\__hit_equation_paren:nn {全角}{半角}}
}
\TEST{取值写错要报错}{
  \hitsetup{ math = { numbering-parenthesis-style = quan } }
}
\TEST{不给值要报错}{
  \hitsetup{ math = { numbering-parenthesis-style } }
}
\ExplSyntaxOff
\END
\end{document}
