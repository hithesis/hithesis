\input{regression-test}
\documentclass[fontset=fandol,degree-level=master,lang=en]{hithesis}
\hitsetup{info={title={English}[中文],author={Author}[作者],subtitle={Sub}[副题]}}
\begin{document}
\START
\makeatletter
\ExplSyntaxOn
\TEST{English~document~uses~English~as~primary}{
  \typeout{en=[\hit@info@title@cover@en],zh=[\hit@info@title@cover@zh]}
}
\RenewDocumentCommand\hit@bilingual@original@chapter{s o m o}
  {\typeout{heading=[#3],english-toc=[#4]}}
\RenewDocumentCommand\hit@bilingual@original@caption{s o m o}
  {\typeout{caption=[#3],secondary=[#4]}}
\TEST{Swap~is~a~scoped~setting~not~a~toggle}{
  \group_begin:
    \bilingualswapon\bilingualswapon
    \chapter{中文章}[English~Chapter]
    \caption{中文图}[English~Figure]
    \hitsetup{info={author={新作者}[New~Author]}}
  \group_end:
  \chapter{Next~Chapter}[下一章]
  \caption{Next~Figure}[下一图]
  \typeout{author-en=[\hit@info@author@en],author-zh=[\hit@info@author@zh]}
}
\cs_set_protected:Npn \__hit_titlepage_part:
  {\typeout{local=[\hit@info@title@cover@en],subtitle=[\hit@info@title@subtitle@en]}}
\TEST{Page~overrides~inherit~and~restore}{
  \titlepage[info={title={Local}[\keepvalue],subtitle={}[\keepvalue]}]
  \typeout{after=[\hit@info@title@cover@en],subtitle=[\hit@info@title@subtitle@en]}
}
\TEST{Explicit~empty~differs~from~keep}{
  \hitsetup{info={author={\keepvalue}[]}}
  \typeout{author-en=[\hit@info@author@en],author-zh=[\hit@info@author@zh]}
}
\ExplSyntaxOff
\makeatother
\END
\end{document}
